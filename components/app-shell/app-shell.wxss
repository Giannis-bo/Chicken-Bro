.wow-app-shell {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  max-width: 100vw;
  overflow-x: hidden;
  overflow-y: visible;
  color: #f4ead9;
  background: #050504;
  box-sizing: border-box;
  contain: layout paint style;
  --wow-app-top-safe: 0rpx;
  --wow-app-bottom-safe: 0rpx;
  --wow-app-gutter: 24rpx;
}

.wow-app-shell__material,
.wow-app-shell__backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.wow-app-shell__material {
  opacity: 0.32;
}

.wow-app-shell__backdrop {
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.055) 0 1rpx, transparent 1rpx 128rpx),
    linear-gradient(0deg, rgba(248, 183, 0, 0.04) 0 1rpx, transparent 1rpx 128rpx),
    radial-gradient(circle at 20% -6%, rgba(248, 183, 0, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(8, 7, 5, 0.96), rgba(4, 4, 3, 1));
}

.wow-app-shell__nav,
.wow-app-shell__body {
  position: relative;
  z-index: 1;
  min-width: 0;
  box-sizing: border-box;
}

.wow-app-shell__nav {
  flex: none;
  padding-top: var(--wow-app-top-safe);
}

.wow-app-shell__body {
  flex: 1;
  min-height: auto;
  padding-bottom: var(--wow-app-bottom-safe);
}

.wow-app-shell.is-tab-safe {
  --wow-app-bottom-safe: calc(176rpx + env(safe-area-inset-bottom));
}

.wow-app-shell.is-nav-safe {
  --wow-app-top-safe: env(safe-area-inset-top);
}

.wow-app-shell.is-lock-scroll {
  height: 100vh;
  overflow: hidden;
}

.wow-app-shell.is-lock-scroll .wow-app-shell__body {
  min-height: 0;
  overflow: hidden;
}

.wow-app-shell.density-compact {
  --wow-app-gutter: 20rpx;
}

.wow-app-shell.density-large {
  --wow-app-gutter: 28rpx;
}
