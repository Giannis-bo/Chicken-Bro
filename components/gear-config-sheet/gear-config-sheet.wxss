.wow-gear-config-sheet {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-gear-config-sheet__panel {
  display: block;
  min-width: 0;
}

.wow-gear-config-sheet__head-actions {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: max-content;
  align-items: center;
  justify-content: end;
  gap: 8rpx;
}

.wow-gear-config-sheet__source-strip,
.wow-gear-config-sheet__chip-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
}

.wow-gear-config-sheet__filter,
.wow-gear-config-sheet__chip {
  display: grid;
  gap: 4rpx;
  min-width: 0;
  min-height: 58rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.wow-gear-config-sheet__filter.is-selected,
.wow-gear-config-sheet__chip.is-selected {
  border-color: rgba(248, 183, 0, 0.86);
  background: rgba(248, 183, 0, 0.12);
}

.wow-gear-config-sheet__filter.state-blocked,
.wow-gear-config-sheet__chip.state-blocked {
  border-color: rgba(255, 107, 100, 0.52);
}

.wow-gear-config-sheet__filter text,
.wow-gear-config-sheet__chip text,
.wow-gear-config-sheet__candidate-head text,
.wow-gear-config-sheet__section-title,
.wow-gear-config-sheet__enhancement-group > text,
.wow-gear-config-sheet__template text,
.wow-gear-config-sheet__empty text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-gear-config-sheet__filter text:first-child,
.wow-gear-config-sheet__chip text:first-child {
  color: #fff8ea;
  font-size: 21rpx;
  font-weight: 950;
}

.wow-gear-config-sheet__filter text:last-child,
.wow-gear-config-sheet__chip text:last-child {
  color: rgba(244, 234, 217, 0.64);
  font-size: 18rpx;
  font-weight: 820;
}

.wow-gear-config-sheet__candidate-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  min-width: 0;
  margin-top: 16rpx;
}

.wow-gear-config-sheet__candidate-head text:first-child,
.wow-gear-config-sheet__section-title {
  color: #fff8ea;
  font-size: 26rpx;
  font-weight: 1000;
}

.wow-gear-config-sheet__candidate-head text:last-child {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 950;
}

.wow-gear-config-sheet__candidate-list {
  display: grid;
  gap: 10rpx;
  min-width: 0;
  margin-top: 10rpx;
}

.wow-gear-config-sheet__candidate {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) 76rpx;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 104rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}

.wow-gear-config-sheet__candidate.is-selected {
  border-color: rgba(248, 183, 0, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(255, 225, 128, 0.14);
}

.wow-gear-config-sheet__candidate.state-blocked {
  border-color: rgba(255, 107, 100, 0.52);
}

.wow-gear-config-sheet__candidate-icon {
  width: 76rpx;
  height: 76rpx;
}

.wow-gear-config-sheet__candidate-copy {
  display: grid;
  gap: 5rpx;
  min-width: 0;
}

.wow-gear-config-sheet__candidate-copy text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
}

.wow-gear-config-sheet__candidate-title {
  color: #fff8ea;
  font-size: 23rpx;
  font-weight: 1000;
  white-space: normal;
}

.wow-gear-config-sheet__candidate-meta,
.wow-gear-config-sheet__candidate-detail {
  color: rgba(244, 234, 217, 0.66);
  font-size: 19rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-gear-config-sheet__candidate-detail {
  color: #f8b700;
}

.wow-gear-config-sheet__candidate-status {
  width: 76rpx;
  height: 76rpx;
}

.wow-gear-config-sheet__empty {
  display: grid;
  gap: 8rpx;
  min-height: 132rpx;
  place-items: center;
  padding: 20rpx;
  border: 1rpx dashed rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.24);
  text-align: center;
  box-sizing: border-box;
}

.wow-gear-config-sheet__empty text:first-child {
  color: #fff8ea;
  font-size: 24rpx;
  font-weight: 1000;
}

.wow-gear-config-sheet__empty text:last-child {
  color: rgba(244, 234, 217, 0.64);
  font-size: 20rpx;
  font-weight: 850;
}

.wow-gear-config-sheet__selector,
.wow-gear-config-sheet__enhancements,
.wow-gear-config-sheet__community,
.wow-gear-config-sheet__evidence,
.wow-gear-config-sheet__actions {
  display: grid;
  gap: 10rpx;
  min-width: 0;
  margin-top: 16rpx;
}

.wow-gear-config-sheet__enhancement-group,
.wow-gear-config-sheet__template-list {
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.wow-gear-config-sheet__enhancement-group > text {
  color: rgba(244, 234, 217, 0.7);
  font-size: 21rpx;
  font-weight: 950;
}

.wow-gear-config-sheet__template {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  min-height: 68rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.wow-gear-config-sheet__template view {
  display: grid;
  gap: 4rpx;
  min-width: 0;
}

.wow-gear-config-sheet__template text:first-child {
  color: #fff8ea;
  font-size: 21rpx;
  font-weight: 950;
}

.wow-gear-config-sheet__template text:last-child {
  color: #f8b700;
  font-size: 19rpx;
  font-weight: 900;
}

.wow-gear-config-sheet__actions {
  position: sticky;
  bottom: 0;
  z-index: 2;
  padding-top: 10rpx;
  background: linear-gradient(180deg, rgba(4, 3, 2, 0), rgba(4, 3, 2, 0.96) 28rpx);
}

@media (max-width: 360px) {
  .wow-gear-config-sheet__source-strip,
  .wow-gear-config-sheet__chip-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
