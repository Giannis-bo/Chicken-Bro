<view class="wow-gear-config-sheet {{rootClass}} ext-class" wx:if="{{visible}}">
  <wow-panel
    ext-class="wow-gear-config-sheet__panel"
    title="{{title}}"
    meta="{{meta || slotLabel}}"
    density="dense"
  >
    <view slot="action" class="wow-gear-config-sheet__head-actions">
      <status-visual
        state="{{normalizedStatus}}"
        label="{{normalizedStateLabel}}"
        glyph="{{normalizedStateGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
      <action-button
        label="{{normalizedCloseAction.label}}"
        tone="{{normalizedCloseAction.tone}}"
        size="compact"
        bind:actiontap="handleCloseTap"
      ></action-button>
    </view>

    <view class="wow-gear-config-sheet__source-strip" wx:if="{{normalizedSourceFilters.length}}">
      <view
        wx:for="{{normalizedSourceFilters}}"
        wx:key="key"
        class="wow-gear-config-sheet__filter state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleSourceTap"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.meta}}">{{item.meta}}</text>
      </view>
    </view>

    <view class="wow-gear-config-sheet__candidate-head">
      <text>{{slotLabel}}</text>
      <text>{{normalizedCandidateCountLabel}}</text>
    </view>

    <view class="wow-gear-config-sheet__candidate-list">
      <view
        wx:for="{{normalizedCandidates}}"
        wx:key="id"
        class="wow-gear-config-sheet__candidate state-{{item.status}} {{item.selected ? 'is-selected' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="handleCandidateTap"
      >
        <game-object-icon
          ext-class="wow-gear-config-sheet__candidate-icon"
          object-type="gear"
          entity-id="{{item.id}}"
          display-name="{{item.title}}"
          icon-src="{{item.iconSrc}}"
          icon-name="{{item.iconName}}"
          fallback-text="{{item.fallbackText}}"
          status="{{item.iconSrc || item.iconName ? 'verified' : 'missing'}}"
          size="medium"
          shape="square"
        ></game-object-icon>
        <view class="wow-gear-config-sheet__candidate-copy">
          <text class="wow-gear-config-sheet__candidate-title">{{item.title}}</text>
          <text class="wow-gear-config-sheet__candidate-meta">{{item.meta}}</text>
          <text wx:if="{{item.detail}}" class="wow-gear-config-sheet__candidate-detail">{{item.detail}}</text>
        </view>
        <status-visual
          ext-class="wow-gear-config-sheet__candidate-status"
          state="{{item.status}}"
          label="{{item.statusLabel}}"
          glyph="{{item.statusGlyph}}"
          size="compact"
          showLabel="{{false}}"
        ></status-visual>
      </view>
      <view wx:if="{{!normalizedCandidates.length}}" class="wow-gear-config-sheet__empty">
        <text>当前槽位暂无候选</text>
        <text>刷新来源或导入模板后再配置。</text>
      </view>
    </view>

    <view class="wow-gear-config-sheet__selector" wx:if="{{normalizedVariantTracks.length}}">
      <text class="wow-gear-config-sheet__section-title">装等轨道</text>
      <view class="wow-gear-config-sheet__chip-grid">
        <view
          wx:for="{{normalizedVariantTracks}}"
          wx:key="key"
          class="wow-gear-config-sheet__chip state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
          data-key="{{item.key}}"
          data-status="{{item.status}}"
          bindtap="handleVariantTap"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{item.meta}}">{{item.meta}}</text>
        </view>
      </view>
    </view>

    <view class="wow-gear-config-sheet__selector" wx:if="{{normalizedCraftedStatOptions.length}}">
      <text class="wow-gear-config-sheet__section-title">制造属性</text>
      <view class="wow-gear-config-sheet__chip-grid">
        <view
          wx:for="{{normalizedCraftedStatOptions}}"
          wx:key="key"
          class="wow-gear-config-sheet__chip state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
          data-key="{{item.key}}"
          data-status="{{item.status}}"
          bindtap="handleCraftedTap"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{item.meta}}">{{item.meta}}</text>
        </view>
      </view>
    </view>

    <view class="wow-gear-config-sheet__enhancements" wx:if="{{normalizedSocketOptions.length || normalizedEnchantOptions.length || normalizedEmbellishmentOptions.length}}">
      <text class="wow-gear-config-sheet__section-title">强化配置</text>
      <view class="wow-gear-config-sheet__enhancement-group" wx:if="{{normalizedSocketOptions.length}}">
        <text>宝石</text>
        <view class="wow-gear-config-sheet__chip-grid">
          <view
            wx:for="{{normalizedSocketOptions}}"
            wx:key="key"
            class="wow-gear-config-sheet__chip state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
            data-kind="socket"
            data-key="{{item.key}}"
            data-status="{{item.status}}"
            bindtap="handleEnhancementTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.meta}}">{{item.meta}}</text>
          </view>
        </view>
      </view>
      <view class="wow-gear-config-sheet__enhancement-group" wx:if="{{normalizedEnchantOptions.length}}">
        <text>附魔</text>
        <view class="wow-gear-config-sheet__chip-grid">
          <view
            wx:for="{{normalizedEnchantOptions}}"
            wx:key="key"
            class="wow-gear-config-sheet__chip state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
            data-kind="enchant"
            data-key="{{item.key}}"
            data-status="{{item.status}}"
            bindtap="handleEnhancementTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.meta}}">{{item.meta}}</text>
          </view>
        </view>
      </view>
      <view class="wow-gear-config-sheet__enhancement-group" wx:if="{{normalizedEmbellishmentOptions.length}}">
        <text>美化</text>
        <view class="wow-gear-config-sheet__chip-grid">
          <view
            wx:for="{{normalizedEmbellishmentOptions}}"
            wx:key="key"
            class="wow-gear-config-sheet__chip state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
            data-kind="embellishment"
            data-key="{{item.key}}"
            data-status="{{item.status}}"
            bindtap="handleEnhancementTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.meta}}">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="wow-gear-config-sheet__community" wx:if="{{normalizedCommunityTemplates.length}}">
      <text class="wow-gear-config-sheet__section-title">模板导入</text>
      <view class="wow-gear-config-sheet__template-list">
        <view
          wx:for="{{normalizedCommunityTemplates}}"
          wx:key="key"
          class="wow-gear-config-sheet__template state-{{item.status}} {{item.selected ? 'is-selected' : ''}}"
          data-key="{{item.key}}"
          data-status="{{item.status}}"
          bindtap="handleCommunityTap"
        >
          <view>
            <text>{{item.label}}</text>
            <text wx:if="{{item.meta}}">{{item.meta}}</text>
          </view>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>
    </view>

    <evidence-ledger
      wx:if="{{normalizedEvidenceRows.length || normalizedBlockerRows.length}}"
      ext-class="wow-gear-config-sheet__evidence"
      title="配置证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedBlockerRows.length ? normalizedBlockerRows : normalizedEvidenceRows}}"
      expanded="{{true}}"
      collapsed-rows="4"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>

    <view class="wow-gear-config-sheet__actions">
      <action-button
        label="{{normalizedApplyAction.label}}"
        tone="{{normalizedApplyAction.tone}}"
        size="large"
        block="{{true}}"
        disabled="{{normalizedApplyAction.disabled}}"
        loading="{{normalizedApplyAction.loading}}"
        bind:actiontap="handleApplyTap"
      ></action-button>
    </view>
  </wow-panel>
</view>
