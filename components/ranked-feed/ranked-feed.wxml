<view class="ranked-feed-root news-module-dock news-module-dock--ranked-feed">
  <view class="section-header ranked-feed-header">
    <text class="section-title news-section-title ranked-feed-title">今日重点</text>
    <view class="section-action news-section-action ranked-feed-action" bindtap="handleActionTap">
      <text>查看</text>
      <text class="section-action-arrow">›</text>
    </view>
  </view>
  <view class="focus-list">
    <view
      class="focus-row news-module-card visual-tone-{{item.visualTone}} state-{{item.rowState}} thumb-{{item.thumbState}} {{item.isEvidenceGap ? 'is-evidence-gap' : ''}} {{item.isSourceReference ? 'is-source-reference' : ''}} {{item.isOpenable ? '' : 'is-disabled-row'}} {{index == 4 ? 'is-final-focus-row' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.isOpenable ? item.id : ''}}"
      data-rank="{{item.rankNumber}}"
      data-row-state="{{item.rowState}}"
      data-thumb-state="{{item.thumbState}}"
      bindtap="handleItemTap"
    >
      <view class="focus-rank">
        <text class="focus-rank-number">{{item.rankNumber}}</text>
      </view>
      <view class="focus-thumb thumb-state-{{item.thumbState}}">
        <image wx:if="{{item.visualUrl}}" src="{{item.visualUrl}}" mode="aspectFill"></image>
        <view wx:else class="focus-thumb-fallback visual-tone-{{item.visualTone}}">
          <image wx:if="{{item.fallbackThumbUrl}}" class="focus-thumb-fallback-image" src="{{item.fallbackThumbUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
          <text wx:if="{{!item.fallbackThumbUrl}}" class="visual-mark">{{item.visualText}}</text>
        </view>
      </view>
      <view class="focus-main">
        <view class="focus-head">
          <text class="focus-badge">{{item.visualLabel}}</text>
          <text class="focus-title">{{item.displayRankedTitle || item.title}}</text>
        </view>
        <view class="focus-meta-row">
          <text class="focus-channel">{{item.channel}}</text>
          <text class="focus-meta">{{item.displayFeedMeta}}</text>
        </view>
      </view>
      <view class="focus-save {{item.isOpenable ? '' : 'is-disabled'}}" catchtap="handleItemTap" data-id="{{item.isOpenable ? item.id : ''}}">
        <view class="focus-save-mark"></view>
      </view>
    </view>
  </view>
</view>
