.wow-panel {
  position: relative;
  display: grid;
  gap: 16rpx;
  min-width: 0;
  overflow: hidden;
  padding: 20rpx;
  color: #f4ead9;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(18, 16, 12, 0.96), rgba(7, 7, 6, 0.98)),
    #090806;
  box-sizing: border-box;
  contain: layout paint style;
  --wow-panel-padding: 20rpx;
}

.wow-panel__material,
.wow-panel__shade {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.wow-panel__material {
  opacity: 0.9;
}

.wow-panel__shade {
  background:
    radial-gradient(circle at 12% 8%, rgba(248, 183, 0, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(4, 4, 3, 0.18), rgba(4, 4, 3, 0.72));
}

.wow-panel__head,
.wow-panel__body {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.wow-panel__head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
}

.wow-panel__title-group,
.wow-panel__body {
  display: grid;
  min-width: 0;
  gap: 8rpx;
}

.wow-panel__kicker,
.wow-panel__title,
.wow-panel__meta {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.wow-panel__kicker {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-panel__title {
  color: #fff8ea;
  font-size: 32rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-panel__meta {
  color: rgba(244, 234, 217, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.12;
}

.wow-panel.is-dense {
  gap: 12rpx;
  padding: 16rpx;
  --wow-panel-padding: 16rpx;
}

.wow-panel.is-danger {
  border-color: rgba(255, 107, 100, 0.44);
  background:
    linear-gradient(180deg, rgba(29, 13, 11, 0.96), rgba(8, 7, 6, 0.98)),
    #0d0706;
}

.wow-panel.is-danger .wow-panel__shade {
  background:
    radial-gradient(circle at 82% 20%, rgba(255, 107, 100, 0.16), transparent 34%),
    linear-gradient(180deg, rgba(4, 4, 3, 0.16), rgba(4, 4, 3, 0.76));
}

.wow-panel.is-source {
  border-color: rgba(147, 185, 255, 0.28);
}

.wow-panel.is-flat {
  border-color: rgba(248, 183, 0, 0.18);
  background: rgba(8, 8, 7, 0.72);
}
