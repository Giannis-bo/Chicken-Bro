.wow-module-card {
  position: relative;
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 48rpx;
  align-items: center;
  min-height: 108rpx;
  overflow: hidden;
  padding: 16rpx 14rpx;
  gap: 12rpx;
  box-sizing: border-box;
  color: #f4ead9;
  border-radius: 8rpx;
  contain: layout paint style;
}

.wow-module-card__frame {
  position: absolute;
  inset: 0;
  z-index: 1;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: inherit;
  background:
    radial-gradient(circle at 18% 12%, rgba(248, 183, 0, 0.16), transparent 34%),
    linear-gradient(180deg, rgba(21, 19, 14, 0.98), rgba(8, 8, 7, 0.98));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
    0 8rpx 20rpx rgba(0, 0, 0, 0.24);
}

.wow-module-card__icon-slot,
.wow-module-card__copy,
.wow-module-card__status {
  position: relative;
  z-index: 2;
}

.wow-module-card__icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
}

.wow-module-card__socket,
.wow-module-card__icon {
  position: absolute;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.wow-module-card__socket {
  opacity: 0.82;
}

.wow-module-card__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.wow-module-card__icon-text {
  position: relative;
  z-index: 2;
  display: block;
  max-width: 44rpx;
  overflow: hidden;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 1000;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-module-card__copy {
  display: grid;
  min-width: 0;
  gap: 4rpx;
}

.wow-module-card__title,
.wow-module-card__metric,
.wow-module-card__meta {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.wow-module-card__title {
  color: rgba(244, 234, 217, 0.72);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.1;
}

.wow-module-card__metric {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-module-card__meta {
  color: rgba(244, 234, 217, 0.58);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.1;
}

.wow-module-card__status {
  width: 46rpx;
  height: 56rpx;
  justify-self: end;
}

.wow-module-card.status-verified .wow-module-card__frame {
  border-color: rgba(95, 214, 139, 0.52);
}

.wow-module-card.status-blocked .wow-module-card__frame {
  border-color: rgba(255, 107, 100, 0.62);
}

.wow-module-card.status-partial .wow-module-card__frame {
  border-color: rgba(248, 183, 0, 0.64);
}

.wow-module-card.status-stale .wow-module-card__frame,
.wow-module-card.status-source_reference .wow-module-card__frame {
  border-color: rgba(118, 169, 236, 0.42);
}

.wow-module-card.is-disabled {
  opacity: 0.56;
}
