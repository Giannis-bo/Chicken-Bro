.wow-page-frame {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  height: 100vh;
  min-height: 100vh;
  max-width: 100vw;
  overflow: hidden;
  color: #f4ead9;
  background: #050504;
  box-sizing: border-box;
  contain: layout paint style;
  --wow-page-gutter: 24rpx;
  --wow-page-top: 22rpx;
  --wow-page-bottom: 56rpx;
  --wow-page-section-gap: 16rpx;
}

.wow-page-frame__backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.06) 0 1rpx, transparent 1rpx 128rpx),
    linear-gradient(0deg, rgba(248, 183, 0, 0.045) 0 1rpx, transparent 1rpx 128rpx),
    radial-gradient(circle at 16% 0%, rgba(248, 183, 0, 0.12), transparent 30%),
    linear-gradient(180deg, #080705 0%, #050504 58%, #030302 100%);
  background-size: auto, auto, auto, auto;
}

.wow-page-frame__scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  min-height: 0;
  height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.wow-page-frame__content {
  position: relative;
  z-index: 1;
  display: grid;
  gap: var(--wow-page-section-gap);
  width: 100%;
  min-width: 0;
  padding:
    var(--wow-page-top)
    var(--wow-page-gutter)
    calc(var(--wow-page-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.wow-page-frame.is-dense {
  --wow-page-gutter: 20rpx;
  --wow-page-top: 18rpx;
  --wow-page-bottom: 44rpx;
  --wow-page-section-gap: 12rpx;
}

.wow-page-frame.is-roomy {
  --wow-page-gutter: 28rpx;
  --wow-page-top: 26rpx;
  --wow-page-bottom: 64rpx;
  --wow-page-section-gap: 20rpx;
}

.wow-page-frame.is-flat .wow-page-frame__backdrop {
  background: #050504;
}
