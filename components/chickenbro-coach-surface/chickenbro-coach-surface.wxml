<view class="wow-chickenbro-surface {{rootClass}} ext-class">
  <material-image
    wx:if="{{materialSrc}}"
    class="wow-chickenbro-surface__material"
    src="{{materialSrc}}"
    tone="panel"
    fit="cover"
    opacity="0.32"
    decorative="{{true}}"
  ></material-image>

  <view class="wow-chickenbro-surface__head">
    <status-visual
      state="{{statusState}}"
      label="{{statusLabel}}"
      size="compact"
      shape="seal"
      showLabel="{{false}}"
    ></status-visual>
    <view class="wow-chickenbro-surface__headline">
      <text class="wow-chickenbro-surface__title">{{title}}</text>
      <text class="wow-chickenbro-surface__desc">{{desc}}</text>
    </view>
    <action-button
      class="wow-chickenbro-surface__topic-action"
      label="话题"
      size="compact"
      tone="ghost"
      bind:actiontap="handleOpenDrawer"
    ></action-button>
  </view>

  <view wx:if="{{suggestedPrompts.length}}" class="wow-chickenbro-surface__suggestions">
    <action-button
      wx:for="{{suggestedPrompts}}"
      wx:key="*this"
      data-index="{{index}}"
      label="{{item}}"
      size="compact"
      tone="secondary"
      bind:actiontap="handleSuggestedPrompt"
    ></action-button>
  </view>

  <view class="wow-chickenbro-surface__error" wx:if="{{requestError}}">
    <text class="wow-chickenbro-surface__error-copy">{{requestError}}</text>
    <action-button
      label="重试"
      size="compact"
      tone="danger"
      bind:actiontap="handleRetry"
    ></action-button>
  </view>

  <view class="wow-chickenbro-surface__chat-stage">
    <chat-shell
      entryMode="{{entryMode}}"
      contextTitle="{{resolvedContextTitle}}"
      contextMeta="{{resolvedContextMeta}}"
      messages="{{shellMessages}}"
      inputValue="{{inputValue}}"
      inputPlaceholder="{{inputPlaceholder}}"
      contextActionLabel="上下文"
      newTopicLabel="新话题"
      sendLabel="发送"
      sendingLabel="整理中"
      inputState="{{inputState}}"
      inputDisabled="{{inputDisabled}}"
      submitting="{{loading}}"
      hasDrawer="{{true}}"
      safeAreaBottom="{{safeAreaBottom}}"
      scrollIntoView="{{scrollIntoView}}"
      bind:inputchange="handleInputChange"
      bind:inputfocus="handleInputFocus"
      bind:inputblur="handleInputBlur"
      bind:send="handleSend"
      bind:newtopic="handleNewTopic"
      bind:opendrawer="handleOpenDrawer"
    >
      <view slot="empty" class="wow-chickenbro-surface__empty">
        <text>说出职业、专精、场景和你想解决的问题。</text>
        <text>缺证据时，队长只给补证据路径。</text>
      </view>
    </chat-shell>
  </view>

  <view
    class="wow-chickenbro-surface__drawer-mask"
    wx:if="{{topicDrawerVisible}}"
    bindtap="handleCloseDrawer"
  ></view>
  <view class="wow-chickenbro-surface__drawer" wx:if="{{topicDrawerVisible}}">
    <view class="wow-chickenbro-surface__drawer-head">
      <text class="wow-chickenbro-surface__drawer-title">{{drawerTitle}}</text>
      <action-button
        label="关闭"
        size="compact"
        tone="ghost"
        bind:actiontap="handleCloseDrawer"
      ></action-button>
    </view>
    <view class="wow-chickenbro-surface__drawer-body">
      <text>当前会话会保留追问上下文。</text>
      <text>证据不足时不会给出强结论。</text>
    </view>
  </view>
</view>
