<view class="wow-article-list-board {{rootClass}} ext-class">
  <wow-panel
    title="{{title}}"
    meta="{{countLabel}}"
    variant="{{panelVariant}}"
    density="dense"
    hasHeaderSlot="{{true}}"
  >
    <view slot="action" class="wow-article-list-board__panel-state state-{{statusState}}">
      <text>{{statusLabel}}</text>
    </view>

    <view wx:if="{{loading}}" class="wow-article-list-board__skeletons" aria-label="资讯列表读取中">
      <view class="wow-article-list-board__skeleton"></view>
      <view class="wow-article-list-board__skeleton"></view>
      <view class="wow-article-list-board__skeleton"></view>
    </view>

    <evidence-ledger
      wx:elif="{{evidenceRows.length}}"
      title="来源状态"
      summary="当前列表使用缓存或 fallback"
      rows="{{evidenceRows}}"
      expanded="{{true}}"
      bindtoggle="handleEvidenceToggle"
    ></evidence-ledger>

    <view wx:elif="{{!hasArticles}}" class="wow-article-list-board__empty">
      <text class="wow-article-list-board__empty-title">暂无符合条件的资讯</text>
      <text class="wow-article-list-board__empty-copy">当前频道没有可展示条目，页面保留来源状态，不生成假内容。</text>
    </view>

    <view wx:else class="wow-article-list-board__rows">
      <view
        class="wow-article-list-board__row state-{{item.state}}"
        wx:for="{{visibleArticles}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="handleArticleTap"
      >
        <view class="wow-article-list-board__rank">
          <text>{{item.rank}}</text>
        </view>
        <view class="wow-article-list-board__visual">
          <material-image
            wx:if="{{item.thumbnail}}"
            src="{{item.thumbnail}}"
            fit="cover"
            tone="panel"
            opacity="{{1}}"
            decorative="{{false}}"
          ></material-image>
          <view wx:else class="wow-article-list-board__visual-fallback">
            <text>{{item.fallbackText}}</text>
          </view>
        </view>
        <view class="wow-article-list-board__copy">
          <view class="wow-article-list-board__meta">
            <text class="wow-article-list-board__channel">{{item.channel}}</text>
            <text class="wow-article-list-board__date">{{item.publishedAt}}</text>
          </view>
          <text class="wow-article-list-board__title">{{item.title}}</text>
          <text class="wow-article-list-board__summary">{{item.summary}}</text>
          <view class="wow-article-list-board__source">
            <text>{{item.sourceName}}</text>
            <text wx:if="{{item.sourceUrl}}" class="wow-article-list-board__source-url">{{item.sourceUrl}}</text>
          </view>
        </view>
        <view class="wow-article-list-board__state-chip state-{{item.state}}">
          <text>{{item.stateLabel}}</text>
        </view>
      </view>
    </view>
  </wow-panel>
</view>
