.wow-article-list-board {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-article-list-board__rows,
.wow-article-list-board__skeletons {
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.wow-article-list-board__panel-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  max-width: 140rpx;
  height: 42rpx;
  padding: 0 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(98, 227, 154, 0.4);
  border-radius: 999rpx;
  background: rgba(10, 34, 20, 0.78);
  color: #62e39a;
  box-sizing: border-box;
}

.wow-article-list-board__panel-state.state-source_reference,
.wow-article-list-board__panel-state.state-stale {
  border-color: rgba(139, 216, 255, 0.4);
  background: rgba(11, 28, 36, 0.78);
  color: #8bd8ff;
}

.wow-article-list-board__panel-state.state-blocked,
.wow-article-list-board__panel-state.state-error {
  border-color: rgba(255, 107, 100, 0.48);
  background: rgba(42, 12, 10, 0.82);
  color: #ff8a84;
}

.wow-article-list-board__panel-state text {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 1000;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-article-list-board__row {
  position: relative;
  display: grid;
  grid-template-columns: 48rpx 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  min-height: 126rpx;
  padding: 12rpx 86rpx 12rpx 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 118rpx 50%, rgba(248, 183, 0, 0.075), transparent 34%),
    linear-gradient(90deg, rgba(24, 18, 12, 0.92), rgba(8, 8, 7, 0.96));
}

.wow-article-list-board__row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.5);
}

.wow-article-list-board__row.state-source_reference::before {
  background: rgba(139, 216, 255, 0.72);
}

.wow-article-list-board__rank,
.wow-article-list-board__visual,
.wow-article-list-board__copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.wow-article-list-board__rank {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  color: rgba(246, 231, 193, 0.78);
  font-size: 30rpx;
  font-weight: 1000;
  line-height: 1;
  border-right: 1rpx solid rgba(248, 183, 0, 0.09);
}

.wow-article-list-board__visual {
  width: 96rpx;
  height: 88rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.25);
  border-radius: 7rpx;
  background: rgba(7, 7, 6, 0.92);
}

.wow-article-list-board__visual-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 1000;
  background:
    radial-gradient(circle at 50% 30%, rgba(248, 183, 0, 0.18), transparent 58%),
    rgba(6, 6, 5, 0.95);
}

.wow-article-list-board__copy {
  display: grid;
  gap: 6rpx;
}

.wow-article-list-board__meta,
.wow-article-list-board__source {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.wow-article-list-board__channel,
.wow-article-list-board__date,
.wow-article-list-board__source,
.wow-article-list-board__source-url {
  color: rgba(244, 234, 217, 0.54);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.16;
}

.wow-article-list-board__channel {
  flex: none;
  max-width: 132rpx;
  padding: 3rpx 8rpx;
  color: #f8b700;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 999rpx;
  background: rgba(118, 80, 9, 0.16);
}

.wow-article-list-board__date {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-article-list-board__title,
.wow-article-list-board__summary {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.wow-article-list-board__title {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1.18;
  -webkit-line-clamp: 2;
}

.wow-article-list-board__summary {
  color: rgba(244, 234, 217, 0.68);
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.22;
  -webkit-line-clamp: 2;
}

.wow-article-list-board__source {
  overflow: hidden;
}

.wow-article-list-board__source-url {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-article-list-board__state-chip {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 74rpx;
  min-width: 54rpx;
  height: 30rpx;
  padding: 0 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(98, 227, 154, 0.42);
  border-radius: 999rpx;
  background: rgba(10, 34, 20, 0.82);
  color: #62e39a;
  box-sizing: border-box;
}

.wow-article-list-board__state-chip.state-source_reference,
.wow-article-list-board__state-chip.state-stale {
  border-color: rgba(139, 216, 255, 0.42);
  background: rgba(11, 28, 36, 0.82);
  color: #8bd8ff;
}

.wow-article-list-board__state-chip.state-blocked,
.wow-article-list-board__state-chip.state-error {
  border-color: rgba(255, 107, 100, 0.48);
  background: rgba(42, 12, 10, 0.86);
  color: #ff8a84;
}

.wow-article-list-board__state-chip text {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 1000;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-article-list-board__empty {
  display: grid;
  gap: 8rpx;
  min-height: 148rpx;
  align-content: center;
  padding: 24rpx;
  border: 1rpx dashed rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  background: rgba(8, 8, 7, 0.62);
}

.wow-article-list-board__empty-title {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1.16;
}

.wow-article-list-board__empty-copy {
  color: rgba(244, 234, 217, 0.62);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.28;
}

.wow-article-list-board__skeleton {
  height: 126rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.06), rgba(255, 255, 255, 0.035), rgba(248, 183, 0, 0.06)),
    rgba(8, 8, 7, 0.74);
}

.wow-article-list-board.density-standard .wow-article-list-board__row {
  min-height: 142rpx;
  grid-template-columns: 54rpx 112rpx minmax(0, 1fr);
}

.wow-article-list-board.density-standard .wow-article-list-board__visual {
  width: 112rpx;
  height: 98rpx;
}
