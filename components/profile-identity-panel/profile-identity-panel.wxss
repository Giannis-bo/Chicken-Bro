.wow-profile-identity-panel {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-profile-identity-panel__panel,
.wow-profile-identity-panel__sync {
  display: block;
  min-width: 0;
}

.wow-profile-identity-panel__sync {
  display: flex;
  justify-content: flex-end;
}

.wow-profile-identity-panel__hero {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  min-height: 128rpx;
}

.wow-profile-identity-panel__avatar-button {
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  overflow: visible;
}

.wow-profile-identity-panel__avatar-button::after {
  border: 0;
}

.wow-profile-identity-panel__copy {
  display: grid;
  gap: 6rpx;
  min-width: 0;
}

.wow-profile-identity-panel__kicker,
.wow-profile-identity-panel__nickname,
.wow-profile-identity-panel__meta,
.wow-profile-identity-panel__metric text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
}

.wow-profile-identity-panel__kicker {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 950;
  white-space: nowrap;
}

.wow-profile-identity-panel__nickname {
  width: 100%;
  min-height: 54rpx;
  padding: 0;
  color: #fff8ea;
  font-size: 34rpx;
  font-weight: 1000;
  line-height: 54rpx;
}

.wow-profile-identity-panel__meta {
  color: rgba(244, 234, 217, 0.66);
  font-size: 22rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-profile-identity-panel__metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  min-width: 0;
  margin-top: 16rpx;
}

.wow-profile-identity-panel__metric {
  display: grid;
  gap: 6rpx;
  min-width: 0;
  min-height: 78rpx;
  padding: 12rpx 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.wow-profile-identity-panel__metric text:first-child {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  white-space: nowrap;
}

.wow-profile-identity-panel__metric text:last-child {
  color: rgba(244, 234, 217, 0.58);
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-profile-identity-panel__actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
  gap: 10rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-profile-identity-panel__evidence {
  display: block;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-profile-identity-panel.sync-remote_failed .wow-profile-identity-panel__metric {
  border-color: rgba(255, 191, 71, 0.36);
}

.wow-profile-identity-panel.sync-synced .wow-profile-identity-panel__metric {
  border-color: rgba(71, 214, 143, 0.34);
}
