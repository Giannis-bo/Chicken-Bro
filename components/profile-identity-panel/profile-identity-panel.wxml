<view class="wow-profile-identity-panel {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-profile-identity-panel__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-profile-identity-panel__sync">
      <status-visual
        state="{{normalizedSyncVisual}}"
        label="{{normalizedSyncLabel}}"
        glyph="{{normalizedSyncGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-profile-identity-panel__hero">
      <button class="wow-profile-identity-panel__avatar-button" bindtap="handleChooseAvatar">
        <game-object-icon
          object-type="profile"
          entity-id="current-profile"
          display-name="{{normalizedNickname}}"
          icon-src="{{normalizedAvatarUrl}}"
          fallback-text="{{normalizedAvatarFallback}}"
          status="{{normalizedAvatarUrl ? 'verified' : 'source_reference'}}"
          size="large"
          shape="round"
        ></game-object-icon>
      </button>
      <view class="wow-profile-identity-panel__copy">
        <text class="wow-profile-identity-panel__kicker">{{normalizedRole}}</text>
        <input
          class="wow-profile-identity-panel__nickname"
          type="nickname"
          value="{{normalizedNickname}}"
          placeholder="点击填写微信昵称"
          bindinput="handleNicknameInput"
          bindconfirm="handleNicknameConfirm"
          confirm-type="done"
        />
        <text class="wow-profile-identity-panel__meta">{{normalizedLoginState}} · {{normalizedDraftLabel}}</text>
      </view>
    </view>

    <view class="wow-profile-identity-panel__metrics">
      <view wx:for="{{normalizedMetricRows}}" wx:key="key" class="wow-profile-identity-panel__metric">
        <text>{{item.value}}</text>
        <text>{{item.label}}</text>
      </view>
    </view>

    <view class="wow-profile-identity-panel__actions">
      <action-button
        label="{{normalizedPrimaryAction.label}}"
        tone="{{normalizedPrimaryAction.tone}}"
        size="default"
        disabled="{{normalizedPrimaryAction.disabled}}"
        loading="{{normalizedPrimaryAction.loading}}"
        bind:actiontap="handleSaveProfile"
      ></action-button>
      <action-button
        label="{{normalizedLoginAction.label}}"
        tone="{{normalizedLoginAction.tone}}"
        size="compact"
        disabled="{{normalizedLoginAction.disabled}}"
        loading="{{normalizedLoginAction.loading}}"
        bind:actiontap="handleLogin"
      ></action-button>
    </view>

    <evidence-ledger
      ext-class="wow-profile-identity-panel__evidence"
      title="档案证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
