<view class="wow-builds-tab-surface {{rootClass}} ext-class">
  <material-image
    wx:if="{{materialSrc}}"
    class="wow-builds-tab-surface__material"
    src="{{materialSrc}}"
    tone="panel"
    fit="cover"
    opacity="0.26"
    decorative="{{true}}"
  ></material-image>

  <wow-panel
    ext-class="wow-builds-tab-surface__console"
    material-src="{{consoleMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view class="wow-builds-tab-surface__identity">
      <game-object-icon
        ext-class="wow-builds-tab-surface__spec-icon"
        object-type="spec"
        class-key="{{classKey}}"
        spec-key="{{specKey}}"
        icon-src="{{specIconUrl}}"
        fallback-text="{{specFallbackText}}"
        display-name="{{currentSpecTitle}}"
        size="large"
      ></game-object-icon>
      <view class="wow-builds-tab-surface__identity-copy">
        <text class="wow-builds-tab-surface__kicker">{{kicker}}</text>
        <text class="wow-builds-tab-surface__title">{{currentSpecTitle}}</text>
        <text class="wow-builds-tab-surface__subtitle">{{selectedHeroLabel}} · {{currentSpecDesc}}</text>
      </view>
      <status-visual
        ext-class="wow-builds-tab-surface__state"
        state="{{normalizedStatus}}"
        label="{{normalizedStateLabel}}"
        glyph="{{normalizedStateGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-builds-tab-surface__overview" wx:if="{{normalizedOverviewChips.length}}">
      <view
        wx:for="{{normalizedOverviewChips}}"
        wx:key="key"
        class="wow-builds-tab-surface__chip"
      >
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>

    <view class="wow-builds-tab-surface__switchers">
      <view class="wow-builds-tab-surface__switch-group">
        <text class="wow-builds-tab-surface__switch-label">职业</text>
        <view class="wow-builds-tab-surface__switch-row">
          <view
            wx:for="{{normalizedClassOptions}}"
            wx:key="key"
            class="wow-builds-tab-surface__switch-pill {{item.label == selectedClassLabel ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            data-label="{{item.label}}"
            bindtap="handleClassTap"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="wow-builds-tab-surface__switch-group">
        <text class="wow-builds-tab-surface__switch-label">专精</text>
        <view class="wow-builds-tab-surface__switch-row">
          <view
            wx:for="{{normalizedSpecOptions}}"
            wx:key="key"
            class="wow-builds-tab-surface__switch-pill {{item.label == selectedSpecLabel ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            data-label="{{item.label}}"
            bindtap="handleSpecTap"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="wow-builds-tab-surface__switch-group wow-builds-tab-surface__switch-group--hero">
        <text class="wow-builds-tab-surface__switch-label">英雄天赋</text>
        <view class="wow-builds-tab-surface__switch-row">
          <view
            wx:for="{{normalizedHeroOptions}}"
            wx:key="key"
            class="wow-builds-tab-surface__switch-pill {{item.label == selectedHeroLabel ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            data-label="{{item.label}}"
            bindtap="handleHeroTap"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-builds-tab-surface__workbench"
    material-src="{{workbenchMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view class="wow-builds-tab-surface__workbench-grid" bindtap="handleWorkbenchTap">
      <status-visual
        ext-class="wow-builds-tab-surface__workbench-visual"
        state="{{normalizedWorkbenchEntry.status}}"
        label="{{normalizedWorkbenchEntry.statusLabel}}"
        glyph="{{normalizedWorkbenchEntry.statusGlyph}}"
        size="large"
        shape="shield"
        showLabel="{{false}}"
      ></status-visual>
      <view class="wow-builds-tab-surface__workbench-copy">
        <text class="wow-builds-tab-surface__workbench-kicker">当前专精工作台</text>
        <text class="wow-builds-tab-surface__workbench-title">{{normalizedWorkbenchEntry.title}}</text>
        <text class="wow-builds-tab-surface__workbench-desc">{{normalizedWorkbenchEntry.desc}}</text>
        <view class="wow-builds-tab-surface__facts" wx:if="{{normalizedWorkbenchEntry.facts.length}}">
          <view
            wx:for="{{normalizedWorkbenchEntry.facts}}"
            wx:key="key"
            class="wow-builds-tab-surface__fact"
          >
            <text>{{item.label}}</text>
            <text>{{item.value}}</text>
          </view>
        </view>
      </view>
      <action-button
        ext-class="wow-builds-tab-surface__workbench-action"
        label="{{normalizedWorkbenchEntry.actionLabel}}"
        size="compact"
        tone="{{normalizedStatus == 'blocked' ? 'danger' : 'primary'}}"
        bind:actiontap="handleWorkbenchTap"
      ></action-button>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-builds-tab-surface__workflow"
    title="构筑流程"
    meta="旧入口保留"
    material-src="{{workflowMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view class="wow-builds-tab-surface__workflow-grid">
      <module-card
        wx:for="{{normalizedWorkflowCards}}"
        wx:key="key"
        data-key="{{item.key}}"
        title="{{item.title}}"
        metric="{{item.metric}}"
        meta="{{item.meta}}"
        status="{{item.status}}"
        status-label="{{item.statusLabel}}"
        status-glyph="{{item.statusGlyph}}"
        icon-src="{{item.iconSrc}}"
        icon-text="{{item.iconText}}"
        disabled="{{item.disabled}}"
        bind:cardtap="handleWorkflowTap"
      ></module-card>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-builds-tab-surface__evidence"
    title="入口证据"
    meta="{{normalizedStateLabel}}"
    material-src="{{evidenceMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <evidence-ledger
      title="入口证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
    ></evidence-ledger>
  </wow-panel>
</view>
