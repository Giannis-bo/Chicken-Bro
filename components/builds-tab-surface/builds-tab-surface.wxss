.wow-builds-tab-surface {
  position: relative;
  display: grid;
  gap: 18rpx;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-builds-tab-surface__material {
  position: absolute;
  inset: -28rpx -18rpx;
  z-index: -1;
  pointer-events: none;
}

.wow-builds-tab-surface__console,
.wow-builds-tab-surface__workbench,
.wow-builds-tab-surface__workflow,
.wow-builds-tab-surface__evidence {
  display: block;
  min-width: 0;
}

.wow-builds-tab-surface__identity {
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr) 116rpx;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.wow-builds-tab-surface__identity-copy,
.wow-builds-tab-surface__workbench-copy,
.wow-builds-tab-surface__switch-group {
  display: grid;
  gap: 8rpx;
  min-width: 0;
}

.wow-builds-tab-surface__kicker,
.wow-builds-tab-surface__title,
.wow-builds-tab-surface__subtitle,
.wow-builds-tab-surface__chip text,
.wow-builds-tab-surface__switch-label,
.wow-builds-tab-surface__switch-pill text,
.wow-builds-tab-surface__workbench-kicker,
.wow-builds-tab-surface__workbench-title,
.wow-builds-tab-surface__workbench-desc,
.wow-builds-tab-surface__fact text {
  display: block;
  min-width: 0;
  letter-spacing: 0;
}

.wow-builds-tab-surface__kicker,
.wow-builds-tab-surface__workbench-kicker,
.wow-builds-tab-surface__switch-label {
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-builds-tab-surface__title {
  overflow: hidden;
  color: #fff8ea;
  font-size: 38rpx;
  font-weight: 1000;
  line-height: 1.05;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-builds-tab-surface__subtitle {
  color: rgba(244, 234, 217, 0.82);
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1.22;
  overflow-wrap: anywhere;
}

.wow-builds-tab-surface__spec-icon {
  width: 96rpx;
  height: 96rpx;
}

.wow-builds-tab-surface__state {
  justify-self: end;
  min-width: 96rpx;
}

.wow-builds-tab-surface__overview {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
  margin-top: 18rpx;
}

.wow-builds-tab-surface__chip {
  display: grid;
  gap: 4rpx;
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.wow-builds-tab-surface__chip text:first-child,
.wow-builds-tab-surface__fact text:first-child {
  overflow: hidden;
  color: rgba(244, 234, 217, 0.58);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-builds-tab-surface__chip text:last-child,
.wow-builds-tab-surface__fact text:last-child {
  overflow: hidden;
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 1000;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-builds-tab-surface__switchers {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
  min-width: 0;
  margin-top: 18rpx;
}

.wow-builds-tab-surface__switch-row {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(104rpx, max-content);
  gap: 8rpx;
  min-width: 0;
  overflow-x: auto;
  padding-bottom: 2rpx;
  scrollbar-width: none;
}

.wow-builds-tab-surface__switch-row::-webkit-scrollbar {
  display: none;
}

.wow-builds-tab-surface__switch-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 58rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.wow-builds-tab-surface__switch-pill.is-active {
  border-color: rgba(248, 183, 0, 0.82);
  background: rgba(248, 183, 0, 0.14);
  box-shadow: inset 0 0 0 1rpx rgba(255, 225, 128, 0.12);
}

.wow-builds-tab-surface__switch-pill text {
  overflow: hidden;
  color: #f4ead9;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-builds-tab-surface__switch-pill.is-active text {
  color: #f8b700;
}

.wow-builds-tab-surface__workbench-grid {
  display: grid;
  grid-template-columns: 126rpx minmax(0, 1fr);
  grid-template-areas:
    "visual copy"
    "action action";
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.wow-builds-tab-surface__workbench-visual {
  grid-area: visual;
  justify-self: center;
  width: 116rpx;
  height: 128rpx;
}

.wow-builds-tab-surface__workbench-copy {
  grid-area: copy;
}

.wow-builds-tab-surface__workbench-title {
  overflow: hidden;
  color: #fff8ea;
  font-size: 32rpx;
  font-weight: 1000;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-builds-tab-surface__workbench-desc {
  color: rgba(244, 234, 217, 0.84);
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.28;
  overflow-wrap: anywhere;
}

.wow-builds-tab-surface__facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  min-width: 0;
  margin-top: 4rpx;
}

.wow-builds-tab-surface__fact {
  min-width: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
}

.wow-builds-tab-surface__workbench-action {
  grid-area: action;
  min-width: 0;
}

.wow-builds-tab-surface__workflow-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  min-width: 0;
}

.wow-builds-tab-surface__workflow-grid module-card {
  min-width: 0;
}

.wow-builds-tab-surface__evidence evidence-ledger {
  display: block;
  min-width: 0;
}

.state-blocked .wow-builds-tab-surface__workbench-title {
  color: #ff6b64;
}

.state-ready_to_simulate .wow-builds-tab-surface__workbench-title,
.state-verified .wow-builds-tab-surface__workbench-title {
  color: #62e6a0;
}

@media (min-width: 420px) {
  .wow-builds-tab-surface__workflow-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
