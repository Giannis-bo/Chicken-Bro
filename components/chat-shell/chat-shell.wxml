<view class="wow-chat-shell {{rootClass}} ext-class">
  <view class="wow-chat-shell__context" wx:if="{{contextTitle || contextMeta}}">
    <view class="wow-chat-shell__context-copy">
      <text class="wow-chat-shell__context-title">{{contextTitle}}</text>
      <text wx:if="{{contextMeta}}" class="wow-chat-shell__context-meta">{{contextMeta}}</text>
    </view>
    <view class="wow-chat-shell__context-action" bindtap="handleOpenDrawer">{{contextActionLabel}}</view>
  </view>

  <scroll-view
    class="wow-chat-shell__scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    enable-flex="{{true}}"
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
  >
    <view wx:if="{{!messages.length}}" class="wow-chat-shell__empty">
      <slot name="empty"></slot>
    </view>

    <view class="wow-chat-shell__messages">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="wow-chat-shell__message message-{{item.role}} status-{{item.status}}"
      >
        <view class="wow-chat-shell__bubble">
          <text class="wow-chat-shell__message-text">{{item.content}}</text>
          <view wx:if="{{item.evidenceRows && item.evidenceRows.length}}" class="wow-chat-shell__evidence">
            <view
              wx:for="{{item.evidenceRows}}"
              wx:for-item="evidence"
              wx:key="id"
              class="wow-chat-shell__evidence-row state-{{evidence.state}}"
            >
              <text class="wow-chat-shell__evidence-label">{{evidence.label}}</text>
              <text class="wow-chat-shell__evidence-value">{{evidence.value}}</text>
            </view>
          </view>
          <view wx:if="{{item.nextQuestions && item.nextQuestions.length}}" class="wow-chat-shell__next">
            <view
              wx:for="{{item.nextQuestions}}"
              wx:for-item="question"
              wx:key="*this"
              class="wow-chat-shell__next-chip"
              data-value="{{question}}"
              bindtap="handleNextQuestion"
            >
              {{question}}
            </view>
          </view>
        </view>
      </view>
      <view id="{{bottomAnchorId}}" class="wow-chat-shell__bottom-anchor"></view>
    </view>
  </scroll-view>

  <view class="wow-chat-shell__inputbar" style="{{inputBarStyle}}">
    <view class="wow-chat-shell__topic-button" bindtap="handleNewTopic">{{newTopicLabel}}</view>
    <textarea
      class="wow-chat-shell__input"
      value="{{inputValue}}"
      placeholder="{{inputPlaceholder}}"
      disabled="{{inputDisabled || submitting}}"
      auto-height="{{false}}"
      fixed="{{false}}"
      cursor-spacing="20"
      adjust-position="{{true}}"
      maxlength="800"
      bindinput="handleInput"
      bindfocus="handleFocus"
      bindblur="handleBlur"
    ></textarea>
    <view class="wow-chat-shell__send {{submitting || inputDisabled ? 'is-disabled' : ''}}" bindtap="handleSend">
      {{submitting ? sendingLabel : sendLabel}}
    </view>
  </view>
</view>
