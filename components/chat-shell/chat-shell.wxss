.wow-chat-shell {
  position: relative;
  z-index: 1;
  flex: 1 1 auto;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  width: 100%;
  min-width: 0;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  color: #f4ead9;
  background: #050504;
  box-sizing: border-box;
  contain: layout paint style;
  --chat-safe-bottom: env(safe-area-inset-bottom);
}

.wow-chat-shell__context {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid rgba(248, 183, 0, 0.24);
  background:
    linear-gradient(180deg, rgba(23, 20, 14, 0.94), rgba(8, 8, 7, 0.96)),
    #090806;
  box-sizing: border-box;
}

.wow-chat-shell__context-copy {
  display: grid;
  min-width: 0;
  gap: 6rpx;
}

.wow-chat-shell__context-title,
.wow-chat-shell__context-meta {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.wow-chat-shell__context-title {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-chat-shell__context-meta {
  color: rgba(244, 234, 217, 0.62);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.14;
}

.wow-chat-shell__context-action,
.wow-chat-shell__topic-button,
.wow-chat-shell__send {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.36);
  border-radius: 8rpx;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 1000;
  line-height: 1;
  box-sizing: border-box;
}

.wow-chat-shell__scroll {
  min-width: 0;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

.wow-chat-shell__messages,
.wow-chat-shell__empty {
  display: grid;
  min-width: 0;
  gap: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.wow-chat-shell__bottom-anchor {
  width: 100%;
  height: 2rpx;
}

.wow-chat-shell__empty {
  min-height: 220rpx;
  place-items: center;
  color: rgba(244, 234, 217, 0.58);
  font-size: 24rpx;
  text-align: center;
}

.wow-chat-shell__message {
  display: flex;
  min-width: 0;
}

.wow-chat-shell__message.message-user {
  justify-content: flex-end;
}

.wow-chat-shell__message.message-assistant {
  justify-content: flex-start;
}

.wow-chat-shell__bubble {
  display: grid;
  max-width: 86%;
  min-width: 0;
  gap: 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(20, 18, 13, 0.96), rgba(9, 9, 8, 0.96)),
    #0b0a08;
  box-sizing: border-box;
}

.message-user .wow-chat-shell__bubble {
  border-color: rgba(98, 227, 154, 0.28);
  background:
    linear-gradient(180deg, rgba(13, 29, 20, 0.96), rgba(8, 11, 9, 0.96)),
    #07100c;
}

.wow-chat-shell__message-text {
  display: block;
  min-width: 0;
  color: #f4ead9;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-word;
  overflow-wrap: anywhere;
  letter-spacing: 0;
}

.wow-chat-shell__evidence {
  display: grid;
  gap: 8rpx;
  min-width: 0;
}

.wow-chat-shell__evidence-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(147, 185, 255, 0.22);
  border-radius: 8rpx;
  background: rgba(7, 9, 11, 0.72);
  box-sizing: border-box;
}

.wow-chat-shell__evidence-label,
.wow-chat-shell__evidence-value {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.wow-chat-shell__evidence-label {
  color: rgba(244, 234, 217, 0.68);
  font-size: 20rpx;
  font-weight: 800;
}

.wow-chat-shell__evidence-value {
  color: #93b9ff;
  font-size: 20rpx;
  font-weight: 1000;
}

.wow-chat-shell__next {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.wow-chat-shell__next-chip {
  max-width: 100%;
  overflow: hidden;
  padding: 9rpx 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 8rpx;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.wow-chat-shell__inputbar {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: end;
  gap: 12rpx;
  min-width: 0;
  padding: 16rpx 18rpx calc(16rpx + var(--chat-safe-bottom));
  border-top: 1rpx solid rgba(248, 183, 0, 0.24);
  background:
    linear-gradient(180deg, rgba(12, 11, 9, 0.94), rgba(5, 5, 4, 0.98)),
    #070605;
  box-shadow: 0 -12rpx 28rpx rgba(0, 0, 0, 0.32);
  box-sizing: border-box;
}

.wow-chat-shell__input {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  max-height: 168rpx;
  min-height: 52rpx;
  padding: 14rpx 16rpx;
  color: #f4ead9;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(8, 8, 7, 0.84);
  box-sizing: border-box;
}

.wow-chat-shell__send.is-disabled {
  opacity: 0.52;
}
