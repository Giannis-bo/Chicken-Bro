.wow-evidence-ledger {
  display: grid;
  gap: 14rpx;
  min-width: 0;
  overflow: hidden;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-evidence-ledger__head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 64rpx;
}

.wow-evidence-ledger__title-group {
  display: grid;
  min-width: 0;
  gap: 6rpx;
}

.wow-evidence-ledger__title,
.wow-evidence-ledger__summary,
.wow-evidence-ledger__label,
.wow-evidence-ledger__value,
.wow-evidence-ledger__status {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.wow-evidence-ledger__title {
  color: #fff8ea;
  font-size: 32rpx;
  font-weight: 1000;
  line-height: 1.12;
}

.wow-evidence-ledger__summary {
  color: rgba(244, 234, 217, 0.56);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.12;
}

.wow-evidence-ledger__toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  gap: 6rpx;
  box-sizing: border-box;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 1000;
  border: 1rpx solid rgba(248, 183, 0, 0.36);
  border-radius: 8rpx;
  background: rgba(10, 9, 7, 0.72);
}

.wow-evidence-ledger__toggle-icon {
  font-size: 22rpx;
  line-height: 1;
}

.wow-evidence-ledger__rows {
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.wow-evidence-ledger__row {
  position: relative;
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr) minmax(88rpx, auto) 18rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 12rpx 14rpx;
  gap: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(17, 15, 11, 0.98), rgba(7, 7, 6, 0.98)),
    #0b0a08;
}

.wow-evidence-ledger__row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: rgba(147, 185, 255, 0.58);
}

.wow-evidence-ledger__icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 1000;
  border: 1rpx solid rgba(248, 183, 0, 0.32);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(248, 183, 0, 0.18), rgba(6, 6, 5, 0.9));
}

.wow-evidence-ledger__copy {
  display: grid;
  min-width: 0;
  gap: 6rpx;
}

.wow-evidence-ledger__label {
  color: rgba(244, 234, 217, 0.58);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.1;
}

.wow-evidence-ledger__value {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1.16;
}

.wow-evidence-ledger__status {
  justify-self: end;
  max-width: 132rpx;
  padding: 4rpx 10rpx;
  color: #93b9ff;
  font-size: 20rpx;
  font-weight: 1000;
  line-height: 1.1;
  border: 1rpx solid rgba(147, 185, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(30, 58, 112, 0.18);
}

.wow-evidence-ledger__arrow {
  color: rgba(248, 183, 0, 0.52);
  font-size: 28rpx;
  font-weight: 1000;
  line-height: 1;
}

.wow-evidence-ledger__row.status-verified::before {
  background: #5fd68b;
}

.wow-evidence-ledger__row.status-blocked::before {
  background: #ff6b64;
}

.wow-evidence-ledger__row.status-partial::before {
  background: #f8b700;
}

.wow-evidence-ledger__row.status-stale::before {
  background: #8bd8ff;
}

.wow-evidence-ledger__row.status-verified .wow-evidence-ledger__status {
  color: #8bdc9e;
  border-color: rgba(95, 214, 139, 0.26);
  background: rgba(29, 91, 51, 0.18);
}

.wow-evidence-ledger__row.status-blocked .wow-evidence-ledger__status {
  color: #ff9b95;
  border-color: rgba(255, 107, 100, 0.28);
  background: rgba(91, 29, 25, 0.2);
}

.wow-evidence-ledger__row.status-partial .wow-evidence-ledger__status {
  color: #f8b700;
  border-color: rgba(248, 183, 0, 0.28);
  background: rgba(118, 80, 9, 0.18);
}

.wow-evidence-ledger__empty {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 18rpx;
  color: rgba(244, 234, 217, 0.54);
  font-size: 24rpx;
  font-weight: 800;
  border: 1rpx dashed rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
}
