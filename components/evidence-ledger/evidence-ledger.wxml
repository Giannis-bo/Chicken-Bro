<view class="wow-evidence-ledger ext-class">
  <view class="wow-evidence-ledger__head">
    <view class="wow-evidence-ledger__title-group">
      <text class="wow-evidence-ledger__title">{{title}}</text>
      <text wx:if="{{summary}}" class="wow-evidence-ledger__summary">{{summary}}</text>
    </view>
    <view class="wow-evidence-ledger__toggle" role="button" bindtap="handleToggle">
      <text>{{expanded ? '收起' : '展开'}}</text>
      <text class="wow-evidence-ledger__toggle-icon">{{expanded ? '⌃' : '⌄'}}</text>
    </view>
  </view>
  <view class="wow-evidence-ledger__rows">
    <view
      class="wow-evidence-ledger__row status-{{item.status || 'source_reference'}}"
      wx:for="{{visibleRows}}"
      wx:key="key"
      data-key="{{item.key}}"
      data-status="{{item.status}}"
      bindtap="handleRowTap"
    >
      <view class="wow-evidence-ledger__icon-slot">
        <text>{{item.iconText || '?'}}</text>
      </view>
      <view class="wow-evidence-ledger__copy">
        <text class="wow-evidence-ledger__label">{{item.label}}</text>
        <text class="wow-evidence-ledger__value">{{item.value}}</text>
      </view>
      <text class="wow-evidence-ledger__status">{{item.statusLabel}}</text>
      <text class="wow-evidence-ledger__arrow">›</text>
    </view>
    <view wx:if="{{!visibleRows.length}}" class="wow-evidence-ledger__empty">
      <text>暂无证据行</text>
    </view>
  </view>
</view>
