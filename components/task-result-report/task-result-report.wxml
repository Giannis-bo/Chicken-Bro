<view class="wow-task-result-report {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-task-result-report__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-task-result-report__head-status">
      <status-visual
        state="{{normalizedModeVisualState}}"
        label="{{normalizedModeLabel}}"
        glyph="{{normalizedModeGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-task-result-report__hero">
      <game-object-icon
        ext-class="wow-task-result-report__hero-icon"
        object-type="spec"
        entity-id="{{normalizedTask.id}}"
        display-name="{{normalizedTask.title}}"
        icon-src="{{normalizedTask.iconSrc}}"
        icon-name="{{normalizedTask.iconName}}"
        fallback-text="{{normalizedTask.fallbackText}}"
        status="{{normalizedTask.iconSrc || normalizedTask.iconName ? 'verified' : 'source_reference'}}"
        size="large"
        shape="round"
      ></game-object-icon>
      <view class="wow-task-result-report__hero-copy">
        <text>{{normalizedTask.title}}</text>
        <text>{{normalizedTask.context}}</text>
        <text>{{normalizedTask.scenario}} · {{normalizedTask.updatedAt || normalizedTask.createdAt}}</text>
      </view>
    </view>

    <view wx:if="{{normalizedMode == 'loading'}}" class="wow-task-result-report__loading">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="wow-task-result-report__skeleton"></view>
    </view>

    <view wx:elif="{{normalizedMode == 'missing_id' || normalizedMode == 'not_found'}}" class="wow-task-result-report__blocked">
      <status-visual state="blocked" label="{{normalizedModeLabel}}" glyph="!" size="standard" shape="seal"></status-visual>
      <view class="wow-task-result-report__blocked-copy">
        <text>{{normalizedModeLabel}}</text>
        <text>没有可读取的任务详情。返回列表或重新发起一次模拟。</text>
      </view>
    </view>

    <view wx:else class="wow-task-result-report__sections">
      <view class="wow-task-result-report__metric-grid">
        <view
          wx:for="{{normalizedMetricRows}}"
          wx:key="key"
          class="wow-task-result-report__metric state-{{item.status}}"
        >
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <view wx:if="{{normalizedFailureRows.length}}" class="wow-task-result-report__section state-blocked">
        <view class="wow-task-result-report__section-title">
          <text>失败说明</text>
          <text>已隐藏底层诊断</text>
        </view>
        <view
          wx:for="{{normalizedFailureRows}}"
          wx:key="key"
          class="wow-task-result-report__row state-{{item.status}}"
        >
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <view wx:if="{{normalizedContextRows.length}}" class="wow-task-result-report__section">
        <view class="wow-task-result-report__section-title">
          <text>运行上下文</text>
          <text>{{normalizedContextRows.length}} 项</text>
        </view>
        <view wx:for="{{normalizedContextRows}}" wx:key="key" class="wow-task-result-report__row state-{{item.status}}">
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <view wx:if="{{normalizedStatRows.length}}" class="wow-task-result-report__section">
        <view class="wow-task-result-report__section-title">
          <text>快照摘要</text>
          <text>{{normalizedStatRows.length}} 项</text>
        </view>
        <view wx:for="{{normalizedStatRows}}" wx:key="key" class="wow-task-result-report__row state-{{item.status}}">
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <view wx:if="{{normalizedCombatBuffRows.length}}" class="wow-task-result-report__section">
        <view class="wow-task-result-report__section-title">
          <text>战斗准备</text>
          <text>{{normalizedCombatBuffRows.length}} 项</text>
        </view>
        <view wx:for="{{normalizedCombatBuffRows}}" wx:key="key" class="wow-task-result-report__row state-{{item.status}}">
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>
    </view>

    <view class="wow-task-result-report__actions">
      <action-button
        label="{{normalizedBackAction.label}}"
        tone="{{normalizedBackAction.tone}}"
        size="compact"
        disabled="{{normalizedBackAction.disabled}}"
        loading="{{normalizedBackAction.loading}}"
        bind:actiontap="handleBackTap"
      ></action-button>
      <action-button
        label="{{normalizedSimcAction.label}}"
        tone="{{normalizedSimcAction.tone}}"
        size="compact"
        disabled="{{normalizedSimcAction.disabled}}"
        loading="{{normalizedSimcAction.loading}}"
        bind:actiontap="handleSimcTap"
      ></action-button>
      <action-button
        label="{{normalizedChickenbroAction.label}}"
        tone="{{normalizedChickenbroAction.tone}}"
        size="compact"
        disabled="{{normalizedChickenbroAction.disabled}}"
        loading="{{normalizedChickenbroAction.loading}}"
        bind:actiontap="handleChickenbroTap"
      ></action-button>
    </view>

    <evidence-ledger
      ext-class="wow-task-result-report__evidence"
      title="报告证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
