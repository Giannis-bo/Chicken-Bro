.wow-task-result-report {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-task-result-report__panel,
.wow-task-result-report__head-status {
  display: block;
  min-width: 0;
}

.wow-task-result-report__head-status {
  display: flex;
  justify-content: flex-end;
}

.wow-task-result-report__hero {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(248, 183, 0, 0.14), transparent 38%),
    rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.wow-task-result-report__hero-icon {
  width: 104rpx;
  height: 104rpx;
}

.wow-task-result-report__hero-copy {
  display: grid;
  gap: 6rpx;
  min-width: 0;
}

.wow-task-result-report__hero-copy text,
.wow-task-result-report__metric text,
.wow-task-result-report__section-title text,
.wow-task-result-report__row text,
.wow-task-result-report__blocked-copy text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
}

.wow-task-result-report__hero-copy text:first-child {
  color: #fff8ea;
  font-size: 31rpx;
  font-weight: 1000;
  white-space: nowrap;
}

.wow-task-result-report__hero-copy text:nth-child(2) {
  color: rgba(244, 234, 217, 0.78);
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.wow-task-result-report__hero-copy text:last-child {
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.wow-task-result-report__loading {
  display: grid;
  gap: 10rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-task-result-report__skeleton {
  min-height: 96rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 8rpx;
  background:
    linear-gradient(100deg, rgba(255, 255, 255, 0.04), rgba(248, 183, 0, 0.1), rgba(255, 255, 255, 0.04)),
    rgba(0, 0, 0, 0.28);
}

.wow-task-result-report__blocked {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 107, 100, 0.46);
  border-radius: 8rpx;
  background: rgba(30, 5, 5, 0.32);
  box-sizing: border-box;
}

.wow-task-result-report__blocked-copy {
  display: grid;
  gap: 8rpx;
  min-width: 0;
}

.wow-task-result-report__blocked-copy text:first-child {
  color: #ff6b64;
  font-size: 28rpx;
  font-weight: 1000;
}

.wow-task-result-report__blocked-copy text:last-child {
  color: rgba(244, 234, 217, 0.72);
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.24;
  white-space: normal;
}

.wow-task-result-report__sections {
  display: grid;
  gap: 14rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-task-result-report__metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
}

.wow-task-result-report__metric {
  display: grid;
  gap: 5rpx;
  min-width: 0;
  min-height: 94rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.wow-task-result-report__metric.state-verified {
  border-color: rgba(71, 214, 143, 0.46);
}

.wow-task-result-report__metric.state-blocked {
  border-color: rgba(255, 107, 100, 0.5);
}

.wow-task-result-report__metric text:first-child {
  color: rgba(244, 234, 217, 0.62);
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-task-result-report__metric text:nth-child(2) {
  color: #fff8ea;
  font-size: 25rpx;
  font-weight: 1000;
  white-space: normal;
}

.wow-task-result-report__metric text:last-child {
  color: #f8b700;
  font-size: 18rpx;
  font-weight: 900;
  white-space: nowrap;
}

.wow-task-result-report__section {
  display: grid;
  gap: 8rpx;
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.wow-task-result-report__section.state-blocked {
  border-color: rgba(255, 107, 100, 0.45);
  background: rgba(30, 5, 5, 0.28);
}

.wow-task-result-report__section-title,
.wow-task-result-report__row {
  display: grid;
  align-items: center;
  min-width: 0;
}

.wow-task-result-report__section-title {
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10rpx;
}

.wow-task-result-report__section-title text:first-child {
  color: #fff8ea;
  font-size: 24rpx;
  font-weight: 1000;
  white-space: nowrap;
}

.wow-task-result-report__section-title text:last-child {
  color: rgba(244, 234, 217, 0.58);
  font-size: 19rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-task-result-report__row {
  grid-template-columns: minmax(84rpx, 0.72fr) minmax(0, 1fr) auto;
  gap: 10rpx;
  min-height: 52rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-radius: 7rpx;
  background: rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.wow-task-result-report__row.state-blocked {
  border-color: rgba(255, 107, 100, 0.36);
}

.wow-task-result-report__row text {
  color: rgba(244, 234, 217, 0.66);
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-task-result-report__row text:nth-child(2) {
  color: #fff8ea;
  font-weight: 950;
}

.wow-task-result-report__row text:last-child {
  color: #f8b700;
  font-size: 18rpx;
  font-weight: 900;
}

.wow-task-result-report__actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-task-result-report__evidence {
  display: block;
  min-width: 0;
  margin-top: 14rpx;
}

@media (max-width: 374px) {
  .wow-task-result-report__metric-grid,
  .wow-task-result-report__actions {
    grid-template-columns: minmax(0, 1fr);
  }
}
