<view
  class="wow-status-badge wow-status-badge-{{size}} {{toneClass}} ext-class"
  aria-label="{{label}}"
>
  <image
    class="wow-status-badge__base"
    src="{{baseSrc}}"
    mode="aspectFit"
  ></image>
  <view class="wow-status-badge__glyph-stage">
    <text class="wow-status-badge__glyph {{glyphClass}}">{{glyph}}</text>
  </view>
  <text wx:if="{{showLabel}}" class="wow-status-badge__label">{{label}}</text>
</view>
