.wow-status-badge {
  position: relative;
  display: block;
  width: 120rpx;
  height: 148rpx;
  min-width: 0;
  overflow: visible;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-status-badge__base {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0.98;
  pointer-events: none;
}

.wow-status-badge__glyph-stage {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 18%;
  box-sizing: border-box;
  pointer-events: none;
}

.wow-status-badge__glyph {
  display: block;
  min-width: 0;
  max-width: 72%;
  overflow: hidden;
  color: #8bdc9e;
  font-size: 64rpx;
  font-weight: 1000;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow:
    0 0 12rpx rgba(139, 220, 158, 0.7),
    0 0 24rpx rgba(139, 220, 158, 0.26),
    0 2rpx 0 rgba(0, 0, 0, 0.58);
}

.wow-status-badge__glyph.is-wide {
  font-size: 38rpx;
  letter-spacing: 0;
}

.wow-status-badge__label {
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  z-index: 3;
  max-width: 82%;
  transform: translateX(-50%);
  overflow: hidden;
  color: rgba(239, 239, 239, 0.86);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.16;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-status-badge.status-blocked .wow-status-badge__glyph {
  color: #ff6b64;
  text-shadow:
    0 0 12rpx rgba(255, 107, 100, 0.76),
    0 0 24rpx rgba(255, 107, 100, 0.28),
    0 2rpx 0 rgba(0, 0, 0, 0.64);
}

.wow-status-badge.status-partial .wow-status-badge__glyph {
  color: #f8b700;
  text-shadow:
    0 0 12rpx rgba(248, 183, 0, 0.72),
    0 0 24rpx rgba(248, 183, 0, 0.24),
    0 2rpx 0 rgba(0, 0, 0, 0.6);
}

.wow-status-badge.status-stale .wow-status-badge__glyph {
  color: #8bd8ff;
  text-shadow:
    0 0 12rpx rgba(139, 216, 255, 0.72),
    0 0 24rpx rgba(139, 216, 255, 0.24),
    0 2rpx 0 rgba(0, 0, 0, 0.6);
}

.wow-status-badge.status-source_reference .wow-status-badge__glyph {
  color: #93b9ff;
  text-shadow:
    0 0 12rpx rgba(147, 185, 255, 0.68),
    0 0 24rpx rgba(147, 185, 255, 0.22),
    0 2rpx 0 rgba(0, 0, 0, 0.6);
}

.wow-status-badge-verdict {
  width: 100%;
  height: 100%;
}

.wow-status-badge-verdict .wow-status-badge__glyph {
  font-size: 74rpx;
}

.wow-status-badge-verdict .wow-status-badge__glyph.is-wide {
  font-size: 42rpx;
}
