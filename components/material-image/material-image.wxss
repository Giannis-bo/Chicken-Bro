.wow-material-image {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  height: 100%;
  min-height: 0;
  overflow: visible;
  box-sizing: border-box;
  pointer-events: none;
  contain: layout paint style;
  --wow-material-opacity: 1;
}

.wow-material-image.is-clipped {
  overflow: hidden;
}

.wow-material-image__asset,
.wow-material-image__fallback {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  opacity: var(--wow-material-opacity);
  box-sizing: border-box;
  pointer-events: none;
}

.wow-material-image__fallback {
  background:
    linear-gradient(135deg, rgba(248, 183, 0, 0.08), transparent 42%),
    rgba(8, 8, 7, 0.68);
}

.wow-material-image.tone-border .wow-material-image__fallback {
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  background: transparent;
}

.wow-material-image.tone-socket .wow-material-image__fallback {
  border: 1rpx solid rgba(248, 183, 0, 0.38);
  border-radius: 999rpx;
  background: rgba(8, 8, 7, 0.72);
}

.wow-material-image.tone-state .wow-material-image__fallback {
  border: 1rpx solid rgba(255, 107, 100, 0.34);
  border-radius: 12rpx;
  background: rgba(16, 8, 7, 0.72);
}

.wow-material-image.is-decorative {
  opacity: 0.72;
}
