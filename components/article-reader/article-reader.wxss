.wow-article-reader {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-article-reader__content,
.wow-article-reader__headline,
.wow-article-reader__body {
  display: grid;
  min-width: 0;
}

.wow-article-reader__content {
  gap: 18rpx;
}

.wow-article-reader__panel-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  max-width: 140rpx;
  height: 42rpx;
  padding: 0 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(98, 227, 154, 0.4);
  border-radius: 999rpx;
  background: rgba(10, 34, 20, 0.78);
  color: #62e39a;
  box-sizing: border-box;
}

.wow-article-reader__panel-state.state-source_reference,
.wow-article-reader__panel-state.state-stale {
  border-color: rgba(139, 216, 255, 0.4);
  background: rgba(11, 28, 36, 0.78);
  color: #8bd8ff;
}

.wow-article-reader__panel-state.state-blocked,
.wow-article-reader__panel-state.state-error {
  border-color: rgba(255, 107, 100, 0.48);
  background: rgba(42, 12, 10, 0.82);
  color: #ff8a84;
}

.wow-article-reader__panel-state text {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 1000;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-article-reader__headline {
  gap: 10rpx;
}

.wow-article-reader__meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.wow-article-reader__channel {
  flex: none;
  max-width: 160rpx;
  padding: 4rpx 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 1000;
  line-height: 1.1;
  border: 1rpx solid rgba(248, 183, 0, 0.25);
  border-radius: 999rpx;
  background: rgba(118, 80, 9, 0.16);
}

.wow-article-reader__date,
.wow-article-reader__original,
.wow-article-reader__summary,
.wow-article-reader__source-url {
  min-width: 0;
  color: rgba(244, 234, 217, 0.62);
  font-weight: 800;
  letter-spacing: 0;
}

.wow-article-reader__date {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
}

.wow-article-reader__title {
  color: #fff8ea;
  font-size: 42rpx;
  font-weight: 1000;
  line-height: 1.12;
  letter-spacing: 0;
}

.wow-article-reader__original {
  font-size: 24rpx;
  line-height: 1.26;
}

.wow-article-reader__summary {
  font-size: 26rpx;
  line-height: 1.35;
}

.wow-article-reader__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.wow-article-reader__chip {
  max-width: 100%;
  padding: 5rpx 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(244, 234, 217, 0.72);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.12;
  border: 1rpx solid rgba(244, 234, 217, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.035);
}

.wow-article-reader__chip.is-source {
  color: #8bd8ff;
  border-color: rgba(139, 216, 255, 0.24);
  background: rgba(33, 82, 115, 0.16);
}

.wow-article-reader__body {
  gap: 18rpx;
  padding-top: 4rpx;
}

.wow-article-reader__body-heading,
.wow-article-reader__body-paragraph,
.wow-article-reader__body-quote,
.wow-article-reader__body-list-item {
  color: #f4ead9;
  letter-spacing: 0;
}

.wow-article-reader__body-heading {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 1000;
  line-height: 1.18;
}

.wow-article-reader__body-paragraph {
  font-size: 29rpx;
  font-weight: 760;
  line-height: 1.55;
}

.wow-article-reader__body-list {
  display: grid;
  gap: 12rpx;
  min-width: 0;
}

.wow-article-reader__body-list-item {
  display: grid;
  grid-template-columns: 14rpx minmax(0, 1fr);
  gap: 12rpx;
  align-items: start;
  font-size: 28rpx;
  font-weight: 780;
  line-height: 1.45;
}

.wow-article-reader__body-list-bullet {
  width: 8rpx;
  height: 8rpx;
  margin-top: 15rpx;
  border-radius: 50%;
  background: #f8b700;
  box-shadow: 0 0 10rpx rgba(248, 183, 0, 0.22);
}

.wow-article-reader__body-quote {
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.42;
  border-left: 4rpx solid rgba(139, 216, 255, 0.55);
  border-radius: 8rpx;
  background: rgba(33, 82, 115, 0.12);
}

.wow-article-reader__source-footer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(248, 183, 0, 0.14);
}

.wow-article-reader__source-copy {
  display: grid;
  min-width: 0;
  gap: 6rpx;
}

.wow-article-reader__source-name {
  color: #fff8ea;
  font-size: 24rpx;
  font-weight: 1000;
  line-height: 1.16;
}

.wow-article-reader__source-url {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 1.16;
}

.wow-article-reader__blocked,
.wow-article-reader__empty-body,
.wow-article-reader__loading {
  display: grid;
  gap: 12rpx;
  min-width: 0;
  padding: 24rpx;
  border: 1rpx dashed rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  background: rgba(8, 8, 7, 0.64);
}

.wow-article-reader__blocked-title {
  color: #ff9b95;
  font-size: 34rpx;
  font-weight: 1000;
  line-height: 1.16;
}

.wow-article-reader__blocked-copy,
.wow-article-reader__empty-body {
  color: rgba(244, 234, 217, 0.68);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.wow-article-reader__loading-title,
.wow-article-reader__loading-line,
.wow-article-reader__loading-block {
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.06), rgba(255, 255, 255, 0.035), rgba(248, 183, 0, 0.06)),
    rgba(8, 8, 7, 0.74);
}

.wow-article-reader__loading-title {
  width: 76%;
  height: 50rpx;
}

.wow-article-reader__loading-line {
  width: 100%;
  height: 28rpx;
}

.wow-article-reader__loading-block {
  width: 100%;
  height: 180rpx;
}
