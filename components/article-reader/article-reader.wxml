<view class="wow-article-reader {{rootClass}} ext-class">
  <wow-panel
    variant="{{panelVariant}}"
    density="dense"
    hasHeaderSlot="{{true}}"
  >
    <view slot="action" class="wow-article-reader__panel-state state-{{statusState}}">
      <text>{{statusLabel}}</text>
    </view>

    <view wx:if="{{loading}}" class="wow-article-reader__loading" aria-label="资讯详情读取中">
      <view class="wow-article-reader__loading-title"></view>
      <view class="wow-article-reader__loading-line"></view>
      <view class="wow-article-reader__loading-line"></view>
      <view class="wow-article-reader__loading-block"></view>
    </view>

    <view wx:elif="{{missingId || notFound}}" class="wow-article-reader__blocked">
      <text class="wow-article-reader__blocked-title">{{titleText}}</text>
      <text class="wow-article-reader__blocked-copy">{{missingId ? '路由缺少 article id，无法读取详情。' : '当前 id 没有对应可读文章。'}}</text>
    </view>

    <view wx:else class="wow-article-reader__content">
      <view class="wow-article-reader__headline">
        <view class="wow-article-reader__meta-row">
          <text class="wow-article-reader__channel">{{channelText}}</text>
          <text class="wow-article-reader__date">{{publishedAtText}}</text>
        </view>
        <text class="wow-article-reader__title">{{titleText}}</text>
        <text wx:if="{{originalTitleText}}" class="wow-article-reader__original">{{originalTitleText}}</text>
        <text wx:if="{{summaryText}}" class="wow-article-reader__summary">{{summaryText}}</text>
        <view wx:if="{{sourceBadges.length || metaChips.length}}" class="wow-article-reader__chips">
          <text
            wx:for="{{sourceBadges}}"
            wx:key="key"
            class="wow-article-reader__chip is-source"
          >{{item.label}}</text>
          <text
            wx:for="{{metaChips}}"
            wx:key="key"
            class="wow-article-reader__chip"
          >{{item.label}}</text>
        </view>
      </view>

      <evidence-ledger
        wx:if="{{evidenceRows.length}}"
        title="来源证明"
        summary="{{sourceNameText}}"
        rows="{{evidenceRows}}"
        expanded="{{false}}"
        collapsedRows="{{2}}"
        bindtoggle="handleEvidenceToggle"
      ></evidence-ledger>

      <view wx:if="{{hasBodyBlocks}}" class="wow-article-reader__body">
        <block wx:for="{{bodyBlocks}}" wx:key="key">
          <text wx:if="{{item.type == 'heading'}}" class="wow-article-reader__body-heading">{{item.text}}</text>
          <view wx:elif="{{item.type == 'list'}}" class="wow-article-reader__body-list">
            <view wx:for="{{item.items}}" wx:key="key" class="wow-article-reader__body-list-item">
              <text class="wow-article-reader__body-list-bullet"></text>
              <text>{{item.text}}</text>
            </view>
          </view>
          <view wx:elif="{{item.type == 'quote'}}" class="wow-article-reader__body-quote">
            <text>{{item.text}}</text>
          </view>
          <text wx:else class="wow-article-reader__body-paragraph">{{item.text}}</text>
        </block>
      </view>

      <view wx:else class="wow-article-reader__empty-body">
        <text>正文尚未进入可读状态，页面不会用摘要伪装全文。</text>
      </view>

      <view class="wow-article-reader__source-footer">
        <view class="wow-article-reader__source-copy">
          <text class="wow-article-reader__source-name">{{sourceNameText}}</text>
          <text wx:if="{{sourceUrlText}}" class="wow-article-reader__source-url">{{sourceUrlText}}</text>
        </view>
        <action-button
          label="复制来源链接"
          tone="secondary"
          size="compact"
          disabled="{{!sourceUrlText}}"
          bindactiontap="handleCopySource"
        ></action-button>
      </view>
    </view>
  </wow-panel>
</view>
