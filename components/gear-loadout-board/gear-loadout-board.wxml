<view class="wow-gear-loadout-board {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-gear-loadout-board__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-gear-loadout-board__head-status">
      <status-visual
        state="{{normalizedStatus}}"
        label="{{normalizedStateLabel}}"
        glyph="{{normalizedStateGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-gear-loadout-board__summary">
      <view class="wow-gear-loadout-board__identity">
        <text>{{identityLabel}}</text>
        <text>{{normalizedSlotCountLabel}}</text>
      </view>
      <view class="wow-gear-loadout-board__stat-strip">
        <view
          wx:for="{{normalizedStatRows}}"
          wx:key="key"
          class="wow-gear-loadout-board__stat state-{{item.status}}"
        >
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="wow-gear-loadout-board__readiness" wx:if="{{normalizedReadinessRows.length}}">
      <view
        wx:for="{{normalizedReadinessRows}}"
        wx:key="key"
        class="wow-gear-loadout-board__readiness-row state-{{item.status}}"
      >
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
        <text>{{item.statusLabel}}</text>
      </view>
    </view>

    <view class="wow-gear-loadout-board__grid-shell">
      <material-image
        wx:if="{{boardMaterialSrc}}"
        ext-class="wow-gear-loadout-board__board-material"
        src="{{boardMaterialSrc}}"
        mode="aspectFill"
        decorative="{{true}}"
      ></material-image>
      <view class="wow-gear-loadout-board__slot-grid">
        <view
          wx:for="{{normalizedSlots}}"
          wx:key="slotId"
          class="wow-gear-loadout-board__slot state-{{item.status}} {{item.isSelected ? 'is-selected' : ''}} {{item.isMissing ? 'is-missing' : ''}}"
          data-slot-id="{{item.slotId}}"
          data-status="{{item.status}}"
          bindtap="handleSlotTap"
        >
          <view class="wow-gear-loadout-board__slot-head">
            <text>{{item.slotLabel}}</text>
            <status-visual
              ext-class="wow-gear-loadout-board__slot-status"
              state="{{item.status}}"
              label="{{item.statusLabel}}"
              glyph="{{item.statusGlyph}}"
              size="compact"
              showLabel="{{false}}"
            ></status-visual>
          </view>
          <view class="wow-gear-loadout-board__slot-body">
            <game-object-icon
              ext-class="wow-gear-loadout-board__slot-icon"
              object-type="gear"
              entity-id="{{item.slotId}}"
              display-name="{{item.title}}"
              icon-src="{{item.iconSrc}}"
              icon-name="{{item.iconName}}"
              fallback-text="{{item.fallbackText}}"
              status="{{item.iconSrc || item.iconName ? 'verified' : 'missing'}}"
              size="medium"
              shape="square"
            ></game-object-icon>
            <view class="wow-gear-loadout-board__slot-copy">
              <text class="wow-gear-loadout-board__item-title">{{item.title}}</text>
              <text wx:if="{{item.meta}}" class="wow-gear-loadout-board__item-meta">{{item.meta}}</text>
              <text wx:if="{{item.enhancementSummary}}" class="wow-gear-loadout-board__enhancement">{{item.enhancementSummary}}</text>
              <text wx:if="{{item.blockerText}}" class="wow-gear-loadout-board__blocker">{{item.blockerText}}</text>
            </view>
          </view>
          <view
            class="wow-gear-loadout-board__config"
            data-slot-id="{{item.slotId}}"
            data-status="{{item.status}}"
            catchtap="handleConfigTap"
          >
            <text>{{item.canOpenConfig ? '配置' : '查看'}}</text>
            <text>›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="wow-gear-loadout-board__actions">
      <action-button
        label="{{normalizedImportAction.label}}"
        tone="secondary"
        size="compact"
        disabled="{{normalizedImportAction.disabled}}"
        loading="{{normalizedImportAction.loading}}"
        bind:actiontap="handleImportTap"
      ></action-button>
      <action-button
        label="{{normalizedResetAction.label}}"
        tone="ghost"
        size="compact"
        disabled="{{normalizedResetAction.disabled}}"
        loading="{{normalizedResetAction.loading}}"
        bind:actiontap="handleResetTap"
      ></action-button>
      <action-button
        label="{{normalizedSaveAction.label}}"
        tone="{{normalizedStatus == 'blocked' ? 'danger' : 'primary'}}"
        size="default"
        disabled="{{normalizedSaveAction.disabled}}"
        loading="{{normalizedSaveAction.loading}}"
        bind:actiontap="handleSaveTap"
      ></action-button>
    </view>

    <evidence-ledger
      ext-class="wow-gear-loadout-board__evidence"
      title="装备证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
