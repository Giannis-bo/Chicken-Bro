.wow-gear-loadout-board {
  display: block;
  min-width: 0;
  color: #f4ead9;
  box-sizing: border-box;
  contain: layout paint style;
}

.wow-gear-loadout-board__panel {
  display: block;
  min-width: 0;
}

.wow-gear-loadout-board__head-status {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.wow-gear-loadout-board__summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
  min-width: 0;
}

.wow-gear-loadout-board__identity {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 16rpx;
  min-width: 0;
}

.wow-gear-loadout-board__identity text {
  display: block;
  min-width: 0;
  letter-spacing: 0;
  line-height: 1.12;
}

.wow-gear-loadout-board__identity text:first-child {
  overflow: hidden;
  color: #fff8ea;
  font-size: 30rpx;
  font-weight: 1000;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-gear-loadout-board__identity text:last-child {
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 950;
}

.wow-gear-loadout-board__stat-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
}

.wow-gear-loadout-board__stat {
  display: grid;
  gap: 4rpx;
  min-width: 0;
  min-height: 70rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.wow-gear-loadout-board__stat text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-gear-loadout-board__stat text:first-child {
  color: rgba(244, 234, 217, 0.62);
  font-size: 20rpx;
  font-weight: 850;
}

.wow-gear-loadout-board__stat text:last-child {
  color: #fff8ea;
  font-size: 24rpx;
  font-weight: 1000;
}

.wow-gear-loadout-board__readiness {
  display: grid;
  gap: 8rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.wow-gear-loadout-board__readiness-row {
  display: grid;
  grid-template-columns: minmax(90rpx, 0.7fr) minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 54rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.wow-gear-loadout-board__readiness-row.state-blocked {
  border-color: rgba(255, 107, 100, 0.48);
}

.wow-gear-loadout-board__readiness-row text {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: rgba(244, 234, 217, 0.7);
  font-size: 21rpx;
  font-weight: 850;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-gear-loadout-board__readiness-row text:nth-child(2) {
  color: #fff8ea;
  font-weight: 950;
}

.wow-gear-loadout-board__grid-shell {
  position: relative;
  min-width: 0;
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(12, 8, 4, 0.9), rgba(4, 3, 2, 0.96)),
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.12), transparent 32%);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 225, 128, 0.06),
    inset 0 -32rpx 70rpx rgba(0, 0, 0, 0.34);
}

.wow-gear-loadout-board__board-material {
  position: absolute;
  inset: 0;
  opacity: 0.24;
  pointer-events: none;
}

.wow-gear-loadout-board__slot-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  min-width: 0;
  padding: 12rpx;
  box-sizing: border-box;
}

.wow-gear-loadout-board__slot {
  display: grid;
  grid-template-rows: auto minmax(108rpx, 1fr) auto;
  gap: 8rpx;
  min-width: 0;
  min-height: 190rpx;
  padding: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  background:
    linear-gradient(145deg, rgba(248, 183, 0, 0.08), transparent 40%),
    rgba(0, 0, 0, 0.34);
  box-sizing: border-box;
}

.wow-gear-loadout-board__slot.is-selected {
  border-color: rgba(248, 183, 0, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(255, 225, 128, 0.16);
}

.wow-gear-loadout-board__slot.state-blocked,
.wow-gear-loadout-board__slot.state-missing {
  border-color: rgba(255, 107, 100, 0.58);
  background:
    linear-gradient(145deg, rgba(255, 107, 100, 0.1), transparent 40%),
    rgba(0, 0, 0, 0.36);
}

.wow-gear-loadout-board__slot-head,
.wow-gear-loadout-board__slot-body,
.wow-gear-loadout-board__config {
  min-width: 0;
}

.wow-gear-loadout-board__slot-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 76rpx;
  align-items: center;
  gap: 8rpx;
}

.wow-gear-loadout-board__slot-head > text {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: rgba(244, 234, 217, 0.72);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wow-gear-loadout-board__slot-status {
  width: 76rpx;
  height: 76rpx;
}

.wow-gear-loadout-board__slot-body {
  display: grid;
  grid-template-columns: 78rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
}

.wow-gear-loadout-board__slot-icon {
  width: 78rpx;
  height: 78rpx;
}

.wow-gear-loadout-board__slot-copy {
  display: grid;
  gap: 4rpx;
  min-width: 0;
}

.wow-gear-loadout-board__slot-copy text {
  display: block;
  min-width: 0;
  overflow: hidden;
  letter-spacing: 0;
  line-height: 1.12;
  text-overflow: ellipsis;
}

.wow-gear-loadout-board__item-title {
  color: #fff8ea;
  font-size: 22rpx;
  font-weight: 1000;
  white-space: normal;
}

.wow-gear-loadout-board__item-meta,
.wow-gear-loadout-board__enhancement {
  color: rgba(244, 234, 217, 0.66);
  font-size: 19rpx;
  font-weight: 850;
  white-space: nowrap;
}

.wow-gear-loadout-board__enhancement {
  color: #62e6a0;
}

.wow-gear-loadout-board__blocker {
  color: #ff6b64;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
}

.wow-gear-loadout-board__config {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  min-height: 46rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: rgba(248, 183, 0, 0.11);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 950;
  letter-spacing: 0;
  box-sizing: border-box;
}

.wow-gear-loadout-board__actions {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 0.72fr) minmax(0, 1.2fr);
  gap: 10rpx;
  min-width: 0;
  margin-top: 16rpx;
}

.wow-gear-loadout-board__evidence {
  display: block;
  min-width: 0;
  margin-top: 16rpx;
}

@media (min-width: 700px) {
  .wow-gear-loadout-board__slot-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
