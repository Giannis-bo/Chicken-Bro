.wow-status-visual {
  position: relative;
  display: block;
  width: 112rpx;
  height: 112rpx;
  min-width: 0;
  overflow: visible;
  box-sizing: border-box;
  contain: layout paint style;
  --status-color: #93b9ff;
  --status-bg: rgba(20, 25, 32, 0.9);
  --status-border: rgba(147, 185, 255, 0.46);
}

.wow-status-visual.state-ready_to_simulate {
  --status-color: #62e39a;
  --status-bg: rgba(14, 31, 21, 0.92);
  --status-border: rgba(98, 227, 154, 0.48);
}

.wow-status-visual.state-blocked,
.wow-status-visual.state-error {
  --status-color: #ff6b64;
  --status-bg: rgba(35, 12, 10, 0.94);
  --status-border: rgba(255, 107, 100, 0.58);
}

.wow-status-visual.state-partial,
.wow-status-visual.state-loading {
  --status-color: #f8b700;
  --status-bg: rgba(37, 27, 9, 0.94);
  --status-border: rgba(248, 183, 0, 0.54);
}

.wow-status-visual.state-stale {
  --status-color: #8bd8ff;
  --status-bg: rgba(11, 24, 31, 0.92);
  --status-border: rgba(139, 216, 255, 0.48);
}

.wow-status-visual.state-empty,
.wow-status-visual.state-unknown {
  --status-color: #a89a83;
  --status-bg: rgba(20, 19, 16, 0.92);
  --status-border: rgba(168, 154, 131, 0.42);
}

.wow-status-visual__atomic,
.wow-status-visual__base-image,
.wow-status-visual__base,
.wow-status-visual__glyph-stage {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  pointer-events: none;
}

.wow-status-visual__atomic {
  object-fit: contain;
  object-position: center;
}

.wow-status-visual__base {
  border: 2rpx solid var(--status-border);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 50% 34%, rgba(255, 255, 255, 0.08), transparent 30%),
    linear-gradient(180deg, var(--status-bg), rgba(6, 6, 5, 0.96));
  box-shadow:
    inset 0 0 0 2rpx rgba(0, 0, 0, 0.26),
    0 0 26rpx rgba(0, 0, 0, 0.34);
}

.wow-status-visual__base--atomic {
  z-index: 0;
  opacity: 0.62;
}

.wow-status-visual.shape-circle .wow-status-visual__base,
.wow-status-visual.shape-circle .wow-status-visual__base-image,
.wow-status-visual.shape-seal .wow-status-visual__base {
  border-radius: 999rpx;
}

.wow-status-visual.shape-circle .wow-status-visual__base::before,
.wow-status-visual.shape-circle .wow-status-visual__base::after {
  content: "";
  position: absolute;
  pointer-events: none;
  border-radius: 999rpx;
}

.wow-status-visual.shape-circle .wow-status-visual__base::before {
  inset: 12%;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
}

.wow-status-visual.shape-circle .wow-status-visual__base::after {
  inset: 24%;
  border: 1rpx solid var(--status-border);
  opacity: 0.65;
}

.wow-status-visual.shape-triangle .wow-status-visual__base {
  left: 50%;
  top: 6%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-top: 0;
  border-right: 48rpx solid transparent;
  border-bottom: 92rpx solid var(--status-border);
  border-left: 48rpx solid transparent;
  border-radius: 0;
  background: none;
  box-shadow: none;
}

.wow-status-visual.shape-triangle.size-large .wow-status-visual__base,
.wow-status-visual.shape-triangle.size-hero .wow-status-visual__base,
.wow-status-visual.shape-triangle.is-fill .wow-status-visual__base {
  border-right-width: 52rpx;
  border-bottom-width: 100rpx;
  border-left-width: 52rpx;
}

.wow-status-visual.shape-triangle .wow-status-visual__base::before {
  content: "";
  position: absolute;
  left: -41rpx;
  top: 8rpx;
  width: 0;
  height: 0;
  border-right: 41rpx solid transparent;
  border-bottom: 78rpx solid rgba(35, 12, 10, 0.96);
  border-left: 41rpx solid transparent;
}

.wow-status-visual.shape-triangle.size-large .wow-status-visual__base::before,
.wow-status-visual.shape-triangle.size-hero .wow-status-visual__base::before,
.wow-status-visual.shape-triangle.is-fill .wow-status-visual__base::before {
  left: -44rpx;
  top: 10rpx;
  border-right-width: 44rpx;
  border-bottom-width: 84rpx;
  border-left-width: 44rpx;
}

.wow-status-visual.shape-triangle .wow-status-visual__glyph-stage {
  padding-top: 18rpx;
  padding-bottom: 30rpx;
}

.wow-status-visual.shape-diamond .wow-status-visual__base,
.wow-status-visual.shape-diamond .wow-status-visual__base-image {
  width: 74%;
  height: 74%;
  inset: 13%;
  transform: rotate(45deg);
  border-radius: 14rpx;
}

.wow-status-visual.shape-diamond .wow-status-visual__base::before {
  content: "";
  position: absolute;
  inset: 14%;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 10rpx;
  pointer-events: none;
}

.wow-status-visual.shape-shield .wow-status-visual__base,
.wow-status-visual.shape-shield .wow-status-visual__base-image {
  clip-path: polygon(50% 0, 90% 15%, 82% 70%, 50% 100%, 18% 70%, 10% 15%);
  border-radius: 24rpx 24rpx 42rpx 42rpx;
}

.wow-status-visual.shape-shield .wow-status-visual__base::before,
.wow-status-visual.shape-shield .wow-status-visual__base::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 7%;
  width: 68%;
  height: 78%;
  transform: translateX(-50%);
  box-sizing: border-box;
  pointer-events: none;
}

.wow-status-visual.shape-shield .wow-status-visual__base::before {
  border: 2rpx solid var(--status-border);
  border-bottom-width: 3rpx;
  border-radius: 24rpx 24rpx 46rpx 46rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 28%),
    rgba(0, 0, 0, 0.2);
  box-shadow:
    inset 0 0 18rpx rgba(255, 255, 255, 0.035),
    0 0 18rpx rgba(0, 0, 0, 0.32);
}

.wow-status-visual.shape-shield .wow-status-visual__base::after {
  top: 16%;
  width: 44%;
  height: 54%;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-bottom-color: var(--status-border);
  border-radius: 18rpx 18rpx 34rpx 34rpx;
  opacity: 0.72;
}

.wow-status-visual.shape-shield .wow-status-visual__glyph-stage {
  padding: 18rpx 18rpx 30rpx;
}

.wow-status-visual.shape-pill {
  width: 168rpx;
  height: 64rpx;
}

.wow-status-visual.shape-pill .wow-status-visual__base {
  border-radius: 999rpx;
}

.wow-status-visual__glyph-stage {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.wow-status-visual__glyph {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: var(--status-color);
  font-size: 48rpx;
  font-weight: 1000;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
  text-shadow:
    0 0 12rpx currentColor,
    0 2rpx 0 rgba(0, 0, 0, 0.64);
}

.wow-status-visual__glyph.is-wide {
  font-size: 34rpx;
}

.wow-status-visual__glyph.is-long {
  font-size: 24rpx;
}

.wow-status-visual.size-compact {
  width: 76rpx;
  height: 76rpx;
}

.wow-status-visual.size-compact .wow-status-visual__glyph {
  font-size: 34rpx;
}

.wow-status-visual.size-large {
  width: 148rpx;
  height: 148rpx;
}

.wow-status-visual.size-hero {
  width: 188rpx;
  height: 188rpx;
}

.wow-status-visual.is-fill {
  width: 100%;
  height: 100%;
}

.wow-status-visual__label {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  z-index: 3;
  max-width: 160rpx;
  transform: translateX(-50%);
  overflow: hidden;
  color: var(--status-color);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.15;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
