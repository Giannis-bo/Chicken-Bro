<view class="wow-template-library-board {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-template-library-board__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-template-library-board__sync">
      <status-visual
        state="{{normalizedRemoteVisual}}"
        label="{{normalizedRemoteLabel}}"
        glyph="{{normalizedRemoteGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-template-library-board__modules">
      <module-card
        wx:for="{{normalizedModules}}"
        wx:key="type"
        ext-class="wow-template-library-board__module-card"
        title="{{item.title}}"
        metric="{{item.metric}}"
        meta="{{item.meta}}"
        status="{{item.status}}"
        status-label="{{item.statusLabel}}"
        status-glyph="{{item.statusGlyph}}"
        icon-text="{{item.iconText}}"
        data-type="{{item.type}}"
        bind:cardtap="handleModuleTap"
      ></module-card>
    </view>

    <view wx:if="{{normalizedLoading}}" class="wow-template-library-board__loading">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="wow-template-library-board__skeleton"></view>
    </view>

    <view wx:elif="{{normalizedIsEmpty}}" class="wow-template-library-board__empty">
      <status-visual state="source_reference" label="暂无模板" glyph="空" size="standard" shape="seal"></status-visual>
      <view class="wow-template-library-board__empty-copy">
        <text>{{normalizedEmptyTitle}}</text>
        <text>{{normalizedEmptyMeta}}</text>
      </view>
      <view class="wow-template-library-board__entry-actions">
        <action-button
          label="{{normalizedTalentAction.label}}"
          tone="{{normalizedTalentAction.tone}}"
          size="default"
          disabled="{{normalizedTalentAction.disabled}}"
          loading="{{normalizedTalentAction.loading}}"
          bind:actiontap="handleTalentEntry"
        ></action-button>
        <action-button
          label="{{normalizedGearAction.label}}"
          tone="{{normalizedGearAction.tone}}"
          size="compact"
          disabled="{{normalizedGearAction.disabled}}"
          loading="{{normalizedGearAction.loading}}"
          bind:actiontap="handleGearEntry"
        ></action-button>
      </view>
    </view>

    <view wx:else class="wow-template-library-board__groups">
      <view wx:for="{{normalizedModules}}" wx:key="type" class="wow-template-library-board__group">
        <view class="wow-template-library-board__group-head">
          <text>{{item.title}}</text>
          <text>{{item.count}} 个</text>
        </view>
        <view wx:if="{{item.count == 0}}" class="wow-template-library-board__module-empty">
          <text>{{item.emptyText}}</text>
        </view>
        <view wx:else class="wow-template-library-board__cards">
          <view
            wx:for="{{item.recent}}"
            wx:for-item="template"
            wx:key="id"
            class="wow-template-library-board__card state-{{template.status}}"
            data-template-id="{{template.id}}"
            data-type="{{template.type}}"
            bindtap="handleTemplateTap"
          >
            <game-object-icon
              ext-class="wow-template-library-board__card-icon"
              object-type="{{template.type}}"
              entity-id="{{template.id}}"
              display-name="{{template.title}}"
              icon-src="{{template.iconSrc}}"
              fallback-text="{{template.fallbackText}}"
              status="{{template.iconSrc ? 'verified' : 'source_reference'}}"
              size="medium"
              shape="round"
            ></game-object-icon>
            <view class="wow-template-library-board__card-copy">
              <view class="wow-template-library-board__title-line">
                <text>{{template.title}}</text>
                <text>{{template.statusLabel}}</text>
              </view>
              <view class="wow-template-library-board__chips">
                <text wx:for="{{template.metaChips}}" wx:key="*this">{{item}}</text>
              </view>
              <view class="wow-template-library-board__source-row">
                <text>{{template.savedTimeLabel}}</text>
                <text>{{template.sourceLabel}}</text>
              </view>
            </view>
            <view class="wow-template-library-board__card-actions">
              <action-button
                label="{{template.entryAction.label}}"
                tone="{{template.entryAction.tone}}"
                size="compact"
                disabled="{{template.entryAction.disabled}}"
                loading="{{template.entryAction.loading}}"
              ></action-button>
              <button
                class="wow-template-library-board__delete"
                data-template-id="{{template.id}}"
                data-title="{{template.title}}"
                catchtap="handleConfirmDelete"
              >删除</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{normalizedDeleteState.confirming}}" class="wow-template-library-board__delete-confirm">
      <status-visual state="blocked" label="确认删除" glyph="!" size="standard" shape="seal"></status-visual>
      <view class="wow-template-library-board__delete-copy">
        <text>删除「{{normalizedDeleteState.title}}」？</text>
        <text>{{normalizedDeleteState.message}}</text>
      </view>
      <view class="wow-template-library-board__delete-actions">
        <action-button
          label="{{normalizedDeleteState.cancelAction.label}}"
          tone="{{normalizedDeleteState.cancelAction.tone}}"
          size="compact"
          bind:actiontap="handleCancelDelete"
        ></action-button>
        <action-button
          label="{{normalizedDeleteState.confirmAction.label}}"
          tone="{{normalizedDeleteState.confirmAction.tone}}"
          size="compact"
          loading="{{normalizedDeleteState.confirmAction.loading}}"
          disabled="{{normalizedDeleteState.confirmAction.disabled}}"
          bind:actiontap="handleDeleteTemplate"
        ></action-button>
      </view>
    </view>

    <view class="wow-template-library-board__footer-actions">
      <action-button
        label="{{normalizedSyncAction.label}}"
        tone="{{normalizedSyncAction.tone}}"
        size="compact"
        disabled="{{normalizedSyncAction.disabled}}"
        loading="{{normalizedSyncAction.loading}}"
        bind:actiontap="handleSyncTap"
      ></action-button>
    </view>

    <evidence-ledger
      ext-class="wow-template-library-board__evidence"
      title="模板证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
