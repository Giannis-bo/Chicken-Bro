.surface-material {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  pointer-events: none;
}

.news-tab-dock {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: stretch;
  gap: 0;
  height: 100%;
  min-height: 126rpx;
  padding: 10rpx 10rpx 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0), rgba(248, 183, 0, 0.06) 14%, rgba(248, 183, 0, 0.025) 50%, rgba(248, 183, 0, 0.06) 86%, rgba(248, 183, 0, 0)),
    radial-gradient(circle at 18% 0%, rgba(246, 231, 193, 0.055), rgba(246, 231, 193, 0) 32%),
    radial-gradient(circle at 50% 100%, rgba(248, 183, 0, 0.055), rgba(248, 183, 0, 0) 38%),
    linear-gradient(180deg, rgba(27, 25, 21, 0.8), rgba(3, 3, 3, 0.95));
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.026),
    inset 0 -20rpx 28rpx rgba(0, 0, 0, 0.58),
    inset 0 10rpx 18rpx rgba(255, 255, 255, 0.024),
    0 8rpx 18rpx rgba(0, 0, 0, 0.24);
}

.news-tab-dock::before {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 5rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(248, 183, 0, 0.15), transparent);
  pointer-events: none;
}

.news-tab-dock::after {
  content: "";
  position: absolute;
  left: 17rpx;
  right: 17rpx;
  bottom: 8rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(248, 183, 0, 0.18), transparent);
  pointer-events: none;
}

.channel-dock-material {
  inset: 2rpx 9rpx auto;
  width: auto;
  height: 28rpx;
  opacity: 0.42;
  filter: saturate(0.92) contrast(1.1);
  mix-blend-mode: screen;
}

.channel-frame-material {
  inset: 7rpx 18rpx auto;
  width: auto;
  height: 10rpx;
  opacity: 0.14;
  filter: saturate(0.9) contrast(1.08);
  mix-blend-mode: screen;
}

.news-tab-rail {
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  top: 7rpx;
  bottom: 7rpx;
  z-index: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-radius: 7rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.024), rgba(255, 255, 255, 0) 34%),
    linear-gradient(90deg, rgba(6, 6, 5, 0.98), rgba(19, 18, 15, 0.98) 18%, rgba(18, 17, 14, 0.96) 82%, rgba(6, 6, 5, 0.98));
  box-shadow:
    inset 0 0 0 1rpx rgba(0, 0, 0, 0.38),
    inset 0 -22rpx 30rpx rgba(0, 0, 0, 0.48),
    inset 0 8rpx 20rpx rgba(248, 183, 0, 0.032);
  pointer-events: none;
}

.news-tab-item {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-rows: 58rpx 32rpx;
  align-items: center;
  align-content: center;
  justify-content: center;
  justify-items: center;
  row-gap: 6rpx;
  min-width: 0;
  min-height: 0;
  height: 100%;
  padding: 4rpx 3rpx 6rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.news-tab-item.is-active {
  z-index: 2;
}

.news-tab-item::before {
  content: "";
  position: absolute;
  top: 10rpx;
  bottom: 16rpx;
  right: -1rpx;
  width: 1rpx;
  background: linear-gradient(180deg, rgba(248, 183, 0, 0), rgba(248, 183, 0, 0.11), rgba(248, 183, 0, 0));
  pointer-events: none;
}

.news-tab-item::after {
  content: "";
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 1rpx;
  bottom: 1rpx;
  z-index: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.012);
  border-radius: 44rpx 44rpx 5rpx 5rpx;
  background:
    radial-gradient(circle at 50% 28%, rgba(246, 231, 193, 0.018), rgba(246, 231, 193, 0) 43%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.012), rgba(255, 255, 255, 0) 44%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.01), rgba(0, 0, 0, 0.2));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.014),
    inset 0 -8rpx 12rpx rgba(0, 0, 0, 0.16);
  pointer-events: none;
}

.news-tab-item.is-active::after {
  border-color: rgba(248, 183, 0, 0.16);
  background:
    radial-gradient(circle at 50% 28%, rgba(248, 183, 0, 0.09), rgba(248, 183, 0, 0.018) 42%, rgba(248, 183, 0, 0) 64%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0) 43%),
    linear-gradient(180deg, rgba(32, 22, 12, 0.22), rgba(0, 0, 0, 0.4));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.035),
    inset 0 -12rpx 18rpx rgba(0, 0, 0, 0.28),
    0 0 0 1rpx rgba(248, 183, 0, 0.04);
}

.news-tab-item:last-child::before {
  display: none;
}

.news-tab-cell-surface {
  display: none;
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  width: 58rpx;
  height: 58rpx;
  border: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background:
    radial-gradient(circle at 50% 45%, rgba(248, 183, 0, 0.11), rgba(248, 183, 0, 0.032) 43%, rgba(0, 0, 0, 0.34) 71%, rgba(0, 0, 0, 0) 72%),
    radial-gradient(circle at 50% 54%, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0) 74%);
  box-shadow:
    0 0 0 6rpx rgba(0, 0, 0, 0.2),
    0 0 16rpx rgba(248, 183, 0, 0.07);
  pointer-events: none;
}

.news-tab-active-mark {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 2rpx;
  z-index: 2;
  height: 2rpx;
  border-radius: 999rpx;
  background: transparent;
  pointer-events: none;
}

.news-tab-item.is-active .news-tab-active-mark {
  background: linear-gradient(90deg, rgba(248, 183, 0, 0), rgba(248, 183, 0, 0.42), rgba(248, 183, 0, 0));
  box-shadow: 0 0 7rpx rgba(248, 183, 0, 0.12);
}

.news-tab-item.is-active .news-tab-cell-surface {
  background:
    radial-gradient(circle at 50% 45%, rgba(248, 183, 0, 0.14), rgba(248, 183, 0, 0.042) 43%, rgba(0, 0, 0, 0.34) 72%, rgba(0, 0, 0, 0) 73%),
    radial-gradient(circle at 50% 54%, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0) 74%);
  box-shadow:
    0 0 0 6rpx rgba(0, 0, 0, 0.23),
    0 0 18rpx rgba(248, 183, 0, 0.09);
}

.news-tab-item.is-active .news-tab-title {
  color: #f8d776;
  text-shadow: 0 0 10rpx rgba(248, 183, 0, 0.16);
}

.news-tab-icon-slot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  min-width: 58rpx;
  min-height: 58rpx;
  overflow: visible;
  box-sizing: border-box;
}

.news-tab-orb {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  align-self: center;
  justify-self: center;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 35%, rgba(246, 231, 193, 0.038), rgba(248, 183, 0, 0.022) 42%, rgba(0, 0, 0, 0.92) 78%),
    rgba(8, 8, 7, 0.88);
  color: #f8b700;
  font-weight: 900;
  box-shadow:
    0 4rpx 10rpx rgba(0, 0, 0, 0.36),
    0 0 0 3rpx rgba(0, 0, 0, 0.22),
    inset 0 0 0 2rpx rgba(0, 0, 0, 0.24);
  line-height: 0;
}

.channel-socket-material {
  inset: -4rpx;
  width: calc(100% + 8rpx);
  height: calc(100% + 8rpx);
  opacity: 0.76;
  filter: saturate(1) contrast(1.08);
  mix-blend-mode: normal;
}

.news-tab-icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 1000;
  line-height: 50rpx;
  text-align: center;
}

.news-tab-orb::after {
  content: "";
  position: absolute;
  inset: 5rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.055);
  border-radius: 50%;
  pointer-events: none;
}

.news-tab-label-slot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.news-tab-title {
  display: block;
  width: 100%;
  overflow: hidden;
  color: rgba(246, 231, 193, 0.88);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-tab-item.visual-tone-ptr .news-tab-orb,
.news-tab-item.visual-tone-update .news-tab-orb {
  border-color: rgba(84, 192, 255, 0.11);
  color: #8bd8ff;
  background:
    radial-gradient(circle at 50% 35%, rgba(84, 192, 255, 0.045), rgba(248, 183, 0, 0.02) 46%, rgba(0, 0, 0, 0.92) 80%),
    rgba(9, 8, 7, 0.88);
}

.news-tab-item.visual-tone-event .news-tab-orb,
.news-tab-item.visual-tone-class .news-tab-orb {
  border-color: rgba(240, 82, 82, 0.1);
  color: #f3a071;
  background:
    radial-gradient(circle at 50% 35%, rgba(240, 82, 82, 0.034), rgba(248, 183, 0, 0.022) 46%, rgba(0, 0, 0, 0.92) 80%),
    rgba(9, 8, 7, 0.88);
}

.news-tab-item.visual-tone-community .news-tab-orb,
.news-tab-item.visual-tone-guide .news-tab-orb {
  border-color: rgba(84, 192, 255, 0.14);
}

.news-tab-item.visual-tone-ptr .news-tab-icon,
.news-tab-item.visual-tone-update .news-tab-icon {
  color: #8bd8ff;
}

.news-tab-item.visual-tone-event .news-tab-icon,
.news-tab-item.visual-tone-class .news-tab-icon {
  color: #f3a071;
}

@media (max-width: 380px) {
  .news-tab-dock {
    padding-left: 6rpx;
    padding-right: 6rpx;
  }

  .news-tab-orb {
    width: 50rpx;
    height: 50rpx;
  }

  .news-tab-item {
    grid-template-rows: 58rpx 30rpx;
    row-gap: 5rpx;
    padding-top: 3rpx;
    padding-bottom: 3rpx;
  }

  .news-tab-icon-slot,
  .news-tab-cell-surface {
    width: 58rpx;
    height: 58rpx;
    min-width: 58rpx;
    min-height: 58rpx;
  }

  .news-tab-icon {
    width: 50rpx;
    height: 50rpx;
    font-size: 22rpx;
    line-height: 50rpx;
  }

  .news-tab-label-slot {
    height: 30rpx;
    min-height: 30rpx;
  }

  .news-tab-title {
    font-size: 20rpx;
    line-height: 30rpx;
  }
}
