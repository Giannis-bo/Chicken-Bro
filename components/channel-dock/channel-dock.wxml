<view class="news-tab-dock pass37-module-dock pass37-module-dock--channel" aria-label="资讯频道">
  <view class="news-tab-rail"></view>
  <view
    class="news-tab-item pass37-module-card {{item.isActive ? 'is-active' : ''}} visual-tone-{{item.visualTone}} visual-key-{{item.dockKey}}"
    wx:for="{{items}}"
    wx:key="dockKey"
    data-type="{{item.queryType}}"
    data-key="{{item.queryKey}}"
    data-value="{{item.queryValue}}"
    bindtap="handleTabTap"
  >
    <view class="news-tab-icon-slot">
      <view class="news-tab-cell-surface"></view>
      <view class="news-tab-orb">
        <text class="news-tab-icon">{{item.visualText}}</text>
      </view>
    </view>
    <view class="news-tab-label-slot">
      <text class="news-tab-title">{{item.title}}</text>
    </view>
    <view class="news-tab-active-mark"></view>
  </view>
</view>
