<view class="wow-talent-tree-canvas {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-talent-tree-canvas__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-talent-tree-canvas__head-status">
      <status-visual
        state="{{normalizedState}}"
        label="{{normalizedStateLabel}}"
        glyph="{{normalizedStateGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-talent-tree-canvas__summary">
      <view class="wow-talent-tree-canvas__identity">
        <text>{{classLabel}}</text>
        <text>{{specLabel}}</text>
        <text>{{heroLabel}}</text>
      </view>
      <view class="wow-talent-tree-canvas__points">
        <text>{{pointSummary}}</text>
        <text wx:if="{{blockerLabel}}">{{blockerLabel}}</text>
      </view>
    </view>

    <view class="wow-talent-tree-canvas__tabs">
      <view
        wx:for="{{normalizedTreeTabs}}"
        wx:key="key"
        class="wow-talent-tree-canvas__tab state-{{item.status}} {{activeTreeKey == item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleTreeTabTap"
      >
        <text>{{item.label}}</text>
        <text>{{item.points}}</text>
      </view>
    </view>

    <view class="wow-talent-tree-canvas__tree-shell" bindtap="handleViewportTap">
      <material-image
        wx:if="{{treeMaterialSrc}}"
        ext-class="wow-talent-tree-canvas__tree-material"
        src="{{treeMaterialSrc}}"
        mode="aspectFill"
        decorative="{{true}}"
      ></material-image>
      <view class="wow-talent-tree-canvas__links">
        <view
          wx:for="{{normalizedLinks}}"
          wx:key="id"
          class="wow-talent-tree-canvas__link state-{{item.status}}"
          style="{{item.style}}"
        ></view>
      </view>
      <view class="wow-talent-tree-canvas__nodes">
        <view
          wx:for="{{normalizedNodes}}"
          wx:key="id"
          class="wow-talent-tree-canvas__node shape-{{item.shape}} state-{{item.status}} {{item.isSelected ? 'is-selected' : ''}} {{item.isGranted ? 'is-granted' : ''}} {{item.isLocked ? 'is-locked' : ''}}"
          style="{{item.style}}"
          data-id="{{item.id}}"
          data-shape="{{item.shape}}"
          data-status="{{item.status}}"
          bindtap="handleNodeTap"
        >
          <view class="wow-talent-tree-canvas__choice-affordance" wx:if="{{item.shape == 'choice'}}">
            <text>‹</text>
            <text>›</text>
          </view>
          <game-object-icon
            ext-class="wow-talent-tree-canvas__icon"
            object-type="talent"
            entity-id="{{item.id}}"
            display-name="{{item.title}}"
            icon-src="{{item.iconSrc}}"
            icon-name="{{item.iconName}}"
            fallback-text="{{item.fallbackText}}"
            status="{{item.iconSrc || item.iconName ? 'verified' : 'missing'}}"
            size="small"
            shape="{{item.shape == 'active' ? 'square' : 'circle'}}"
          ></game-object-icon>
          <view class="wow-talent-tree-canvas__rank">
            <text>{{item.rank}}/{{item.maxRank}}</text>
          </view>
          <text class="wow-talent-tree-canvas__node-title">{{item.shortTitle}}</text>
        </view>
      </view>
    </view>

    <view class="wow-talent-tree-canvas__actions">
      <action-button
        label="{{normalizedImportAction.label}}"
        tone="secondary"
        size="compact"
        disabled="{{normalizedImportAction.disabled}}"
        loading="{{normalizedImportAction.loading}}"
        bind:actiontap="handleImportTap"
      ></action-button>
      <action-button
        label="{{normalizedResetAction.label}}"
        tone="ghost"
        size="compact"
        disabled="{{normalizedResetAction.disabled}}"
        loading="{{normalizedResetAction.loading}}"
        bind:actiontap="handleResetTap"
      ></action-button>
      <action-button
        label="{{normalizedSaveAction.label}}"
        tone="{{normalizedState == 'blocked' ? 'danger' : 'primary'}}"
        size="default"
        disabled="{{normalizedSaveAction.disabled}}"
        loading="{{normalizedSaveAction.loading}}"
        bind:actiontap="handleSaveTap"
      ></action-button>
    </view>

    <evidence-ledger
      ext-class="wow-talent-tree-canvas__evidence"
      title="天赋证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
    ></evidence-ledger>
  </wow-panel>
</view>
