<view class="wow-simc-submit-surface {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-simc-submit-surface__hero"
    title="{{normalizedTitle}}"
    meta="{{normalizedMeta}}"
    material-src="{{heroMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-simc-submit-surface__status">
      <status-visual
        state="{{normalizedState}}"
        label="{{normalizedStateLabel}}"
        glyph="{{normalizedStateGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>
    <view class="wow-simc-submit-surface__identity">
      <game-object-icon
        ext-class="wow-simc-submit-surface__icon"
        object-type="spec"
        entity-id="{{profileId}}"
        display-name="{{profileLabel}}"
        icon-src="{{profileIconUrl}}"
        fallback-text="{{profileFallbackText}}"
        status="{{normalizedState}}"
        size="large"
      ></game-object-icon>
      <view class="wow-simc-submit-surface__copy">
        <text>{{profileLabel}}</text>
        <text>{{normalizedSummary}}</text>
      </view>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-simc-submit-surface__readiness"
    title="提交检查"
    meta="{{normalizedReadinessMeta}}"
    material-src="{{readinessMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view class="wow-simc-submit-surface__modules">
      <module-card
        wx:for="{{normalizedModules}}"
        wx:key="key"
        data-key="{{item.key}}"
        title="{{item.title}}"
        metric="{{item.metric}}"
        meta="{{item.meta}}"
        status="{{item.status}}"
        status-label="{{item.statusLabel}}"
        status-glyph="{{item.statusGlyph}}"
        icon-src="{{item.iconSrc}}"
        icon-text="{{item.iconText}}"
        disabled="{{item.disabled}}"
        bind:cardtap="handleModuleTap"
      ></module-card>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-simc-submit-surface__actions"
    title="下一步"
    meta="{{normalizedActionMeta}}"
    material-src="{{actionMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view class="wow-simc-submit-surface__action-row">
      <action-button
        label="{{normalizedPrimaryAction.label}}"
        tone="{{normalizedPrimaryAction.tone}}"
        size="large"
        block="{{true}}"
        disabled="{{normalizedPrimaryAction.disabled}}"
        loading="{{normalizedPrimaryAction.loading}}"
        bind:actiontap="handlePrimaryAction"
      ></action-button>
      <action-button
        label="{{normalizedSecondaryAction.label}}"
        tone="{{normalizedSecondaryAction.tone}}"
        size="compact"
        disabled="{{normalizedSecondaryAction.disabled}}"
        loading="{{normalizedSecondaryAction.loading}}"
        bind:actiontap="handleSecondaryAction"
      ></action-button>
    </view>
  </wow-panel>

  <wow-panel
    ext-class="wow-simc-submit-surface__evidence"
    title="SimC 证据"
    meta="{{normalizedEvidenceSummary}}"
    material-src="{{evidenceMaterialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <evidence-ledger
      title="SimC 证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
