.wow-news-home-surface {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.wow-news-home-surface__material {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.wow-news-home-surface > wow-panel {
  position: relative;
  z-index: 1;
}

.wow-news-home-surface__summary {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(238, 232, 216, 0.78);
  font-size: 24rpx;
  line-height: 1.45;
}

.wow-news-home-surface__state {
  min-width: 128rpx;
}
