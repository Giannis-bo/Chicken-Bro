<view class="wow-task-queue-board {{rootClass}} ext-class">
  <wow-panel
    ext-class="wow-task-queue-board__panel"
    title="{{title}}"
    meta="{{meta}}"
    material-src="{{materialSrc}}"
    material-mode="aspectFill"
    density="dense"
  >
    <view slot="action" class="wow-task-queue-board__head-status">
      <status-visual
        state="{{normalizedSurfaceVisualState}}"
        label="{{normalizedSurfaceLabel}}"
        glyph="{{normalizedSurfaceGlyph}}"
        size="compact"
        shape="seal"
        showLabel="{{true}}"
      ></status-visual>
    </view>

    <view class="wow-task-queue-board__status-rail">
      <view
        wx:for="{{normalizedStatusRail}}"
        wx:key="key"
        class="wow-task-queue-board__rail-item state-{{item.status}}"
      >
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>

    <view class="wow-task-queue-board__guest">
      <text>{{normalizedGuestLabel}}</text>
      <text>{{normalizedGuestMeta}}</text>
    </view>

    <view wx:if="{{normalizedSurfaceStatus == 'loading'}}" class="wow-task-queue-board__loading">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="wow-task-queue-board__skeleton"></view>
    </view>

    <view wx:elif="{{normalizedSurfaceStatus == 'blocked'}}" class="wow-task-queue-board__error">
      <status-visual state="blocked" label="读取失败" glyph="!" size="standard" shape="seal"></status-visual>
      <view class="wow-task-queue-board__empty-copy">
        <text>任务读取失败</text>
        <text>{{normalizedErrorText}}</text>
      </view>
      <action-button
        label="{{normalizedRetryAction.label}}"
        tone="secondary"
        size="compact"
        disabled="{{normalizedRetryAction.disabled}}"
        loading="{{normalizedRetryAction.loading}}"
        bind:actiontap="handleRetryTap"
      ></action-button>
    </view>

    <view wx:elif="{{normalizedSurfaceStatus == 'empty'}}" class="wow-task-queue-board__empty">
      <status-visual state="source_reference" label="暂无任务" glyph="空" size="standard" shape="seal"></status-visual>
      <view class="wow-task-queue-board__empty-copy">
        <text>{{normalizedEmptyTitle}}</text>
        <text>{{normalizedEmptyMeta}}</text>
      </view>
      <view class="wow-task-queue-board__actions">
        <action-button
          label="{{normalizedSimcAction.label}}"
          tone="{{normalizedSimcAction.tone}}"
          size="default"
          disabled="{{normalizedSimcAction.disabled}}"
          loading="{{normalizedSimcAction.loading}}"
          bind:actiontap="handleSimcTap"
        ></action-button>
        <action-button
          label="{{normalizedWorkbenchAction.label}}"
          tone="{{normalizedWorkbenchAction.tone}}"
          size="compact"
          disabled="{{normalizedWorkbenchAction.disabled}}"
          loading="{{normalizedWorkbenchAction.loading}}"
          bind:actiontap="handleWorkbenchTap"
        ></action-button>
      </view>
    </view>

    <view wx:else class="wow-task-queue-board__list">
      <view
        wx:for="{{normalizedTasks}}"
        wx:key="id"
        class="wow-task-queue-board__card state-{{item.status}} {{item.isPreview ? 'is-preview' : ''}}"
        data-task-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="handleTaskTap"
      >
        <view class="wow-task-queue-board__card-status">
          <status-visual
            state="{{item.visualState}}"
            label="{{item.statusLabel}}"
            glyph="{{item.statusGlyph}}"
            size="compact"
            shape="seal"
          ></status-visual>
        </view>
        <game-object-icon
          ext-class="wow-task-queue-board__card-icon"
          object-type="spec"
          entity-id="{{item.id}}"
          display-name="{{item.title}}"
          icon-src="{{item.iconSrc}}"
          icon-name="{{item.iconName}}"
          fallback-text="{{item.fallbackText}}"
          status="{{item.iconSrc || item.iconName ? 'verified' : 'source_reference'}}"
          size="medium"
          shape="round"
        ></game-object-icon>
        <view class="wow-task-queue-board__card-copy">
          <view class="wow-task-queue-board__card-title-line">
            <text>{{item.title}}</text>
            <text>{{item.statusLabel}}</text>
          </view>
          <text class="wow-task-queue-board__context">{{item.context}}</text>
          <text class="wow-task-queue-board__summary">{{item.summary}}</text>
          <view class="wow-task-queue-board__tags">
            <text wx:for="{{item.tags}}" wx:key="key" class="state-{{item.status}}">{{item.label}}</text>
          </view>
          <view class="wow-task-queue-board__time-row">
            <text>{{item.scenario}}</text>
            <text>{{item.updatedAt || item.createdAt}}</text>
          </view>
        </view>
        <text class="wow-task-queue-board__arrow">›</text>
      </view>
    </view>

    <evidence-ledger
      ext-class="wow-task-queue-board__evidence"
      title="任务证据"
      summary="{{normalizedEvidenceSummary}}"
      rows="{{normalizedEvidenceRows}}"
      expanded="{{evidenceExpanded}}"
      collapsed-rows="3"
      bind:toggle="handleEvidenceToggle"
      bind:rowtap="handleEvidenceRowTap"
    ></evidence-ledger>
  </wow-panel>
</view>
