{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/mini-taro/config/index.ts",
    "apps/mini-taro/src/app.config.ts",
    "apps/mini-taro/src/app.tsx",
    "apps/mini-taro/src/env.d.ts",
    "apps/mini-taro/src/components/**/*.ts",
    "apps/mini-taro/src/components/**/*.tsx",
    "apps/mini-taro/src/custom-tab-bar/**/*.ts",
    "apps/mini-taro/src/custom-tab-bar/**/*.tsx",
    "apps/mini-taro/src/features/**/*.ts",
    "apps/mini-taro/src/features/**/*.tsx",
    "apps/mini-taro/src/pages/auth/**/*.ts",
    "apps/mini-taro/src/pages/auth/**/*.tsx",
    "apps/mini-taro/src/pages/chickenbro/**/*.ts",
    "apps/mini-taro/src/pages/chickenbro/**/*.tsx",
    "apps/mini-taro/src/pages/simc/**/*.ts",
    "apps/mini-taro/src/pages/simc/**/*.tsx",
    "apps/mini-taro/src/platform/**/*.ts",
