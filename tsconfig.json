{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/mini-taro/config/index.ts",
    "apps/mini-taro/src/app.config.ts",
    "apps/mini-taro/src/app.tsx",
    "apps/mini-taro/src/env.d.ts",
    "apps/mini-taro/src/components/**/*.ts",
    "apps/mini-taro/src/components/**/*.tsx",
    "apps/mini-taro/src/features/chat/**/*.ts",
    "apps/mini-taro/src/features/chat/**/*.tsx",
    "apps/mini-taro/src/features/simc/**/*.ts",
    "apps/mini-taro/src/features/simc/**/*.tsx",
    "apps/mini-taro/src/features/help/faq-content.ts",
    "apps/mini-taro/src/features/auth/TestLoginForm.tsx",
    "apps/mini-taro/src/features/auth/test-login-mode.ts",
    "apps/mini-taro/src/pages/web/**/*.ts",
    "apps/mini-taro/src/pages/web/**/*.tsx",
    "apps/mini-taro/src/web/**/*.ts",
    "apps/mini-taro/src/web/**/*.tsx",
    "packages/api-client/src/api-v2-prefix.ts",
    "packages/api-client/src/auth-context*.ts",
    "packages/api-client/src/chat*.ts",
    "packages/api-client/src/clients.ts",
    "packages/api-client/src/index.ts",
    "packages/api-client/src/simc*.ts",
    "packages/api-client/src/storage.ts",
    "packages/api-client/src/transport*.ts",
    "packages/api-client/src/web-auth*.ts",
    "packages/domain/src/chat*.ts",
    "packages/domain/src/index.ts",
    "packages/domain/src/simc*.ts",
    "packages/domain/src/web-auth*.ts",
    "packages/types/**/*.d.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
