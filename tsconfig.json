{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/mini-taro/config/**/*.ts",
    "apps/mini-taro/src/**/*.ts",
    "apps/mini-taro/src/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
