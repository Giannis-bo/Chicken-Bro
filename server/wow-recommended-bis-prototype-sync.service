[Unit]
Description=WOW recommended_bis_v1 projected prototype sync
After=network-online.target wow-backend.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
ExecStart=/usr/bin/flock -w 1800 /run/lock/wow-mini-program-bis-prototype.lock /usr/bin/python3 /opt/wow-mini-program/server/recommended_bis_prototype_sync.py
TimeoutStartSec=45min
