[Unit]
Description=Chickenbro v2 Web Authentication API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-v2-api.env
Environment=WOW_APP_ENV=production
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_API_V2_HOST=127.0.0.1
Environment=WOW_API_V2_PORT=8790
ExecStart=/opt/wow-mini-program/.venv-v2/bin/python -m uvicorn server.app.main:app --host 127.0.0.1 --port 8790
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
