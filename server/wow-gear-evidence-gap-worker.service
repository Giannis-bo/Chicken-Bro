[Unit]
Description=Recover bounded immutable WOW gear evidence inputs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
ExecStart=/usr/bin/flock -n /run/lock/wow-gear-evidence-gap-worker.lock /usr/bin/python3 /opt/wow-mini-program/server/gear_evidence_gap_worker.py --json
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/lock
