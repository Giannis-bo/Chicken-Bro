[Unit]
Description=WOW Mini Program candidate backend (read-only preview)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wow-mini-program-candidate
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_NEWS_HOST=127.0.0.1
Environment=WOW_NEWS_PORT=8788
Environment=WOW_NEWS_ENABLE_COLLECTORS=0
Environment=WOW_NEWS_MAX_COLLECTED_ARTICLES=0
Environment="PGOPTIONS=-c default_transaction_read_only=on"
Environment=WOW_SIMC_BIN=/bin/false
Environment=WOW_SIMULATION_SNAPSHOT_V1_ENABLED=1
Environment=WOW_ATTRIBUTE_RULEBOOK_PREVIEW=1
ExecStart=/usr/bin/python3 /opt/wow-mini-program-candidate/server/news_backend.py
Restart=no
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=45
TimeoutStopSec=30
