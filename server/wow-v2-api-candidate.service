[Unit]
Description=Chickenbro v2 Web Authentication API candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wow-mini-program-candidate
EnvironmentFile=-/etc/wow-v2-api-candidate.env
Environment=WOW_APP_ENV=candidate
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_API_V2_HOST=127.0.0.1
Environment=WOW_API_V2_PORT=8791
Environment=WOW_WEB_ORIGIN=https://www.chickenbro.cloud
Environment=WOW_WEB_COOKIE_NAME=__Host-wow_v2_candidate
Environment=WOW_WEB_PROTOTYPE_ENABLED=1
Environment=WOW_WECHAT_PAGE=pages/auth/web-login-confirm
Environment=WOW_WECHAT_ENV_VERSION=trial
Environment=WOW_WECHAT_CHECK_PATH=0
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/wow-mini-program/.venv-v2/bin/python -m uvicorn server.app.main:app --host 127.0.0.1 --port 8791
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
