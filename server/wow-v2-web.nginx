server {
    listen 80;
    server_name www.chickenbro.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.chickenbro.cloud;

    ssl_certificate /etc/nginx/ssl/www.chickenbro.cloud/www.chickenbro.cloud_bundle.pem;
    ssl_certificate_key /etc/nginx/ssl/www.chickenbro.cloud/www.chickenbro.cloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/chickenbro-web/current;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location ^~ /api/v2/ {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_read_timeout 210s;
    }

    # The H5 build currently uses stable app.js/app.css URLs. Revalidate the
    # shell and bundles so a new candidate is not hidden behind browser cache.
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    location ~* \.(?:js|css)$ {
        expires -1;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
