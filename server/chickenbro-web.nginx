# This file contains additive candidate locations only. The deploy script
# installs the WWW section into the existing www.chickenbro.cloud server and
# the API section into the existing api.chickenbro.cloud server. It never
# replaces the production / or /api/v2/ owners during candidate verification.

# BEGIN CHICKENBRO CANDIDATE WWW
location = /web-candidate {
    return 302 /web-candidate/;
}

location ^~ /web-candidate/ {
    alias /var/www/chickenbro-candidate/current/;
    index index.html;
    rewrite ^/web-candidate/simc/?$ /web-candidate/index.html last;
    expires -1;
}

location ^~ /api/v2-candidate/ {
    proxy_pass http://127.0.0.1:8791/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_buffering off;
    proxy_read_timeout 540s;
}
# END CHICKENBRO CANDIDATE WWW

# BEGIN CHICKENBRO CANDIDATE API
location ^~ /api/v2-candidate/ {
    proxy_pass http://127.0.0.1:8791/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_buffering off;
    proxy_read_timeout 540s;
}
# END CHICKENBRO CANDIDATE API
