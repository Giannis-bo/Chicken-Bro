[Unit]
Description=Build and gate immutable WOW gear release candidates
After=network-online.target postgresql.service wow-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
ExecStart=/usr/bin/flock -n /run/lock/wow-gear-release-refresh.lock /usr/bin/python3 /opt/wow-mini-program/server/gear_release_refresh.py --json
TimeoutStartSec=20min
MemoryMax=2200M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
