[Unit]
Description=WOW community template sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_COMMUNITY_TEMPLATE_SYNC_MODE=scheduled
Environment=WOW_RAIDERIO_REGIONS=cn,tw,kr,us,eu
Environment=WOW_RAIDERIO_RUN_PAGES=8
Environment=WOW_RAIDERIO_SPEC_RANKING_ENABLED=1
Environment=WOW_RAIDERIO_SPEC_RANKING_REGIONS=world
Environment=WOW_RAIDERIO_SPEC_RANKING_PAGES=2
Environment=WOW_RAIDERIO_SPEC_RANKING_PAGE_SIZE=50
Environment=WOW_RAIDERIO_SPEC_RANKING_RUNS_PER_CHARACTER=1
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_ENABLED=1
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_REGIONS=cn,tw,kr,us,eu
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_PAGES=4
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_PAGE_SIZE=50
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_RUNS_PER_CHARACTER=1
Environment=WOW_RAIDERIO_PROFILE_LIMIT=1200
Environment=WOW_RAIDERIO_PROFILE_LIMIT_PER_SPEC=24
Environment=WOW_RAIDERIO_PROFILE_WORKERS=6
Environment=WOW_RAIDERIO_RUN_DETAIL_LIMIT=1400
Environment=WOW_RAIDERIO_RUN_DETAIL_LIMIT_PER_SPEC=32
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_LIMIT=1400
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_LIMIT_PER_SPEC=48
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_FRONTLOAD_PER_SPEC=32
Environment=WOW_RAIDERIO_RUN_DETAIL_WORKERS=6
Environment=WOW_RAIDERIO_TALENT_LOADOUT_LIMIT_PER_SPEC=24
Environment=WOW_RAIDERIO_COMMUNITY_TEMPLATE_LIMIT=1400
ExecStart=/usr/bin/flock -w 7200 /run/lock/wow-mini-program-sync.lock /usr/bin/python3 /opt/wow-mini-program/server/community_template_sync.py
TimeoutStartSec=180min
