[Unit]
Description=WOW community template daily incremental sync
After=network-online.target mihomo.service
Wants=network-online.target mihomo.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_COMMUNITY_TEMPLATE_SYNC_MODE=daily_incremental
Environment=WOW_COMMUNITY_DAILY_TIER=daily_targeted
Environment=WOW_COMMUNITY_DAILY_TALENT_MODE=missing_slots
Environment=WOW_COMMUNITY_DAILY_GEAR_MODE=gear_template_targeted_refresh
Environment=WOW_COMMUNITY_DAILY_GEAR_SKIP_WHEN_NO_TARGETS=1
Environment=WOW_COMMUNITY_DAILY_GEAR_REFRESH_RAIDERIO=1
Environment=WOW_RAIDERIO_REGIONS=cn,tw,kr,us,eu
Environment=WOW_RAIDERIO_RETRIES=3
Environment=WOW_RAIDERIO_RUN_PAGES=0
Environment=WOW_RAIDERIO_SPEC_RANKING_ENABLED=1
Environment=WOW_RAIDERIO_SPEC_RANKING_REGIONS=world
Environment=WOW_RAIDERIO_SPEC_RANKING_PAGES=2
Environment=WOW_RAIDERIO_SPEC_RANKING_PAGE_SIZE=50
Environment=WOW_RAIDERIO_SPEC_RANKING_RUNS_PER_CHARACTER=1
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_ENABLED=1
Environment=WOW_RAIDERIO_SPEC_RANKING_GAP_FILL_PAGES=1
Environment=WOW_RAIDERIO_PROFILE_LIMIT=160
Environment=WOW_RAIDERIO_PROFILE_LIMIT_PER_SPEC=24
Environment=WOW_RAIDERIO_PROFILE_WORKERS=4
Environment=WOW_RAIDERIO_RUN_DETAIL_LIMIT=160
Environment=WOW_RAIDERIO_RUN_DETAIL_LIMIT_PER_SPEC=4
Environment=WOW_COMMUNITY_TEMPLATE_TARGETED_RUN_DETAIL_LIMIT=240
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_LIMIT=160
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_LIMIT_PER_SPEC=4
Environment=WOW_RAIDERIO_GAP_FILL_RUN_DETAIL_FRONTLOAD_PER_SPEC=2
Environment=WOW_RAIDERIO_RUN_DETAIL_WORKERS=2
Environment=WOW_RAIDERIO_TALENT_LOADOUT_LIMIT_PER_SPEC=24
Environment=WOW_RAIDERIO_COMMUNITY_TEMPLATE_LIMIT=240
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_TARGET_LIMIT=1200
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_PROFILE_LIMIT=160
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_TIMEOUT_SECONDS=3600
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_SPEC_LIMIT=8
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_SIMC_STATS=1
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_FULL_PROFILE_GEAR=1
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_ITEM_PROBE_LIMIT=96
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_SPEC_RANKING_PAGES=2
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_SPEC_RANKING_PAGE_SIZE=50
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_PROFILE_LIMIT_PER_SPEC=24
Environment=WOW_COMMUNITY_GEAR_FIRST_SYNC_PROFILE_WORKERS=4
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=ALL_PROXY=socks5h://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost,::1,169.254.169.254,raider.io,.raider.io,cdn.raiderio.net,.raiderio.net
Environment=https_proxy=http://127.0.0.1:7890
Environment=http_proxy=http://127.0.0.1:7890
Environment=all_proxy=socks5h://127.0.0.1:7890
Environment=no_proxy=127.0.0.1,localhost,::1,169.254.169.254,raider.io,.raider.io,cdn.raiderio.net,.raiderio.net
MemoryHigh=768M
MemoryMax=1024M
ExecStart=/usr/bin/flock -w 7200 /run/lock/wow-mini-program-sync.lock /usr/bin/python3 /opt/wow-mini-program/server/community_template_sync.py
TimeoutStartSec=180min
