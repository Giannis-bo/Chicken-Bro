[Unit]
Description=Recover WOW talent graph with SimC and TraitEdge only
After=network-online.target mihomo.service
Wants=network-online.target mihomo.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_SIMC_BIN=/opt/wow-simc/current/simc
Environment=WOW_SIMC_VERSION_FILE=/var/lib/wow-backend/simc-version.json
Environment=WOW_WEBSIM_FETCH_WAGO_DB2=0
Environment=WOW_WEBSIM_FETCH_WAGO_DB2_TRAIT_EDGE=1
Environment=WOW_WEBSIM_FETCH_WAGO_DB2_LOCALIZATION=0
Environment=WOW_WAGO_DB2_BASE_URL=https://wago.tools/db2
Environment=WOW_WAGO_DB2_TRAIT_EDGE_TIMEOUT_SECONDS=20
Environment=WOW_WAGO_DB2_TRAIT_EDGE_MAX_BYTES=8388608
Environment=WOW_WAGO_DB2_TRAIT_EDGE_MAX_ROWS=50000
Environment=WOW_WEBSIM_SIMC_MIN_PARENT_COVERAGE_PERCENT=80
Environment=WOW_WEBSIM_SIMC_MIN_PROFILE_COVERAGE_PERCENT=80
Environment=WOW_WEBSIM_SIMC_MIN_BASELINE_RETENTION_PERCENT=80
Environment=WOW_WEBSIM_SKIP_BLIZZARD=1
Environment=WOW_WEBSIM_SKIP_RAIDERIO=1
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=ALL_PROXY=socks5h://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost,::1,169.254.169.254,wago.tools
Environment=https_proxy=http://127.0.0.1:7890
Environment=http_proxy=http://127.0.0.1:7890
Environment=all_proxy=socks5h://127.0.0.1:7890
Environment=no_proxy=127.0.0.1,localhost,::1,169.254.169.254,wago.tools
TimeoutStartSec=180min
ExecStart=/usr/bin/flock -w 7200 /run/lock/wow-mini-program-sync.lock /usr/bin/python3 /opt/wow-mini-program/server/websim_sync.py
