[Unit]
Description=Chickenbro SimC isolated candidate queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chickenbro-candidate
EnvironmentFile=-/etc/chickenbro-worker-candidate.env
Environment=PYTHONPATH=/opt/chickenbro-candidate
Environment=WOW_APP_ENV=candidate
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_SIMC_SUPPORTED_SPECS=shaman:elemental
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/rm -f -- /var/lib/chickenbro/candidate-worker-heartbeat.json
ExecStart=/opt/chickenbro-runtime/bin/python -m server.app.worker.main --worker-id chickenbro-simc-candidate-worker
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chickenbro
ReadOnlyPaths=/opt/chickenbro-candidate /opt/chickenbro-runtime /opt/wow-simc

[Install]
WantedBy=multi-user.target
