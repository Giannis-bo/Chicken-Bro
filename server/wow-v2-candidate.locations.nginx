# BEGIN CHICKENBRO V2 CANDIDATE
location = /web-candidate {
    return 301 /web-candidate/;
}

location = /web-candidate/ {
    alias /var/www/chickenbro-web-candidate/current/index.html;
    expires -1;
}

location ^~ /web-candidate/ {
    alias /var/www/chickenbro-web-candidate/current/;
    expires -1;
}

location ^~ /api/v2-candidate/ {
    proxy_pass http://127.0.0.1:8791/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_buffering off;
    proxy_read_timeout 210s;
}
# END CHICKENBRO V2 CANDIDATE
