[Unit]
Description=Refresh WOW WebSim data cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_NEWS_DB=/opt/wow-mini-program/server/data/wow_news.sqlite3
Environment=WOW_SIMC_BIN=/opt/wow-simc/current/simc
Environment=WOW_SIMC_VERSION_FILE=/var/lib/wow-backend/simc-version.json
Environment=WOW_WEBSIM_FETCH_WAGO_DB2=0
Environment=WOW_WEBSIM_FETCH_WAGO_DB2_TRAIT_EDGE=1
Environment=WOW_WEBSIM_FETCH_WAGO_DB2_LOCALIZATION=0
Environment=WOW_WAGO_DB2_TRAIT_EDGE_TIMEOUT_SECONDS=20
Environment=WOW_WEBSIM_SYNC_INSTANCE_LIMIT=20
Environment=WOW_WEBSIM_SYNC_RAID_INSTANCE_LIMIT=8
Environment=WOW_WEBSIM_SYNC_SPELL_LIMIT=40
Environment=WOW_WEBSIM_SYNC_ITEM_LIMIT=1200
Environment=WOW_WEBSIM_SYNC_ENCOUNTER_LIMIT=200
Environment=WOW_WEBSIM_SYNC_ITEM_SET_LIMIT=40
Environment=WOW_WEBSIM_SYNC_OBSERVED_ITEM_LIMIT=300
Environment=WOW_RAIDERIO_RUN_PAGES=20
Environment=WOW_RAIDERIO_PROFILE_LIMIT=160
Environment=WOW_RAIDERIO_PROFILE_LIMIT_PER_SPEC=4
Environment=WOW_RAIDERIO_PROFILE_WORKERS=8
Environment=WOW_RAIDERIO_TARGET_ITEM_LIMIT=500
Environment=WOW_RAIDERIO_TARGET_PROFILE_LIMIT=800
Environment=WOW_RAIDERIO_TIMEOUT_SECONDS=45
Environment=WOW_RAIDERIO_SYNC_DEADLINE_SECONDS=900
Environment=WOW_BLIZZARD_TIMEOUT_SECONDS=8
TimeoutStartSec=180min
ExecStart=/usr/bin/flock -w 7200 /run/lock/wow-mini-program-sync.lock /usr/bin/env WOW_WEBSIM_SYNC_INSTANCE_LIMIT=20 WOW_WEBSIM_SYNC_RAID_INSTANCE_LIMIT=8 WOW_WEBSIM_SYNC_ITEM_LIMIT=1200 WOW_WEBSIM_SYNC_ENCOUNTER_LIMIT=200 WOW_WEBSIM_SYNC_ITEM_SET_LIMIT=40 WOW_WEBSIM_SYNC_OBSERVED_ITEM_LIMIT=300 WOW_RAIDERIO_RUN_PAGES=20 WOW_RAIDERIO_PROFILE_LIMIT=160 WOW_RAIDERIO_PROFILE_LIMIT_PER_SPEC=4 WOW_RAIDERIO_PROFILE_WORKERS=8 WOW_RAIDERIO_TARGET_ITEM_LIMIT=500 WOW_RAIDERIO_TARGET_PROFILE_LIMIT=800 WOW_RAIDERIO_TIMEOUT_SECONDS=45 WOW_RAIDERIO_SYNC_DEADLINE_SECONDS=900 /usr/bin/python3 /opt/wow-mini-program/server/websim_sync.py
