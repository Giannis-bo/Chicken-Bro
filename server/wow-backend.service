[Unit]
Description=WOW Mini Program Unified Backend
After=network-online.target mihomo.service
Wants=network-online.target mihomo.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=WOW_NEWS_HOST=127.0.0.1
Environment=WOW_NEWS_PORT=8787
Environment=WOW_NEWS_ENABLE_COLLECTORS=1
Environment=WOW_NEWS_MAX_COLLECTED_ARTICLES=1
Environment=WOW_LLM_TIMEOUT_SECONDS=45
Environment=WOW_LLM_MODEL=deepseek-v4-flash
Environment=WOW_SIMC_BIN=/opt/wow-simc/current/simc
Environment=WOW_SIMC_VERSION_FILE=/var/lib/wow-backend/simc-version.json
Environment=WOW_SIMULATION_SNAPSHOT_V1_ENABLED=1
Environment=WOW_CODEX_BIN=/usr/local/bin/codex
Environment=WOW_CODEX_HOME=/home/ubuntu/.codex
Environment=WOW_CODEX_JOBS_DIR=/var/lib/wow-backend/codex-jobs
Environment=WOW_CODEX_SANDBOX=read-only
Environment=WOW_CHICKENBRO_CODEX_ENABLED=1
Environment=WOW_CHICKENBRO_NATIVE_AGENT_ENABLED=1
Environment=WOW_CHICKENBRO_AGENTIC_RESEARCH_ENABLED=0
Environment=WOW_CHICKENBRO_NATIVE_AGENT_PROFILE=chickenbro-native
Environment=WOW_CHICKENBRO_NATIVE_AGENT_MODEL=gpt-5.6-luna
Environment=WOW_CHICKENBRO_CODEX_TIMEOUT_SECONDS=75
# Explicit, public-only WCL target for retail Mythic+ community-strength coverage.
# This is intentionally separate from the generic WCL/template target: a change of
# season or encounter must be an explicit deployment decision, never a heuristic.
Environment=WOW_CHICKENBRO_WCL_PUBLIC_MPLUS_ENCOUNTER_ID=112526
Environment=WOW_CHICKENBRO_WCL_PUBLIC_MPLUS_PARTITION=1
Environment="WOW_CHICKENBRO_WCL_PUBLIC_MPLUS_SEASON_LABEL=Midnight Mythic+ Season 1 (WCL zone 47)"
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=ALL_PROXY=socks5h://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost,::1,169.254.169.254
Environment=https_proxy=http://127.0.0.1:7890
Environment=http_proxy=http://127.0.0.1:7890
Environment=all_proxy=socks5h://127.0.0.1:7890
Environment=no_proxy=127.0.0.1,localhost,::1,169.254.169.254
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/wow-mini-program/server/news_backend.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
