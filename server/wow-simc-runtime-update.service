[Unit]
Description=Update WOW SimulationCraft runtime
After=network-online.target mihomo.service
Wants=network-online.target mihomo.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wow-mini-program
EnvironmentFile=-/etc/wow-backend.env
Environment=WOW_DATABASE_RUNTIME=postgres_only
Environment=SIMC_GITHUB_REPO=simulationcraft/simc
Environment=SIMC_BRANCH=midnight
Environment=SIMC_ROOT=/opt/wow-simc
Environment=SIMC_BIN=/opt/wow-simc/current/simc
Environment=SIMC_COMMIT_FILE=/opt/wow-simc/.commit
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=ALL_PROXY=socks5h://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost,::1,169.254.169.254
Environment=https_proxy=http://127.0.0.1:7890
Environment=http_proxy=http://127.0.0.1:7890
Environment=all_proxy=socks5h://127.0.0.1:7890
Environment=no_proxy=127.0.0.1,localhost,::1,169.254.169.254
TimeoutStartSec=480min
ExecStart=/usr/bin/flock -w 21600 /run/lock/wow-mini-program-sync.lock /opt/wow-mini-program/server/simc_runtime_update.sh
