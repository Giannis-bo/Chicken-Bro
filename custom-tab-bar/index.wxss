.wow-tabbar {
  --wow-tabbar-height-local: var(--wow-tabbar-height, 132rpx);
  --wow-tabbar-bottom-local: var(--wow-tabbar-bottom, 0rpx);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: stretch;
  height: calc(var(--wow-tabbar-height-local) + env(safe-area-inset-bottom));
  min-height: calc(var(--wow-tabbar-height-local) + env(safe-area-inset-bottom));
  padding: 12rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(248, 183, 0, 0.2);
  border-right: 0;
  border-bottom: 0;
  border-left: 0;
  border-radius: 0;
  background:
    linear-gradient(180deg, rgba(19, 17, 13, 0.98), rgba(5, 5, 5, 0.99)),
    #080808;
  box-shadow:
    0 -16rpx 34rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.035);
}

.wow-tabbar__rail {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 8rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  z-index: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.08), transparent 40%),
    linear-gradient(90deg, rgba(248, 183, 0, 0.035), transparent 22%, transparent 78%, rgba(248, 183, 0, 0.035));
  pointer-events: none;
}

.wow-tabbar__item {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-rows: 54rpx 32rpx;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  min-width: 0;
  min-height: 100rpx;
  padding: 2rpx 2rpx 4rpx;
  overflow: hidden;
  color: #8e8e8e;
  font-weight: 900;
  box-sizing: border-box;
}

.wow-tabbar__item.is-selected {
  color: #f8b700;
}

.wow-tabbar__item.is-selected::before {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 3rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(248, 183, 0, 0.86), transparent);
  box-shadow: 0 0 16rpx rgba(248, 183, 0, 0.42);
}

.wow-tabbar__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  overflow: hidden;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 35%, rgba(248, 183, 0, 0.14), rgba(0, 0, 0, 0.72) 72%),
    #050504;
  box-shadow:
    0 0 0 1rpx rgba(248, 183, 0, 0.08),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.035);
}

.wow-tabbar__icon {
  display: block;
  width: 38rpx;
  height: 38rpx;
  opacity: 0.86;
}

.wow-tabbar__glyph {
  display: block;
  width: 38rpx;
  height: 38rpx;
  color: currentColor;
  font-size: 26rpx;
  font-weight: 1000;
  line-height: 38rpx;
  text-align: center;
  letter-spacing: 0;
  text-shadow: 0 0 14rpx rgba(248, 183, 0, 0.18);
}

.wow-tabbar__item.is-selected .wow-tabbar__icon-shell {
  background:
    radial-gradient(circle at 50% 35%, rgba(248, 183, 0, 0.28), rgba(0, 0, 0, 0.72) 74%),
    #050504;
  box-shadow:
    0 0 0 1rpx rgba(248, 183, 0, 0.18),
    0 0 22rpx rgba(248, 183, 0, 0.18),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.05);
}

.wow-tabbar__item.is-selected .wow-tabbar__icon {
  opacity: 1;
}

.wow-tabbar__label {
  display: block;
  max-width: 132rpx;
  overflow: hidden;
  color: currentColor;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
