{
  "name": "wow-mini-program-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "capture:ui-review-cache": "node scripts/capture-ui-review-cache.js",
    "build:ui-review-index": "node scripts/build-ui-review-index.js",
    "promote:ui-review-cache": "node scripts/promote-ui-review-cache.js",
    "audit:ui-architecture": "node scripts/audit-ui-architecture.js",
    "audit:taro-domain": "node scripts/audit-taro-request-domain.js",
    "audit:taro-domain:probe": "node scripts/audit-taro-request-domain.js --probe",
    "build:weapp": "npm --workspace @wow-mini/mini-taro run build:weapp",
    "build:weapp:release": "NODE_ENV=production WOW_TARO_ISOLATED_BUILD=1 WOW_ASSET_RUNTIME_ROOT=https://static.chickenbro.cloud/wow-assets/releases/2026-07-18-ui-v2 WOW_RUNTIME_MEDIA_ROOT=https://static.chickenbro.cloud/wow-media/releases/2026-07-19-wow-icons-v1 WOW_BACKEND_API_BASE_URL=https://api.chickenbro.cloud WOW_WECHAT_REQUEST_DOMAIN_APPROVED=yes npm run build:weapp",
    "dev:weapp": "npm --workspace @wow-mini/mini-taro run dev:weapp",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages vitest.config.ts --max-warnings=0",
    "test:taro": "vitest run",
    "verify:ui-baselines": "node scripts/verify-ui-baselines.js",
    "verify:ui-interactions": "node scripts/verify-ui-interactions.js",
    "promote:ui-interactions": "node scripts/promote-ui-interaction-review.js",
    "verify:ui-route-geometry": "node scripts/verify-ui-route-geometry.js",
    "promote:ui-route-geometry": "node scripts/promote-ui-route-geometry.js",
    "compare:ui-runtime-regions": "node scripts/compare-ui-runtime-regions.js",
    "promote:ui-region-comparison": "node scripts/promote-ui-region-comparison.js",
    "verify:ui-selected-states": "node scripts/verify-ui-selected-states.js",
    "promote:ui-selected-states": "node scripts/promote-ui-selected-state-review.js",
    "verify:ui-asset-slots": "node scripts/verify-ui-asset-slots.js",
    "promote:ui-asset-slots": "node scripts/promote-ui-asset-slot-review.js",
    "verify:ui-package": "node scripts/verify-ui-package.js",
    "verify:ui-package:release": "node scripts/verify-ui-package.js --require-production-ready",
    "verify:ui-asset-integrity": "node scripts/verify-ui-asset-integrity.js",
    "generate:weapp-vector-runtime": "node scripts/generate-weapp-vector-runtime.js",
    "prepare:ui-cdn": "node scripts/publish-ui-cdn-assets.js prepare",
    "publish:ui-cdn": "node scripts/publish-ui-cdn-assets.js publish",
    "verify:ui-cdn": "node scripts/publish-ui-cdn-assets.js verify",
    "prepare:runtime-media": "node scripts/publish-runtime-media.js prepare",
    "publish:runtime-media": "node scripts/publish-runtime-media.js publish",
    "verify:runtime-media": "node scripts/publish-runtime-media.js verify"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "1.18.8",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "miniprogram-automator": "^0.12.1",
    "playwright-core": "1.61.1",
    "sass": "1.101.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.10"
  }
}
