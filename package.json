{
  "name": "wow-mini-program-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "capture:ui-review-cache": "node scripts/capture-ui-review-cache.js",
    "promote:ui-review-cache": "node scripts/promote-ui-review-cache.js",
    "audit:ui-architecture": "node scripts/audit-ui-architecture.js",
    "audit:taro-domain": "node scripts/audit-taro-request-domain.js",
    "audit:taro-domain:probe": "node scripts/audit-taro-request-domain.js --probe",
    "build:weapp": "npm --workspace @wow-mini/mini-taro run build:weapp",
    "dev:weapp": "npm --workspace @wow-mini/mini-taro run dev:weapp",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages vitest.config.ts --max-warnings=0",
    "test:taro": "vitest run",
    "verify:ui-baselines": "node scripts/verify-ui-baselines.js",
    "verify:ui-interactions": "node scripts/verify-ui-interactions.js",
    "verify:ui-route-geometry": "node scripts/verify-ui-route-geometry.js",
    "compare:ui-runtime-regions": "node scripts/compare-ui-runtime-regions.js",
    "promote:ui-region-comparison": "node scripts/promote-ui-region-comparison.js",
    "verify:ui-selected-states": "node scripts/verify-ui-selected-states.js",
    "verify:ui-package": "node scripts/verify-ui-package.js"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "1.18.8",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "miniprogram-automator": "^0.12.1",
    "playwright-core": "1.61.1",
    "sass": "1.101.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.10"
  }
}
