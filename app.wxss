/**app.wxss**/
page {
  height: 100vh;
  min-height: 100vh;
  background: #060606;
  color: #e1e2e5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page-shell {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #060606;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.page-content {
  padding: 24rpx 28rpx 56rpx;
}

.hero {
  position: relative;
  padding: 32rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 16rpx;
  background: #111111;
  color: #ffffff;
}

.hero::after {
  content: "";
  position: absolute;
  right: -82rpx;
  bottom: -108rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(139, 63, 245, 0.2);
}

.hero-kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 24rpx;
  font-size: 46rpx;
  line-height: 1.15;
  font-weight: 800;
}

.hero-desc {
  position: relative;
  z-index: 1;
  display: block;
  width: 86%;
  margin-top: 18rpx;
  color: rgba(225, 226, 229, 0.76);
  font-size: 26rpx;
  line-height: 1.55;
}

.metrics {
  display: flex;
  margin-top: 24rpx;
}

.metric-card,
.section,
.task-card,
.profile-card {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.metric-card {
  flex: 1;
  min-height: 132rpx;
  padding: 22rpx 18rpx;
}

.metric-card + .metric-card {
  margin-left: 16rpx;
}

.metric-value {
  display: block;
  color: #f8b700;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
}

.metric-label {
  display: block;
  margin-top: 16rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  line-height: 1.35;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  color: #f1f1f1;
  font-size: 30rpx;
  font-weight: 800;
}

.section-action {
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.quick-item {
  width: calc(50% - 16rpx);
  min-height: 132rpx;
  margin: 8rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
}

.quick-title {
  display: block;
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 800;
}

.quick-desc {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.42;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  padding: 24rpx;
}

.task-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.task-title {
  flex: 1;
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.task-status {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.18);
  color: #b78aff;
  font-size: 22rpx;
  font-weight: 700;
}

.task-desc {
  display: block;
  margin-top: 12rpx;
  color: #a7a7a7;
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-card {
  margin-top: 24rpx;
  padding: 30rpx;
}
