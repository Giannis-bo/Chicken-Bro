/**app.wxss**/
page {
  min-height: 100vh;
  background: #f4f1e8;
  color: #211a15;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f1e8;
}

.page-scroll {
  flex: 1;
  overflow-y: hidden;
}

.page-content {
  padding: 28rpx 32rpx 56rpx;
}

.hero {
  position: relative;
  padding: 36rpx 34rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #192436;
  color: #ffffff;
}

.hero::after {
  content: "";
  position: absolute;
  right: -76rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 218, 112, 0.28);
}

.hero-kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 26rpx;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 700;
}

.hero-desc {
  position: relative;
  z-index: 1;
  display: block;
  width: 86%;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.55;
}

.metrics {
  display: flex;
  margin-top: 24rpx;
}

.metric-card,
.section,
.task-card,
.profile-card {
  border: 1rpx solid rgba(47, 34, 24, 0.08);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(47, 34, 24, 0.06);
}

.metric-card {
  flex: 1;
  min-height: 144rpx;
  padding: 24rpx 18rpx;
}

.metric-card + .metric-card {
  margin-left: 16rpx;
}

.metric-value {
  display: block;
  color: #b36b16;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 700;
}

.metric-label {
  display: block;
  margin-top: 16rpx;
  color: #7b7468;
  font-size: 22rpx;
  line-height: 1.35;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  color: #211a15;
  font-size: 30rpx;
  font-weight: 700;
}

.section-action {
  color: #b36b16;
  font-size: 24rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.quick-item {
  width: calc(50% - 16rpx);
  min-height: 132rpx;
  margin: 8rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fbf5e7;
}

.quick-title {
  display: block;
  color: #2c2119;
  font-size: 27rpx;
  font-weight: 700;
}

.quick-desc {
  display: block;
  margin-top: 10rpx;
  color: #7b7468;
  font-size: 23rpx;
  line-height: 1.42;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  padding: 24rpx;
}

.task-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.task-title {
  flex: 1;
  color: #211a15;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.task-status {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0c4;
  color: #80510d;
  font-size: 22rpx;
}

.task-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b7468;
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-card {
  margin-top: 24rpx;
  padding: 30rpx;
}
