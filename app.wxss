/**app.wxss**/
page {
  --wow-bg: #060606;
  --wow-surface: #101010;
  --wow-panel: #151515;
  --wow-panel-warm: #17120d;
  --wow-iron: #21170f;
  --wow-gold: #f8b700;
  --wow-text: #e1e2e5;
  --wow-text-strong: #ffffff;
  --wow-text-muted: #9a9a9a;
  --wow-border: rgba(255, 255, 255, 0.08);
  --wow-gold-border: rgba(248, 183, 0, 0.28);
  --wow-verified: #58c98e;
  --wow-reference: #54c0ff;
  --wow-blocked: #ff6b64;
  --wow-stale: #ff8c80;
  height: 100vh;
  min-height: 100vh;
  background: #060606;
  background: var(--wow-bg);
  color: #e1e2e5;
  color: var(--wow-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page-shell {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #060606;
  background: var(--wow-bg);
}

.page-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.page-content {
  padding: 22rpx 24rpx 56rpx;
}

.hero {
  position: relative;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border: 1rpx solid var(--wow-gold-border);
  border-radius: 12rpx;
  background: linear-gradient(135deg, #101010 0%, #17120d 66%, #21170f 100%);
  color: #ffffff;
  color: var(--wow-text-strong);
}

.hero::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, rgba(248, 183, 0, 0.46), rgba(248, 183, 0, 0));
}

.hero-kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 16rpx;
  font-size: 38rpx;
  line-height: 1.16;
  font-weight: 800;
}

.hero-desc {
  position: relative;
  z-index: 1;
  display: block;
  width: 92%;
  margin-top: 10rpx;
  color: rgba(225, 226, 229, 0.76);
  font-size: 24rpx;
  line-height: 1.42;
}

.metrics {
  display: flex;
  margin-top: 18rpx;
}

.metric-card,
.section,
.task-card,
.profile-card {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--wow-border);
  border-radius: 12rpx;
  background: #151515;
  background: var(--wow-panel);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.24);
}

.metric-card {
  flex: 1;
  min-height: 112rpx;
  padding: 18rpx 16rpx;
}

.metric-card + .metric-card {
  margin-left: 14rpx;
}

.metric-value {
  display: block;
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 32rpx;
  line-height: 1;
  font-weight: 800;
}

.metric-label {
  display: block;
  margin-top: 10rpx;
  color: #9a9a9a;
  color: var(--wow-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.section {
  margin-top: 18rpx;
  padding: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.section-title {
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 800;
}

.section-action {
  flex: none;
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 24rpx;
  font-weight: 700;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.quick-item {
  width: calc(50% - 16rpx);
  min-height: 112rpx;
  margin: 8rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--wow-border);
  border-radius: 12rpx;
  background: #101010;
  background: var(--wow-surface);
}

.quick-title {
  display: block;
  color: #f1f1f1;
  font-size: 26rpx;
  font-weight: 800;
}

.quick-desc {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.38;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-card {
  padding: 18rpx;
}

.task-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  flex: 1;
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.32;
}

.task-status {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 22rpx;
  font-weight: 700;
}

.task-desc {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.42;
}

.profile-card {
  margin-top: 18rpx;
  padding: 20rpx;
}
