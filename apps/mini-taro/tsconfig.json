{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@tarojs/taro", "@types/webpack-env"]
  },
  "include": [
    "../../packages/types/**/*.d.ts",
    "config/index.ts",
    "src/app.config.ts",
    "src/app.tsx",
    "src/env.d.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/chat/**/*.ts",
    "src/features/chat/**/*.tsx",
    "src/features/simc/**/*.ts",
    "src/features/simc/**/*.tsx",
    "src/features/help/faq-content.ts",
    "src/features/auth/TestLoginForm.tsx",
    "src/features/auth/test-login-mode.ts",
    "src/pages/web/**/*.ts",
    "src/pages/web/**/*.tsx",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/env.d.ts"
  ]
}
