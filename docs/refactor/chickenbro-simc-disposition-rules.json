    {
      "id": "target-ui-design-inputs",
      "disposition": "migrate",
      "category": "target-design-migration",
      "owner": "Two-capability dual-client UX",
      "reason": "Existing Chickenbro and SimC interaction evidence may be migrated into the new two-capability design authority.",
      "prefixes": [
        "docs/design/current-ui/routes/chickenbro-chat/",
        "docs/design/current-ui/routes/simc-submit/",
        "docs/design/current-ui/routes/simulator-home/",
        "docs/design/current-ui/routes/task-detail/",
        "docs/design/current-ui/routes/tasks-list/"
