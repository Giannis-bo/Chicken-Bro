        "server/deploy_web_v2_candidate_lighthouse.sh",
        "server/deploy_web_v2_lighthouse.sh",
        "server/requirements-v2.txt",
        "server/wow-v2-api-candidate.service",
        "server/wow-v2-api.service",
        "server/wow-v2-candidate-api.locations.nginx",
        "server/wow-v2-candidate.locations.nginx",
        "server/wow-v2-web.nginx",
        "server/wow-v2-worker.service"
      ]
    },
    {
      "id": "remaining-server-migration-inputs",
      "disposition": "migrate",
      "category": "server-dependency-review",
      "owner": "Target caller-graph review",
      "reason": "Potential Chickenbro, SimC, data, deployment, or dependency inputs require caller proof before keep or delete.",
      "prefixes": [
        "server/"
      ]
    },
    {
      "id": "api-client-prototype",
      "disposition": "delete",
