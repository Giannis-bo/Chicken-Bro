    {
      "id": "legacy-product-documentation",
      "disposition": "delete",
      "category": "legacy-documentation",
      "owner": "Documentation retirement",
      "reason": "News, builds, gear, template, and old UI runbooks are outside the approved product.",
      "paths": [
        "docs/builds-architecture.md",
        "docs/community-template-import-full-chain-runbook.md",
