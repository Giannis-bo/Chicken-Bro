      "disposition": "migrate",
      "category": "shared-dependency-review",
      "owner": "Dual-client shared packages",
      "reason": "Shared API, domain, design, assets, and type code must be reduced using target caller proof.",
      "prefixes": [
        "packages/"
      ]
    },
    {
