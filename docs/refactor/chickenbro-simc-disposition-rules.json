        "packages/api-client/src/transport.test.ts",
        "packages/api-client/src/transport.ts",
        "packages/api-client/src/web-auth.test.ts",
        "packages/api-client/src/web-auth.ts",
        "packages/domain/src/chat.test.ts",
        "packages/domain/src/chat.ts",
        "packages/domain/src/platform-v2.test.ts",
        "packages/domain/src/platform-v2.ts",
        "packages/domain/src/simc.test.ts",
        "packages/domain/src/simc.ts",
        "packages/domain/src/web-auth.test.ts",
        "packages/domain/src/web-auth.ts"
