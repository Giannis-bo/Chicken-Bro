    },
    {
      "id": "target-chickenbro-deployment",
      "disposition": "keep",
      "category": "target-deployment-code",
      "owner": "Chickenbro and SimC runtime",
      "reason": "The isolated Chickenbro services, Nginx owner, candidate acceptance, deploy, provision, and cutover tooling are the current runtime authority.",
      "paths": [
        "server/accept_chickenbro_candidate.py",
        "server/chickenbro-api-candidate.service",
        "server/chickenbro-api.service",
        "server/chickenbro-web.nginx",
        "server/chickenbro-worker-candidate.service",
        "server/chickenbro-worker.service",
        "server/chickenbro_simc_cloud_inventory.py",
        "server/cutover_chickenbro_lighthouse.sh",
        "server/deploy_chickenbro_candidate_lighthouse.sh",
        "server/provision_chickenbro_database_lighthouse.sh"
      ]
    },
    {
      "id": "superseded-v2-deployment-inputs",
      "disposition": "delete",
      "category": "legacy-deployment-code",
      "owner": "Legacy v2 runtime retirement",
      "reason": "The generic v2 candidate and production owners are superseded by the isolated Chickenbro runtime.",
