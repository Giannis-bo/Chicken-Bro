    {
      "id": "remaining-documentation-migration",
      "disposition": "migrate",
      "category": "documentation-review",
      "owner": "Rebuild documentation",
      "reason": "Stable architecture and operations material must be rewritten or retired against the new product boundary.",
      "prefixes": [
        "docs/"
      ]
    },
    {
      "id": "historical-release-artifacts",
      "disposition": "delete",
      "category": "historical-evidence",
      "owner": "Artifact retirement",
      "reason": "Historical release packets are removed from the working tree; Git history remains the archive.",
      "prefixes": [
        "artifacts/"
      ]
    },
    {
      "id": "current-and-migration-tests",
      "disposition": "migrate",
      "category": "test-dependency-review",
      "owner": "Target verification suite",
      "reason": "Tests are retained until caller and behavior mapping proves which target contracts remain.",
      "prefixes": [
        "tests/"
      ]
    },
    {
      "id": "current-and-migration-scripts",
      "disposition": "migrate",
      "category": "tooling-dependency-review",
      "owner": "Harness and target operations",
      "reason": "Harness and operational scripts are retained until target callers and deployment owners are proven.",
      "prefixes": [
        "scripts/"
      ]
    },
    {
      "id": "github-workflows",
      "disposition": "migrate",
      "category": "repository-tooling",
      "owner": "Target CI",
      "reason": "CI must be reduced to the new target verification and release packet.",
      "prefixes": [
        ".github/"
      ]
    },
    {
      "id": "repository-scaffold",
      "disposition": "migrate",
      "category": "repository-tooling",
      "owner": "Target workspace",
      "reason": "Repository policy, package, TypeScript, lint, and build configuration must be reconciled with the reduced product.",
      "paths": [
        ".eslintrc.js",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        "Agent.md",
        "DESIGN.md",
        "README.md",
        "eslint.config.mjs",
        "package-lock.json",
        "package.json",
        "project.config.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts"
      ]
    }
