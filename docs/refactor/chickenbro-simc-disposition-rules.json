{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "rebuild-control-plane",
      "disposition": "keep",
      "category": "current-control-plane",
      "owner": "Harness and rebuild roadmap",
      "reason": "Current approved product direction, executable phase plans, and machine-readable state.",
      "paths": [
        "docs/harness.md",
        "docs/plans/README.md",
        "docs/project-state.json",
        "docs/roadmap.md",
        "docs/roadmap/ideas.md",
        "docs/schemas/harness-evidence.schema.json",
        "docs/schemas/harness-requirement.schema.json",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-01-control-plane.md",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-02-identity-data.md",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-03-chat.md",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-04-simc.md",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-05-dual-client-migration-cutover.md",
        "docs/superpowers/plans/2026-09-02-chickenbro-simc-rebuild-06-legacy-retirement.md",
        "docs/superpowers/specs/2026-09-02-chickenbro-simc-total-rebuild-design.md"
      ]
    },
    {
      "id": "rebuild-inventory-owner",
      "disposition": "keep",
      "category": "current-control-plane",
      "owner": "Refactor inventory",
      "reason": "Deterministic disposition rules, generator, and focused verification.",
      "paths": [
        "docs/refactor/chickenbro-simc-disposition-rules.json",
        "scripts/apply-chickenbro-simc-local-cleanup.js",
        "scripts/build-chickenbro-simc-refactor-inventory.js",
        "tests/chickenbro-simc-local-cleanup.test.js",
        "tests/chickenbro-simc-refactor-inventory.test.js"
      ]
    },
    {
      "id": "current-rebuild-release-packet",
      "disposition": "keep",
      "category": "current-release-evidence",
      "owner": "Harness release packet",
      "reason": "Evidence and requirements for the currently executing rebuild.",
      "prefixes": [
        "artifacts/releases/2026-09-02-chickenbro-simc-control-plane/",
        "artifacts/releases/2026-09-02-chickenbro-simc-dual-client-cutover/",
        "artifacts/releases/2026-09-02-chickenbro-simc-identity-data/",
        "artifacts/releases/2026-09-02-chickenbro-simc-legacy-retirement/"
      ]
    },
    {
      "id": "mini-client-legacy-simulator-routes",
      "disposition": "delete",
      "category": "legacy-client-code",
      "owner": "Mini Program retirement",
      "reason": "The superseded simulator route family is replaced by the formal Chickenbro and SimC pages.",
      "prefixes": [
        "apps/mini-taro/src/pages/simulator/"
      ]
    },
    {
      "id": "mini-client-legacy-builds",
      "disposition": "delete",
      "category": "legacy-client-code",
      "owner": "Mini Program retirement",
      "reason": "Builds, gear, and talent surfaces are outside the approved two-capability product.",
      "prefixes": [
        "apps/mini-taro/src/pages/builds/"
      ]
    },
    {
      "id": "mini-client-legacy-news",
      "disposition": "delete",
      "category": "legacy-client-code",
      "owner": "Mini Program retirement",
      "reason": "News is outside the approved two-capability product.",
      "prefixes": [
        "apps/mini-taro/src/pages/news/"
      ]
    },
    {
      "id": "mini-client-legacy-profile",
      "disposition": "delete",
      "category": "legacy-client-code",
      "owner": "Mini Program retirement",
      "reason": "The legacy profile/template surface is outside the approved product.",
      "prefixes": [
        "apps/mini-taro/src/pages/profile/"
      ]
    },
    {
      "id": "mini-client-legacy-build-context",
      "disposition": "delete",
      "category": "legacy-client-code",
      "owner": "Mini Program retirement",
      "reason": "Build-context state belongs to retired builds and gear journeys.",
      "paths": [
        "apps/mini-taro/src/pages/_shared/build-context-storage.ts",
        "apps/mini-taro/src/pages/_shared/build-context.test.ts",
        "apps/mini-taro/src/pages/_shared/build-context.ts"
      ]
    },
    {
      "id": "web-prototype-panel",
      "disposition": "delete",
      "category": "prototype-client-code",
      "owner": "Web prototype retirement",
      "reason": "Visible prototype bypass and panel are not an accepted login or product surface.",
      "paths": [
        "apps/mini-taro/src/web/PrototypePanel.module.scss",
        "apps/mini-taro/src/web/PrototypePanel.tsx"
      ]
    },
    {
      "id": "mini-client-auth-owner",
      "disposition": "keep",
      "category": "target-client-code",
      "owner": "Mini-assisted Web login",
      "reason": "Mini Program confirmation is the trust root for Web sessions.",
      "prefixes": [
        "apps/mini-taro/src/pages/auth/"
      ]
    },
    {
      "id": "mini-client-core-capabilities",
      "disposition": "keep",
      "category": "target-client-code",
      "owner": "Chickenbro and SimC Mini Program",
      "reason": "Conversation, SimC submission, task list, and task detail are the approved product capabilities.",
      "prefixes": [
        "apps/mini-taro/src/features/",
        "apps/mini-taro/src/pages/chickenbro/",
        "apps/mini-taro/src/pages/simc/",
        "apps/mini-taro/src/web/"
      ]
    },
    {
      "id": "mini-client-shell-migration",
      "disposition": "migrate",
      "category": "target-client-migration",
      "owner": "Shared Taro dual-client shell",
      "reason": "Shared routing, tab, transport, and Web shell must be reduced to the two-capability contract.",
      "prefixes": [
        "apps/"
      ]
    },
    {
      "id": "server-prototype-route",
      "disposition": "delete",
      "category": "prototype-server-code",
      "owner": "Prototype retirement",
      "reason": "Prototype bypass sessions and routes are not part of real Mini-assisted Web authentication.",
      "paths": [
        "server/app/api/routes/prototype.py",
        "server/app/identity/prototype.py"
      ]
    },
    {
      "id": "target-product-schema-and-migration",
      "disposition": "keep",
      "category": "target-database-code",
      "owner": "Canonical Chickenbro PostgreSQL schema",
      "reason": "The clean schema, allowlisted legacy copier, and reconciliation owners are the current migration authority.",
      "prefixes": [
        "server/migrations/product/"
      ]
    },
    {
      "id": "server-target-domain-owners",
      "disposition": "keep",
      "category": "target-server-code",
      "owner": "Modular v2 application",
      "reason": "Identity, Chickenbro, SimC, worker, platform, and integration owners form the new server core.",
      "prefixes": [
        "server/app/chickenbro/",
        "server/app/identity/",
        "server/app/integrations/",
        "server/app/platform/",
        "server/app/simulation/",
        "server/app/worker/"
      ]
    },
    {
      "id": "server-target-api-shell",
      "disposition": "migrate",
      "category": "target-server-migration",
      "owner": "Modular v2 API",
      "reason": "The API shell must be completed and restricted to identity, conversation, SimC, health, and operations.",
      "prefixes": [
        "server/app/api/"
      ],
      "paths": [
        "server/app/__init__.py",
        "server/app/main.py"
      ]
    },
    {
      "id": "identity-and-platform-migration-inputs",
      "disposition": "migrate",
      "category": "database-migration-input",
      "owner": "Canonical PostgreSQL v2 schema",
      "reason": "Foundation and real Web-login schema are inputs to the new clean migration chain.",
      "paths": [
        "server/migrations/postgres/0038_chickenbro_simc_platform_foundation.sql",
        "server/migrations/postgres/0039_wechat_web_login_sessions.sql",
        "server/migrations/postgres/data_copy_plan.py",
        "server/migrations/postgres/identity_shadow_plan.py",
        "server/migrations/postgres/shadow_migrate.py"
      ]
    },
    {
      "id": "prototype-database-migration",
      "disposition": "delete",
      "category": "prototype-database-code",
      "owner": "Prototype retirement",
      "reason": "Prototype sessions must not survive into the clean migration chain.",
      "paths": [
        "server/migrations/postgres/0040_web_prototype_sessions.sql"
      ]
    },
    {
      "id": "legacy-database-migrations",
      "disposition": "delete",
      "category": "legacy-database-code",
      "owner": "Clean-schema rebuild",
      "reason": "The historical migration chain is replaced by a clean canonical schema after data migration proof.",
      "prefixes": [
        "server/migrations/postgres/"
      ]
    },
    {
      "id": "legacy-news-server",
      "disposition": "delete",
      "category": "legacy-server-code",
      "owner": "News retirement",
      "reason": "News collection, translation, payloads, and storage are outside the approved product.",
      "prefixes": [
        "server/news/",
        "server/news_sources/"
      ],
      "paths": [
        "server/news_backend.py",
        "server/news_collector.py",
        "server/news_translator.py"
      ]
    },
    {
      "id": "legacy-build-payload-server",
      "disposition": "delete",
      "category": "legacy-server-code",
      "owner": "Builds retirement",
      "reason": "Legacy builds and PvE home payload surfaces are outside the approved product.",
      "prefixes": [
        "server/builds/",
        "server/pve/"
      ]
    },
    {
      "id": "legacy-websim-server",
      "disposition": "delete",
      "category": "legacy-server-code",
      "owner": "WebSim retirement",
      "reason": "WebSim synchronization and payload contracts are superseded by canonical SimC jobs.",
