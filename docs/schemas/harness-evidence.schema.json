{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/schemas/harness-evidence.schema.json",
  "title": "Harness Evidence Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "slug",
    "requirementSlug",
    "status",
    "highestEvidenceLevel",
    "branch",
    "commit",
    "scope",
    "verification",
    "candidateDeployment",
    "runtimeEvidence",
    "risks",
    "rollback",
    "cleanup",
    "archivedReferences",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "requirementSlug": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "requirement_challenged",
        "requirement_contract_approved",
        "implementation_allowed",
        "local_verified",
        "runtime_verified",
        "deployable",
        "live_verified",
        "archived"
      ]
    },
    "highestEvidenceLevel": {
      "type": "string",
      "enum": [
        "requirement_challenged",
        "requirement_contract_approved",
        "implementation_allowed",
        "local_verified",
        "runtime_verified",
        "deployable",
        "live_verified",
        "archived"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "candidateDeployment": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtimeEvidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "archivedReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
