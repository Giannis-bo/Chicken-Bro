{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/schemas/harness-evidence.schema.json",
  "title": "Harness Evidence Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "slug",
    "requirementSlug",
    "status",
    "highestEvidenceLevel",
    "branch",
    "commit",
    "identities",
    "manualAcceptance",
    "scope",
    "verification",
    "candidateDeployment",
    "runtimeEvidence",
    "risks",
    "rollback",
    "cleanup",
    "archivedReferences",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "requirementSlug": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "requirement_challenged",
        "requirement_contract_approved",
        "implementation_allowed",
        "local_verified",
        "runtime_verified",
        "deployable",
        "live_verified",
        "archived"
      ]
    },
    "highestEvidenceLevel": {
      "type": "string",
      "enum": [
        "requirement_challenged",
        "requirement_contract_approved",
        "implementation_allowed",
        "local_verified",
        "runtime_verified",
        "deployable",
        "live_verified",
        "archived"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "verification",
        "closure"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtimeIdentity"
        },
        "verification": {
          "$ref": "#/$defs/verificationIdentity"
        },
        "closure": {
          "$ref": "#/$defs/closureIdentity"
        }
      }
    },
    "manualAcceptance": {
      "$ref": "#/$defs/manualAcceptance"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "candidateDeployment": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtimeEvidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "archivedReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "runtimeIdentity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["bound", "not_applicable", "pending"]
        },
        "kind": {
          "enum": ["git_commit", "git_tree", "build_identity"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "verificationIdentity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["bound_at_check", "pending"]
        },
        "kind": {
          "const": "git_ref"
        },
        "value": {
          "const": "HEAD"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "closureIdentity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["bound", "pending", "not_applicable"]
        },
        "kind": {
          "const": "merge_commit"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "manualAcceptance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "status", "items", "rollup"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": ["not_applicable", "pending", "complete", "complete_with_user_waiver"]
        },
        "reason": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "status"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["accepted", "not_run_user_waived", "pending"]
              },
              "evidence": {
                "type": "string"
              },
              "authorization": {
                "type": "string"
              }
            }
          }
        },
        "rollup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "accepted", "notRunUserWaived", "pending"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "accepted": {"type": "integer", "minimum": 0},
            "notRunUserWaived": {"type": "integer", "minimum": 0},
            "pending": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
