.pve-shell {
  background: #060606;
}

.pve-hero {
  border: 1rpx solid rgba(167, 26, 25, 0.48);
  background: linear-gradient(135deg, #7a1116 0%, #2b0b0e 54%, #060606 100%);
  box-shadow: 0 18rpx 44rpx rgba(122, 17, 22, 0.28);
}

.pve-hero::after {
  background: rgba(248, 183, 0, 0.18);
}

.zone-section {
  border-color: rgba(255, 255, 255, 0.08);
  background: #151515;
}

.zone-section .section-header {
  align-items: flex-start;
  gap: 18rpx;
}

.zone-section .section-title {
  color: #ffffff;
}

.zone-section .section-action {
  max-width: 360rpx;
  color: #f8b700;
  line-height: 1.35;
  text-align: right;
}

.zone-desc {
  display: block;
  color: #a7a7a7;
  font-size: 24rpx;
  line-height: 1.55;
}

.source-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #f8b700;
  font-size: 22rpx;
  line-height: 1.4;
}

.source-note {
  display: block;
  margin-top: 8rpx;
  color: #8e8e8e;
  font-size: 22rpx;
  line-height: 1.45;
}

.zone-grid {
  margin-top: 20rpx;
}

.zone-item {
  min-height: 164rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
}

.zone-item:nth-child(2n) {
  background: #151515;
}

.zone-item .quick-title {
  color: #f1f1f1;
}

.zone-item .quick-desc {
  color: #a7a7a7;
}

.module-footer {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #f8b700;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 800;
}
