.pve-shell {
  background: #1d080a;
}

.pve-hero {
  border: 2rpx solid rgba(215, 163, 61, 0.36);
  background: linear-gradient(135deg, #7a1116 0%, #4a090d 58%, #1d080a 100%);
  box-shadow: 0 18rpx 42rpx rgba(122, 17, 22, 0.22);
}

.pve-hero::after {
  background: rgba(215, 163, 61, 0.28);
}

.zone-section {
  border-color: rgba(122, 17, 22, 0.16);
  background: #fffaf0;
}

.zone-section .section-header {
  align-items: flex-start;
  gap: 18rpx;
}

.zone-section .section-title {
  color: #7a1116;
}

.zone-section .section-action {
  max-width: 360rpx;
  color: #8e6419;
  line-height: 1.35;
  text-align: right;
}

.zone-desc {
  display: block;
  color: #6b5550;
  font-size: 24rpx;
  line-height: 1.55;
}

.source-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #8e6419;
  font-size: 22rpx;
  line-height: 1.4;
}

.source-note {
  display: block;
  margin-top: 8rpx;
  color: #806e67;
  font-size: 22rpx;
  line-height: 1.45;
}

.zone-grid {
  margin-top: 20rpx;
}

.zone-item {
  min-height: 164rpx;
  border: 1rpx solid rgba(122, 17, 22, 0.12);
  background: #fff3df;
}

.zone-item:nth-child(2n) {
  background: #faeadb;
}

.zone-item .quick-title {
  color: #2b0b0e;
}

.zone-item .quick-desc {
  color: #725b54;
}

.module-footer {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #d7a33d;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}
