<view class="page-shell pve-shell">
  <navigation-bar title="{{navTitle}}" back="{{false}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y>
    <view class="page-content">
      <view class="hero pve-hero">
        <text class="hero-kicker">{{kicker}}</text>
        <text class="hero-title">{{title}}</text>
        <text class="hero-desc">{{desc}}</text>
      </view>

      <view class="section zone-section" wx:for="{{zones}}" wx:key="key">
        <view class="section-header">
          <text class="section-title">{{item.title}}</text>
          <text class="section-action">{{item.eyebrow}}</text>
        </view>
        <text class="zone-desc">{{item.desc}}</text>
        <view class="source-row">
          <text>{{item.sourceName}}</text>
          <text>{{item.publishedAt}}</text>
        </view>
        <text class="source-note">{{item.analysisWindow}}</text>
        <view class="quick-grid zone-grid">
          <view
            class="quick-item zone-item"
            wx:for="{{item.modules}}"
            wx:for-item="module"
            wx:key="key"
            data-key="{{module.key}}"
            bindtap="openPveModule"
          >
            <text class="quick-title">{{module.title}}</text>
            <text class="quick-desc">{{module.desc}}</text>
            <view class="module-footer">
              <text>{{module.itemCount}} 条数据</text>
              <text>进入详情</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
