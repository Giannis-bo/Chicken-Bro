.pve-detail-shell {
  background: #060606;
}

.pve-detail-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.detail-hero {
  padding: 32rpx 30rpx;
  border: 1rpx solid rgba(167, 26, 25, 0.48);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #7a1116 0%, #2b0b0e 58%, #060606 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(122, 17, 22, 0.28);
}

.detail-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-title {
  display: block;
  margin-top: 24rpx;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
}

.detail-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(225, 226, 229, 0.82);
  font-size: 25rpx;
  line-height: 1.55;
}

.detail-source-strip,
.source-box {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.detail-source-strip {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  color: #f8b700;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 800;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.record-card {
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.24);
}

.record-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  flex: 1;
  color: #f1f1f1;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.record-value {
  flex: none;
  max-width: 230rpx;
  color: #f8b700;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: right;
  font-weight: 900;
}

.record-desc {
  display: block;
  margin-top: 12rpx;
  color: #a7a7a7;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-source {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  color: #8e8e8e;
  font-size: 21rpx;
  line-height: 1.35;
}

.record-window {
  display: block;
  margin-top: 8rpx;
  color: #8e8e8e;
  font-size: 21rpx;
  line-height: 1.4;
}

.source-box-title {
  display: block;
  color: #f8b700;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 900;
}

.source-box-text {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.45;
}
