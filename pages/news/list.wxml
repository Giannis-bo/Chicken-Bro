<app-shell surface="news" density="compact" tabSafe="{{false}}">
  <page-frame density="dense" bottomInset="36rpx">
    <navigation-bar slot="nav" title="{{navTitle}}" back="{{true}}" color="#F8B700" background="#060606"></navigation-bar>
    <article-list-board
      query="{{query}}"
      title="{{title}}"
      count="{{count}}"
      articles="{{articles}}"
      loading="{{loading}}"
      empty="{{!articles.length && !loading}}"
      fromFallback="{{fromFallback}}"
      requestError="{{requestError}}"
      density="compact"
      bindopenarticle="openArticle"
    ></article-list-board>
  </page-frame>
</app-shell>
