<app-shell surface="news" density="compact" tabSafe="{{false}}">
  <page-frame density="dense" bottomInset="36rpx">
    <navigation-bar slot="nav" title="{{navTitle}}" back="{{true}}" homeButton="{{homeButton}}" color="#F8B700" background="#060606"></navigation-bar>
    <article-reader
      article="{{article}}"
      loading="{{loading}}"
      missingId="{{missingId}}"
      notFound="{{notFound}}"
      fromFallback="{{fromFallback}}"
      requestError="{{requestError}}"
      homeButton="{{homeButton}}"
      bindcopysource="copySourceUrl"
    ></article-reader>
  </page-frame>
</app-shell>
