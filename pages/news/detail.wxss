.detail-shell {
  background: #060606;
}

.detail-content {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #060606 0%, #101010 34%, #060606 100%);
}

.detail-card {
  padding: 28rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.28);
}

.loading-card {
  min-height: 280rpx;
  align-items: center;
  justify-content: center;
}

.loading-text {
  color: #a7a7a7;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-channel {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.detail-date {
  flex: none;
  color: #8e8e8e;
  font-size: 23rpx;
}

.detail-title {
  display: block;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.26;
}

.detail-summary {
  display: block;
  margin-top: 20rpx;
  color: #b8b8b8;
  font-size: 27rpx;
  line-height: 1.65;
}

.detail-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.detail-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  background: #101010;
  color: #a7a7a7;
  font-size: 20rpx;
  line-height: 1.25;
}

.detail-chip-label {
  color: #f8b700;
  font-weight: 800;
  flex: 0 0 auto;
}

.detail-chip-value {
  margin-left: 8rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.body-panel,
.original-panel {
  margin-top: 28rpx;
}

.section-label {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.detail-body {
  display: block;
  margin-top: 12rpx;
  color: #e1e2e5;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.original-panel {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
}

.original-title {
  display: block;
  margin-top: 10rpx;
  color: #f1f1f1;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.45;
}

.original-body {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-line;
  word-break: break-all;
}

.source-panel {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(167, 26, 25, 0.28);
  border-radius: 16rpx;
  background: rgba(167, 26, 25, 0.12);
}

.source-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.source-label {
  color: #ff6b64;
  font-size: 20rpx;
  font-weight: 800;
}

.source-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.source-desc,
.source-url {
  display: block;
  margin-top: 10rpx;
  color: #b8b8b8;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-all;
}

.source-url {
  color: #f8b700;
}

.source-button {
  height: 58rpx;
  margin: 18rpx 0 0;
  border-radius: 999rpx;
  background: #a71a19;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.source-button::after {
  border: 0;
}

.detail-warning {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(248, 183, 0, 0.1);
  color: #f8b700;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-warning-text {
  display: block;
  margin-top: 14rpx;
  color: #f8b700;
  font-size: 23rpx;
}
