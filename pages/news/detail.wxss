.detail-shell {
  background: #060606;
}

.detail-content {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #060606 0%, #101010 34%, #060606 100%);
}

.detail-card {
  padding: 28rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.28);
}

.loading-card {
  min-height: 280rpx;
  align-items: center;
  justify-content: center;
}

.loading-text {
  color: #a7a7a7;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-channel {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.detail-date {
  flex: none;
  color: #8e8e8e;
  font-size: 23rpx;
}

.source-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.source-badge {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.1);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.detail-title {
  display: block;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.26;
}

.detail-summary {
  display: block;
  margin-top: 18rpx;
  color: #b8b8b8;
  font-size: 27rpx;
  line-height: 1.65;
}

.detail-original-title {
  display: block;
  margin-top: 12rpx;
  color: #858585;
  font-size: 22rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.detail-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.detail-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  background: #101010;
  color: #a7a7a7;
  font-size: 20rpx;
  line-height: 1.25;
}

.detail-chip-label {
  color: #f8b700;
  font-weight: 800;
  flex: 0 0 auto;
}

.detail-chip-value {
  margin-left: 8rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.tag-chip .detail-chip-value {
  margin-left: 0;
  color: #e1e2e5;
  font-weight: 800;
}

.body-panel {
  margin-top: 28rpx;
}

.section-label {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.detail-body-blocks {
  margin-top: 12rpx;
}

.body-block {
  margin-top: 18rpx;
}

.body-block:first-child {
  margin-top: 0;
}

.body-block-paragraph {
  display: block;
  color: #e1e2e5;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}

.body-block-heading {
  display: block;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.body-block-list {
  display: block;
}

.body-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.body-list-bullet {
  flex: none;
  width: 22rpx;
  color: #f8b700;
  font-size: 28rpx;
  line-height: 1.65;
}

.body-list-text {
  flex: 1;
  color: #e1e2e5;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}

.body-block-quote {
  display: block;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #f8b700;
  background: rgba(248, 183, 0, 0.08);
  color: #e1e2e5;
  font-size: 27rpx;
  line-height: 1.7;
}

.source-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.source-desc {
  flex: 1;
  color: #b8b8b8;
  font-size: 21rpx;
  line-height: 1.4;
}

.source-button {
  width: auto;
  min-width: 168rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #a71a19;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.source-button::after {
  border: 0;
}

.detail-warning {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(248, 183, 0, 0.1);
  color: #f8b700;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-warning-text {
  display: block;
  margin-top: 14rpx;
  color: #f8b700;
  font-size: 23rpx;
}
