<view class="page-shell news-shell">
  <navigation-bar title="{{navTitle}}" back="{{false}}" color="#F8B700" background="#111111"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content news-content">
      <swiper class="news-swiper" indicator-dots circular autoplay interval="5200" duration="420" indicator-color="rgba(247, 228, 176, 0.28)" indicator-active-color="#F0B84B">
        <swiper-item wx:for="{{heroNews}}" wx:key="id">
          <view class="banner-card" data-id="{{item.id}}" bindtap="openArticle">
            <view class="banner-topline">
              <text class="banner-channel">{{item.channel}}</text>
              <text class="banner-date">{{item.publishedAt}}</text>
            </view>
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-summary">{{item.summary}}</text>
            <view class="source-row">
              <text class="source-name">{{item.sourceName}}</text>
              <text class="source-dot">/</text>
              <text class="source-note">{{item.sourceNote}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <view class="metrics news-metrics">
        <view class="metric-card news-metric-card" wx:for="{{metrics}}" wx:key="label" data-key="{{item.key}}" bindtap="openMetric">
          <text class="metric-value news-metric-value">{{item.value}}</text>
          <text class="metric-label news-metric-label">{{item.label}}</text>
        </view>
      </view>

      <view class="section news-section">
        <view class="section-header">
          <text class="section-title news-section-title">资讯频道</text>
        </view>
        <view class="channel-grid">
          <view class="channel-item" wx:for="{{channels}}" wx:key="id" data-value="{{item.title}}" bindtap="openChannel">
            <text class="channel-title">{{item.title}}</text>
            <text class="channel-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="section news-section">
        <view class="section-header">
          <text class="section-title news-section-title">今日重点</text>
          <text class="section-action news-section-action">{{fromFallback ? '本地缓存' : refreshMode}}</text>
        </view>
        <view class="highlight-list">
          <view class="highlight-card" wx:for="{{highlights}}" wx:key="id" data-id="{{item.id}}" bindtap="openArticle">
            <view class="highlight-head">
              <text class="highlight-channel">{{item.channel}}</text>
              <text class="highlight-date">{{item.publishedAt}}</text>
            </view>
            <text class="highlight-title">{{item.title}}</text>
            <text class="highlight-summary">{{item.summary}}</text>
            <view class="source-row highlight-source">
              <text class="source-name">{{item.sourceName}}</text>
              <text class="source-dot">/</text>
              <text class="source-note">{{item.sourceNote}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
