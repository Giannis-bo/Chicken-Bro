.news-shell {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: #060606;
}

.news-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 12% 12%, rgba(248, 183, 0, 0.18), rgba(248, 183, 0, 0) 30%),
    radial-gradient(circle at 96% 0%, rgba(122, 17, 22, 0.26), rgba(122, 17, 22, 0) 34%),
    linear-gradient(180deg, rgba(17, 14, 10, 0.88), rgba(3, 3, 3, 0.98));
}

.news-shell::after {
  content: "";
  position: absolute;
  inset: 0 10rpx 0;
  z-index: 0;
  border-left: 1rpx solid rgba(248, 183, 0, 0.16);
  border-right: 1rpx solid rgba(248, 183, 0, 0.16);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    inset 0 120rpx 220rpx rgba(248, 183, 0, 0.035);
  pointer-events: none;
}

.surface-material {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  pointer-events: none;
}

.news-shell-corner-material {
  left: auto;
  top: 98rpx;
  right: 0;
  bottom: auto;
  width: 196rpx;
  height: 216rpx;
  opacity: 0.48;
  mix-blend-mode: screen;
}

.page-scroll {
  position: relative;
  z-index: 1;
}

.news-shell .news-content {
  position: relative;
  z-index: 1;
  padding: 14rpx 20rpx var(--wow-tabbar-space);
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(6, 6, 6, 0.08) 0%, rgba(16, 16, 16, 0.58) 48%, #060606 100%);
}

.news-target-stage {
  width: 100%;
  box-sizing: border-box;
}

.news-command {
  position: relative;
  height: 155rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0)),
    linear-gradient(135deg, rgba(33, 23, 15, 0.95) 0%, rgba(16, 16, 16, 0.96) 52%, rgba(8, 8, 8, 0.98) 100%);
  box-shadow:
    0 18rpx 38rpx rgba(0, 0, 0, 0.4),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.045),
    inset 0 -18rpx 42rpx rgba(0, 0, 0, 0.28),
    inset 0 0 38rpx rgba(248, 183, 0, 0.045);
}

.news-command::before,
.news-channel-section::before,
.news-feed-section::before {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 8rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(248, 183, 0, 0), rgba(248, 183, 0, 0.42), rgba(248, 183, 0, 0));
  pointer-events: none;
}

.news-command::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-radius: 5rpx;
  pointer-events: none;
}

.news-command-material {
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.98;
  filter: saturate(1.12) contrast(1.12);
  mix-blend-mode: normal;
}

.news-command-frame-material {
  inset: 0 18rpx auto 154rpx;
  width: auto;
  height: 26rpx;
  opacity: 0.7;
  filter: saturate(1.14) contrast(1.18);
  mix-blend-mode: screen;
}

.news-command-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 100%;
  padding: 14rpx 18rpx 12rpx;
  box-sizing: border-box;
}

.news-command-emblem {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border: 2rpx solid rgba(248, 183, 0, 0.5);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(248, 183, 0, 0.3), rgba(248, 183, 0, 0.06) 48%, rgba(0, 0, 0, 0.9) 100%),
    #101010;
  box-shadow:
    0 0 0 7rpx rgba(0, 0, 0, 0.42),
    0 0 0 9rpx rgba(248, 183, 0, 0.08),
    inset 0 0 0 4rpx rgba(0, 0, 0, 0.34),
    inset 0 0 28rpx rgba(248, 183, 0, 0.17);
}

.news-command-icon-image {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 1;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%);
  object-fit: cover;
}

.news-command-emblem::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 78rpx;
  height: 78rpx;
  transform: translate(-50%, -50%);
  z-index: 1;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(248, 183, 0, 0.2), rgba(248, 183, 0, 0.03) 48%, rgba(0, 0, 0, 0.52) 76%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(0, 0, 0, 0.12));
  box-shadow:
    inset 0 0 0 6rpx rgba(0, 0, 0, 0.2),
    inset 0 -14rpx 20rpx rgba(0, 0, 0, 0.32);
  pointer-events: none;
  display: none;
}

.news-command-emblem::after {
  content: "";
  position: absolute;
  left: 25rpx;
  right: 25rpx;
  bottom: 22rpx;
  z-index: 3;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(248, 183, 0, 0.62), transparent);
  box-shadow: 0 0 10rpx rgba(248, 183, 0, 0.18);
  pointer-events: none;
}

.news-command-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 92rpx;
  height: 92rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.news-command-orbit-dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f8b700;
  box-shadow: 0 0 12rpx rgba(248, 183, 0, 0.42);
}

.news-command-orbit-dot.dot-a {
  left: 42rpx;
  top: -4rpx;
}

.news-command-orbit-dot.dot-b {
  right: 4rpx;
  top: 56rpx;
}

.news-command-orbit-dot.dot-c {
  left: 8rpx;
  bottom: 12rpx;
}

.news-command-crest {
  display: none;
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  transform: translate(-50%, -50%);
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.46);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(248, 183, 0, 0.22), rgba(248, 183, 0, 0.05) 56%, rgba(0, 0, 0, 0.66) 100%),
    rgba(8, 7, 5, 0.84);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.11),
    inset 0 -10rpx 16rpx rgba(0, 0, 0, 0.34),
    0 0 18rpx rgba(248, 183, 0, 0.1);
}

.news-command-scanline {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 15rpx;
  display: none;
  height: 1rpx;
  background: rgba(255, 244, 202, 0.62);
  box-shadow:
    0 12rpx 0 rgba(248, 183, 0, 0.3),
    0 24rpx 0 rgba(248, 183, 0, 0.18);
}

.news-command-symbol {
  display: none;
  position: relative;
  z-index: 5;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  color: #f8b700;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  letter-spacing: 0;
  text-shadow:
    0 2rpx 0 rgba(0, 0, 0, 0.78),
    0 0 14rpx rgba(248, 183, 0, 0.22);
}

.command-socket-material {
  display: none;
}

.news-command-body {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 4rpx 0 2rpx;
}

.news-command-body::before {
  content: "";
  position: absolute;
  left: -10rpx;
  right: 0;
  top: 1rpx;
  bottom: 0;
  z-index: 0;
  border-left: 1rpx solid rgba(248, 183, 0, 0.18);
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.08), rgba(248, 183, 0, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(0, 0, 0, 0));
}

.news-command-heading {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  overflow: hidden;
  padding-bottom: 9rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.news-command-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  overflow: hidden;
}

.news-command-title {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 184rpx;
  overflow: hidden;
  color: #f6e7c1;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-command-meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(225, 226, 229, 0.56);
  font-size: 19rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-command-link {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  max-width: 120rpx;
  overflow: hidden;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.news-command-status {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-command-arrow {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
}

.news-command-strip {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 6rpx 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.1);
  border-radius: 7rpx;
  background:
    linear-gradient(90deg, rgba(6, 6, 6, 0.56), rgba(22, 16, 10, 0.38), rgba(6, 6, 6, 0.52)),
    rgba(6, 6, 6, 0.35);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    inset 0 -8rpx 12rpx rgba(0, 0, 0, 0.22);
}

.news-command-chip {
  min-width: 0;
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  column-gap: 7rpx;
  align-items: center;
}

.chip-mark {
  grid-row: 1 / 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.26);
  border-radius: 50%;
  background: rgba(248, 183, 0, 0.1);
  color: #caa75b;
  font-size: 17rpx;
  font-weight: 900;
}

.chip-label,
.chip-value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-label {
  color: rgba(225, 226, 229, 0.62);
  font-size: 18rpx;
  line-height: 1.18;
}

.chip-value {
  color: #f6e7c1;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.15;
}

.news-swiper {
  width: 100%;
  height: 430rpx;
  margin-bottom: 18rpx;
  overflow: visible;
}

.news-swiper .wx-swiper-dots {
  right: 26rpx;
  bottom: 24rpx;
  left: auto;
  width: auto;
}

.banner-card {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.46);
  border-radius: 8rpx;
  background: #101010;
  box-shadow:
    0 22rpx 46rpx rgba(0, 0, 0, 0.42),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.05),
    inset 0 0 38rpx rgba(248, 183, 0, 0.06);
  color: #f1f1f1;
}

.banner-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(6, 6, 6, 0.03) 0%, rgba(6, 6, 6, 0.08) 45%, rgba(6, 6, 6, 0.82) 100%),
    linear-gradient(90deg, rgba(6, 6, 6, 0.4), rgba(6, 6, 6, 0) 48%, rgba(6, 6, 6, 0.24));
  pointer-events: none;
}

.banner-card::after {
  content: "";
  position: absolute;
  inset: 7rpx;
  z-index: 2;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 4rpx;
  pointer-events: none;
}

.banner-visual-shell {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 40%, rgba(76, 68, 58, 0.2), rgba(6, 6, 6, 0) 58%),
    rgba(6, 6, 6, 0.72);
}

.banner-visual-image,
.banner-material-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.banner-visual-image {
  z-index: 1;
  opacity: 1;
  filter: saturate(1.04) contrast(1.04);
}

.banner-material-image {
  z-index: 0;
  opacity: 0.9;
  filter: saturate(1.08) contrast(1.08);
}

.banner-channel-pill {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  z-index: 3;
}

.banner-channel,
.highlight-channel {
  display: inline-flex;
  align-items: center;
  max-width: 240rpx;
  min-height: 38rpx;
  padding: 6rpx 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 8rpx;
  background: rgba(248, 183, 0, 0.13);
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-copy-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 3;
  min-width: 0;
}

.banner-topline,
.highlight-head,
.source-row {
  display: flex;
  align-items: center;
}

.banner-topline,
.highlight-head {
  justify-content: space-between;
  gap: 14rpx;
}

.banner-date,
.highlight-date {
  flex: none;
  color: rgba(246, 231, 193, 0.7);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.banner-title {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.12;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.74);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.banner-summary {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: rgba(246, 231, 193, 0.82);
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-row {
  margin-top: 10rpx;
  min-width: 0;
}

.source-name {
  flex: none;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
}

.source-dot {
  flex: none;
  margin: 0 10rpx;
  color: rgba(246, 231, 193, 0.32);
  font-size: 21rpx;
}

.source-note {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(225, 226, 229, 0.62);
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-section {
  position: relative;
  padding: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(21, 21, 21, 0.88), rgba(8, 8, 8, 0.96));
  box-shadow:
    0 14rpx 32rpx rgba(0, 0, 0, 0.32),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.03),
    inset 0 0 32rpx rgba(248, 183, 0, 0.035);
}

.news-section::after {
  content: "";
  position: absolute;
  inset: 7rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.055);
  border-radius: 4rpx;
  pointer-events: none;
}

.news-section .section-header {
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
}

.news-section-title {
  color: #f6e7c1;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.news-section-action {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.news-channel-section {
  width: 100%;
  max-width: 100%;
  height: 154rpx;
  margin-left: auto;
  margin-right: auto;
  margin-top: 0;
  margin-bottom: 20rpx;
  padding: 0;
  border-color: rgba(248, 183, 0, 0.085);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 50% 3%, rgba(248, 183, 0, 0.1), rgba(248, 183, 0, 0) 30%),
    linear-gradient(180deg, rgba(24, 21, 15, 0.84), rgba(4, 4, 4, 0.98));
}

.news-channel-section .section-header {
  display: none;
}

.news-feed-section {
  min-height: 717rpx;
  padding: 16rpx 15rpx 18rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 7%, rgba(248, 183, 0, 0.045), rgba(248, 183, 0, 0) 34%),
    linear-gradient(180deg, rgba(17, 15, 11, 0.9), rgba(7, 7, 7, 0.98));
}

@media (max-width: 380px) {
  .news-shell .news-content {
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .news-command-content {
    gap: 10rpx;
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .news-command-emblem {
    width: 92rpx;
    height: 92rpx;
  }

  .news-command-copy {
    gap: 10rpx;
  }

  .news-command-title {
    font-size: 26rpx;
    max-width: 160rpx;
  }

  .news-command-meta {
    font-size: 17rpx;
  }

  .news-command-link {
    max-width: 104rpx;
  }

  .news-channel-section {
    width: 707rpx;
    max-width: 100%;
    height: 130rpx;
  }
}
