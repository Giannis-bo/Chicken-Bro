.news-shell {
  background: #111821;
}

.news-content {
  padding: 24rpx 28rpx 56rpx;
  background: linear-gradient(180deg, #111821 0%, #182231 34%, #efe0bd 34%, #f4ead2 100%);
}

.news-swiper {
  width: 100%;
  height: 408rpx;
}

.news-swiper .wx-swiper-dots {
  bottom: 12rpx;
}

.banner-card {
  position: relative;
  height: 408rpx;
  padding: 34rpx 32rpx;
  overflow: hidden;
  border: 2rpx solid rgba(240, 184, 75, 0.72);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #162033 0%, #26354b 52%, #614018 100%);
  box-shadow: 0 22rpx 48rpx rgba(3, 8, 16, 0.28);
  color: #fff8df;
}

.banner-card::before {
  content: "";
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(247, 228, 176, 0.2);
  border-radius: 12rpx;
}

.banner-topline,
.highlight-head,
.source-row,
.refresh-strip {
  display: flex;
  align-items: center;
}

.banner-topline,
.highlight-head {
  position: relative;
  z-index: 1;
  justify-content: space-between;
}

.banner-channel,
.highlight-channel {
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(240, 184, 75, 0.52);
  border-radius: 999rpx;
  background: rgba(12, 18, 27, 0.5);
  color: #f0b84b;
  font-size: 22rpx;
  line-height: 1.2;
}

.banner-date,
.highlight-date {
  color: rgba(255, 248, 223, 0.72);
  font-size: 22rpx;
}

.banner-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 42rpx;
  color: #fff8df;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.18;
}

.banner-summary {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 248, 223, 0.82);
  font-size: 25rpx;
  line-height: 1.52;
}

.source-row {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  min-width: 0;
}

.source-name {
  flex: none;
  color: #f0b84b;
  font-size: 22rpx;
  font-weight: 700;
}

.source-dot {
  flex: none;
  margin: 0 10rpx;
  color: rgba(247, 228, 176, 0.42);
  font-size: 22rpx;
}

.source-note {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(247, 228, 176, 0.68);
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-strip {
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(240, 184, 75, 0.38);
  border-radius: 14rpx;
  background: rgba(14, 22, 33, 0.88);
}

.refresh-copy {
  min-width: 0;
}

.refresh-label {
  display: block;
  color: rgba(247, 228, 176, 0.62);
  font-size: 21rpx;
}

.refresh-time {
  display: block;
  margin-top: 5rpx;
  max-width: 470rpx;
  overflow: hidden;
  color: #f7e4b0;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-error {
  display: block;
  margin-top: 6rpx;
  max-width: 470rpx;
  overflow: hidden;
  color: #d29b54;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-button {
  width: 118rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #b87724;
  color: #fff8df;
  font-size: 24rpx;
  line-height: 58rpx;
}

.refresh-button::after {
  border: 0;
}

.news-metrics {
  margin-top: 22rpx;
}

.news-metric-card {
  border-color: rgba(79, 53, 25, 0.14);
  background: #fff8e8;
  box-shadow: 0 12rpx 28rpx rgba(77, 52, 22, 0.1);
}

.news-metric-value {
  color: #9b5c16;
}

.news-metric-label {
  color: #63523a;
}

.news-section {
  border: 1rpx solid rgba(79, 53, 25, 0.16);
  border-radius: 18rpx;
  background: #fff7e5;
  box-shadow: 0 14rpx 34rpx rgba(77, 52, 22, 0.1);
}

.news-section-title {
  color: #251b12;
}

.news-section-action {
  color: #9b5c16;
}

.channel-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.channel-item {
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(155, 92, 22, 0.18);
  border-radius: 14rpx;
  background: linear-gradient(90deg, #fbefd2 0%, #fffaf0 100%);
}

.channel-title {
  display: block;
  color: #2c2117;
  font-size: 28rpx;
  font-weight: 800;
}

.channel-desc {
  display: block;
  margin-top: 9rpx;
  color: #6e5a3e;
  font-size: 23rpx;
  line-height: 1.45;
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.highlight-card {
  padding: 24rpx;
  border: 1rpx solid rgba(155, 92, 22, 0.18);
  border-radius: 14rpx;
  background: #fffaf0;
}

.highlight-channel {
  background: #251b12;
}

.highlight-date {
  color: #7c6746;
}

.highlight-title {
  display: block;
  margin-top: 18rpx;
  color: #23180f;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.highlight-summary {
  display: block;
  margin-top: 10rpx;
  color: #675337;
  font-size: 24rpx;
  line-height: 1.55;
}

.highlight-source {
  margin-top: 16rpx;
}

.highlight-source .source-note {
  color: #8a724b;
}
