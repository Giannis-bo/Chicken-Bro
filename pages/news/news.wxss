.news-shell {
  background: #060606;
}

.news-content {
  padding: 18rpx 22rpx 52rpx;
  background: linear-gradient(180deg, #060606 0%, #101010 42%, #060606 100%);
}

.news-swiper {
  width: 100%;
  height: 260rpx;
}

.news-swiper .wx-swiper-dots {
  bottom: 12rpx;
}

.banner-card {
  position: relative;
  height: 260rpx;
  padding: 20rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 12rpx;
  background: linear-gradient(135deg, #101010 0%, #17120d 62%, #21170f 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.32);
  color: #f1f1f1;
}

.banner-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: #f8b700;
}

.banner-topline,
.highlight-head,
.source-row {
  display: flex;
  align-items: center;
}

.banner-topline,
.highlight-head {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
}

.banner-channel,
.highlight-channel {
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.48);
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.banner-date,
.highlight-date {
  flex: none;
  color: #8e8e8e;
  font-size: 22rpx;
}

.banner-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.banner-summary {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  color: rgba(225, 226, 229, 0.8);
  font-size: 23rpx;
  line-height: 1.38;
}

.source-row {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  min-width: 0;
}

.source-name {
  flex: none;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.source-dot {
  flex: none;
  margin: 0 10rpx;
  color: #4f4f4f;
  font-size: 22rpx;
}

.source-note {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #9a9a9a;
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-section {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
}

.news-section .section-header {
  margin-bottom: 14rpx;
}

.news-section-title {
  color: #f1f1f1;
}

.news-section-action {
  color: #f8b700;
}

.channel-grid {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 8rpx;
}

.channel-item {
  flex: 1 1 0;
  min-width: 0;
  min-height: 72rpx;
  padding: 12rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101010;
}

.channel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  min-width: 0;
}

.channel-title {
  flex: 1;
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-update-indicator {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5rpx;
  min-width: 28rpx;
}

.channel-count {
  flex: none;
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.channel-update-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff3b30;
  box-shadow: 0 0 10rpx rgba(255, 59, 48, 0.42);
}

.channel-desc {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #9a9a9a;
  font-size: 19rpx;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.highlight-card {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101010;
}

.highlight-channel {
  background: rgba(167, 26, 25, 0.18);
  color: #ff6b64;
  border-color: rgba(167, 26, 25, 0.42);
}

.highlight-date {
  color: #8e8e8e;
}

.highlight-title {
  display: block;
  margin-top: 12rpx;
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.34;
}

.highlight-summary {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.42;
}

.highlight-source {
  margin-top: 12rpx;
}

.highlight-source .source-note {
  color: #8e8e8e;
}
