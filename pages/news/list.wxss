.list-shell {
  background: #060606;
}

.list-content {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #060606 0%, #101010 38%, #060606 100%);
}

.list-header {
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.32);
  border-radius: 16rpx;
  background: #151515;
  color: #f1f1f1;
}

.list-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.list-count {
  display: block;
  margin-top: 12rpx;
  color: #f8b700;
  font-size: 25rpx;
  font-weight: 800;
}

.list-error {
  display: block;
  margin-top: 12rpx;
  color: #ff6b64;
  font-size: 22rpx;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.list-card {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.24);
}

.article-card {
  padding: 22rpx;
}

.article-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.article-channel {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.article-date {
  flex: none;
  color: #8e8e8e;
  font-size: 22rpx;
}

.article-title {
  display: block;
  margin-top: 16rpx;
  color: #f1f1f1;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.article-summary {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 24rpx;
  line-height: 1.55;
}

.article-source {
  display: block;
  margin-top: 14rpx;
  color: #f8b700;
  font-size: 22rpx;
  line-height: 1.45;
}

.article-source-url {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #8e8e8e;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-card {
  margin-top: 22rpx;
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-text {
  color: #a7a7a7;
  font-size: 27rpx;
  font-weight: 800;
}
