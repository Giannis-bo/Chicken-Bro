.list-shell {
  background: #111821;
}

.list-content {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #111821 0%, #182231 24%, #f4ead2 24%, #f4ead2 100%);
}

.list-header {
  padding: 28rpx 30rpx;
  border: 2rpx solid rgba(240, 184, 75, 0.36);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #162033 0%, #2a3850 100%);
  color: #fff8df;
}

.list-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.list-count {
  display: block;
  margin-top: 12rpx;
  color: #f0b84b;
  font-size: 25rpx;
  font-weight: 700;
}

.list-error {
  display: block;
  margin-top: 12rpx;
  color: #d29b54;
  font-size: 22rpx;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.list-card {
  border: 1rpx solid rgba(155, 92, 22, 0.18);
  border-radius: 16rpx;
  background: #fff7e5;
  box-shadow: 0 14rpx 34rpx rgba(77, 52, 22, 0.1);
}

.article-card {
  padding: 24rpx;
}

.article-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.article-channel {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #251b12;
  color: #f0b84b;
  font-size: 22rpx;
}

.article-date {
  color: #7c6746;
  font-size: 22rpx;
}

.article-title {
  display: block;
  margin-top: 18rpx;
  color: #23180f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.article-summary {
  display: block;
  margin-top: 10rpx;
  color: #675337;
  font-size: 24rpx;
  line-height: 1.55;
}

.article-source {
  display: block;
  margin-top: 14rpx;
  color: #9b5c16;
  font-size: 22rpx;
  line-height: 1.45;
}

.article-source-url {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-card {
  margin-top: 22rpx;
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-text {
  color: #6d5738;
  font-size: 27rpx;
  font-weight: 700;
}
