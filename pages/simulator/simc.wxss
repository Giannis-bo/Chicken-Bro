page {
  background: #060606;
}

.simc-page-shell {
  height: 100vh;
  min-height: 100vh;
  background: #060606;
}

.simc-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.simc-page {
  position: relative;
  min-height: 100%;
  padding: 16rpx 22rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #060606;
}

.template-hero {
  flex: none;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 12rpx;
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.24);
}

.context-kicker {
  display: block;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.context-title {
  display: block;
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.context-desc {
  flex: 1;
  min-width: 0;
  color: rgba(225, 226, 229, 0.76);
  font-size: 21rpx;
  line-height: 1.36;
}

.template-selector,
.confirm-summary,
.blocked-panel,
.result-panel,
.combat-preparation-panel,
.preparation-panel {
  margin-bottom: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
}

.template-hero + .identity-selector-row {
  margin-top: 14rpx;
}

.identity-selector-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.identity-selector-card {
  min-width: 0;
  margin-bottom: 0;
}

.identity-selector-card .selector-row {
  gap: 10rpx;
}

.identity-selector-card .selector-title-group {
  width: 82rpx;
}

.identity-selector-card .section-title {
  font-size: 25rpx;
}

.identity-selector-card .toolbar-picker {
  min-height: 50rpx;
  padding: 8rpx 10rpx;
}

.identity-selector-card .picker-value {
  font-size: 23rpx;
}

.compact-selector {
  margin-bottom: 10rpx;
  padding: 12rpx 14rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.section-title {
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 900;
}

.section-meta {
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  font-weight: 700;
}

.empty-state {
  margin-top: 12rpx;
  padding: 16rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 24rpx;
  line-height: 1.45;
}

.selector-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.selector-title-group {
  flex: none;
  width: 146rpx;
  min-width: 0;
}

.class-selector .selector-title-group,
.race-selector .selector-title-group {
  width: 96rpx;
}

.selector-title-group .section-title,
.selector-title-group .section-meta {
  display: block;
}

.selector-title-group .section-meta {
  margin-top: 4rpx;
}

.selector-picker {
  flex: 1;
  min-width: 0;
  display: block;
}

.selector-disabled {
  opacity: 0.78;
}

.toolbar-picker {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101214;
  gap: 10rpx;
  overflow: hidden;
}

.toolbar-picker-disabled {
  border-style: dashed;
  background: rgba(255, 255, 255, 0.025);
}

.toolbar-picker-disabled .picker-value {
  color: rgba(255, 255, 255, 0.52);
}

.picker-value {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.segmented-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.segment-button {
  margin: 0;
  padding: 12rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  background: #101214;
  color: #ffffff;
  line-height: 1.3;
  text-align: left;
}

.segment-selected {
  border-color: rgba(64, 180, 136, 0.7);
  background: rgba(64, 180, 136, 0.12);
}

.segment-title {
  display: block;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
}

.segment-desc {
  display: block;
  margin-top: 4rpx;
  color: rgba(225, 226, 229, 0.64);
  font-size: 18rpx;
  line-height: 1.28;
}

.summary-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22rpx;
  align-items: stretch;
}

.summary-left,
.summary-stat-panel {
  min-width: 0;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 48rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.summary-label {
  flex: none;
  width: 88rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  font-weight: 800;
}

.summary-value {
  min-width: 0;
  flex: 1;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.summary-left .summary-value {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selector-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.62);
}

.selector-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  max-height: 74vh;
  padding: 16rpx 22rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: #111111;
  color: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(0, 0, 0, 0.42);
}

.selector-sheet-handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.selector-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selector-sheet-title-group {
  min-width: 0;
  flex: 1;
}

.selector-sheet-kicker,
.selector-sheet-title {
  display: block;
}

.selector-sheet-kicker {
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.selector-sheet-title {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.22;
}

.selector-sheet-close {
  flex: none;
  min-width: 104rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.selector-sheet-list {
  max-height: 56vh;
  margin-top: 18rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.selector-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 76rpx;
  margin-top: 10rpx;
  padding: 14rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.selector-sheet-option:first-child {
  margin-top: 0;
}

.selector-sheet-option.selected {
  border-color: rgba(248, 183, 0, 0.52);
  background: rgba(248, 183, 0, 0.11);
}

.selector-sheet-option-copy {
  min-width: 0;
  flex: 1;
}

.selector-sheet-option-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.24;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selector-sheet-option-desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(225, 226, 229, 0.62);
  font-size: 20rpx;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selector-sheet-check {
  flex: none;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.selector-sheet-empty {
  padding: 26rpx 18rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  background: #0c0c0c;
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  line-height: 1.4;
}

.summary-stat-panel {
  padding-left: 20rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.summary-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 48rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.summary-stat-label {
  min-width: 0;
  flex: 1;
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-primary-value {
  flex: none;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.summary-secondary-percent {
  flex: none;
  color: #76d89f;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.summary-stat-note {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 176, 168, 0.9);
  font-size: 19rpx;
  line-height: 1.35;
  word-break: break-word;
}

.blocked-panel {
  border-color: rgba(232, 92, 92, 0.38);
  background: rgba(232, 92, 92, 0.1);
}

.blocked-title {
  display: block;
  color: #ffb0a8;
  font-size: 25rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.blocked-reason {
  color: #ffd6d2;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 6rpx;
  word-break: break-word;
}

.result-panel {
  border-color: rgba(64, 180, 136, 0.36);
  background: rgba(64, 180, 136, 0.1);
}

.combat-preparation-panel {
  border-color: rgba(248, 183, 0, 0.16);
}

.preparation-policy-list,
.temporary-buff-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.temporary-buff-list {
  margin-top: 14rpx;
}

.preparation-policy-row,
.temporary-buff-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.045);
}

.preparation-policy-row {
  align-items: center;
}

.preparation-policy-label {
  flex: 0 0 116rpx;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.35;
}

.preparation-policy-value {
  flex: 1;
  min-width: 0;
  color: #f1f1f1;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.temporary-buff-row {
  justify-content: space-between;
}

.temporary-buff-enabled {
  border: 1rpx solid rgba(64, 180, 136, 0.32);
  background: rgba(64, 180, 136, 0.08);
}

.temporary-buff-copy {
  flex: 1;
  min-width: 0;
}

.temporary-buff-title,
.temporary-buff-desc {
  display: block;
}

.temporary-buff-title {
  color: #f1f1f1;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.temporary-buff-desc {
  margin-top: 4rpx;
  color: rgba(225, 226, 229, 0.58);
  font-size: 20rpx;
  line-height: 1.35;
}

.temporary-buff-toggle {
  flex: 0 0 auto;
  width: 68rpx;
  height: 38rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.18);
  transition: background 120ms ease;
}

.temporary-buff-toggle-on {
  background: rgba(64, 180, 136, 0.92);
}

.temporary-buff-knob {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
  transition: transform 120ms ease;
}

.temporary-buff-toggle-on .temporary-buff-knob {
  transform: translateX(30rpx);
}

.preparation-panel {
  border-color: rgba(248, 183, 0, 0.18);
  background: rgba(248, 183, 0, 0.06);
}

.preparation-summary {
  display: block;
  color: #e1e2e5;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.preparation-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.preparation-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.05);
}

.preparation-copy {
  flex: 1;
  min-width: 0;
}

.preparation-label {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.25;
}

.preparation-value {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 225, 154, 0.94);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.preparation-state {
  flex: 0 0 auto;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: right;
}

.result-title {
  display: block;
  color: #9be4c1;
  font-size: 25rpx;
  font-weight: 900;
}

.result-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(235, 255, 246, 0.78);
  font-size: 22rpx;
  line-height: 1.45;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 10rpx;
  padding: 10rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #060606;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.confirm-button,
.submit-button {
  width: 100%;
  min-height: 72rpx;
  margin: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
}

.confirm-button {
  background: #253242;
  color: #e8f0f8;
}

.confirm-button.action-disabled {
  background: #1a2028;
  color: rgba(255, 255, 255, 0.42);
}

.submit-button,
.task-submit-button.action-disabled {
  background: #2f352f;
  color: rgba(255, 255, 255, 0.5);
}

.task-submit-button.submit-ready {
  background: #2a8c67;
  color: #ffffff;
}

.button-label {
  min-width: 0;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.button-spinner {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: currentColor;
  border-radius: 999rpx;
  box-sizing: border-box;
  animation: button-spin 780ms linear infinite;
}

@keyframes button-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
