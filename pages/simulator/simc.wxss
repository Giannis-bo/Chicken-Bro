.simc-page {
  height: 0;
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 28rpx 30rpx;
  background: #0d0f12;
}

.template-hero {
  flex: none;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(95, 128, 168, 0.38);
  border-radius: 12rpx;
  background: #151a20;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
}

.context-kicker {
  display: block;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.context-title {
  display: block;
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.context-desc {
  flex: 1;
  min-width: 0;
  color: rgba(225, 226, 229, 0.76);
  font-size: 22rpx;
  line-height: 1.45;
}

.template-workspace {
  min-height: 0;
  flex: 1;
  height: 0;
  margin-top: 18rpx;
}

.template-selector,
.confirm-summary,
.blocked-panel,
.result-panel {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
}

.compact-selector {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.section-title {
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 900;
}

.section-meta {
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  font-weight: 700;
}

.empty-state {
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 24rpx;
  line-height: 1.45;
}

.selector-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.selector-title-group {
  flex: none;
  width: 146rpx;
  min-width: 0;
}

.class-selector .selector-title-group {
  width: 96rpx;
}

.selector-title-group .section-title,
.selector-title-group .section-meta {
  display: block;
}

.selector-title-group .section-meta {
  margin-top: 4rpx;
}

.selector-picker {
  flex: 1;
  min-width: 0;
}

.toolbar-picker {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101214;
  gap: 10rpx;
  overflow: hidden;
}

.picker-value {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.segment-button::after,
.confirm-button::after,
.submit-button::after {
  border: 0;
}

.segmented-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.segment-button {
  margin: 0;
  padding: 16rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  background: #101214;
  color: #ffffff;
  line-height: 1.3;
  text-align: left;
}

.segment-selected {
  border-color: rgba(64, 180, 136, 0.7);
  background: rgba(64, 180, 136, 0.12);
}

.segment-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.segment-desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(225, 226, 229, 0.64);
  font-size: 20rpx;
  line-height: 1.35;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.summary-label {
  flex: none;
  width: 88rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  font-weight: 800;
}

.summary-value {
  min-width: 0;
  flex: 1;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-word;
}

.blocked-panel {
  border-color: rgba(232, 92, 92, 0.38);
  background: rgba(232, 92, 92, 0.1);
}

.blocked-title {
  display: block;
  color: #ffb0a8;
  font-size: 25rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.blocked-reason {
  color: #ffd6d2;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 6rpx;
  word-break: break-word;
}

.result-panel {
  border-color: rgba(64, 180, 136, 0.36);
  background: rgba(64, 180, 136, 0.1);
}

.result-title {
  display: block;
  color: #9be4c1;
  font-size: 25rpx;
  font-weight: 900;
}

.result-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(235, 255, 246, 0.78);
  font-size: 22rpx;
  line-height: 1.45;
}

.action-bar {
  flex: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  padding-top: 14rpx;
}

.confirm-button,
.submit-button {
  width: 100%;
  min-height: 84rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.confirm-button {
  background: #253242;
  color: #e8f0f8;
}

.confirm-button[disabled] {
  background: #1a2028;
  color: rgba(255, 255, 255, 0.42);
}

.submit-button,
.task-submit-button[disabled] {
  background: #2f352f;
  color: rgba(255, 255, 255, 0.5);
}

.task-submit-button.submit-ready {
  background: #2a8c67;
  color: #ffffff;
}
