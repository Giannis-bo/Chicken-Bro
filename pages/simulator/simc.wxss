.simc-page {
  height: 0;
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 28rpx 30rpx;
}

.chat-context {
  flex: none;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.5);
  border-radius: 14rpx;
  border-color: rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #493477 0%, #1a1128 58%, #060606 100%);
  box-shadow: 0 10rpx 26rpx rgba(73, 52, 119, 0.22);
}

.context-kicker {
  display: block;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.context-title {
  display: block;
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.context-desc {
  flex: 1;
  min-width: 0;
  color: rgba(225, 226, 229, 0.76);
  font-size: 22rpx;
  line-height: 1.45;
}

.context-source {
  flex: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 14rpx;
  background: rgba(248, 183, 0, 0.1);
}

.context-source-label {
  flex: none;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.context-source-title {
  min-width: 0;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.chat-panel {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.18);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.chat-header {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.chat-title {
  color: #f1f1f1;
  font-size: 30rpx;
  font-weight: 900;
}

.chat-round {
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  font-weight: 700;
}

.chat-messages {
  flex: 1;
  height: 0;
  min-height: 320rpx;
  padding: 2rpx 0;
}

.chat-row {
  display: flex;
  margin-bottom: 18rpx;
}

.chat-row-ai {
  justify-content: flex-start;
}

.chat-row-user {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 78%;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: #e1e2e5;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

.chat-row-ai .chat-bubble {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-top-left-radius: 6rpx;
  background: #101010;
}

.chat-row-user .chat-bubble {
  border-top-right-radius: 6rpx;
  background: #8b3ff5;
  color: #ffffff;
}

.chat-composer {
  flex: none;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chat-input {
  box-sizing: border-box;
  flex: 1;
  height: 92rpx;
  max-height: 160rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.3);
  border-radius: 14rpx;
  background: #101010;
  color: #e1e2e5;
  font-size: 25rpx;
  line-height: 1.45;
}

.send-button {
  flex: none;
  width: 132rpx;
  min-width: 132rpx;
  max-width: 132rpx;
  min-height: 92rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(139, 63, 245, 0.92);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.send-button[disabled] {
  background: #302743;
  color: rgba(255, 255, 255, 0.5);
}

.send-button::after {
  border: 0;
}

.submit-button {
  width: 100%;
  min-height: 84rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #3a2c55;
  color: rgba(255, 255, 255, 0.62);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.task-submit-button[disabled] {
  background: #3a2c55;
  color: rgba(255, 255, 255, 0.62);
}

.task-submit-button.submit-ready {
  background: #8b3ff5;
  color: #ffffff;
}

.submit-button::after {
  border: 0;
}

.quick-reply-list {
  flex: none;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.quick-reply {
  margin: 0;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 210, 74, 0.28);
  border-radius: 12rpx;
  background: rgba(255, 210, 74, 0.1);
  color: #ffe08a;
  font-size: 22rpx;
  line-height: 56rpx;
}

.quick-reply::after {
  border: 0;
}

.stage-title {
  min-width: 0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}
