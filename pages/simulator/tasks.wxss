.task-list-page {
  background: #060606;
}

.task-list-content {
  padding-bottom: 72rpx;
}

.task-list-section {
  border-color: rgba(255, 255, 255, 0.08);
  background: #151515;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-list-card {
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101010;
}

.task-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
}

.task-status {
  flex: 0 0 auto;
  max-width: 180rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.18);
  color: #c9a8ff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.task-desc {
  display: block;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.task-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
  color: rgba(248, 183, 0, 0.82);
  font-size: 21rpx;
  font-weight: 800;
}

.task-loading,
.task-empty {
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  color: #8e8e8e;
  text-align: center;
  font-size: 23rpx;
}

.task-error {
  color: #f8b700;
  font-size: 21rpx;
}
