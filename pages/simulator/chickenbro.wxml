<view class="page-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content">
      <view class="hero chickenbro-hero">
        <text class="hero-kicker">{{kicker}}</text>
        <text class="hero-title">{{title}}</text>
        <text class="hero-desc">{{desc}}</text>
      </view>

      <view class="section chickenbro-panel">
        <view class="section-header">
          <text class="section-title">证据输入</text>
          <text class="section-action">{{loading ? '检查中' : '可提交'}}</text>
        </view>
        <textarea
          class="chickenbro-input"
          value="{{chickenbroPrompt}}"
          maxlength="3000"
          auto-height="{{false}}"
          bindinput="updateChickenbroPrompt"
          placeholder="粘贴角色、SimC、WCL 或你已确认的证据"
        />
        <button class="submit-button" loading="{{loading}}" disabled="{{loading}}" bindtap="submitChickenbroCoach">提交证据教练</button>
      </view>

      <view class="section" wx:if="{{latestAnalysis && latestAnalysis.coach}}">
        <view class="section-header">
          <text class="section-title">教练结果</text>
          <text class="section-action">{{latestAnalysis.coach.confidence}}</text>
        </view>
        <view class="task-list">
          <view class="task-card coach-summary-card">
            <text class="task-title">摘要</text>
            <text class="task-desc" user-select="{{true}}">{{latestAnalysis.coach.summary}}</text>
            <text class="coach-evidence-refs" user-select="{{true}}">{{latestAnalysis.coach.evidenceRefs}}</text>
          </view>
          <view class="task-card coach-action-card" wx:for="{{latestAnalysis.coach.priorityActions}}" wx:key="title">
            <text class="task-title">优先行动</text>
            <text class="task-desc" user-select="{{true}}">{{item.title}}</text>
            <text class="coach-evidence-refs" user-select="{{true}}">{{item.evidenceRefs}}</text>
          </view>
          <view class="task-card coach-missing-card" wx:if="{{latestAnalysis.coach.missingInputs.length}}">
            <text class="task-title">缺失输入</text>
            <view class="coach-chip-list">
              <text class="coach-chip" wx:for="{{latestAnalysis.coach.missingInputs}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
          <view class="task-card coach-next-card" wx:if="{{latestAnalysis.coach.nextSteps.length}}">
            <text class="task-title">下一步</text>
            <text class="task-desc" wx:for="{{latestAnalysis.coach.nextSteps}}" wx:key="*this" user-select="{{true}}">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="section" wx:elif="{{latestAnalysis}}">
        <view class="section-header">
          <text class="section-title">检查结果</text>
          <text class="section-action">{{latestAnalysis.status}}</text>
        </view>
        <view class="task-list">
          <view class="task-card" wx:for="{{latestAnalysis.recommendations}}" wx:key="*this">
            <text class="task-desc" user-select="{{true}}">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
