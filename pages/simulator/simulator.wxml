<view class="chickenbro-page">
  <navigation-bar
    title="{{navTitle}}"
    back="{{showBack}}"
    color="#F8B700"
    background="#060606"
  ></navigation-bar>

  <view class="chickenbro-panel">
    <view class="chickenbro-head">
      <view class="chickenbro-avatar"></view>
      <view class="chickenbro-title-block">
        <text class="chickenbro-title">{{title}}</text>
        <text class="chickenbro-desc">{{desc}}</text>
      </view>
      <view class="chickenbro-topic" bindtap="toggleTopicDrawer">
        <text>话题</text>
        <text class="chickenbro-topic-arrow">›</text>
      </view>
    </view>

    <scroll-view
      class="chickenbro-scroll"
      scroll-y="{{true}}"
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollAnchor}}"
    >
      <view class="chickenbro-messages">
        <view class="chickenbro-context" wx:if="{{boundedContext && boundedContext.contextLabel}}">
          <text class="chickenbro-context-kicker">已带入工作台上下文</text>
          <text class="chickenbro-context-title">{{boundedContext.contextLabel}}</text>
        </view>
        <view
          id="{{item.messageId}}"
          wx:for="{{chatMessages}}"
          wx:key="messageId"
          class="chickenbro-message message-{{item.role}} status-{{item.status}}"
        >
          <view class="chickenbro-bubble">
            <text class="chickenbro-copy" user-select="{{true}}">{{item.content}}</text>
            <text wx:if="{{item.statusText}}" class="chickenbro-meta">{{item.statusText}}</text>
          </view>
        </view>
        <view class="chickenbro-prompt-grid" wx:if="{{suggestedPrompts.length}}">
          <view
            class="chickenbro-prompt"
            wx:for="{{suggestedPrompts}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="useSuggestedPrompt"
          >
            <text>{{item}}</text>
          </view>
        </view>

        <view class="chickenbro-evidence-strip">
          <view class="chickenbro-evidence-cell">
            <text class="chickenbro-evidence-label">回答边界</text>
            <text class="chickenbro-evidence-value">只解释证据</text>
          </view>
          <view class="chickenbro-evidence-cell">
            <text class="chickenbro-evidence-label">缺资料时</text>
            <text class="chickenbro-evidence-value">先给下一步</text>
          </view>
        </view>
        <view id="chat-bottom-a" class="chickenbro-anchor"></view>
        <view id="chat-bottom-b" class="chickenbro-anchor"></view>
      </view>
    </scroll-view>

    <view class="chickenbro-error" wx:if="{{requestError}}">
      <text>{{requestError}}</text>
      <text class="chickenbro-retry" bindtap="retryChickenbroMessage">重试</text>
    </view>

    <view class="chickenbro-inputbar">
      <view class="chickenbro-new-topic" bindtap="startNewTopic">新话题</view>
      <textarea
        class="chickenbro-input"
        value="{{chatDraft}}"
        placeholder="问炸鸡队长"
        disabled="{{loading}}"
        auto-height="{{false}}"
        fixed="{{false}}"
        cursor-spacing="20"
        adjust-position="{{true}}"
        maxlength="800"
        bindinput="updateChatDraft"
        bindfocus="handleInputFocus"
        bindblur="handleInputBlur"
      ></textarea>
      <view class="chickenbro-send {{loading ? 'is-disabled' : ''}}" bindtap="submitChickenbroMessage">
        {{loading ? '发送中' : '发送'}}
      </view>
    </view>
  </view>

  <view class="chickenbro-drawer-mask" wx:if="{{topicDrawerVisible}}" bindtap="closeTopicDrawer"></view>
  <view class="chickenbro-drawer" wx:if="{{topicDrawerVisible}}">
    <view class="chickenbro-drawer-head">
      <text>当前话题</text>
      <text bindtap="closeTopicDrawer">关闭</text>
    </view>
    <text class="chickenbro-drawer-copy">{{session && session.title ? session.title : '当前话题'}}</text>
    <text class="chickenbro-drawer-copy">{{generationStatusText}}</text>
  </view>
</view>
