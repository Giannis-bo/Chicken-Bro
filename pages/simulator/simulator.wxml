<view class="page-shell">
  <navigation-bar title="{{navTitle}}" back="{{false}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content">
      <view class="hero simulator-hero">
        <text class="hero-kicker">{{kicker}}</text>
        <text class="hero-title">{{title}}</text>
        <text class="hero-desc">{{desc}}</text>
      </view>

      <view class="analysis-modules">
        <view
          class="analysis-module-card module-{{item.key}}"
          wx:for="{{analysisModules}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="openAnalysisModule"
        >
          <view class="module-heading">
            <text class="module-badge">{{item.badge}}</text>
            <text class="module-action">{{item.action}}</text>
          </view>
          <text class="module-title">{{item.title}}</text>
          <text class="module-desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="section task-section">
        <view class="section-header">
          <text class="section-title">任务列表</text>
          <text class="section-action">最近记录</text>
        </view>
        <view class="task-list">
          <view
            class="task-card"
            wx:for="{{tasks}}"
            wx:key="taskId"
            data-task-id="{{item.taskId}}"
            bindtap="openTaskDetail"
          >
            <view class="task-row">
              <text class="task-title">{{item.title}}</text>
              <text class="task-status">{{item.status}}</text>
            </view>
            <text class="task-desc" user-select="{{true}}">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
