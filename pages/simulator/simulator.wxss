.simulator-hero {
  border-color: rgba(248, 183, 0, 0.28);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28), inset 0 0 0 1rpx rgba(139, 63, 245, 0.16);
}

.analysis-modules {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.analysis-module-card {
  min-height: 156rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.24);
}

.module-simc {
  border-color: rgba(139, 63, 245, 0.28);
  background: linear-gradient(135deg, rgba(139, 63, 245, 0.16), #151515 54%);
}

.module-wcl {
  border-color: rgba(248, 183, 0, 0.28);
  background: linear-gradient(135deg, rgba(248, 183, 0, 0.14), #151515 62%);
}

.module-chickenbro {
  border-color: rgba(91, 214, 180, 0.3);
  background: linear-gradient(135deg, rgba(28, 112, 95, 0.16), #151515 58%);
}

.module-tasks {
  border-color: rgba(255, 255, 255, 0.12);
}

.module-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.module-badge {
  flex: none;
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.module-action {
  flex: none;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 800;
}

.module-title {
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.module-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(225, 226, 229, 0.72);
  font-size: 23rpx;
  line-height: 1.4;
}

.task-section {
  border-color: rgba(255, 255, 255, 0.08);
}
