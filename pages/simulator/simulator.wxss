.chickenbro-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: 100vh;
  overflow: hidden;
  color: #f4ead9;
  background:
    linear-gradient(180deg, rgba(7, 7, 6, 0.98), rgba(0, 0, 0, 1)),
    #050504;
  box-sizing: border-box;
}

.chickenbro-panel {
  flex: 1 1 auto;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  min-height: 0;
  margin: 18rpx 24rpx var(--wow-tabbar-space);
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.06), transparent 32%),
    linear-gradient(180deg, rgba(12, 11, 8, 0.98), rgba(3, 3, 3, 0.99)),
    #050504;
  box-sizing: border-box;
}

.chickenbro-head {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  padding: 24rpx 24rpx 18rpx;
  box-sizing: border-box;
}

.chickenbro-avatar {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid rgba(246, 231, 193, 0.26);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(246, 231, 193, 0.32), rgba(246, 231, 193, 0.04) 12%, rgba(0, 0, 0, 0.88) 58%),
    #090807;
}

.chickenbro-title-block {
  display: grid;
  gap: 7rpx;
  min-width: 0;
}

.chickenbro-title,
.chickenbro-desc,
.chickenbro-copy,
.chickenbro-meta,
.chickenbro-drawer-copy {
  display: block;
  min-width: 0;
  letter-spacing: 0;
}

.chickenbro-title,
.chickenbro-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chickenbro-title {
  color: #fff8ea;
  font-size: 34rpx;
  font-weight: 1000;
  line-height: 1.1;
}

.chickenbro-desc {
  color: rgba(244, 234, 217, 0.62);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.chickenbro-topic,
.chickenbro-new-topic,
.chickenbro-send,
.chickenbro-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 8rpx;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 1000;
  line-height: 1;
  box-sizing: border-box;
}

.chickenbro-topic {
  gap: 12rpx;
}

.chickenbro-topic-arrow {
  font-size: 34rpx;
  line-height: 1;
}

.chickenbro-scroll {
  min-width: 0;
  min-height: 0;
  height: 100%;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.22);
}

.chickenbro-messages {
  display: grid;
  align-content: start;
  gap: 18rpx;
  min-height: 100%;
  padding: 22rpx;
  box-sizing: border-box;
}

.chickenbro-context,
.chickenbro-evidence-strip {
  min-width: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background: rgba(7, 6, 4, 0.58);
  box-sizing: border-box;
}

.chickenbro-context {
  display: grid;
  gap: 6rpx;
  padding: 16rpx 18rpx;
}

.chickenbro-context-kicker,
.chickenbro-evidence-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: rgba(244, 234, 217, 0.56);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chickenbro-context-title,
.chickenbro-evidence-value {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 1000;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chickenbro-message {
  display: flex;
  min-width: 0;
}

.chickenbro-message.message-user {
  justify-content: flex-end;
}

.chickenbro-bubble {
  max-width: 82%;
  min-width: 0;
  padding: 20rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(20, 18, 13, 0.96), rgba(9, 9, 8, 0.96)),
    #0b0a08;
  box-sizing: border-box;
}

.message-user .chickenbro-bubble {
  border-color: rgba(98, 227, 154, 0.28);
  background:
    linear-gradient(180deg, rgba(13, 29, 20, 0.96), rgba(8, 11, 9, 0.96)),
    #07100c;
}

.chickenbro-copy {
  color: #fff8ea;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.42;
  overflow-wrap: anywhere;
}

.chickenbro-meta {
  margin-top: 10rpx;
  color: rgba(244, 234, 217, 0.56);
  font-size: 20rpx;
  font-weight: 800;
}

.answer-layer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.answer-layer-chip {
  flex: none;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.28);
  border-radius: 8rpx;
  color: #5bd6b4;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.answer-basis {
  min-width: 0;
  color: rgba(225, 226, 229, 0.72);
  font-size: 21rpx;
  line-height: 1.3;
}

.answer-action {
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.answer-action-title {
  display: block;
  color: #e1e2e5;
  font-size: 23rpx;
  line-height: 1.4;
}

.answer-action-ref {
  display: block;
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 20rpx;
  line-height: 1.3;
}

.coach-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.coach-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f8b700;
  font-size: 21rpx;
  line-height: 1.3;
}

.limitation-chip {
  color: #ffb09d;
}

.missing-chip {
  color: #8ad6ff;
}

.next-question {
  display: flex;
  gap: 10rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.next-question-label {
  flex: none;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.35;
}

.next-question-text {
  flex: 1;
  min-width: 0;
  color: #e1e2e5;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-word;
}

.chickenbro-anchor,
.chat-bottom-anchor {
  height: 2rpx;
}

.chickenbro-prompt-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  min-width: 0;
}

.chickenbro-prompt {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 58rpx;
  padding: 0 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 8rpx;
  background: rgba(248, 183, 0, 0.07);
  box-sizing: border-box;
}

.chickenbro-prompt text {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chickenbro-evidence-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  overflow: hidden;
}

.chickenbro-evidence-cell {
  min-width: 0;
  padding: 14rpx 16rpx;
}

.chickenbro-evidence-cell + .chickenbro-evidence-cell {
  border-left: 1rpx solid rgba(248, 183, 0, 0.14);
}

.chickenbro-error {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 22rpx;
  border-top: 1rpx solid rgba(255, 107, 100, 0.32);
  color: #ffb2ad;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.chickenbro-inputbar {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr) 92rpx;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 16rpx 22rpx 18rpx;
  border-top: 1rpx solid rgba(248, 183, 0, 0.24);
  background:
    linear-gradient(180deg, rgba(12, 11, 9, 0.95), rgba(4, 4, 3, 0.98)),
    #070605;
  box-sizing: border-box;
}

.chickenbro-new-topic,
.chickenbro-send {
  min-height: 60rpx;
}

.chickenbro-input {
  width: 100%;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  max-height: 132rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  color: #f4ead9;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  background: rgba(4, 4, 3, 0.92);
  box-sizing: border-box;
}

.chickenbro-send.is-disabled {
  opacity: 0.52;
}

.chickenbro-drawer-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.48);
}

.chickenbro-drawer {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: var(--wow-tabbar-space);
  z-index: 1001;
  display: grid;
  gap: 12rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 8rpx;
  background: #080706;
  box-sizing: border-box;
}

.chickenbro-drawer-head {
  display: flex;
  justify-content: space-between;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 1000;
}

.chickenbro-drawer-copy {
  color: rgba(244, 234, 217, 0.68);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}
