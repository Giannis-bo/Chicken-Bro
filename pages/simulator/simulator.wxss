.simulator-hero {
  border-color: rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #493477 0%, #1a1128 58%, #060606 100%);
  box-shadow: 0 18rpx 44rpx rgba(73, 52, 119, 0.28);
}

.analysis-modules {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.analysis-module-card {
  min-height: 188rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.module-simc {
  border-color: rgba(139, 63, 245, 0.36);
  background: linear-gradient(135deg, rgba(73, 52, 119, 0.92), #151515 68%);
}

.module-wcl {
  border-color: rgba(248, 183, 0, 0.28);
  background: linear-gradient(135deg, rgba(248, 183, 0, 0.14), #151515 62%);
}

.module-tasks {
  border-color: rgba(255, 255, 255, 0.12);
}

.module-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.module-badge {
  flex: none;
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.module-action {
  flex: none;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 800;
}

.module-title {
  display: block;
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.module-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(225, 226, 229, 0.72);
  font-size: 25rpx;
  line-height: 1.5;
}

.task-section {
  border-color: rgba(255, 255, 255, 0.08);
}
