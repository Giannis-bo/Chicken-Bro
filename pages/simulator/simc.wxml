<view class="page-shell simc-page-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll simc-scroll" scroll-y type="list">
    <view class="simc-page">
    <view class="template-hero">
      <view>
        <text class="context-kicker">{{kicker}}</text>
        <text class="context-title">{{title}}</text>
      </view>
      <text class="context-desc">{{desc}}</text>
    </view>

    <view class="identity-selector-row">
        <view class="template-selector compact-selector class-selector identity-selector-card">
          <view class="selector-row">
            <view class="selector-title-group">
              <text class="section-title">职业</text>
            </view>
            <view class="selector-picker {{!classOptions.length ? 'selector-disabled' : ''}}" data-selector="class" bindtap="openSelectorSheet">
              <view class="toolbar-picker {{!classOptions.length ? 'toolbar-picker-disabled' : ''}}">
                <text class="picker-value">{{selectedClassName || '请选择职业'}}</text>
              </view>
            </view>
          </view>
          <view class="empty-state" wx:if="{{emptyState.class}}">
            <text>{{emptyState.class}}</text>
          </view>
        </view>

        <view class="template-selector compact-selector race-selector identity-selector-card">
          <view class="selector-row">
            <view class="selector-title-group">
              <text class="section-title">种族</text>
            </view>
            <view class="selector-picker" data-selector="race" bindtap="openSelectorSheet">
              <view class="toolbar-picker">
                <text class="picker-value">{{selectedRaceName || '请选择种族'}}</text>
              </view>
            </view>
          </view>
        </view>
    </view>

        <view class="template-selector compact-selector">
          <view class="selector-row">
            <view class="selector-title-group">
              <text class="section-title">天赋模板</text>
              <text class="section-meta">{{talentTemplates.length}} 个配置</text>
            </view>
            <view class="selector-picker {{!talentTemplates.length ? 'selector-disabled' : ''}}" data-selector="talent" bindtap="openSelectorSheet">
              <view class="toolbar-picker {{!talentTemplates.length ? 'toolbar-picker-disabled' : ''}}">
                <text class="picker-value">{{selectedTalentTemplate ? selectedTalentTemplate.title : (emptyState.talent || '尚未保存天赋模板')}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="template-selector compact-selector">
          <view class="selector-row">
            <view class="selector-title-group">
              <text class="section-title">装备模板</text>
              <text class="section-meta">{{gearTemplates.length}} 个配置</text>
            </view>
            <view class="selector-picker {{!gearTemplates.length ? 'selector-disabled' : ''}}" data-selector="gear" bindtap="openSelectorSheet">
              <view class="toolbar-picker {{!gearTemplates.length ? 'toolbar-picker-disabled' : ''}}">
                <text class="picker-value">{{selectedGearTemplate ? selectedGearTemplate.title : (emptyState.gear || '尚未保存装备模板')}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="template-selector scenario-selector">
          <view class="section-header">
            <text class="section-title">场景预设</text>
          </view>
          <view class="segmented-row">
            <view
              class="segment-button {{selectedScenarioKey === item.key ? 'segment-selected' : ''}}"
              wx:for="{{scenarioOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="selectScenario"
            >
              <text class="segment-title">{{item.title}}</text>
              <text class="segment-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>

        <view class="combat-preparation-panel">
          <view class="section-header">
            <text class="section-title">战斗增益</text>
          </view>
          <view class="preparation-policy-list">
            <view class="preparation-policy-row" wx:for="{{combatPreparationRows}}" wx:key="key">
              <text class="preparation-policy-label">{{item.label}}</text>
              <text class="preparation-policy-value">{{item.value}}</text>
            </view>
          </view>
          <view class="temporary-buff-list">
            <view
              class="temporary-buff-row {{item.enabled ? 'temporary-buff-enabled' : ''}}"
              wx:for="{{temporaryBuffOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="toggleTemporaryBuff"
            >
              <view class="temporary-buff-copy">
                <text class="temporary-buff-title">{{item.title}}</text>
                <text class="temporary-buff-desc">{{item.desc}}</text>
              </view>
              <view class="temporary-buff-toggle {{item.enabled ? 'temporary-buff-toggle-on' : ''}}">
                <view class="temporary-buff-knob"></view>
              </view>
            </view>
          </view>
        </view>

        <view class="confirm-summary">
          <view class="section-header">
            <text class="section-title">确认摘要</text>
          </view>
          <view class="summary-layout">
            <view class="summary-left">
              <view class="summary-row">
                <text class="summary-label">职业</text>
                <text class="summary-value">{{selectedClassName || '未选择'}}</text>
              </view>
              <view class="summary-row">
                <text class="summary-label">种族</text>
                <text class="summary-value">{{selectedRaceName || '未选择'}}</text>
              </view>
              <view class="summary-row">
                <text class="summary-label">天赋</text>
                <text class="summary-value">{{selectedTalentTemplate ? selectedTalentTemplate.title : '未选择'}}</text>
              </view>
              <view class="summary-row">
                <text class="summary-label">装备</text>
                <text class="summary-value">{{selectedGearTemplate ? selectedGearTemplate.title : '未选择'}}</text>
              </view>
              <view class="summary-row">
                <text class="summary-label">场景</text>
                <text class="summary-value">{{selectedScenarioTitle || selectedScenarioKey}}</text>
              </view>
            </view>
            <view class="summary-stat-panel">
              <view class="summary-stat-row summary-primary-row">
                <text class="summary-stat-label">{{summaryStatPanel.primary.label}}</text>
                <text class="summary-primary-value">{{summaryStatPanel.primary.valueText}}</text>
              </view>
              <view class="summary-stat-row" wx:for="{{summaryStatPanel.secondaryRows}}" wx:key="key">
                <text class="summary-stat-label">{{item.label}}</text>
                <text class="summary-secondary-percent">{{item.percentText}}</text>
              </view>
              <text class="summary-stat-note" wx:if="{{summaryStatPanel.noteText}}">{{summaryStatPanel.noteText}}</text>
            </view>
          </view>
        </view>

        <view class="blocked-panel" wx:if="{{blockedReasons.length}}">
          <text class="blocked-title">暂不能提交</text>
          <view class="blocked-reason" wx:for="{{blockedReasons}}" wx:key="*this">
            <text>{{item}}</text>
          </view>
        </view>

        <view class="result-panel" wx:if="{{latestAnalysis && latestAnalysis.agent && !blockedReasons.length}}">
          <text class="result-title">{{latestAnalysis.agent.status}}</text>
          <text class="result-desc">{{resultSummary}}</text>
        </view>

        <view class="preparation-panel" wx:if="{{latestAnalysis && latestAnalysis.simcReport && latestAnalysis.simcReport.preparation && latestAnalysis.simcReport.preparation.summary}}">
          <view class="section-header">
            <text class="section-title">模拟增益</text>
            <text class="section-meta">{{latestAnalysis.simcReport.preparation.evidenceState}}</text>
          </view>
          <text class="preparation-summary">{{latestAnalysis.simcReport.preparation.summary}}</text>
          <view class="preparation-list" wx:if="{{latestAnalysis.simcReport.preparation.items && latestAnalysis.simcReport.preparation.items.length}}">
            <view class="preparation-row" wx:for="{{latestAnalysis.simcReport.preparation.items}}" wx:key="key">
              <text class="preparation-label">{{item.label}}</text>
              <text class="preparation-state">{{item.state}}</text>
            </view>
          </view>
        </view>
    </view>
  </scroll-view>

  <view class="action-bar">
      <view
        class="confirm-button action-button {{!canConfirm || confirming || submittingTask ? 'action-disabled' : ''}} {{confirming ? 'action-loading' : ''}}"
        bindtap="confirmTemplateSimulation"
      >
        <view class="button-spinner" wx:if="{{confirming}}"></view>
        <text class="button-label">{{confirming ? '校验中' : '校验组合'}}</text>
      </view>
      <view
        class="submit-button task-submit-button action-button {{canSubmitTask ? 'submit-ready' : ''}} {{!canSubmitTask || submittingTask || taskSubmitted ? 'action-disabled' : ''}} {{submittingTask ? 'action-loading' : ''}}"
        bindtap="submitConfirmedTask"
      >
        <view class="button-spinner" wx:if="{{submittingTask}}"></view>
        <text class="button-label">{{submittingTask ? '提交中' : (taskSubmitted ? '任务已提交' : '提交任务')}}</text>
      </view>
  </view>

  <view class="selector-sheet-mask" wx:if="{{selectorSheet.visible}}" catchtap="closeSelectorSheet"></view>
  <view class="selector-sheet" wx:if="{{selectorSheet.visible}}">
      <view class="selector-sheet-handle"></view>
      <view class="selector-sheet-header">
        <view class="selector-sheet-title-group">
          <text class="selector-sheet-kicker">{{selectorSheet.kicker}}</text>
          <text class="selector-sheet-title">{{selectorSheet.title}}</text>
        </view>
        <view class="selector-sheet-close" bindtap="closeSelectorSheet">关闭</view>
      </view>
      <view class="selector-sheet-list">
        <view
          class="selector-sheet-option {{item.selected ? 'selected' : ''}}"
          wx:for="{{selectorSheet.options}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="selectSelectorOption"
        >
          <view class="selector-sheet-option-copy">
            <text class="selector-sheet-option-title">{{item.label}}</text>
            <text class="selector-sheet-option-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="selector-sheet-check" wx:if="{{item.selected}}">已选</text>
        </view>
        <view class="selector-sheet-empty" wx:if="{{selectorSheet.emptyText}}">
          <text>{{selectorSheet.emptyText}}</text>
        </view>
      </view>
  </view>
</view>
