<view class="page-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <view class="simc-page">
    <view class="chat-context">
      <view>
        <text class="context-kicker">{{kicker}}</text>
        <text class="context-title">{{title}}</text>
      </view>
      <text class="context-desc">{{desc}}</text>
    </view>

    <view class="context-source" wx:if="{{buildContextTitle}}">
      <text class="context-source-label">已带入</text>
      <text class="context-source-title">{{buildContextTitle}}</text>
    </view>

    <view class="chat-panel">
      <view class="chat-header">
        <text class="chat-title">SimC 需求确认</text>
        <text class="chat-round">已交流 {{conversationRound}} 轮</text>
      </view>

      <scroll-view class="chat-messages" scroll-y scroll-into-view="{{chatAnchor}}" type="list">
        <view
          class="chat-row chat-row-{{item.role}}"
          wx:for="{{messages}}"
          wx:key="id"
        >
          <view class="chat-bubble">
            <text user-select="{{true}}">{{item.text}}</text>
          </view>
        </view>
        <view id="chat-bottom"></view>
      </scroll-view>

      <view class="quick-reply-list" wx:if="{{latestAnalysis.agent && latestAnalysis.agent.quickReplies && latestAnalysis.agent.quickReplies.length && !canSubmitTask && !taskSubmitted}}">
        <button
          class="quick-reply"
          wx:for="{{latestAnalysis.agent.quickReplies}}"
          wx:key="*this"
          data-reply="{{item}}"
          bindtap="useQuickReply"
        >{{item}}</button>
      </view>

      <view class="chat-composer">
        <textarea
          class="chat-input"
          value="{{chatInput}}"
          maxlength="6000"
          auto-height="{{false}}"
          disabled="{{canSubmitTask || loadingChat || taskSubmitted}}"
          bindinput="updateChatInput"
          placeholder="输入职业专精、装等、目标场景，例如：290元素萨大秘境AOE"
        />
        <button class="send-button" loading="{{loadingChat}}" disabled="{{canSubmitTask || loadingChat || taskSubmitted}}" bindtap="sendChatMessage">发送</button>
      </view>

      <button
        class="submit-button task-submit-button {{canSubmitTask ? 'submit-ready' : ''}}"
        loading="{{submittingTask}}"
        disabled="{{!canSubmitTask || submittingTask || taskSubmitted}}"
        bindtap="submitConfirmedTask"
      >{{taskSubmitted ? '任务已提交' : '提交任务'}}</button>
    </view>
  </view>
</view>
