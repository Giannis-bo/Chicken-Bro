.wcl-hero {
  border-color: rgba(248, 183, 0, 0.42);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28), inset 0 0 0 1rpx rgba(248, 183, 0, 0.14);
}

.wcl-panel {
  gap: 18rpx;
  border-color: rgba(248, 183, 0, 0.18);
}

.wcl-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 210rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.26);
  border-radius: 12rpx;
  background: #101010;
  color: #e1e2e5;
  font-size: 24rpx;
  line-height: 1.44;
}

.submit-button {
  width: 100%;
  min-height: 72rpx;
  border-radius: 12rpx;
  background: #f8b700;
  color: #17120a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.submit-button[disabled] {
  background: #4c3a14;
  color: rgba(255, 255, 255, 0.62);
}

.submit-button::after {
  border: 0;
}

.ai-advice-card {
  border-color: rgba(248, 183, 0, 0.22);
}

.wcl-evidence-card {
  border-color: rgba(112, 178, 255, 0.24);
  background: rgba(12, 20, 32, 0.84);
}

.wcl-evidence-grid {
  display: grid;
  gap: 10rpx;
  color: #cdd6e2;
  font-size: 23rpx;
  line-height: 1.45;
}

.wcl-report-finding {
  border-color: rgba(248, 183, 0, 0.2);
}

.wcl-evidence-refs {
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 21rpx;
  line-height: 1.4;
}

.ai-advice-text {
  white-space: pre-wrap;
}
