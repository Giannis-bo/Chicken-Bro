.task-detail-content {
  padding-bottom: 72rpx;
}

.task-detail-hero {
  padding: 30rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.42);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #493477 0%, #151515 66%);
  box-shadow: 0 18rpx 44rpx rgba(73, 52, 119, 0.26);
}

.detail-kicker {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  color: rgba(225, 226, 229, 0.68);
  font-size: 22rpx;
}

.detail-summary {
  display: block;
  margin-top: 18rpx;
  color: #e1e2e5;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-list-item {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #101010;
  color: #d9dadd;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.detail-text {
  color: #d9dadd;
  word-break: break-all;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.detail-question-text {
  display: block;
  line-height: 1.55;
}

.build-context-box {
  border-color: rgba(248, 183, 0, 0.18);
}

.report-explanation-box {
  border-color: rgba(64, 180, 136, 0.24);
}

.report-finding {
  border: 1rpx solid rgba(64, 180, 136, 0.18);
}

.report-evidence {
  display: block;
  margin-top: 10rpx;
  color: rgba(155, 228, 193, 0.72);
  font-size: 21rpx;
  line-height: 1.35;
  word-break: break-all;
}

.report-sublist {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.report-subtitle {
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  font-weight: 800;
}

.report-note-row {
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #d9dadd;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.benchmark-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.benchmark-cell {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #101010;
}

.result-strip {
  display: flex;
  gap: 14rpx;
}

.result-cell {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.22);
  border-radius: 12rpx;
  background: #101010;
}

.benchmark-label {
  display: block;
  color: rgba(255, 255, 255, 0.52);
  font-size: 21rpx;
  font-weight: 700;
}

.benchmark-unit {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
  font-weight: 700;
}

.benchmark-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.stage-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #101010;
}

.stage-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.stage-summary {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.loading-section {
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14rpx;
}

.loading-text {
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-warning-text {
  color: #f8b700;
  font-size: 23rpx;
}
