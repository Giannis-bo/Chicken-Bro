<view class="page-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content task-detail-content">
      <view wx:if="{{loading}}" class="section loading-section">
        <text class="loading-text">加载中</text>
      </view>

      <view wx:elif="{{detail}}">
        <view class="task-detail-hero">
          <text class="detail-kicker">任务详情</text>
          <text class="detail-title">{{detail.heroTitle}}</text>
          <text class="detail-summary" user-select="{{true}}">{{detail.briefConclusion}}</text>
          <view class="detail-meta-row">
            <text>{{detail.statusText}}</text>
            <text>{{detail.createdAtText}}</text>
          </view>
        </view>

        <view class="section">
          <view class="section-header">
            <text class="section-title">SimC 结果</text>
            <text class="section-action">{{detail.simcStatusText}}</text>
          </view>
          <view class="result-strip">
            <view class="result-cell">
              <text class="benchmark-label">{{detail.simcMetricLabel}}</text>
              <text class="benchmark-unit">{{detail.simcUnitText}}</text>
              <text class="benchmark-value">{{detail.simcDisplayValue}}</text>
            </view>
          </view>
        </view>

        <view class="section simc-context-section" wx:if="{{detail.hasRunContext}}">
          <view class="section-header">
            <text class="section-title">模拟上下文</text>
            <text class="section-action">{{detail.scenarioDisplayText}}</text>
          </view>
          <view class="context-card" wx:if="{{detail.scenarioDisplayText}}">
            <text class="benchmark-label">场景</text>
            <text class="benchmark-value">{{detail.scenarioDisplayText}}</text>
            <text class="benchmark-unit" wx:if="{{detail.scenarioMetaText}}">{{detail.scenarioMetaText}}</text>
          </view>
          <view class="stat-context-grid" wx:if="{{detail.statRows.length}}">
            <view class="stat-context-cell" wx:for="{{detail.statRows}}" wx:key="key">
              <text class="benchmark-label">{{item.label}}</text>
              <text class="benchmark-value">{{item.valueText}}</text>
            </view>
          </view>
        </view>

      </view>

      <view wx:else class="section loading-section">
        <text class="loading-text">未找到这个任务</text>
        <text wx:if="{{requestError}}" class="detail-warning-text">{{requestError}}</text>
      </view>
    </view>
  </scroll-view>
</view>
