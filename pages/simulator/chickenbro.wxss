.chickenbro-hero {
  border-color: rgba(248, 183, 0, 0.28);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28), inset 0 0 0 1rpx rgba(91, 214, 180, 0.18);
}

.chickenbro-panel {
  gap: 18rpx;
  border-color: rgba(91, 214, 180, 0.18);
}

.chickenbro-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 210rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.28);
  border-radius: 12rpx;
  background: #101010;
  color: #e1e2e5;
  font-size: 24rpx;
  line-height: 1.44;
}

.chickenbro-context {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.22);
  border-radius: 10rpx;
  background: #12100d;
  color: #d8c48a;
  font-size: 22rpx;
  line-height: 1.35;
}

.submit-button {
  width: 100%;
  min-height: 72rpx;
  border-radius: 12rpx;
  background: #5bd6b4;
  color: #06110f;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.submit-button[disabled] {
  background: #264940;
  color: rgba(255, 255, 255, 0.62);
}

.submit-button::after {
  border: 0;
}

.request-error {
  color: #f39a7d;
  font-size: 22rpx;
  line-height: 1.4;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.chat-message {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.045);
}

.assistant-message {
  border-color: rgba(91, 214, 180, 0.24);
  background: rgba(16, 45, 38, 0.56);
}

.user-message {
  border-color: rgba(248, 183, 0, 0.2);
  background: rgba(42, 32, 10, 0.46);
}

.chat-role {
  color: #f3d27a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.chat-content {
  color: #e1e2e5;
  font-size: 24rpx;
  line-height: 1.46;
}

.coach-summary-card,
.coach-action-card {
  border-color: rgba(91, 214, 180, 0.22);
}

.coach-missing-card {
  border-color: rgba(248, 183, 0, 0.24);
  background: rgba(42, 32, 10, 0.72);
}

.coach-next-card {
  border-color: rgba(112, 178, 255, 0.22);
}

.coach-evidence-refs {
  display: block;
  margin-top: 10rpx;
  color: #8a96a8;
  font-size: 21rpx;
  line-height: 1.4;
}

.coach-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.coach-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f3d27a;
  font-size: 22rpx;
  line-height: 1.3;
}
