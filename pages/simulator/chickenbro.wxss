.chickenbro-page-shell {
  position: relative;
  overflow: hidden;
}

.chickenbro-chat-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 18rpx 22rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #060606;
}

.chickenbro-route-shell {
  background: #060606;
}

.chat-header {
  flex: none;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 10rpx 0 18rpx;
}

.chat-title-block {
  flex: 1;
  min-width: 0;
}

.chat-title {
  display: block;
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.12;
}

.chat-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(225, 226, 229, 0.72);
  font-size: 23rpx;
  line-height: 1.42;
}

.chat-header-action {
  flex: none;
  min-width: 92rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.28);
  border-radius: 8rpx;
  color: #5bd6b4;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.chat-message-list {
  min-height: 100%;
  padding: 10rpx 0 20rpx;
}

.chat-message-row {
  display: flex;
  width: 100%;
  margin: 14rpx 0;
}

.message-row-assistant {
  justify-content: flex-start;
}

.message-row-user {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 82%;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  background: #151515;
}

.bubble-assistant {
  border-color: rgba(91, 214, 180, 0.26);
  background: #102d26;
}

.bubble-user {
  border-color: rgba(248, 183, 0, 0.24);
  background: #2a200a;
}

.bubble-pending {
  opacity: 0.78;
}

.bubble-failed {
  border-color: rgba(255, 107, 100, 0.42);
  background: #2a1210;
}

.chat-speaker,
.chat-role {
  display: block;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.chat-content {
  display: block;
  margin-top: 8rpx;
  color: #e1e2e5;
  font-size: 25rpx;
  line-height: 1.48;
  word-break: break-word;
}

.chat-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(225, 226, 229, 0.54);
  font-size: 20rpx;
  line-height: 1.2;
}

.answer-evidence {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  background: #101010;
}

.answer-evidence-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.answer-evidence-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.answer-evidence-source {
  flex: none;
  color: #5bd6b4;
  font-size: 21rpx;
  font-weight: 800;
}

.answer-layer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.answer-layer-chip {
  flex: none;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.28);
  border-radius: 8rpx;
  color: #5bd6b4;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.answer-basis {
  min-width: 0;
  color: rgba(225, 226, 229, 0.72);
  font-size: 21rpx;
  line-height: 1.3;
}

.answer-action {
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.answer-action-title {
  display: block;
  color: #e1e2e5;
  font-size: 23rpx;
  line-height: 1.4;
}

.answer-action-ref {
  display: block;
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 20rpx;
  line-height: 1.3;
}

.coach-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.coach-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f8b700;
  font-size: 21rpx;
  line-height: 1.3;
}

.limitation-chip {
  color: #ffb09d;
}

.missing-chip {
  color: #8ad6ff;
}

.next-question {
  display: flex;
  gap: 10rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.next-question-label {
  flex: none;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.35;
}

.next-question-text {
  flex: 1;
  min-width: 0;
  color: #e1e2e5;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-word;
}

.chat-bottom-anchor {
  height: 2rpx;
}

.chat-status-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 19;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 10rpx 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(6, 6, 6, 0.94);
}

.chat-status-text {
  flex: 1;
  min-width: 0;
  color: rgba(225, 226, 229, 0.7);
  font-size: 21rpx;
  line-height: 1.3;
}

.chat-status-job {
  flex: none;
  color: #5bd6b4;
  font-size: 20rpx;
  font-weight: 800;
}

.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  background: #080808;
}

.topic-shortcut {
  flex: none;
  width: 112rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 8rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  max-height: 160rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: #151515;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.35;
}

.send-button {
  flex: none;
  width: 104rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #5bd6b4;
  color: #06110f;
  font-size: 23rpx;
  font-weight: 900;
}

.send-button-loading {
  background: #264940;
  color: rgba(255, 255, 255, 0.62);
}

.topic-drawer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 28;
  background: rgba(0, 0, 0, 0.48);
}

.topic-drawer {
  position: fixed;
  right: 0;
  top: 180rpx;
  bottom: 0;
  z-index: 29;
  width: 600rpx;
  max-width: 88vw;
  padding: 22rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  background: #101010;
  box-shadow: -20rpx 0 44rpx rgba(0, 0, 0, 0.38);
}

.topic-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.topic-drawer-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.topic-drawer-close {
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 800;
}

.topic-item {
  padding: 18rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.22);
  border-radius: 8rpx;
  background: #102d26;
}

.topic-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.32;
}

.topic-meta {
  display: block;
  margin-top: 8rpx;
  color: rgba(225, 226, 229, 0.62);
  font-size: 21rpx;
  line-height: 1.3;
}
