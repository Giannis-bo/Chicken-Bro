.chickenbro-hero {
  border-color: rgba(91, 214, 180, 0.4);
  background: linear-gradient(135deg, #1c705f 0%, #10221f 58%, #060606 100%);
  box-shadow: 0 18rpx 44rpx rgba(28, 112, 95, 0.2);
}

.chickenbro-panel {
  gap: 18rpx;
  border-color: rgba(91, 214, 180, 0.18);
}

.chickenbro-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 260rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(91, 214, 180, 0.28);
  border-radius: 16rpx;
  background: #101010;
  color: #e1e2e5;
  font-size: 25rpx;
  line-height: 1.55;
}

.submit-button {
  width: 100%;
  min-height: 84rpx;
  border-radius: 16rpx;
  background: #5bd6b4;
  color: #06110f;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.submit-button[disabled] {
  background: #264940;
  color: rgba(255, 255, 255, 0.62);
}

.submit-button::after {
  border: 0;
}

.coach-summary-card,
.coach-action-card {
  border-color: rgba(91, 214, 180, 0.22);
}

.coach-missing-card {
  border-color: rgba(248, 183, 0, 0.24);
  background: rgba(42, 32, 10, 0.72);
}

.coach-next-card {
  border-color: rgba(112, 178, 255, 0.22);
}

.coach-evidence-refs {
  display: block;
  margin-top: 10rpx;
  color: #8a96a8;
  font-size: 21rpx;
  line-height: 1.4;
}

.coach-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.coach-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f3d27a;
  font-size: 22rpx;
  line-height: 1.3;
}
