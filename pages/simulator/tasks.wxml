<view class="page-shell task-list-page">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content task-list-content">
      <view class="section task-list-section">
        <view class="section-header">
          <text class="section-title">任务列表</text>
          <text class="section-action">最近记录</text>
        </view>

        <view class="task-loading" wx:if="{{loading}}">
          <text>加载中</text>
        </view>

        <view class="task-list" wx:elif="{{tasks.length}}">
          <view
            class="task-list-card"
            wx:for="{{tasks}}"
            wx:key="taskId"
            data-task-id="{{item.taskId}}"
            bindtap="openTaskDetail"
          >
            <view class="task-row">
              <text class="task-title">{{item.title}}</text>
              <text class="task-status {{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="task-tags" wx:if="{{item.tags.length}}">
              <text
                class="task-tag"
                wx:for="{{item.tags}}"
                wx:for-item="tag"
                wx:key="key"
              >{{tag.text}}</text>
            </view>
            <text wx:if="{{item.desc}}" class="task-desc" user-select="{{true}}">{{item.desc}}</text>
            <text class="task-finished-at">{{item.completionTimeText}}</text>
          </view>
        </view>

        <view class="task-empty" wx:else>
          <text>暂无任务记录</text>
          <text wx:if="{{requestError}}" class="task-error">{{requestError}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
