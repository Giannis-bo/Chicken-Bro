.builds-shell {
  background: #060606;
}

.builds-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.builds-hero {
  border: 1rpx solid rgba(248, 183, 0, 0.3);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28), inset 0 0 0 1rpx rgba(139, 63, 245, 0.16);
}

.builds-hero::after {
  background: rgba(248, 183, 0, 0.18);
}

.builds-hero .hero-kicker {
  border: 1rpx solid rgba(139, 63, 245, 0.28);
  background: rgba(139, 63, 245, 0.14);
  color: #d7c3ff;
}

.builds-hero .hero-title {
  color: #ffffff;
}

.builds-hero .hero-desc {
  color: rgba(225, 226, 229, 0.8);
}

.query-section {
  border-color: rgba(255, 255, 255, 0.08);
  background: #151515;
}

.section-title {
  color: #f1f1f1;
}

.section-action {
  color: #f8b700;
}

.query-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.query-card {
  min-height: 152rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
  box-shadow: inset 0 0 0 1rpx rgba(139, 63, 245, 0.12);
}

.query-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #8b3ff5;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.query-title {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.28;
}

.query-desc {
  display: block;
  min-height: 50rpx;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.35;
}

.query-link {
  display: block;
  margin-top: 10rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}
