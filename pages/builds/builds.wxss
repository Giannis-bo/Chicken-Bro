.builds-shell {
  background: #060606;
}

.builds-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.builds-hero {
  border: 1rpx solid rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #111111 0%, #1a1128 56%, #8b3ff5 150%);
  box-shadow: 0 18rpx 44rpx rgba(139, 63, 245, 0.18);
}

.builds-hero::after {
  background: rgba(248, 183, 0, 0.18);
}

.builds-hero .hero-kicker {
  background: rgba(139, 63, 245, 0.2);
  color: #c9a8ff;
}

.builds-hero .hero-title {
  color: #ffffff;
}

.builds-hero .hero-desc {
  color: rgba(225, 226, 229, 0.8);
}

.query-section,
.intel-section {
  border-color: rgba(255, 255, 255, 0.08);
  background: #151515;
}

.section-title {
  color: #f1f1f1;
}

.section-action {
  color: #f8b700;
}

.query-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.query-card {
  min-height: 184rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: inset 0 0 0 1rpx rgba(139, 63, 245, 0.12);
}

.query-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #8b3ff5;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.query-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.28;
}

.query-desc {
  display: block;
  min-height: 64rpx;
  margin-top: 10rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.45;
}

.query-link {
  display: block;
  margin-top: 14rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-card {
  height: 260rpx;
  padding: 22rpx;
  overflow: hidden;
  border-color: rgba(139, 63, 245, 0.18);
  background: #101010;
}

.intel-swiper {
  width: 100%;
  height: 300rpx;
}

.intel-swiper .wx-swiper-dots {
  bottom: 10rpx;
}

.task-status {
  background: rgba(139, 63, 245, 0.18);
  color: #c9a8ff;
}

.source-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #f8b700;
  font-size: 22rpx;
}

.source-note {
  display: block;
  margin-top: 8rpx;
  color: #8e8e8e;
  font-size: 22rpx;
  line-height: 1.45;
}
