.builds-shell {
  background: #edf3ff;
}

.builds-content {
  padding-bottom: 72rpx;
}

.builds-hero {
  border: 2rpx solid rgba(242, 201, 76, 0.38);
  background: linear-gradient(135deg, #153f8a 0%, #1f5bb8 58%, #f2c94c 160%);
  box-shadow: 0 18rpx 42rpx rgba(21, 63, 138, 0.2);
}

.builds-hero::after {
  background: rgba(242, 201, 76, 0.28);
}

.builds-hero .hero-kicker {
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.88);
}

.builds-hero .hero-title {
  color: #ffffff;
}

.builds-hero .hero-desc {
  color: rgba(255, 255, 255, 0.82);
}

.query-section,
.intel-section {
  border-color: rgba(21, 63, 138, 0.12);
  background: #ffffff;
}

.section-title {
  color: #153f8a;
}

.section-action {
  color: #b68a11;
}

.query-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.query-card {
  min-height: 188rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(21, 63, 138, 0.14);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #edf3ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(21, 63, 138, 0.08);
}

.query-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #153f8a;
  color: #f2c94c;
  font-size: 22rpx;
  font-weight: 700;
}

.query-title {
  display: block;
  margin-top: 18rpx;
  color: #12346f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.28;
}

.query-desc {
  display: block;
  min-height: 64rpx;
  margin-top: 10rpx;
  color: #58677d;
  font-size: 22rpx;
  line-height: 1.45;
}

.query-link {
  display: block;
  margin-top: 16rpx;
  color: #b68a11;
  font-size: 22rpx;
  font-weight: 700;
}

.intel-card {
  height: 260rpx;
  padding: 24rpx;
  overflow: hidden;
  border-color: rgba(21, 63, 138, 0.1);
  background: #fbfdff;
}

.intel-swiper {
  width: 100%;
  height: 300rpx;
}

.intel-swiper .wx-swiper-dots {
  bottom: 10rpx;
}

.task-status {
  background: #eef4ff;
  color: #153f8a;
}

.source-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #b68a11;
  font-size: 22rpx;
}

.source-note {
  display: block;
  margin-top: 8rpx;
  color: #6f7d92;
  font-size: 22rpx;
  line-height: 1.45;
}
