<view class="page-shell intel-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content intel-content">
      <view class="intel-hero">
        <text class="intel-kicker">查看全部</text>
        <text class="intel-title">{{title}}</text>
        <text class="intel-desc">{{desc}}</text>
        <text class="intel-count">{{count}} 条内容 · {{lastAnalyzedAt}}</text>
      </view>

      <view class="intel-list">
        <view
          class="intel-item"
          wx:for="{{items}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openSpecDetail"
        >
          <view class="intel-head">
            <view class="intel-name-block">
              <text class="intel-name">{{item.title}}</text>
              <text class="intel-role">{{item.status}}</text>
            </view>
            <text class="intel-arrow">查看构筑</text>
          </view>
          <text class="intel-summary">{{item.desc}}</text>
          <view class="intel-source">
            <text>{{item.sourceName}}</text>
            <text>{{item.publishedAt}}</text>
          </view>
          <text class="intel-window">{{item.analysisWindow}}</text>
          <text class="intel-note">{{item.sourceNote}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
