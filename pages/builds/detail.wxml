<view class="page-shell detail-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content detail-content">
      <view class="detail-hero">
        <text class="detail-kicker">职业专精查询</text>
        <text class="detail-title">{{activeQuery.title}}</text>
        <text class="detail-desc" wx:if="{{activeQuery.desc && activeQueryKey != 'gear'}}">{{activeQuery.desc}}</text>
      </view>

      <view class="filter-panel">
        <view class="picker-field">
          <text class="picker-label">职业</text>
          <picker mode="selector" range="{{classOptions}}" range-key="name" value="{{selectedClassIndex}}" bindchange="selectClass">
            <view class="picker-value">{{selectedClass.name}}</view>
          </picker>
        </view>
        <view class="picker-field">
          <text class="picker-label">专精</text>
          <picker mode="selector" range="{{specOptions}}" range-key="title" value="{{selectedSpecIndex}}" bindchange="selectSpec">
            <view class="picker-value">{{selectedSpec.title}}</view>
          </picker>
        </view>
      </view>

      <view class="module-panel talent-panel" wx:if="{{activeQueryKey == 'talents'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">天赋代码、场景差异和核心节点</text>
        </view>
        <view class="talent-code-card" wx:if="{{activeDetail.importCode}}">
          <text class="code-label">导入代码</text>
          <text class="code-value">{{activeDetail.importCode}}</text>
        </view>
        <view class="talent-chip-list" wx:if="{{activeDetail.coreTalents}}">
          <text class="talent-chip" wx:for="{{activeDetail.coreTalents}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="talent-simulator">
          <view class="talent-scenario-tabs">
            <view class="talent-scenario-tab {{activeTalentScenarioKey == item.key ? 'active' : ''}}" wx:for="{{talentScenarios}}" wx:key="key" data-key="{{item.key}}" bindtap="setTalentScenario">
              <text class="scenario-title">{{item.title}}</text>
              <text class="scenario-label">{{item.label}}</text>
            </view>
          </view>
          <view class="talent-node-grid">
            <view class="talent-node-chip {{item.selected ? 'selected' : ''}}" wx:for="{{talentNodeRows}}" wx:key="key" data-node="{{item.name}}" bindtap="toggleTalentNode">
              <text class="talent-node-badge">{{item.badge}}</text>
              <text class="talent-node-name">{{item.name}}</text>
            </view>
          </view>
          <view class="talent-sim-summary">
            <text>{{talentSimulationSummary}}</text>
          </view>
        </view>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="module-panel gear-panel" wx:if="{{activeQueryKey == 'gear'}}">
        <view class="gear-request-alert" wx:if="{{gearDataWarningText}}">
          <text>{{gearDataWarningText}}</text>
        </view>

        <view class="gear-slot-grid">
          <view class="gear-slot-card {{item.statusClass}}" wx:for="{{gearSlotRows}}" wx:key="slot" data-slot="{{item.slot}}" bindtap="openGearSlotSheet">
            <view class="gear-slot-topline">
              <text class="gear-slot-label">{{item.label}}</text>
              <text class="gear-slot-status">{{item.statusLabel}}</text>
            </view>
            <view class="gear-slot-body">
              <view class="gear-icon-frame {{item.statusClass}}">
                <image wx:if="{{item.gameAsset.iconUrl}}" class="gear-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
                <text wx:else class="gear-icon-fallback">{{item.gameAsset.fallbackText}}</text>
              </view>
              <view class="gear-copy">
                <text class="gear-name">{{item.displayName}}</text>
                <text class="gear-source" wx:if="{{item.ilevel}}">装等 {{item.ilevel}}</text>
              </view>
            </view>
            <view class="gear-slot-footer">
              <text>{{item.trustLabel}}</text>
            </view>
          </view>
        </view>

        <view class="gear-loading-state" wx:if="{{gearInitialLoading}}">
          <text class="gear-loading-title">正在加载真实装备槽位</text>
          <text class="gear-loading-copy">等待后端返回当前赛季装备库。</text>
        </view>

        <view class="gear-empty-state" wx:if="{{!gearLoading && !gearSlotRows.length}}">
          <text>装备模拟数据暂不可用，等待后端返回槽位结构。</text>
        </view>

        <view class="gear-template-actions" wx:if="{{!gearInitialLoading}}">
          <button class="gear-template-action-button primary" loading="{{gearTemplateSaving}}" disabled="{{gearDataFallback || gearTemplateSaving}}" bindtap="saveGearTemplate">保存模板</button>
          <button class="gear-template-action-button import" disabled="{{gearDataFallback}}" bindtap="openGearCommunityTemplates">导入社区推荐</button>
          <button class="gear-template-action-button muted" bindtap="resetGearSelection">重置</button>
        </view>
      </view>

      <view class="module-panel stats-panel" wx:if="{{activeQueryKey == 'statWeights'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">按 M+ 场景查看 Raider.IO 样本 + SimC scale factors 的参考方向</text>
        </view>
        <view class="stat-scenario-tabs" wx:if="{{statWeightScenarios.length > 1}}">
          <view class="stat-scenario-tab {{activeStatWeightScenarioKey == item.scenarioKey ? 'active' : ''}}" wx:for="{{statWeightScenarios}}" wx:key="scenarioKey" data-key="{{item.scenarioKey}}" bindtap="setStatWeightScenario">
            <text class="stat-scenario-title">{{item.scenarioLabel || item.scenarioTitle}}</text>
            <text class="stat-scenario-status">{{item.sourceStatus}}</text>
          </view>
        </view>
        <view class="stat-source-state {{activeStatWeightScenario.sourceStatus}}">
          <view class="stat-source-topline">
            <text class="stat-source-badge">{{statWeightStatusLabel}}</text>
            <text class="stat-source-scenario">{{activeStatWeightScenario.scenarioTitle}}</text>
          </view>
          <text class="stat-source-meta">{{activeStatWeightScenario.analysisWindow}}</text>
          <view class="stat-validation-grid">
            <text>样本 {{statWeightValidation.sampleCount || 0}}</text>
            <text>Profile {{statWeightValidation.profileCount || 0}}</text>
            <text>SimC {{statWeightValidation.simcSuccessCount || 0}}</text>
          </view>
        </view>
        <view class="stat-bars" wx:if="{{activeStatRows.length}}">
          <view class="stat-row {{item.kind == 'primary' ? 'primary' : ''}}" wx:for="{{activeStatRows}}" wx:key="key">
            <view class="stat-copy">
              <text class="stat-name">{{item.name}}</text>
              <text class="stat-value">{{item.value}}</text>
            </view>
            <view class="stat-track">
              <view class="stat-fill" style="width: {{item.percent}}%;"></view>
            </view>
          </view>
        </view>
        <view class="stat-blocked-list" wx:if="{{!activeStatRows.length || statWeightBlockers.length}}">
          <text class="stat-blocked-title">当前不输出强结论</text>
          <text class="stat-blocked-item" wx:for="{{statWeightBlockers}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="stat-advice-list" wx:if="{{statWeightRecommendations.length || statWeightWarnings.length}}">
          <text class="stat-advice-title" wx:if="{{statWeightRecommendations.length}}">中文建议</text>
          <text class="stat-advice-item" wx:for="{{statWeightRecommendations}}" wx:key="*this">{{item}}</text>
          <text class="stat-advice-title warning" wx:if="{{statWeightWarnings.length}}">边界提示</text>
          <text class="stat-advice-item warning" wx:for="{{statWeightWarnings}}" wx:key="*this">{{item}}</text>
        </view>
        <button class="stat-simc-button" bindtap="openSimcWithBuildContext">带当前构筑去 SimC</button>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="module-panel rotation-panel" wx:if="{{activeQueryKey == 'rotation'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">起手、爆发、平稳期和场景处理</text>
        </view>
        <view class="rotation-timeline">
          <view class="rotation-step" wx:for="{{activeDetail.rotation}}" wx:key="phase">
            <text class="phase-name">{{item.phase}}</text>
            <text class="phase-copy">{{item.action}}</text>
          </view>
        </view>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="source-box" wx:if="{{activeDetail && activeQueryKey != 'gear'}}">
        <text class="source-box-title">来源与样本窗口</text>
        <text class="source-box-text">{{activeDetail.analysisWindow}}</text>
        <text class="source-box-text">{{activeDetail.sourceNote}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="gear-slot-sheet-mask" wx:if="{{gearSlotSheet.visible}}" bindtap="closeGearSlotSheet"></view>
  <view class="gear-slot-sheet" wx:if="{{gearSlotSheet.visible}}">
    <view class="gear-sheet-handle"></view>
    <view class="gear-sheet-header">
      <view>
        <text class="gear-sheet-kicker">{{gearSlotSheet.label}}</text>
        <text class="gear-sheet-title">替换装备</text>
      </view>
      <button class="gear-sheet-close" bindtap="closeGearSlotSheet">关闭</button>
    </view>
    <view class="gear-sheet-filter-row">
      <view class="gear-sheet-filter {{item.active ? 'active' : ''}}" wx:for="{{gearSlotSheet.filters}}" wx:key="key" data-key="{{item.key}}" bindtap="setGearCandidateFilter">
        <text>{{item.label}}</text>
        <text class="gear-sheet-filter-count">{{item.count}}</text>
      </view>
    </view>
    <view class="gear-candidate-list">
      <view class="gear-candidate-row {{item.statusClass}} {{item.selected ? 'selected' : ''}}" wx:for="{{gearSlotSheet.candidates}}" wx:for-index="candidateIndex" wx:key="key">
        <view class="gear-candidate-main" data-index="{{candidateIndex}}" data-slot="{{gearSlotSheet.slot}}" bindtap="selectGearCandidate">
          <view class="gear-icon-frame {{item.statusClass}}">
            <image wx:if="{{item.gameAsset.iconUrl}}" class="gear-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
            <text wx:else class="gear-icon-fallback">{{item.gameAsset.fallbackText}}</text>
          </view>
          <view class="gear-copy">
            <text class="gear-name">{{item.displayName}}</text>
            <text class="gear-source" wx:if="{{item.ilevel}}">装等 {{item.ilevel}}</text>
          </view>
          <view class="gear-candidate-action">
            <button class="gear-candidate-detail-button" data-index="{{candidateIndex}}" catchtap="toggleGearCandidateDetail">{{item.detailOpen ? '收起' : '详情'}}</button>
          </view>
        </view>
        <view class="gear-candidate-detail" wx:if="{{item.detailOpen}}">
          <view class="gear-candidate-detail-row" wx:for="{{item.detailRows}}" wx:for-item="detail" wx:key="label">
            <text class="gear-candidate-detail-label">{{detail.label}}</text>
            <text class="gear-candidate-detail-value">{{detail.value}}</text>
          </view>
        </view>
      </view>
      <view class="gear-candidate-empty" wx:if="{{gearSlotSheet.emptyText}}">
        <text>{{gearSlotSheet.emptyText}}</text>
      </view>
    </view>
    <view class="gear-sheet-config" wx:if="{{gearSlotSheet.activeCandidate}}">
      <view class="gear-config-stack">
        <view class="gear-variant-section" wx:if="{{gearSlotSheet.variantOptions.length}}">
          <view class="gear-sheet-section-heading">
            <text class="gear-sheet-section-title">难度 / 装等</text>
          </view>
          <view class="gear-variant-track-grid">
            <view class="gear-variant-track-card {{item.selected ? 'active' : ''}} {{item.statusClass}}" wx:for="{{gearSlotSheet.variantOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="selectGearVariant">
              <text class="gear-variant-track-name">{{item.displayLabel}}</text>
              <text class="gear-variant-track-level" wx:if="{{item.levelLabel}}">{{item.levelLabel}}</text>
            </view>
          </view>
        </view>
        <view class="gear-crafted-stat-section" wx:if="{{gearSlotSheet.craftedStatOptions.length}}">
          <view class="gear-sheet-section-heading">
            <text class="gear-sheet-section-title">属性搭配</text>
          </view>
          <view class="gear-crafted-stat-list">
            <view class="gear-crafted-stat-chip {{item.selected ? 'active' : ''}} {{item.statusClass}}" wx:for="{{gearSlotSheet.craftedStatOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="selectCraftedStatOption">
              <text class="gear-crafted-stat-label">{{item.label}}</text>
              <text class="gear-crafted-stat-status" wx:if="{{item.status && item.status !== 'verified'}}">待补</text>
            </view>
          </view>
        </view>
        <view class="gear-apply-row">
          <text class="gear-apply-message" wx:if="{{!gearSlotSheet.canApplyCandidate && gearSlotSheet.activeTrustText}}">{{gearSlotSheet.activeTrustText}}</text>
          <button class="gear-apply-button" disabled="{{!gearSlotSheet.canApplyCandidate}}" bindtap="applyGearCandidate">{{gearSlotSheet.canApplyCandidate ? '应用' : '待补'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view class="gear-slot-sheet-mask gear-community-template-sheet-mask" wx:if="{{gearCommunityTemplateSheet.visible}}" bindtap="closeGearCommunityTemplates"></view>
  <view class="gear-community-template-sheet" wx:if="{{gearCommunityTemplateSheet.visible}}">
    <view class="gear-sheet-handle"></view>
    <view class="gear-sheet-header">
      <view>
        <text class="gear-sheet-kicker">{{gearCommunityTemplateStatusText}}</text>
        <text class="gear-sheet-title">社区装备模板</text>
      </view>
      <button class="gear-sheet-close" bindtap="closeGearCommunityTemplates">关闭</button>
    </view>
    <view class="gear-community-template-list" wx:if="{{activeGearCommunityTemplates.length}}">
      <view class="gear-community-template-card {{item.cardClass}}" wx:for="{{activeGearCommunityTemplates}}" wx:key="id">
        <view class="gear-community-template-main">
          <text class="gear-community-template-title">{{item.displayName || item.name}}</text>
          <text class="gear-community-template-meta">{{item.displaySourceName || item.sourceName}} · {{item.slotCoverageLabel}}</text>
          <text class="gear-community-template-meta">{{item.statusLabel}} · {{item.updatedLabel || item.analysisWindow}}</text>
          <text class="gear-community-template-meta warning" wx:if="{{item.blockerLabel}}">{{item.blockerLabel}}</text>
        </view>
        <view class="gear-community-template-side">
          <text class="gear-community-template-state">{{item.missingSlotLabel}}</text>
          <button class="gear-community-template-apply" disabled="{{!item.canApplyGear}}" data-id="{{item.id}}" bindtap="applyGearCommunityTemplate">{{item.actionLabel}}</button>
        </view>
      </view>
    </view>
    <view class="gear-community-template-empty" wx:else>
      <text>暂无可导入装备模板</text>
    </view>
  </view>
</view>
