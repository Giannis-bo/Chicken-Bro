<view class="page-shell detail-shell">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content detail-content">
      <view class="detail-hero">
        <text class="detail-kicker">职业专精查询</text>
        <text class="detail-title">{{activeQuery.title}}</text>
        <text class="detail-desc">{{activeQuery.desc}}</text>
      </view>

      <view class="filter-panel">
        <view class="picker-field">
          <text class="picker-label">职业</text>
          <picker mode="selector" range="{{classOptions}}" range-key="name" value="{{selectedClassIndex}}" bindchange="selectClass">
            <view class="picker-value">{{selectedClass.name}}</view>
          </picker>
        </view>
        <view class="picker-field">
          <text class="picker-label">专精</text>
          <picker mode="selector" range="{{specOptions}}" range-key="title" value="{{selectedSpecIndex}}" bindchange="selectSpec">
            <view class="picker-value">{{selectedSpec.title}}</view>
          </picker>
        </view>
      </view>

      <view class="source-strip" wx:if="{{activeDetail}}">
        <text>{{selectedSpec.role}}</text>
        <text>{{activeDetail.sourceName}}</text>
        <text>{{activeDetail.publishedAt}}</text>
      </view>

      <view class="module-panel talent-panel" wx:if="{{activeQueryKey == 'talents'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">天赋代码、场景差异和核心节点</text>
        </view>
        <view class="talent-code-card" wx:if="{{activeDetail.importCode}}">
          <text class="code-label">导入代码</text>
          <text class="code-value">{{activeDetail.importCode}}</text>
        </view>
        <view class="talent-chip-list" wx:if="{{activeDetail.coreTalents}}">
          <text class="talent-chip" wx:for="{{activeDetail.coreTalents}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="talent-simulator">
          <view class="talent-scenario-tabs">
            <view class="talent-scenario-tab {{activeTalentScenarioKey == item.key ? 'active' : ''}}" wx:for="{{talentScenarios}}" wx:key="key" data-key="{{item.key}}" bindtap="setTalentScenario">
              <text class="scenario-title">{{item.title}}</text>
              <text class="scenario-label">{{item.label}}</text>
            </view>
          </view>
          <view class="talent-node-grid">
            <view class="talent-node-chip {{item.selected ? 'selected' : ''}}" wx:for="{{talentNodeRows}}" wx:key="key" data-node="{{item.name}}" bindtap="toggleTalentNode">
              <text class="talent-node-badge">{{item.badge}}</text>
              <text class="talent-node-name">{{item.name}}</text>
            </view>
          </view>
          <view class="talent-sim-summary">
            <text>{{talentSimulationSummary}}</text>
          </view>
          <button class="talent-simc-button" bindtap="openTalentSimc">模拟这套天赋</button>
        </view>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="module-panel gear-panel" wx:if="{{activeQueryKey == 'gear'}}">
        <view class="panel-header">
          <text class="panel-title">装备模拟</text>
          <text class="panel-subtitle">查看满级属性、替换装备并校验 SimC-ready 状态</text>
        </view>

        <view class="gear-status-strip">
          <text>{{gearPayload.maxLevel ? '满级 ' + gearPayload.maxLevel : '满级配置待返回'}}</text>
          <text>{{gearReadiness.fullReady ? '装备 ready' : '装备待补齐'}}</text>
          <text>{{gearStatsLoading ? '属性刷新中' : gearStatSnapshot.statStatus}}</text>
        </view>

        <view class="gear-template-actions">
          <picker mode="selector" range="{{gearTemplateScenarios}}" range-key="title" value="{{selectedGearTemplateScenarioIndex}}" bindchange="selectGearTemplateScenario">
            <view class="gear-template-picker">场景：{{gearTemplateScenarios[selectedGearTemplateScenarioIndex] ? gearTemplateScenarios[selectedGearTemplateScenarioIndex].title : '未选择'}}</view>
          </picker>
          <button class="gear-template-save-button" loading="{{gearTemplateSaving}}" bindtap="saveGearTemplate">保存装备模板</button>
        </view>

        <view class="gear-stat-panel">
          <view class="gear-stat-state {{gearStatSnapshot.statStatus == 'verified' ? 'verified' : 'blocked'}}">
            <view class="gear-stat-heading">
              <text class="gear-stat-title">{{gearStatStatusText}}</text>
              <text class="gear-stat-note">{{gearStatSnapshot.checkedAt}}</text>
            </view>
            <view wx:if="{{gearStatSnapshot.statStatus == 'verified'}}" class="gear-stat-grid">
              <view class="gear-stat-cell" wx:if="{{gearStatSnapshot.primary}}">
                <text class="gear-stat-label">{{gearStatSnapshot.primary.label}}</text>
                <text class="gear-stat-value">{{gearStatSnapshot.primary.value}}</text>
              </view>
              <view class="gear-stat-cell" wx:if="{{gearStatSnapshot.stamina}}">
                <text class="gear-stat-label">{{gearStatSnapshot.stamina.label}}</text>
                <text class="gear-stat-value">{{gearStatSnapshot.stamina.value}}</text>
              </view>
              <view class="gear-stat-cell" wx:for="{{gearStatSnapshot.secondary}}" wx:key="key">
                <text class="gear-stat-label">{{item.label}}</text>
                <text class="gear-stat-value">{{item.value}}</text>
              </view>
              <view class="gear-stat-cell" wx:if="{{gearStatSnapshot.armor}}">
                <text class="gear-stat-label">{{gearStatSnapshot.armor.label}}</text>
                <text class="gear-stat-value">{{gearStatSnapshot.armor.value}}</text>
              </view>
              <view class="gear-stat-cell" wx:if="{{gearStatSnapshot.weaponDps}}">
                <text class="gear-stat-label">{{gearStatSnapshot.weaponDps.label}}</text>
                <text class="gear-stat-value">{{gearStatSnapshot.weaponDps.value}}</text>
              </view>
            </view>
            <view wx:else class="gear-blocked-list">
              <text class="gear-blocked-title">暂不能显示已验证属性</text>
              <text class="gear-blocked-item" wx:for="{{gearStatBlockers}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="gear-slot-grid">
          <view class="gear-slot-card {{item.statusClass}}" wx:for="{{gearSlotRows}}" wx:key="slot" data-slot="{{item.slot}}" bindtap="openGearSlotSheet">
            <view class="gear-slot-topline">
              <text class="gear-slot-label">{{item.label}}</text>
              <text class="gear-slot-status">{{item.statusLabel}}</text>
            </view>
            <view class="gear-slot-body">
              <view class="gear-icon-frame {{item.statusClass}}">
                <image wx:if="{{item.gameAsset.iconUrl}}" class="gear-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
                <text wx:else class="gear-icon-fallback">{{item.gameAsset.fallbackText}}</text>
              </view>
              <view class="gear-copy">
                <text class="gear-name">{{item.displayName}}</text>
                <text class="gear-source">{{item.ilevel ? '装等 ' + item.ilevel : item.reason}}</text>
              </view>
            </view>
            <view class="gear-slot-footer">
              <text>{{item.candidateCount}} 个候选</text>
              <text>{{item.itemId || '未选择'}}</text>
            </view>
          </view>
        </view>

        <view class="gear-empty-state" wx:if="{{!gearLoading && !gearSlotRows.length}}">
          <text>装备模拟数据暂不可用，等待后端返回槽位结构。</text>
        </view>

        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="module-panel stats-panel" wx:if="{{activeQueryKey == 'statWeights'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">属性优先级、权重趋势和适用边界</text>
        </view>
        <view class="stat-bars">
          <view class="stat-row" wx:for="{{activeDetail.stats}}" wx:key="name">
            <view class="stat-copy">
              <text class="stat-name">{{item.name}}</text>
              <text class="stat-value">{{item.value}}</text>
            </view>
            <view class="stat-track">
              <view class="stat-fill" style="width: {{item.percent}}%;"></view>
            </view>
          </view>
        </view>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="module-panel rotation-panel" wx:if="{{activeQueryKey == 'rotation'}}">
        <view class="panel-header">
          <text class="panel-title">{{activeDetail.title}}</text>
          <text class="panel-subtitle">起手、爆发、平稳期和场景处理</text>
        </view>
        <view class="rotation-timeline">
          <view class="rotation-step" wx:for="{{activeDetail.rotation}}" wx:key="phase">
            <text class="phase-name">{{item.phase}}</text>
            <text class="phase-copy">{{item.action}}</text>
          </view>
        </view>
        <view class="insight-list">
          <text class="insight-item" wx:for="{{activeDetail.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="simc-link-panel" wx:if="{{activeDetail}}">
        <view class="simc-link-copy">
          <text class="simc-link-title">用 SimC 校验当前方案</text>
          <text class="simc-link-desc">带入当前专精、天赋、装备列表、属性趋势和来源证据，进入模拟器生成可提交任务。</text>
        </view>
        <button class="simc-link-button" bindtap="openSimcWithBuildContext">带当前构筑去 SimC</button>
      </view>

      <view class="source-box" wx:if="{{activeDetail}}">
        <text class="source-box-title">来源与样本窗口</text>
        <text class="source-box-text">{{activeDetail.analysisWindow}}</text>
        <text class="source-box-text">{{activeDetail.sourceNote}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="gear-slot-sheet-mask" wx:if="{{gearSlotSheet.visible}}" bindtap="closeGearSlotSheet"></view>
  <view class="gear-slot-sheet" wx:if="{{gearSlotSheet.visible}}">
    <view class="gear-sheet-handle"></view>
    <view class="gear-sheet-header">
      <view>
        <text class="gear-sheet-kicker">{{gearSlotSheet.label}}</text>
        <text class="gear-sheet-title">替换装备</text>
      </view>
      <button class="gear-sheet-close" bindtap="closeGearSlotSheet">关闭</button>
    </view>
    <view class="gear-candidate-list">
      <view class="gear-candidate-row {{item.selected ? 'selected' : ''}}" wx:for="{{gearSlotSheet.candidates}}" wx:for-index="candidateIndex" wx:key="key" data-index="{{candidateIndex}}" data-slot="{{gearSlotSheet.slot}}" bindtap="selectGearCandidate">
        <view class="gear-icon-frame {{item.statusClass}}">
          <image wx:if="{{item.gameAsset.iconUrl}}" class="gear-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
          <text wx:else class="gear-icon-fallback">{{item.gameAsset.fallbackText}}</text>
        </view>
        <view class="gear-copy">
          <text class="gear-name">{{item.displayName}}</text>
          <text class="gear-source">{{item.source || item.reason}}</text>
        </view>
        <view class="gear-candidate-meta">
          <text class="gear-slot-status">{{item.statusLabel}}</text>
          <text>{{item.ilevel ? '装等 ' + item.ilevel : item.itemId}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
