<view class="talent-simulator-page">
  <navigation-bar title="{{navTitle}}" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="talent-page-content">
      <view class="talent-header">
        <view class="talent-title-row">
          <view>
            <text class="talent-kicker">职业专精</text>
            <text class="talent-title">{{selectedSpec.title || '天赋构筑'}}</text>
          </view>
          <text class="talent-status {{talentStatus}}">{{talentStatus}}</text>
        </view>
        <text class="talent-desc">{{statusText}}</text>
      </view>

      <view class="talent-toolbar">
        <picker mode="selector" range="{{classOptions}}" range-key="name" value="{{selectedClassIndex}}" bindchange="selectClass">
          <view class="toolbar-picker">
            <text class="picker-label">职业</text>
            <text class="picker-value">{{selectedClass.name}}</text>
          </view>
        </picker>
        <picker mode="selector" range="{{specOptions}}" range-key="title" value="{{selectedSpecIndex}}" bindchange="selectSpec">
          <view class="toolbar-picker">
            <text class="picker-label">专精</text>
            <text class="picker-value">{{selectedSpec.title}}</text>
          </view>
        </picker>
        <picker mode="selector" range="{{heroOptions}}" range-key="label" value="{{selectedHeroIndex}}" bindchange="selectHero">
          <view class="toolbar-picker">
            <text class="picker-label">英雄天赋</text>
            <text class="picker-value">{{selectedHeroLabel}}</text>
          </view>
        </picker>
      </view>

      <view class="tree-tabs">
        <view class="{{item.tabClass}}" wx:for="{{treeNavItems}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTalentTree">
          <text class="tree-tab-label">{{item.label}}</text>
          <text class="tree-tab-points">{{item.pointLabel}}</text>
          <text class="tree-tab-subtitle">{{item.subtitle}}</text>
        </view>
      </view>

      <view class="active-tree-panel {{activeSection.panelClass}}">
        <view class="active-tree-head">
          <view class="active-tree-title-wrap">
            <text class="active-tree-kicker">{{activeSection.displayLabel}}</text>
            <text class="active-tree-separator">·</text>
            <text class="active-tree-title">{{activeSection.displayTitle}}</text>
            <text class="active-tree-separator">·</text>
            <text class="active-tree-subtitle">{{activeSection.subtitle}}</text>
          </view>
          <text class="active-tree-points">{{activeSection.pointLabel}}</text>
        </view>
        <view class="tree-progress">
          <view class="tree-progress-fill" style="{{activeSection.progressStyle}}"></view>
        </view>
        <view class="{{activeSection.gridClass}}">
          <view class="{{item.linkClass}}" wx:for="{{activeSection.links}}" wx:key="renderKey" style="{{item.lineStyle}}"></view>
          <view class="{{item.nodeClass}}" wx:for="{{activeSection.nodes}}" wx:key="renderKey" style="{{item.nodeStyle}}" data-id="{{item.id}}" bindtap="tapTalentNode" bindlongpress="openNodeDetail">
            <view class="talent-choice-frame" wx:if="{{item.shape === 'choice'}}"></view>
            <image wx:if="{{item.gameAsset.iconUrl}}" class="talent-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
            <text wx:else class="talent-icon-fallback">{{item.gameAsset.fallbackText}}</text>
            <text class="talent-rank">{{item.rankLabel}}</text>
          </view>
        </view>
      </view>

      <view class="talent-export-summary">
        <text class="export-title">WebSim 构筑</text>
        <text class="export-code">{{exportStatusText}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="mobile-action-bar">
    <button class="action-primary-button" loading="{{templateSaving}}" disabled="{{!canSaveTalentTemplate || templateSaving}}" bindtap="saveTalentTemplate">保存模板</button>
    <button class="action-secondary-button community-action-button" bindtap="openCommunityTemplates">导入</button>
    <button class="action-secondary-button reset-action-button" bindtap="resetTalents">重置</button>
  </view>

  <view class="sheet-mask" wx:if="{{choiceSheet.visible}}" catchtap="closeChoiceSheet"></view>
  <view class="talent-choice-sheet" wx:if="{{choiceSheet.visible}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">{{choiceSheet.title}}</text>
    <view class="choice-option {{item.selected ? 'selected' : ''}}" wx:for="{{choiceSheet.options}}" wx:key="id" data-id="{{item.id}}" bindtap="selectChoiceTalent">
      <image wx:if="{{item.gameAsset.iconUrl}}" class="sheet-icon" src="{{item.gameAsset.iconUrl}}" mode="aspectFill"></image>
      <text wx:else class="sheet-icon">{{item.gameAsset.fallbackText}}</text>
      <view class="sheet-copy">
        <text class="sheet-option-title">{{item.name}}</text>
        <text class="sheet-option-desc">{{item.description}}</text>
      </view>
      <text class="sheet-rank">{{item.rankLabel}}</text>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{nodeDetailSheet.visible}}" catchtap="closeNodeDetail"></view>
  <view class="talent-detail-sheet" wx:if="{{nodeDetailSheet.visible}}">
    <view class="sheet-handle"></view>
    <view class="detail-sheet-head">
      <text class="sheet-title">{{nodeDetailSheet.node.name}}</text>
      <text class="sheet-rank">{{nodeDetailSheet.node.rankLabel}}</text>
    </view>
    <text class="sheet-option-desc">{{nodeDetailSheet.node.description}}</text>
    <text class="lock-reason" wx:if="{{nodeDetailSheet.reason}}">{{nodeDetailSheet.reason}}</text>
    <view class="rank-stepper">
      <button class="rank-button" data-id="{{nodeDetailSheet.node.id}}" data-delta="-1" bindtap="changeDetailRank">-</button>
      <text class="rank-current">{{nodeDetailSheet.node.rankLabel}}</text>
      <button class="rank-button" data-id="{{nodeDetailSheet.node.id}}" data-delta="1" bindtap="changeDetailRank">+</button>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{saveTemplateSheet.visible}}" catchtap="closeSaveTemplateSheet"></view>
  <view class="template-save-sheet" wx:if="{{saveTemplateSheet.visible}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">保存天赋模板</text>
    <input
      class="template-name-input"
      value="{{saveTemplateSheet.name}}"
      placeholder="{{saveTemplateSheet.defaultName}}"
      maxlength="28"
      bindinput="updateTemplateName"
      confirm-type="done"
      bindconfirm="confirmSaveTalentTemplate"
    />
    <view class="save-sheet-actions">
      <button class="save-sheet-secondary" bindtap="closeSaveTemplateSheet">取消</button>
      <button class="save-sheet-primary" loading="{{templateSaving}}" disabled="{{!canSaveTalentTemplate || templateSaving}}" bindtap="confirmSaveTalentTemplate">保存</button>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{communityTemplateSheet.visible}}" catchtap="closeCommunityTemplates"></view>
  <view class="community-template-sheet" wx:if="{{communityTemplateSheet.visible}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">导入</text>
    <scroll-view class="template-layer-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="template-layer personal-template-section">
        <view class="template-section-head">
          <text class="template-section-title">我的保存</text>
          <text class="template-section-count">{{savedTalentTemplates.length}}</text>
        </view>
        <view class="community-template-empty template-layer-empty" wx:if="{{savedTalentTemplates.length == 0}}">
          <text>暂无已保存天赋模板</text>
        </view>
        <view class="community-template-list personal-template-list" wx:else>
          <view class="{{item.cardClass}}" wx:for="{{savedTalentTemplates}}" wx:key="id">
            <view class="template-card-head">
              <view class="template-title-wrap">
                <text class="template-name">{{item.name}}</text>
                <text class="template-source">{{item.sourceName}}</text>
              </view>
              <text class="template-mode">{{item.keyLabel}}</text>
            </view>
            <view class="template-meta-row">
              <text class="template-meta" wx:if="{{item.detailLabel}}">{{item.detailLabel}}</text>
              <text class="template-meta">{{item.sampleLabel}}</text>
              <text class="template-meta" wx:if="{{item.updatedLabel}}">{{item.updatedLabel}}</text>
            </view>
            <view class="template-apply-row">
              <button class="template-apply-button" data-id="{{item.id}}" bindtap="applySavedTalentTemplate">{{item.actionLabel}}</button>
            </view>
          </view>
        </view>
      </view>

      <view class="template-layer community-template-section">
        <view class="template-section-head">
          <text class="template-section-title">社区推荐</text>
          <text class="template-section-count">{{activeCommunityTemplates.length}}</text>
        </view>
        <text class="sheet-option-desc community-status">{{communityTemplateStatusText}}</text>
        <view class="community-template-empty template-layer-empty" wx:if="{{activeCommunityTemplates.length == 0}}">
          <text>暂无可用社区模板</text>
        </view>
        <view class="community-template-list" wx:else>
          <view class="{{item.cardClass}}" wx:for="{{activeCommunityTemplates}}" wx:key="id">
            <view class="template-card-head">
              <view class="template-title-wrap">
                <text class="template-name">{{item.name}}</text>
                <text class="template-source">{{item.sourceName}}</text>
              </view>
              <text class="template-mode">{{item.modeLabel}}</text>
            </view>
            <view class="template-meta-row">
              <text class="template-meta" wx:if="{{item.detailLabel}}">{{item.detailLabel}}</text>
              <text class="template-meta">{{item.sampleLabel}}</text>
              <text class="template-meta" wx:if="{{item.keyLabel}}">{{item.keyLabel}}</text>
              <text class="template-meta" wx:if="{{item.updatedLabel}}">{{item.updatedLabel}}</text>
            </view>
            <view class="template-apply-row">
              <button class="template-apply-button" disabled="{{item.applyMode !== 'visual'}}" data-id="{{item.id}}" bindtap="applyCommunityTemplate">{{item.actionLabel}}</button>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
