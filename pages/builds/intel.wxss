.intel-shell {
  background: #060606;
}

.intel-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.intel-hero,
.intel-item {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.intel-hero {
  padding: 30rpx;
  border-color: rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #111111 0%, #1a1128 58%, #8b3ff5 150%);
  color: #ffffff;
}

.intel-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.16;
}

.intel-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(225, 226, 229, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.intel-count {
  display: block;
  margin-top: 18rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.intel-item {
  padding: 24rpx;
  background: #101010;
}

.intel-head,
.intel-source {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.intel-name-block {
  flex: 1;
  min-width: 0;
}

.intel-name {
  display: block;
  color: #f1f1f1;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.intel-role {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.18);
  color: #c9a8ff;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-arrow {
  flex: none;
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 800;
}

.intel-summary,
.intel-window,
.intel-note {
  display: block;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.48;
}

.intel-summary {
  margin-top: 18rpx;
}

.intel-source {
  margin-top: 18rpx;
  color: #f8b700;
  font-size: 22rpx;
}

.intel-window {
  margin-top: 8rpx;
}

.intel-note {
  margin-top: 8rpx;
  color: #8e8e8e;
}
