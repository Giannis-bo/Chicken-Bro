.intel-shell {
  background: #edf3ff;
}

.intel-content {
  padding-bottom: 72rpx;
}

.intel-hero,
.intel-item {
  border: 1rpx solid rgba(21, 63, 138, 0.12);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(21, 63, 138, 0.08);
}

.intel-hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #153f8a 0%, #1f5bb8 68%, #f2c94c 170%);
  color: #ffffff;
}

.intel-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(242, 201, 76, 0.18);
  color: #ffe58a;
  font-size: 22rpx;
}

.intel-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.16;
}

.intel-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.5;
}

.intel-count {
  display: block;
  margin-top: 18rpx;
  color: #ffe58a;
  font-size: 22rpx;
  font-weight: 700;
}

.intel-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.intel-item {
  padding: 26rpx;
}

.intel-head,
.intel-source {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.intel-name-block {
  flex: 1;
  min-width: 0;
}

.intel-name {
  display: block;
  color: #153f8a;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.intel-role {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #153f8a;
  font-size: 22rpx;
  font-weight: 700;
}

.intel-arrow {
  flex: none;
  color: #b68a11;
  font-size: 23rpx;
  font-weight: 700;
}

.intel-summary,
.intel-window,
.intel-note {
  display: block;
  color: #657489;
  font-size: 23rpx;
  line-height: 1.48;
}

.intel-summary {
  margin-top: 18rpx;
}

.intel-source {
  margin-top: 18rpx;
  color: #b68a11;
  font-size: 22rpx;
}

.intel-window {
  margin-top: 8rpx;
}

.intel-note {
  margin-top: 8rpx;
  color: #58677d;
}
