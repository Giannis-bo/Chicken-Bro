.intel-shell {
  background: #060606;
}

.intel-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.intel-hero,
.intel-item {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #151515;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.24);
}

.intel-hero {
  padding: 24rpx;
  border-color: rgba(248, 183, 0, 0.3);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28), inset 0 0 0 1rpx rgba(139, 63, 245, 0.16);
}

.intel-kicker {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-title {
  display: block;
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.16;
}

.intel-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(225, 226, 229, 0.82);
  font-size: 24rpx;
  line-height: 1.42;
}

.intel-count {
  display: block;
  margin-top: 12rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.intel-item {
  padding: 18rpx;
  background: #101010;
}

.intel-head,
.intel-source {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.intel-name-block {
  flex: 1;
  min-width: 0;
}

.intel-name {
  display: block;
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.intel-role {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.18);
  color: #c9a8ff;
  font-size: 22rpx;
  font-weight: 800;
}

.intel-arrow {
  flex: none;
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 800;
}

.intel-summary,
.intel-window,
.intel-note {
  display: block;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.4;
}

.intel-summary {
  margin-top: 12rpx;
}

.intel-source {
  margin-top: 12rpx;
  color: #f8b700;
  font-size: 22rpx;
}

.intel-window {
  margin-top: 8rpx;
}

.intel-note {
  margin-top: 8rpx;
  color: #8e8e8e;
}
