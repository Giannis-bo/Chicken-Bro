.detail-shell {
  background: #060606;
}

.detail-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.detail-hero,
.filter-panel,
.module-panel,
.source-box {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.detail-hero {
  padding: 30rpx;
  border-color: rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #111111 0%, #1a1128 58%, #8b3ff5 150%);
  color: #ffffff;
}

.detail-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.16;
}

.detail-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(225, 226, 229, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.filter-panel {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 22rpx;
}

.picker-field {
  flex: 1;
  min-width: 0;
}

.picker-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8e8e8e;
  font-size: 22rpx;
}

.picker-value {
  min-height: 76rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.3);
  border-radius: 16rpx;
  background: #101010;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.source-strip {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 16rpx;
  background: rgba(248, 183, 0, 0.1);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.module-panel {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-title {
  display: block;
  color: #f1f1f1;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.34;
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.45;
}

.talent-code-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.24);
  border-radius: 16rpx;
  background: #101010;
}

.code-label,
.code-value {
  display: block;
}

.code-label {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.code-value {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.talent-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.talent-chip {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.3);
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.14);
  color: #c9a8ff;
  font-size: 22rpx;
  font-weight: 800;
}

.gear-list,
.stat-bars,
.rotation-timeline,
.insight-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.gear-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
}

.gear-slot {
  flex: none;
  width: 96rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.gear-copy {
  flex: 1;
  min-width: 0;
}

.gear-name,
.gear-source,
.stat-name,
.stat-value,
.phase-name,
.phase-copy,
.insight-item {
  display: block;
}

.gear-name,
.stat-name,
.phase-name {
  color: #f1f1f1;
  font-size: 24rpx;
  font-weight: 800;
}

.gear-source,
.phase-copy,
.insight-item {
  margin-top: 6rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.48;
}

.stat-copy {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.stat-value {
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
}

.stat-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #2a2a2a;
}

.stat-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8b3ff5, #f8b700);
}

.rotation-step {
  position: relative;
  padding: 18rpx 18rpx 18rpx 28rpx;
  border-left: 6rpx solid #f8b700;
  border-radius: 16rpx;
  background: #101010;
}

.source-box {
  margin-top: 22rpx;
  padding: 22rpx;
}

.source-box-title {
  display: block;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
}

.source-box-text {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.45;
}
