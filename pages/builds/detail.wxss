.detail-shell {
  background: #060606;
}

.detail-content {
  padding-bottom: 72rpx;
  background: #060606;
}

.detail-hero,
.filter-panel,
.module-panel,
.source-box {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #151515;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.28);
}

.detail-hero {
  padding: 30rpx;
  border-color: rgba(139, 63, 245, 0.5);
  background: linear-gradient(135deg, #111111 0%, #1a1128 58%, #8b3ff5 150%);
  color: #ffffff;
}

.detail-kicker {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.16;
}

.detail-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(225, 226, 229, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.filter-panel {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 22rpx;
}

.picker-field {
  flex: 1;
  min-width: 0;
}

.picker-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8e8e8e;
  font-size: 22rpx;
}

.picker-value {
  min-height: 76rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.3);
  border-radius: 16rpx;
  background: #101010;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.module-panel {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-title {
  display: block;
  color: #f1f1f1;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.34;
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.45;
}

.talent-code-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.24);
  border-radius: 16rpx;
  background: #101010;
}

.code-label,
.code-value {
  display: block;
}

.code-label {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.code-value {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.talent-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.talent-chip {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(139, 63, 245, 0.3);
  border-radius: 999rpx;
  background: rgba(139, 63, 245, 0.14);
  color: #c9a8ff;
  font-size: 22rpx;
  font-weight: 800;
}

.talent-simulator {
  margin-top: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 16rpx;
  background: #101010;
}

.talent-scenario-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.talent-scenario-tab {
  min-width: 0;
  min-height: 78rpx;
  padding: 12rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #181818;
  color: #a7a7a7;
  text-align: center;
}

.talent-scenario-tab.active {
  border-color: rgba(248, 183, 0, 0.52);
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
}

.scenario-title,
.scenario-label {
  display: block;
}

.scenario-title {
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.scenario-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.talent-node-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.talent-node-chip {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 72rpx;
  gap: 12rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #181818;
  color: #d3d3d3;
}

.talent-node-chip.selected {
  border-color: rgba(139, 63, 245, 0.58);
  background: rgba(139, 63, 245, 0.18);
  color: #ffffff;
}

.talent-node-badge {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(248, 183, 0, 0.16);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
}

.talent-node-name {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.28;
  word-break: break-word;
}

.talent-sim-summary {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #d5d5d5;
  font-size: 22rpx;
  line-height: 1.45;
}

.talent-simc-button {
  width: 100%;
  min-height: 74rpx;
  margin: 16rpx 0 0;
  border-radius: 14rpx;
  background: #f8b700;
  color: #111111;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 74rpx;
}

.talent-simc-button::after {
  border: 0;
}

.gear-list,
.stat-bars,
.rotation-timeline,
.insight-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.gear-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #101010;
}

.gear-icon-frame {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 12rpx;
  background: #050505;
  overflow: hidden;
}

.gear-icon-frame.verified {
  border-color: rgba(248, 183, 0, 0.52);
  box-shadow: 0 0 18rpx rgba(248, 183, 0, 0.18);
}

.gear-icon {
  display: block;
  width: 64rpx;
  height: 64rpx;
}

.gear-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #f8b700;
  font-size: 18rpx;
  font-weight: 900;
  text-align: center;
}

.gear-progress-panel {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 16rpx;
  background: rgba(248, 183, 0, 0.1);
}

.gear-progress-main,
.gear-progress-next {
  display: block;
  line-height: 1.42;
}

.gear-progress-main {
  flex: none;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
}

.gear-progress-next {
  flex: 1;
  min-width: 0;
  color: #e2d8bc;
  font-size: 22rpx;
  text-align: right;
}

.gear-acquisition-row.acquired {
  border-color: rgba(88, 201, 142, 0.42);
  background: rgba(88, 201, 142, 0.1);
}

.gear-slot {
  flex: none;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 800;
}

.gear-copy {
  flex: 1;
  min-width: 0;
}

.gear-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.gear-meta {
  flex: none;
  width: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.gear-name,
.gear-original,
.gear-source,
.stat-name,
.stat-value,
.phase-name,
.phase-copy,
.insight-item {
  display: block;
}

.gear-name,
.stat-name,
.phase-name {
  flex: 1;
  min-width: 0;
  color: #f1f1f1;
  font-size: 24rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.gear-source,
.gear-original,
.phase-copy,
.insight-item {
  margin-top: 6rpx;
  color: #a7a7a7;
  font-size: 23rpx;
  line-height: 1.48;
}

.gear-original {
  color: #7f7f7f;
  font-size: 20rpx;
}

.gear-priority,
.gear-source-type,
.gear-metadata,
.gear-check {
  display: block;
  max-width: 136rpx;
  padding: 5rpx 8rpx;
  border-radius: 10rpx;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.gear-priority {
  background: rgba(139, 63, 245, 0.16);
  color: #c9a8ff;
}

.gear-source-type {
  background: rgba(255, 255, 255, 0.06);
  color: #d3d3d3;
}

.gear-metadata {
  background: rgba(255, 255, 255, 0.05);
  color: #9c9c9c;
}

.gear-metadata.verified {
  background: rgba(88, 201, 142, 0.16);
  color: #58c98e;
}

.gear-check {
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
}

.gear-acquisition-row.acquired .gear-check {
  background: rgba(88, 201, 142, 0.16);
  color: #58c98e;
}

.gear-request-alert {
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 12rpx;
  background: rgba(248, 183, 0, 0.12);
  color: #f8d36a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.gear-request-alert text {
  display: block;
  overflow-wrap: anywhere;
}

.gear-template-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
}

.gear-template-action-button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
}

.gear-template-action-button.primary {
  flex-grow: 1.15;
}

.gear-template-action-button.import {
  flex-grow: 1.35;
}

.gear-template-action-button.muted {
  flex-grow: 0.78;
}

.gear-template-action-button.primary {
  background: #8b3ff5;
  color: #ffffff;
}

.gear-template-action-button.muted {
  background: rgba(255, 255, 255, 0.05);
  color: #d3d3d3;
}

.gear-template-action-button[disabled] {
  background: rgba(255, 255, 255, 0.06);
  color: #777777;
}

.gear-template-action-button::after {
  border: 0;
}

.gear-slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.gear-slot-card {
  min-width: 0;
  min-height: 176rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101010;
}

.gear-slot-card.verified {
  border-color: rgba(248, 183, 0, 0.42);
}

.gear-slot-card.partial {
  border-color: rgba(248, 183, 0, 0.22);
}

.gear-slot-card.blocked {
  opacity: 0.78;
}

.gear-slot-topline,
.gear-slot-footer,
.gear-slot-body {
  display: flex;
  gap: 12rpx;
}

.gear-slot-topline,
.gear-slot-footer {
  justify-content: space-between;
}

.gear-slot-body {
  align-items: center;
  margin-top: 10rpx;
}

.gear-slot-label,
.gear-slot-status,
.gear-slot-footer text {
  display: block;
  min-width: 0;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.gear-slot-label {
  color: #f8b700;
}

.gear-slot-status {
  color: #a7a7a7;
  text-align: right;
}

.gear-slot-footer {
  margin-top: 8rpx;
  color: #7f7f7f;
}

.gear-icon-frame.partial {
  border-color: rgba(248, 183, 0, 0.38);
}

.gear-icon-frame.blocked {
  opacity: 0.62;
}

.gear-empty-state {
  margin-top: 20rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.45;
}

.gear-loading-state {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(147, 51, 234, 0.28);
  border-radius: 16rpx;
  background: rgba(147, 51, 234, 0.1);
}

.gear-loading-title {
  color: #f5f3ff;
  font-size: 28rpx;
  font-weight: 800;
}

.gear-loading-copy {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 1.45;
}

.gear-slot-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.62);
}

.gear-slot-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 78vh;
  padding: 16rpx 22rpx 34rpx;
  border-radius: 28rpx 28rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: #111111;
  box-shadow: 0 -20rpx 48rpx rgba(0, 0, 0, 0.42);
}

.gear-community-template-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 72vh;
  padding: 16rpx 22rpx 34rpx;
  border-radius: 28rpx 28rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: #111111;
  box-shadow: 0 -20rpx 48rpx rgba(0, 0, 0, 0.42);
}

.gear-sheet-handle {
  width: 86rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.gear-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.gear-sheet-kicker,
.gear-sheet-title {
  display: block;
}

.gear-sheet-kicker {
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
}

.gear-sheet-title {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.gear-sheet-close {
  flex: none;
  min-width: 104rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.gear-sheet-close::after {
  border: 0;
}

.gear-sheet-filter-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.gear-sheet-filter {
  min-width: 0;
  min-height: 58rpx;
  padding: 8rpx 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  background: #181818;
  color: #a7a7a7;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.gear-sheet-filter.active {
  border-color: rgba(248, 183, 0, 0.55);
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
}

.gear-sheet-filter text {
  display: block;
  overflow-wrap: anywhere;
}

.gear-sheet-filter-count {
  margin-top: 4rpx;
  color: #7d7d7d;
  font-size: 16rpx;
}

.gear-candidate-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  max-height: 30vh;
  margin-top: 18rpx;
  overflow-y: auto;
}

.gear-candidate-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #181818;
}

.gear-candidate-row.selected {
  border-color: rgba(248, 183, 0, 0.5);
  background: rgba(248, 183, 0, 0.1);
}

.gear-candidate-meta {
  flex: none;
  width: 118rpx;
  color: #8e8e8e;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: right;
}

.gear-candidate-meta text {
  display: block;
  overflow-wrap: anywhere;
}

.gear-sheet-config {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.gear-sheet-active-name,
.gear-sheet-active-source,
.gear-sheet-section-title {
  display: block;
  overflow-wrap: anywhere;
}

.gear-sheet-active-name {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.gear-sheet-active-source {
  margin-top: 4rpx;
  color: #8e8e8e;
  font-size: 20rpx;
  line-height: 1.35;
}

.gear-variant-section,
.gear-mod-section {
  margin-top: 16rpx;
}

.gear-sheet-section-title {
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
}

.gear-variant-list,
.gear-mod-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.gear-variant-chip,
.gear-mod-option {
  min-height: 54rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  background: #181818;
  color: #d8d8d8;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.gear-variant-chip text,
.gear-mod-option text {
  display: block;
  overflow-wrap: anywhere;
}

.gear-variant-chip.active,
.gear-mod-option.active {
  border-color: rgba(139, 74, 246, 0.8);
  background: rgba(139, 74, 246, 0.18);
  color: #ffffff;
}

.gear-apply-button {
  width: 100%;
  min-height: 76rpx;
  margin: 18rpx 0 0;
  border-radius: 12rpx;
  background: #8b4af6;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.gear-apply-button::after {
  border: 0;
}

.gear-community-template-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  max-height: 52vh;
  margin-top: 18rpx;
  overflow-y: auto;
}

.gear-community-template-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #181818;
}

.gear-community-template-card.complete {
  border-color: rgba(88, 201, 142, 0.42);
}

.gear-community-template-card.partial {
  border-color: rgba(248, 183, 0, 0.36);
}

.gear-community-template-card.blocked {
  opacity: 0.72;
}

.gear-community-template-main {
  min-width: 0;
}

.gear-community-template-title,
.gear-community-template-meta,
.gear-community-template-state {
  display: block;
  overflow-wrap: anywhere;
}

.gear-community-template-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.28;
}

.gear-community-template-meta {
  margin-top: 6rpx;
  color: #9f9f9f;
  font-size: 20rpx;
  line-height: 1.35;
}

.gear-community-template-side {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: stretch;
  text-align: left;
}

.gear-community-template-state {
  color: #f8b700;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
}

.gear-community-template-apply {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #8b4af6;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.gear-community-template-apply[disabled] {
  background: rgba(255, 255, 255, 0.08);
  color: #777777;
}

.gear-community-template-apply::after {
  border: 0;
}

.gear-community-template-empty {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  color: #9f9f9f;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.stat-scenario-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.stat-scenario-tab {
  min-width: 0;
  min-height: 78rpx;
  padding: 12rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #101010;
  color: #a7a7a7;
  text-align: center;
}

.stat-scenario-tab.active {
  border-color: rgba(248, 183, 0, 0.52);
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
}

.stat-scenario-title,
.stat-scenario-status {
  display: block;
  overflow-wrap: anywhere;
}

.stat-scenario-title {
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.stat-scenario-status {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.2;
}

.stat-source-state {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #101010;
}

.stat-source-state.verified {
  border-color: rgba(88, 201, 142, 0.42);
}

.stat-source-state.partial,
.stat-source-state.stale {
  border-color: rgba(248, 183, 0, 0.32);
}

.stat-source-state.blocked {
  border-color: rgba(239, 93, 93, 0.32);
}

.stat-source-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.stat-source-badge,
.stat-source-scenario,
.stat-source-meta {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
}

.stat-source-badge {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.14);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
}

.stat-source-scenario {
  flex: 1;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  text-align: right;
}

.stat-source-meta {
  margin-top: 12rpx;
  color: #a7a7a7;
  font-size: 21rpx;
  line-height: 1.45;
}

.stat-validation-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.stat-validation-grid text {
  display: block;
  min-height: 48rpx;
  padding: 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #d3d3d3;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
  overflow-wrap: anywhere;
}

.stat-copy {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.stat-value {
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
}

.stat-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #2a2a2a;
}

.stat-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8b3ff5, #f8b700);
}

.stat-row.primary .stat-fill {
  background: linear-gradient(90deg, #58c98e, #f8b700);
}

.stat-blocked-list,
.stat-advice-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.2);
  border-radius: 12rpx;
  background: rgba(248, 183, 0, 0.08);
}

.stat-blocked-title,
.stat-blocked-item,
.stat-advice-title,
.stat-advice-item {
  display: block;
  overflow-wrap: anywhere;
}

.stat-blocked-title,
.stat-advice-title {
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.stat-blocked-item,
.stat-advice-item {
  color: #e1d6b8;
  font-size: 21rpx;
  line-height: 1.45;
}

.stat-advice-title.warning {
  margin-top: 4rpx;
  color: #f2a65a;
}

.stat-advice-item.warning {
  color: #d6c5aa;
}

.stat-simc-button {
  width: 100%;
  min-height: 72rpx;
  margin: 18rpx 0 0;
  border-radius: 14rpx;
  background: #8b3ff5;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.stat-simc-button::after {
  border: 0;
}

.rotation-step {
  position: relative;
  padding: 18rpx 18rpx 18rpx 28rpx;
  border-left: 6rpx solid #f8b700;
  border-radius: 16rpx;
  background: #101010;
}

.source-box {
  margin-top: 22rpx;
  padding: 22rpx;
}

.source-box-title {
  display: block;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
}

.source-box-text {
  display: block;
  margin-top: 8rpx;
  color: #a7a7a7;
  font-size: 22rpx;
  line-height: 1.45;
}
