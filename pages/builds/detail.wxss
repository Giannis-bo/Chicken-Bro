.detail-shell {
  background: #edf3ff;
}

.detail-content {
  padding-bottom: 72rpx;
}

.detail-hero,
.filter-panel,
.module-panel,
.source-box {
  border: 1rpx solid rgba(21, 63, 138, 0.12);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(21, 63, 138, 0.08);
}

.detail-hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #153f8a 0%, #1f5bb8 68%, #f2c94c 170%);
  color: #ffffff;
}

.detail-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(242, 201, 76, 0.18);
  color: #ffe58a;
  font-size: 22rpx;
}

.detail-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.16;
}

.detail-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.5;
}

.filter-panel {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 24rpx;
}

.picker-field {
  flex: 1;
  min-width: 0;
}

.picker-label {
  display: block;
  margin-bottom: 10rpx;
  color: #6f7d92;
  font-size: 22rpx;
}

.picker-value {
  min-height: 76rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(21, 63, 138, 0.16);
  border-radius: 16rpx;
  background: #edf3ff;
  color: #12346f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.source-strip {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff8dc;
  color: #80610c;
  font-size: 22rpx;
}

.module-panel {
  margin-top: 24rpx;
  padding: 26rpx;
}

.panel-title {
  display: block;
  color: #153f8a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.34;
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #6f7d92;
  font-size: 23rpx;
  line-height: 1.45;
}

.talent-code-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #102e66;
}

.code-label,
.code-value {
  display: block;
}

.code-label {
  color: #f2c94c;
  font-size: 22rpx;
}

.code-value {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.talent-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.talent-chip {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(21, 63, 138, 0.16);
  border-radius: 999rpx;
  background: #edf3ff;
  color: #153f8a;
  font-size: 22rpx;
  font-weight: 700;
}

.gear-list,
.stat-bars,
.rotation-timeline,
.insight-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.gear-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #edf3ff;
}

.gear-slot {
  flex: none;
  width: 96rpx;
  color: #153f8a;
  font-size: 22rpx;
  font-weight: 700;
}

.gear-copy {
  flex: 1;
  min-width: 0;
}

.gear-name,
.gear-source,
.stat-name,
.stat-value,
.phase-name,
.phase-copy,
.insight-item {
  display: block;
}

.gear-name,
.stat-name,
.phase-name {
  color: #22334d;
  font-size: 24rpx;
  font-weight: 700;
}

.gear-source,
.phase-copy,
.insight-item {
  margin-top: 6rpx;
  color: #657489;
  font-size: 23rpx;
  line-height: 1.48;
}

.stat-copy {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.stat-value {
  color: #b68a11;
  font-size: 24rpx;
  font-weight: 700;
}

.stat-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #d9e5fb;
}

.stat-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #153f8a, #f2c94c);
}

.rotation-step {
  position: relative;
  padding: 18rpx 18rpx 18rpx 28rpx;
  border-left: 6rpx solid #f2c94c;
  border-radius: 14rpx;
  background: #edf3ff;
}

.source-box {
  margin-top: 24rpx;
  padding: 22rpx;
}

.source-box-title {
  display: block;
  color: #153f8a;
  font-size: 24rpx;
  font-weight: 700;
}

.source-box-text {
  display: block;
  margin-top: 8rpx;
  color: #58677d;
  font-size: 22rpx;
  line-height: 1.45;
}
