<view class="page-shell workbench-shell">
  <navigation-bar title="当前专精工作台" back="{{true}}" color="#FFFFFF" background="#111111"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y scroll-top="{{scrollTop}}" bindscroll="handleWorkbenchScroll">
    <view class="page-content workbench-content">
      <view class="workbench-hero workbench-cockpit {{workbenchState.stateClass}}">
        <view class="workbench-hero-content">
          <view class="workbench-title-row">
            <view class="spec-medallion {{workbenchState.stateClass}}">
              <text>{{workbenchState.specMonogram}}</text>
              <image wx:if="{{workbenchState.specIconUrl}}" src="{{workbenchState.specIconUrl}}" mode="aspectFill"></image>
            </view>
            <view class="workbench-title-copy">
              <text class="workbench-kicker">当前专精</text>
              <text class="workbench-title">{{workbenchState.selectedSpecLabel}}</text>
              <text class="workbench-subtitle">{{workbenchState.selectedHeroLabel}} · {{workbenchState.selectedScenarioLabel}}</text>
              <text class="workbench-intent">{{workbenchState.identitySignal}} · 证据更新 {{workbenchState.evidenceUpdatedAt}}</text>
            </view>
            <view class="readiness-badge {{workbenchState.stateClass}}">
              <text>{{workbenchState.stateLabel}}</text>
            </view>
          </view>

          <view class="cockpit-signal-row" wx:if="{{workbenchState.identityIcons.length}}">
            <view class="cockpit-real-icons" wx:if="{{workbenchState.identityIcons.length}}">
              <view class="cockpit-real-icon {{item.statusClass}}" wx:for="{{workbenchState.identityIcons}}" wx:key="key">
                  <image src="{{item.iconUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
              </view>
            </view>
            <view class="cockpit-signal-copy">
              <text>证据更新 {{workbenchState.evidenceUpdatedAt}}</text>
              <text>{{workbenchState.identitySignal}}</text>
            </view>
          </view>

          <view class="workbench-control-strip">
            <picker class="workbench-picker" mode="selector" range="{{classOptions}}" range-key="name" value="{{classIndex}}" bindchange="selectClass">
              <text class="picker-label">职业</text>
              <text class="picker-value">{{selectedClassName}}</text>
            </picker>
            <picker class="workbench-picker" mode="selector" range="{{specOptions}}" range-key="specName" value="{{specIndex}}" bindchange="selectSpec">
              <text class="picker-label">专精</text>
              <text class="picker-value">{{selectedSpecName}}</text>
            </picker>
            <view class="scenario-tabs">
              <view
                wx:for="{{scenarioOptions}}"
                wx:key="key"
                class="scenario-tab {{scenarioIndex == index ? 'active' : ''}}"
                data-index="{{index}}"
                bindtap="selectScenario"
              >
                <text>{{item.title}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="readiness-panel verdict-slab {{workbenchState.stateClass}}">
        <view class="verdict-head">
          <view class="readiness-copy">
            <text class="verdict-kicker">模拟准备结论</text>
            <text class="readiness-title">{{workbenchState.headline}}</text>
            <view class="verdict-blocker-line">
              <text class="verdict-label">{{workbenchState.primaryBlockerLabel}}</text>
              <text class="verdict-value">{{workbenchState.primaryBlockerTitle}}</text>
            </view>
            <text class="readiness-summary">{{workbenchState.summary}}</text>
          </view>
          <view class="verdict-status-slot">
            <status-visual
              state="{{workbenchState.state}}"
              label="{{workbenchState.stateLabel}}"
              mode="layered"
              shape="auto"
              size="hero"
              fill="{{true}}"
            ></status-visual>
          </view>
        </view>
        <view class="verdict-blocker-list" wx:if="{{workbenchState.secondaryBlockers.length}}">
          <block wx:for="{{workbenchState.secondaryBlockers}}" wx:key="id">
            <view class="blocker-row {{item.statusClass}}">
              <view class="blocker-copy">
                <text class="blocker-title">{{item.title}}</text>
                <text class="blocker-desc">{{item.desc}}</text>
              </view>
              <button class="blocker-action" data-key="{{item.actionKey}}" bindtap="openBlockerAction">{{item.actionLabel}}</button>
            </view>
          </block>
        </view>
        <view class="verdict-next">
          <text class="verdict-next-label">下一步</text>
          <view class="primary-action" bindtap="openPrimaryAction" hover-class="primary-action-hover">
            <text>{{workbenchState.primaryAction.label}}</text>
            <text class="primary-action-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="module-band">
        <view class="section-header compact-header">
          <text class="section-title">工作流状态</text>
          <text class="section-action">{{loading ? '读取中' : workbenchState.stateLabel}}</text>
        </view>
        <view class="module-card-grid">
          <view
            class="module-card {{item.statusClass}}"
            wx:for="{{workbenchState.moduleCards}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="openModule"
          >
            <view class="module-card-top">
              <view class="game-icon-frame">
                <image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
                <text wx:else>{{item.iconFallback}}</text>
              </view>
            </view>
            <view class="module-card-copy">
              <text class="module-title">{{item.title}}</text>
              <text class="module-metric">{{item.metric}}</text>
              <text class="module-desc">{{item.dockDesc}}</text>
            </view>
            <view class="module-card-side">
              <text class="module-status">{{item.statusPillLabel}}</text>
              <text class="module-link">{{item.actionLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="evidence-section">
        <view class="section-header compact-header">
          <text class="section-title">证据明细</text>
          <view class="evidence-actions">
            <text class="template-count">{{templateSourceLabel}} 天赋 {{workbenchState.templateSummary.talentCount}} / 装备 {{workbenchState.templateSummary.gearCount}}</text>
            <view class="evidence-toggle" bindtap="toggleEvidence">
              <text>{{evidenceExpanded ? '收起' : '展开'}}</text>
            </view>
          </view>
        </view>
        <view class="evidence-list" wx:if="{{!evidenceExpanded}}">
          <view class="evidence-row {{item.statusClass}}" wx:for="{{workbenchState.evidencePreviewRows}}" wx:key="key">
            <view class="evidence-icon-socket">
              <text>{{item.labelInitial}}</text>
            </view>
            <view class="evidence-copy">
              <text class="evidence-label">{{item.label}}</text>
              <text class="evidence-value">{{item.value}}</text>
            </view>
            <text class="evidence-status">{{item.statusLabel}}</text>
            <text class="evidence-arrow">›</text>
          </view>
        </view>
        <view class="evidence-list expanded" wx:else>
          <view class="evidence-row {{item.statusClass}}" wx:for="{{workbenchState.evidenceRows}}" wx:key="key">
            <view class="evidence-icon-socket">
              <text>{{item.labelInitial}}</text>
            </view>
            <view class="evidence-copy">
              <text class="evidence-label">{{item.label}}</text>
              <text class="evidence-value">{{item.value}}</text>
            </view>
            <text class="evidence-status">{{item.statusLabel}}</text>
            <text class="evidence-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
