.talent-simulator-page {
  min-height: 100vh;
  background: #050505;
  color: #f2f2f2;
}

.page-scroll {
  height: 100vh;
}

.talent-page-content {
  padding: 24rpx 24rpx 88rpx;
}

.talent-header,
.talent-toolbar,
.talent-actions,
.talent-export-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #121212;
}

.talent-header {
  padding: 28rpx;
  border-color: rgba(248, 183, 0, 0.26);
  background: linear-gradient(135deg, #121212 0%, #1b1710 58%, #2a2416 100%);
}

.talent-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.talent-kicker {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.talent-title {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
}

.talent-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.32);
  border-radius: 999rpx;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.talent-status.blocked,
.talent-status.fallback {
  border-color: rgba(255, 96, 86, 0.35);
  color: #ff8c80;
}

.talent-desc {
  display: block;
  margin-top: 18rpx;
  color: #c9c3b6;
  font-size: 24rpx;
  line-height: 1.48;
}

.talent-toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.toolbar-picker {
  min-height: 86rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.picker-label {
  display: block;
  color: #8f8f8f;
  font-size: 20rpx;
  line-height: 1.2;
}

.picker-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
}

.talent-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 14rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.talent-search-input {
  height: 42rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.search-placeholder {
  color: #6f6f6f;
}

.search-count {
  display: block;
  color: #f8b700;
  font-size: 18rpx;
  line-height: 20rpx;
}

.icon-button {
  width: 86rpx;
  height: 68rpx;
  padding: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 12rpx;
  background: #191815;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.talent-board-scroll {
  margin-top: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 16rpx;
  background: #090909;
}

.talent-board {
  display: flex;
  gap: 18rpx;
  min-width: 1500rpx;
  padding: 18rpx;
}

.talent-column {
  width: 480rpx;
  min-height: 820rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.1), transparent 34%), #101010;
}

.talent-column.spec {
  background: radial-gradient(circle at 50% 0%, rgba(84, 192, 255, 0.1), transparent 34%), #101010;
}

.talent-column.hero {
  background: radial-gradient(circle at 50% 0%, rgba(96, 232, 196, 0.12), transparent 34%), #101010;
}

.column-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.column-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.column-points {
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
}

.talent-grid {
  position: relative;
  height: 736rpx;
}

.hero-grid {
  height: 650rpx;
}

.talent-link {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.24);
  transform-origin: 0 50%;
}

.talent-node {
  position: absolute;
  width: 78rpx;
  height: 78rpx;
  margin-left: -39rpx;
  margin-top: -39rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: #1a1a1a;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.42);
}

.talent-node.available {
  border-color: rgba(248, 183, 0, 0.32);
}

.talent-node.selected {
  border-color: #f8b700;
  box-shadow: 0 0 0 5rpx rgba(248, 183, 0, 0.12), 0 12rpx 26rpx rgba(0, 0, 0, 0.5);
}

.talent-node.locked {
  opacity: 0.44;
  filter: grayscale(1);
}

.talent-node.granted {
  border-color: #60e8c4;
}

.talent-node.choice {
  border-radius: 16rpx;
}

.talent-node.search-match {
  border-color: #54c0ff;
  box-shadow: 0 0 0 6rpx rgba(84, 192, 255, 0.16);
}

.talent-node.search-dimmed {
  opacity: 0.28;
}

.talent-icon,
.talent-icon-fallback {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.talent-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 900;
}

.talent-rank {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  min-width: 46rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.5);
  border-radius: 999rpx;
  background: #050505;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

.talent-export-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.export-copy {
  flex: 1;
  min-width: 0;
}

.export-title {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.export-code {
  display: block;
  margin-top: 8rpx;
  color: #c9c3b6;
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-all;
}

.simc-button {
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: #f8b700;
  color: #111111;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.58);
}

.talent-choice-sheet,
.talent-detail-sheet,
.talent-import-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 18rpx 24rpx 42rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx 28rpx 0 0;
  background: #121212;
  color: #ffffff;
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.sheet-title {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.choice-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  margin-top: 14rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #0c0c0c;
}

.choice-option.selected {
  border-color: rgba(248, 183, 0, 0.5);
  background: rgba(248, 183, 0, 0.1);
}

.sheet-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-option-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.24;
}

.sheet-option-desc {
  display: block;
  margin-top: 8rpx;
  color: #a9a9a9;
  font-size: 22rpx;
  line-height: 1.42;
}

.sheet-rank {
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
}

.detail-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lock-reason {
  display: block;
  margin-top: 12rpx;
  color: #ff8c80;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  margin-top: 24rpx;
}

.rank-button {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 50%;
  background: #191815;
  color: #f8b700;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.rank-current {
  min-width: 92rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.import-input {
  width: auto;
  min-height: 210rpx;
  margin: 18rpx 0;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: #080808;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
}
