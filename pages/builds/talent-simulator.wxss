.talent-simulator-page {
  min-height: 100vh;
  background: #050505;
  color: #f2f2f2;
}

.page-scroll {
  height: 100vh;
}

.talent-page-content {
  padding: 20rpx 22rpx 208rpx;
}

.talent-header,
.talent-toolbar,
.tree-tabs,
.active-tree-panel,
.talent-export-summary {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #121212;
}

.talent-header {
  padding: 22rpx;
  border-color: rgba(248, 183, 0, 0.26);
  background: linear-gradient(135deg, #101010 0%, #17120d 64%, #21170f 100%);
}

.talent-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.talent-kicker {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.talent-title {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.16;
}

.talent-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.32);
  border-radius: 999rpx;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.talent-status.blocked,
.talent-status.fallback {
  border-color: rgba(255, 96, 86, 0.35);
  color: #ff8c80;
}

.talent-desc {
  display: block;
  margin-top: 12rpx;
  color: #c9c3b6;
  font-size: 24rpx;
  line-height: 1.42;
}

.talent-toolbar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 12rpx;
}

.toolbar-picker {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
  gap: 8rpx;
  overflow: hidden;
}

.picker-label {
  flex-shrink: 0;
  color: #8f8f8f;
  font-size: 20rpx;
  line-height: 1.2;
}

.picker-value {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 12rpx;
}

.tree-tab {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
  gap: 8rpx;
  overflow: hidden;
}

.tree-tab.active {
  border-color: rgba(248, 183, 0, 0.58);
  background: #191815;
  box-shadow: inset 0 0 0 1rpx rgba(248, 183, 0, 0.14);
}

.tree-tab-label {
  flex-shrink: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tree-tab-points {
  flex-shrink: 0;
  margin-top: 0;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tree-tab-subtitle {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  color: #8f8f8f;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-tree-panel {
  margin-top: 18rpx;
  border-color: rgba(248, 183, 0, 0.2);
  background: linear-gradient(135deg, rgba(248, 183, 0, 0.08), #101010 48%);
  overflow: hidden;
}

.active-tree-hero {
  border-color: rgba(96, 232, 196, 0.22);
  background: linear-gradient(135deg, rgba(96, 232, 196, 0.1), #101010 54%);
}

.active-tree-spec {
  border-color: rgba(84, 192, 255, 0.22);
  background: linear-gradient(135deg, rgba(84, 192, 255, 0.1), #101010 54%);
}

.active-tree-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.active-tree-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  overflow: hidden;
}

.active-tree-kicker {
  flex-shrink: 0;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.active-tree-separator {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.34);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.active-tree-title {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.24;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-tree-subtitle {
  flex-shrink: 0;
  max-width: 128rpx;
  margin-top: 0;
  color: #9c9c9c;
  font-size: 20rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-tree-points {
  flex-shrink: 0;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tree-progress {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.tree-progress-fill {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: #f8b700;
}

.talent-grid {
  position: relative;
  width: 660rpx;
  height: 1080rpx;
}

.active-tree-grid {
  margin: 26rpx auto 48rpx;
}

.active-tree-grid-hero {
  height: 820rpx;
}

.active-tree-grid-spec {
  height: 1080rpx;
}

.talent-link {
  position: absolute;
  z-index: 1;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(150, 150, 150, 0.48);
  transform-origin: 0 50%;
  pointer-events: none;
}

.talent-link::after {
  content: '';
  position: absolute;
  right: -2rpx;
  top: 50%;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid rgba(150, 150, 150, 0.62);
  transform: translateY(-50%);
}

.talent-link.available {
  background: rgba(248, 183, 0, 0.72);
  box-shadow: 0 0 8rpx rgba(248, 183, 0, 0.2);
}

.talent-link.available::after {
  border-left-color: rgba(248, 183, 0, 0.86);
}

.talent-link.active {
  background: #f8b700;
  box-shadow: 0 0 10rpx rgba(248, 183, 0, 0.28);
}

.talent-link.active::after {
  border-left-color: #f8b700;
}

.talent-node {
  position: absolute;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  margin-top: -32rpx;
  box-sizing: border-box;
  border: 5rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: #1a1a1a;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.42);
}

.talent-node.shape-circle {
  border-radius: 50%;
}

.talent-node.shape-square {
  border-radius: 14rpx;
}

.talent-node.shape-apex {
  border-radius: 14rpx;
}

.talent-node.shape-choice {
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.talent-choice-frame {
  display: none;
}

.talent-node.shape-choice .talent-choice-frame {
  display: block;
  position: absolute;
  z-index: 1;
  left: -3rpx;
  top: -3rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(150, 150, 150, 0.72);
  pointer-events: none;
  -webkit-clip-path: polygon(20% 0, 80% 0, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0 80%, 0 20%);
  clip-path: polygon(20% 0, 80% 0, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0 80%, 0 20%);
  filter: drop-shadow(0 4rpx 5rpx rgba(0, 0, 0, 0.78));
}

.talent-node.shape-choice .talent-choice-frame::after {
  content: '';
  position: absolute;
  inset: 5rpx;
  background: #1a1a1a;
  -webkit-clip-path: polygon(20% 0, 80% 0, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0 80%, 0 20%);
  clip-path: polygon(20% 0, 80% 0, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0 80%, 0 20%);
}

.talent-node.shape-choice::before,
.talent-node.shape-choice::after {
  content: '';
  position: absolute;
  z-index: 4;
  top: 50%;
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  transform: translateY(-50%);
  filter: drop-shadow(0 3rpx 4rpx rgba(0, 0, 0, 0.7));
}

.talent-node.shape-choice::before {
  left: -13rpx;
  border-right: 16rpx solid rgba(150, 150, 150, 0.72);
}

.talent-node.shape-choice::after {
  right: -13rpx;
  border-left: 16rpx solid rgba(150, 150, 150, 0.72);
}

.talent-node.shape-choice .talent-icon,
.talent-node.shape-choice .talent-icon-fallback {
  position: absolute;
  z-index: 2;
  left: 6rpx;
  top: 6rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 0;
  -webkit-clip-path: polygon(18% 0, 82% 0, 100% 18%, 100% 82%, 82% 100%, 18% 100%, 0 82%, 0 18%);
  clip-path: polygon(18% 0, 82% 0, 100% 18%, 100% 82%, 82% 100%, 18% 100%, 0 82%, 0 18%);
}

.talent-node.shape-choice.available .talent-choice-frame,
.talent-node.shape-choice.selected .talent-choice-frame,
.talent-node.shape-choice.granted .talent-choice-frame,
.talent-node.shape-choice.selectable:not(.selected) .talent-choice-frame {
  background: #f8b700;
}

.talent-node.shape-choice.available::before,
.talent-node.shape-choice.selected::before,
.talent-node.shape-choice.granted::before {
  border-right-color: #f8b700;
}

.talent-node.shape-choice.available::after,
.talent-node.shape-choice.selected::after,
.talent-node.shape-choice.granted::after {
  border-left-color: #f8b700;
}

.talent-node.shape-choice.locked:not(.selected)::before {
  border-right-color: rgba(150, 150, 150, 0.72);
}

.talent-node.shape-choice.locked:not(.selected)::after {
  border-left-color: rgba(150, 150, 150, 0.72);
}

.talent-node.shape-choice.locked:not(.selected) .talent-choice-frame {
  background: rgba(150, 150, 150, 0.72);
}

.talent-node.available {
  border-color: rgba(248, 183, 0, 0.32);
}

.talent-node.selected {
  border-color: #f8b700;
  box-shadow: 0 0 0 5rpx rgba(248, 183, 0, 0.12), 0 12rpx 26rpx rgba(0, 0, 0, 0.5);
}

.talent-node.locked {
  opacity: 0.44;
  filter: grayscale(1);
}

.talent-node.granted {
  border-color: #f8b700;
  box-shadow: 0 0 0 5rpx rgba(248, 183, 0, 0.12), 0 12rpx 26rpx rgba(0, 0, 0, 0.5);
}

.talent-node.selectable:not(.selected) {
  border-color: #24f05a;
  box-shadow: 0 0 0 5rpx rgba(36, 240, 90, 0.14), 0 12rpx 24rpx rgba(0, 0, 0, 0.48);
}

.talent-icon,
.talent-icon-fallback {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.talent-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 900;
}

.talent-rank {
  position: absolute;
  z-index: 5;
  right: -8rpx;
  bottom: -8rpx;
  min-width: 42rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.5);
  border-radius: 999rpx;
  background: #050505;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 28rpx;
  text-align: center;
}

.talent-export-summary {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 16rpx;
}

.export-copy {
  flex: 1;
  min-width: 0;
}

.export-title {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.export-code {
  display: block;
  margin-top: 8rpx;
  color: #c9c3b6;
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-all;
}

.simc-button {
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: #f8b700;
  color: #111111;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.mobile-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: grid;
  grid-template-columns: minmax(220rpx, 1.15fr) minmax(220rpx, 1fr) 132rpx;
  gap: 12rpx;
  padding: 12rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.94), rgba(5, 5, 5, 0.98));
  box-shadow: 0 -14rpx 28rpx rgba(0, 0, 0, 0.34);
}

.mobile-action-bar button::after {
  border: 0;
}

.mobile-action-bar button {
  width: 100%;
  min-width: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}

.action-primary-button,
.action-secondary-button {
  height: 72rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.action-primary-button {
  border: 1rpx solid rgba(248, 183, 0, 0.78);
  background: #f8b700;
  color: #111111;
  box-shadow: 0 8rpx 20rpx rgba(248, 183, 0, 0.18);
}

.action-primary-button[disabled],
.save-sheet-primary[disabled] {
  opacity: 0.48;
  background: #7a650d;
  color: rgba(17, 17, 17, 0.72);
}

.action-secondary-button {
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  background: #141414;
  color: #f8b700;
}

.community-action-button {
  font-size: 22rpx;
}

.reset-action-button {
  border-color: rgba(255, 255, 255, 0.14);
  color: #d9d2c0;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.58);
}

.talent-choice-sheet,
.talent-detail-sheet,
.template-save-sheet,
.community-template-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 16rpx 22rpx 36rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx 20rpx 0 0;
  background: #121212;
  color: #ffffff;
}

.community-template-sheet {
  max-height: 72vh;
}

.template-save-sheet {
  padding: 16rpx 22rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.sheet-title {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.choice-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  margin-top: 12rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.choice-option.selected {
  border-color: rgba(248, 183, 0, 0.5);
  background: rgba(248, 183, 0, 0.1);
}

.sheet-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-option-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.24;
}

.sheet-option-desc {
  display: block;
  margin-top: 8rpx;
  color: #a9a9a9;
  font-size: 22rpx;
  line-height: 1.42;
}

.sheet-rank {
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
}

.detail-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lock-reason {
  display: block;
  margin-top: 12rpx;
  color: #ff8c80;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  margin-top: 24rpx;
}

.rank-button {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 50%;
  background: #191815;
  color: #f8b700;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.rank-button::after {
  border: 0;
}

.rank-current {
  min-width: 92rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.template-name-input {
  width: 100%;
  height: 72rpx;
  margin: 18rpx 0 14rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  background: #080808;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.save-sheet-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.save-sheet-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.save-sheet-secondary,
.save-sheet-primary {
  height: 72rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.save-sheet-secondary::after,
.save-sheet-primary::after {
  border: 0;
}

.save-sheet-secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: #151515;
  color: #d8d8d8;
}

.save-sheet-primary {
  border: 1rpx solid rgba(248, 183, 0, 0.72);
  background: #f8b700;
  color: #111111;
}

.community-status {
  margin-top: 10rpx;
}

.community-template-empty {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
  color: #a9a9a9;
  font-size: 24rpx;
  text-align: center;
}

.community-template-list {
  max-height: 52vh;
  margin-top: 16rpx;
}

.community-template-card {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.community-template-card.external {
  border-color: rgba(84, 192, 255, 0.3);
}

.community-template-card.blocked {
  opacity: 0.6;
}

.template-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.template-title-wrap {
  flex: 1;
  min-width: 0;
}

.template-name {
  display: block;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.template-source {
  display: block;
  margin-top: 8rpx;
  color: #a9a9a9;
  font-size: 21rpx;
  line-height: 1.3;
}

.template-mode {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 999rpx;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.community-template-card.external .template-mode {
  border-color: rgba(84, 192, 255, 0.34);
  color: #54c0ff;
}

.template-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.template-meta {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #d8d8d8;
  font-size: 20rpx;
  line-height: 1.2;
}

.template-note {
  display: block;
  margin-top: 12rpx;
  color: #8f8f8f;
  font-size: 21rpx;
  line-height: 1.38;
}

.template-apply-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  margin-top: 16rpx;
}

.template-apply-button {
  width: 300rpx;
  max-width: 100%;
  height: 66rpx;
  margin: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 12rpx;
  background: #f8b700;
  color: #111111;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.template-apply-button::after {
  border: 0;
}
