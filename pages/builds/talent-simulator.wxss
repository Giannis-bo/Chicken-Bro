.talent-simulator-page {
  min-height: 100vh;
  background: #050505;
  color: #f2f2f2;
}

.page-scroll {
  height: 100vh;
}

.talent-page-content {
  padding: 24rpx 24rpx 188rpx;
}

.talent-header,
.talent-toolbar,
.talent-search-panel,
.tree-tabs,
.active-tree-panel,
.talent-export-summary {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: #121212;
}

.talent-header {
  padding: 28rpx;
  border-color: rgba(248, 183, 0, 0.26);
  background: linear-gradient(135deg, #121212 0%, #1b1710 58%, #2a2416 100%);
}

.talent-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.talent-kicker {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
}

.talent-title {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
}

.talent-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.32);
  border-radius: 999rpx;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.talent-status.blocked,
.talent-status.fallback {
  border-color: rgba(255, 96, 86, 0.35);
  color: #ff8c80;
}

.talent-desc {
  display: block;
  margin-top: 18rpx;
  color: #c9c3b6;
  font-size: 24rpx;
  line-height: 1.48;
}

.talent-toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.toolbar-picker {
  min-height: 86rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.picker-label {
  display: block;
  color: #8f8f8f;
  font-size: 20rpx;
  line-height: 1.2;
}

.picker-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
}

.talent-search-panel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 14rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
}

.talent-search-input {
  height: 42rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.search-placeholder {
  color: #6f6f6f;
}

.search-count {
  display: block;
  color: #f8b700;
  font-size: 18rpx;
  line-height: 20rpx;
}

.search-clear-button {
  flex-shrink: 0;
  width: 92rpx;
  height: 68rpx;
  padding: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 12rpx;
  background: #191815;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.tree-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 12rpx;
}

.tree-tab {
  position: relative;
  min-height: 116rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #0c0c0c;
  overflow: hidden;
}

.tree-tab.active {
  border-color: rgba(248, 183, 0, 0.58);
  background: #191815;
  box-shadow: inset 0 0 0 1rpx rgba(248, 183, 0, 0.14);
}

.tree-tab.has-match {
  border-color: rgba(84, 192, 255, 0.4);
}

.tree-tab-label {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tree-tab-points {
  display: block;
  margin-top: 8rpx;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tree-tab-subtitle,
.tree-tab-match {
  display: block;
  margin-top: 6rpx;
  color: #8f8f8f;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-tab-match {
  color: #54c0ff;
  font-weight: 800;
}

.active-tree-panel {
  margin-top: 18rpx;
  border-color: rgba(248, 183, 0, 0.2);
  background: radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.1), transparent 34%), #101010;
  overflow: hidden;
}

.active-tree-hero {
  border-color: rgba(96, 232, 196, 0.22);
  background: radial-gradient(circle at 50% 0%, rgba(96, 232, 196, 0.12), transparent 34%), #101010;
}

.active-tree-spec {
  border-color: rgba(84, 192, 255, 0.22);
  background: radial-gradient(circle at 50% 0%, rgba(84, 192, 255, 0.1), transparent 34%), #101010;
}

.active-tree-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 22rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.active-tree-title-wrap {
  flex: 1;
  min-width: 0;
}

.active-tree-kicker {
  display: block;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.active-tree-title {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.24;
}

.active-tree-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #9c9c9c;
  font-size: 21rpx;
  line-height: 1.3;
}

.active-tree-points {
  flex-shrink: 0;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tree-progress {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

.tree-progress-fill {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: #f8b700;
}

.talent-grid {
  position: relative;
  height: 960rpx;
}

.active-tree-grid {
  margin: 18rpx 8rpx 22rpx;
}

.active-tree-grid-hero {
  height: 760rpx;
}

.active-tree-grid-spec {
  height: 960rpx;
}

.talent-link {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.24);
  transform-origin: 0 50%;
}

.talent-node {
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  margin-left: -41rpx;
  margin-top: -41rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: #1a1a1a;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.42);
}

.talent-node.available {
  border-color: rgba(248, 183, 0, 0.32);
}

.talent-node.selected {
  border-color: #f8b700;
  box-shadow: 0 0 0 5rpx rgba(248, 183, 0, 0.12), 0 12rpx 26rpx rgba(0, 0, 0, 0.5);
}

.talent-node.locked {
  opacity: 0.44;
  filter: grayscale(1);
}

.talent-node.granted {
  border-color: #60e8c4;
}

.talent-node.choice {
  border-radius: 16rpx;
}

.talent-node.search-match {
  border-color: #54c0ff;
  box-shadow: 0 0 0 6rpx rgba(84, 192, 255, 0.16);
}

.talent-node.search-dimmed {
  opacity: 0.28;
}

.talent-icon,
.talent-icon-fallback {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.talent-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8b700;
  font-size: 28rpx;
  font-weight: 900;
}

.talent-rank {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  min-width: 46rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.5);
  border-radius: 999rpx;
  background: #050505;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

.talent-export-summary {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.export-copy {
  flex: 1;
  min-width: 0;
}

.export-title {
  display: block;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
}

.export-code {
  display: block;
  margin-top: 8rpx;
  color: #c9c3b6;
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-all;
}

.simc-button {
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  background: #f8b700;
  color: #111111;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.mobile-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  display: grid;
  grid-template-columns: 88rpx 88rpx 124rpx 88rpx minmax(0, 1fr);
  gap: 10rpx;
  padding: 14rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(8, 8, 8, 0.96);
}

.action-icon-button {
  height: 68rpx;
  padding: 0;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 12rpx;
  background: #191815;
  color: #f8b700;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.action-icon-button.community-button {
  font-size: 20rpx;
}

.action-primary-button {
  min-width: 0;
  width: 100%;
  height: 68rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 68rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.58);
}

.talent-choice-sheet,
.talent-detail-sheet,
.talent-import-sheet,
.community-template-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 18rpx 24rpx 42rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx 28rpx 0 0;
  background: #121212;
  color: #ffffff;
}

.community-template-sheet {
  max-height: 72vh;
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.sheet-title {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.choice-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  margin-top: 14rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #0c0c0c;
}

.choice-option.selected {
  border-color: rgba(248, 183, 0, 0.5);
  background: rgba(248, 183, 0, 0.1);
}

.sheet-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-option-title {
  display: block;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.24;
}

.sheet-option-desc {
  display: block;
  margin-top: 8rpx;
  color: #a9a9a9;
  font-size: 22rpx;
  line-height: 1.42;
}

.sheet-rank {
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
}

.detail-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lock-reason {
  display: block;
  margin-top: 12rpx;
  color: #ff8c80;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  margin-top: 24rpx;
}

.rank-button {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.42);
  border-radius: 50%;
  background: #191815;
  color: #f8b700;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.rank-current {
  min-width: 92rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.import-input {
  width: auto;
  min-height: 210rpx;
  margin: 18rpx 0;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: #080808;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
}

.community-status {
  margin-top: 10rpx;
}

.community-template-empty {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #0c0c0c;
  color: #a9a9a9;
  font-size: 24rpx;
  text-align: center;
}

.community-template-list {
  max-height: 52vh;
  margin-top: 16rpx;
}

.community-template-card {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 14rpx;
  background: #0c0c0c;
}

.community-template-card.external {
  border-color: rgba(84, 192, 255, 0.3);
}

.community-template-card.blocked {
  opacity: 0.6;
}

.template-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.template-title-wrap {
  flex: 1;
  min-width: 0;
}

.template-name {
  display: block;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.template-source {
  display: block;
  margin-top: 8rpx;
  color: #a9a9a9;
  font-size: 21rpx;
  line-height: 1.3;
}

.template-mode {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.34);
  border-radius: 999rpx;
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.community-template-card.external .template-mode {
  border-color: rgba(84, 192, 255, 0.34);
  color: #54c0ff;
}

.template-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.template-meta {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #d8d8d8;
  font-size: 20rpx;
  line-height: 1.2;
}

.template-note {
  display: block;
  margin-top: 12rpx;
  color: #8f8f8f;
  font-size: 21rpx;
  line-height: 1.38;
}

.template-apply-button {
  height: 66rpx;
  margin-top: 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: #f8b700;
  color: #111111;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 66rpx;
}
