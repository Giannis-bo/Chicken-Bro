<view class="page-shell builds-shell">
  <navigation-bar title="{{navTitle}}" back="{{false}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y scroll-top="{{scrollTop}}" bindscroll="handleBuildsScroll">
    <view class="page-content builds-content">
      <view class="hero builds-hero builds-spec-console">
        <view class="builds-hero-medallion">
          <image wx:if="{{workbenchEntry.specIconUrl}}" src="{{workbenchEntry.specIconUrl}}" mode="aspectFill"></image>
          <text wx:else>{{workbenchEntry.specInitial}}</text>
        </view>
        <view class="builds-hero-copy">
          <text class="hero-kicker">{{kicker}}</text>
          <text class="hero-title">{{workbenchEntry.specLabel}}</text>
          <text class="hero-desc">{{desc}}</text>
          <view class="builds-hero-chip-row">
            <view class="builds-hero-chip" wx:for="{{buildsOverview.chips}}" wx:key="label">
              <text class="builds-hero-chip-label">{{item.label}}</text>
              <text class="builds-hero-chip-value">{{item.value}}</text>
            </view>
          </view>
        </view>
        <view class="builds-hero-count">
          <text class="builds-hero-count-value">{{buildsOverview.specCount}}</text>
          <text class="builds-hero-count-label">专精</text>
        </view>
        <view class="builds-hero-module-strip">
          <view class="builds-hero-module module-{{item.statusTone}}" wx:for="{{workbenchEntry.modules}}" wx:key="key">
            <view class="builds-hero-module-icon">
              <text>{{item.iconText}}</text>
            </view>
            <view class="builds-hero-module-copy">
              <text class="builds-hero-module-title">{{item.title}}</text>
              <text class="builds-hero-module-status">{{item.statusLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="workbench-entry" bindtap="openWorkbench">
        <view class="workbench-entry-content">
          <view class="workbench-entry-top">
            <view class="workbench-entry-sigil">
              <image wx:if="{{workbenchEntry.classIconUrl}}" src="{{workbenchEntry.classIconUrl}}" mode="aspectFill"></image>
              <text wx:else>{{workbenchEntry.specInitial}}</text>
            </view>
            <view class="workbench-entry-copy">
              <text class="entry-title">{{workbenchEntry.title}}</text>
              <text class="entry-desc">{{workbenchEntry.readinessText}}</text>
            </view>
            <text class="entry-action">{{workbenchEntry.actionLabel}}</text>
          </view>
          <view class="workbench-entry-facts">
            <view class="workbench-fact" wx:for="{{workbenchEntry.facts}}" wx:key="label">
              <text class="workbench-fact-label">{{item.label}}</text>
              <text class="workbench-fact-value">{{item.value}}</text>
            </view>
          </view>
          <view class="workbench-status-list workbench-stage-grid">
            <view
              class="workbench-module-row module-{{item.statusTone}}"
              wx:for="{{workbenchEntry.modules}}"
              wx:key="key"
            >
              <view class="module-icon-socket">
                <text>{{item.iconText}}</text>
              </view>
              <view class="module-row-copy">
                <text class="module-title">{{item.title}}</text>
                <text class="module-status">{{item.statusLabel}}</text>
              </view>
              <view class="module-row-verdict">
                <text class="module-verdict-text">{{item.metaLabel}}</text>
                <text class="module-arrow">›</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="section query-section">
        <view class="section-header">
          <text class="section-title">构筑流程</text>
          <text class="section-action">输入 / 验证 / 追踪</text>
        </view>
        <view class="workflow-body">
          <view class="workflow-rail">
            <view class="workflow-dot" wx:for="{{quickActions}}" wx:key="key"></view>
          </view>
          <view class="query-grid">
            <view
              class="query-card"
              wx:for="{{quickActions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="openQueryPage"
            >
              <view class="query-icon-socket">
                <text class="query-icon">{{item.phaseLabel}}</text>
              </view>
              <view class="query-copy">
                <view class="query-head">
                  <text class="query-title">{{item.title}}</text>
                </view>
                <text class="query-desc">{{item.desc}}</text>
                <view class="query-meta-row">
                  <text class="query-submeta">{{item.scopeLabel}}</text>
                  <text class="query-evidence">{{item.evidenceLabel}}</text>
                </view>
              </view>
              <view class="query-action-dock">
                <text>{{item.actionLabel}}</text>
                <text class="query-action-arrow">›</text>
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

</view>
