<view class="page-shell builds-shell">
  <navigation-bar title="{{navTitle}}" back="{{false}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content builds-content">
      <view class="hero builds-hero">
        <text class="hero-kicker">{{kicker}}</text>
        <text class="hero-title">{{title}}</text>
        <text class="hero-desc">{{desc}}</text>
      </view>

      <view class="section query-section">
        <view class="section-header">
          <text class="section-title">查询入口</text>
          <text class="section-action">选择模块</text>
        </view>
        <view class="query-grid">
          <view
            class="query-card"
            wx:for="{{quickActions}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="openQueryPage"
          >
            <view class="query-icon">{{index + 1}}</view>
            <text class="query-title">{{item.title}}</text>
            <text class="query-desc">{{item.desc}}</text>
            <text class="query-link">进入查询</text>
          </view>
        </view>
      </view>

      <view class="section intel-section">
        <view class="section-header">
          <text class="section-title">热门专精</text>
          <text class="section-action" bindtap="openIntelPage">查看全部</text>
        </view>
        <swiper class="intel-swiper" indicator-dots circular indicator-color="rgba(255, 255, 255, 0.18)" indicator-active-color="#8B3FF5">
          <swiper-item wx:for="{{featuredSpecializations}}" wx:key="id">
            <view class="task-card intel-card">
              <view class="task-row">
                <text class="task-title">{{item.title}}</text>
                <text class="task-status">{{item.status}}</text>
              </view>
              <text class="task-desc">{{item.desc}}</text>
              <view class="source-row">
                <text>{{item.sourceName}}</text>
                <text>{{item.publishedAt}}</text>
              </view>
              <text class="source-note">{{item.analysisWindow}}</text>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>
  </scroll-view>

</view>
