.workbench-shell {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: #050504;
}

.workbench-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.14), rgba(248, 183, 0, 0) 34%),
    linear-gradient(180deg, #11100e 0%, #070706 44%, #030303 100%);
}

.workbench-shell::after {
  content: "";
  position: absolute;
  inset: 0 24rpx 0;
  z-index: 0;
  border-left: 1rpx solid rgba(248, 183, 0, 0.16);
  border-right: 1rpx solid rgba(248, 183, 0, 0.16);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    inset 0 120rpx 220rpx rgba(248, 183, 0, 0.035);
  pointer-events: none;
}

.workbench-shell-corner {
  position: absolute;
  z-index: 0;
  width: 176rpx;
  height: 196rpx;
  opacity: 0.34;
  pointer-events: none;
  mix-blend-mode: screen;
}

.workbench-shell-corner-top {
  top: 112rpx;
  right: -54rpx;
}

.workbench-shell-corner-bottom {
  left: -48rpx;
  bottom: 18rpx;
  opacity: 0.22;
  transform: rotate(180deg);
}

.page-scroll {
  position: relative;
  z-index: 1;
}

.workbench-shell .workbench-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 0 var(--wow-tabbar-space);
  box-sizing: border-box;
}

.surface-material {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  pointer-events: none;
}

.socket-material {
  position: absolute;
  inset: -7rpx;
  z-index: 0;
  width: calc(100% + 14rpx);
  height: calc(100% + 14rpx);
  opacity: 0.92;
  pointer-events: none;
}

.workbench-hero,
.readiness-panel,
.module-band,
.evidence-section {
  position: relative;
  width: calc(100% - 48rpx);
  max-width: 100%;
  margin-left: 24rpx;
  margin-right: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.26);
  border-radius: 0;
  background:
    linear-gradient(180deg, rgba(18, 16, 13, 0.96), rgba(7, 7, 6, 0.98)),
    #080807;
  box-shadow:
    0 16rpx 34rpx rgba(0, 0, 0, 0.34),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.04),
    inset 0 0 34rpx rgba(248, 183, 0, 0.03),
    inset 0 -22rpx 42rpx rgba(0, 0, 0, 0.24);
}

.workbench-hero::before,
.readiness-panel::before,
.module-band::before,
.evidence-section::before {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 0;
  z-index: 1;
  height: 2rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(248, 183, 0, 0), rgba(248, 183, 0, 0.34), rgba(248, 183, 0, 0));
}

.workbench-hero::after,
.readiness-panel::after,
.module-band::after,
.evidence-section::after {
  content: "";
  position: absolute;
  inset: 10rpx 14rpx;
  z-index: 1;
  border: 1rpx solid rgba(248, 183, 0, 0.065);
  border-radius: 0;
  pointer-events: none;
}

.workbench-cockpit {
  min-height: 246rpx;
  border-color: rgba(248, 183, 0, 0.34);
}

.workbench-cockpit.status-verified,
.workbench-cockpit.status-partial,
.workbench-cockpit.status-blocked,
.workbench-cockpit.status-source_reference,
.workbench-cockpit.status-stale {
  border-color: rgba(248, 183, 0, 0.34);
}

.workbench-cockpit-material {
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.16;
  filter: saturate(1.02) contrast(1.04);
  mix-blend-mode: normal;
}

.workbench-hero-content {
  position: relative;
  z-index: 2;
  min-height: 246rpx;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
}

.workbench-title-row,
.cockpit-signal-row,
.cockpit-real-icons,
.compact-header,
.evidence-row,
.verdict-head,
.verdict-next,
.blocker-row {
  display: flex;
  align-items: center;
}

.workbench-title-row {
  display: grid;
  grid-template-columns: 98rpx minmax(0, 1fr) 104rpx;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-height: 122rpx;
}

.spec-medallion {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  border: 2rpx solid rgba(248, 183, 0, 0.64);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 38%, rgba(84, 192, 255, 0.22), rgba(6, 6, 6, 0.9) 68%),
    #060606;
  box-shadow:
    0 0 0 7rpx rgba(0, 0, 0, 0.4),
    0 0 0 10rpx rgba(248, 183, 0, 0.09),
    0 10rpx 24rpx rgba(0, 0, 0, 0.38),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.07);
}

.spec-medallion::after {
  content: "";
  position: absolute;
  inset: 7rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 50%;
  pointer-events: none;
}

.spec-medallion image:not(.socket-material) {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.spec-medallion text {
  position: relative;
  z-index: 1;
  color: #f8b700;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.workbench-title-copy {
  flex: 1;
  min-width: 0;
}

.workbench-kicker,
.workbench-title,
.workbench-subtitle,
.workbench-intent {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workbench-kicker {
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.18;
}

.workbench-title {
  margin-top: 7rpx;
  color: #f4ead9;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.12;
}

.workbench-subtitle {
  margin-top: 6rpx;
  color: rgba(225, 226, 229, 0.74);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.22;
}

.workbench-intent {
  margin-top: 6rpx;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.18;
}

.readiness-badge {
  flex: none;
  justify-self: end;
  max-width: 112rpx;
  min-width: 92rpx;
  padding: 8rpx 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #e1e2e5;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.18;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readiness-badge text,
.scenario-tab text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cockpit-signal-row {
  display: none;
}

.cockpit-real-icons {
  flex: none;
  gap: 8rpx;
}

.cockpit-real-icon {
  width: 38rpx;
  height: 38rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.48);
  border-radius: 10rpx;
  background: #060606;
}

.cockpit-real-icon image {
  width: 100%;
  height: 100%;
}

.cockpit-signal-copy {
  flex: 1;
  min-width: 0;
}

.cockpit-signal-copy text {
  display: block;
  overflow: hidden;
  color: rgba(225, 226, 229, 0.68);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.24;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cockpit-signal-copy text + text {
  color: #f8b700;
}

.workbench-control-strip {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2.24fr);
  gap: 10rpx;
  width: 100%;
  margin: 20rpx 0 0;
  padding: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.18);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(20, 17, 12, 0.82), rgba(6, 6, 5, 0.94)),
    #070706;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    0 12rpx 26rpx rgba(0, 0, 0, 0.22);
}

.workbench-picker {
  display: grid;
  align-items: center;
  justify-content: center;
  place-items: center;
  min-height: 52rpx;
  padding: 0 10rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 6rpx;
  background: rgba(5, 4, 3, 0.52);
  line-height: 52rpx;
  text-align: center;
}

.picker-label {
  display: none;
}

.picker-value {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: #f1f1f1;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scenario-tabs {
  grid-column: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5rpx;
}

.scenario-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 52rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  background: rgba(16, 16, 16, 0.72);
  color: #a7a7a7;
  font-size: 21rpx;
  font-weight: 900;
}

.scenario-tab.active {
  border-color: rgba(248, 183, 0, 0.58);
  background: rgba(248, 183, 0, 0.13);
  color: #f8b700;
}

.verdict-slab {
  min-height: 416rpx;
  margin-top: 24rpx;
  padding: 34rpx 32rpx 30rpx;
  box-sizing: border-box;
  border-color: rgba(255, 107, 100, 0.24);
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 107, 100, 0.08), rgba(255, 107, 100, 0) 31%),
    linear-gradient(90deg, rgba(46, 10, 8, 0.16), rgba(6, 6, 6, 0.72)),
    #080807;
}

.verdict-slab-material {
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.22;
  filter: saturate(1.04) contrast(1.04);
  mix-blend-mode: normal;
}

.verdict-head {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  align-items: center;
  gap: 18rpx;
  min-height: 196rpx;
  padding-right: 0;
  box-sizing: border-box;
}

.verdict-leading-icon {
  position: relative;
  z-index: 2;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border: 3rpx solid rgba(248, 183, 0, 0.36);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 35%, rgba(248, 183, 0, 0.16), rgba(0, 0, 0, 0.88) 72%),
    #050504;
  box-shadow:
    0 8rpx 18rpx rgba(0, 0, 0, 0.34),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.05);
}

.verdict-leading-icon text {
  color: #f8b700;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.readiness-copy {
  flex: 1;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.verdict-kicker,
.readiness-title,
.readiness-summary,
.verdict-value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.verdict-kicker {
  display: none;
}

.readiness-title {
  margin-top: 0;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.12;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.readiness-summary {
  margin-top: 12rpx;
  color: #c8c8c8;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.36;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.verdict-blocker-line {
  display: flex;
  align-items: center;
  gap: 0;
  min-width: 0;
  margin-top: 14rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.verdict-label {
  display: none;
}

.verdict-value {
  flex: 1;
  min-width: 0;
  color: #f1f1f1;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.18;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.verdict-status-slot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;
  align-self: center;
  width: 124rpx;
  height: 124rpx;
  min-width: 124rpx;
  min-height: 124rpx;
  overflow: visible;
  pointer-events: none;
}

.verdict-status-slot status-visual {
  display: block;
  width: 100%;
  height: 100%;
}

.verdict-blocker-list {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8rpx;
  min-height: 0;
  margin-top: 10rpx;
}

.blocker-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 86rpx;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
  min-height: 52rpx;
  padding: 6rpx 10rpx 6rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  border-left: 3rpx solid rgba(255, 107, 100, 0.48);
  border-radius: 6rpx;
  background: rgba(5, 4, 3, 0.3);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    inset 0 -10rpx 16rpx rgba(0, 0, 0, 0.2);
}

.blocker-copy {
  flex: 1;
  min-width: 0;
}

.blocker-title,
.blocker-desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.blocker-title {
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 1.2;
}

.blocker-desc {
  margin-top: 2rpx;
  color: #9a9a9a;
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1.2;
}

.verdict-next {
  position: relative;
  z-index: 2;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  width: 100%;
  margin-top: 22rpx;
}

.verdict-next-label {
  flex: none;
  display: flex;
  align-items: center;
  color: rgba(244, 234, 217, 0.92);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.1;
}

.primary-action,
.blocker-action,
.evidence-toggle {
  position: relative;
  z-index: 2;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 7rpx;
  font-weight: 900;
  line-height: 1;
}

.primary-action {
  flex: 1;
  align-self: stretch;
  width: 100%;
  min-width: 100%;
  box-sizing: border-box;
  max-width: none;
  min-height: 78rpx;
  padding: 0 24rpx;
  overflow: hidden;
  border: 0;
  background:
    linear-gradient(180deg, rgba(255, 219, 110, 0.96), rgba(187, 124, 20, 0.96) 58%, rgba(120, 72, 10, 0.98)),
    #c88718;
  color: #17120d;
  font-size: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow:
    0 10rpx 22rpx rgba(248, 183, 0, 0.18),
    inset 0 0 0 2rpx rgba(255, 239, 176, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.34),
    inset 0 -5rpx 0 rgba(66, 37, 4, 0.22);
}

.primary-action-hover {
  filter: brightness(1.08);
}

.primary-action text {
  position: relative;
  z-index: 1;
}

.primary-action-arrow {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
}

.blocker-action {
  min-width: 0;
  min-height: 34rpx;
  padding: 0 7rpx;
  overflow: hidden;
  background: rgba(248, 183, 0, 0.1);
  color: #f8b700;
  font-size: 14rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-action::after,
.blocker-action::after,
.evidence-toggle::after {
  border: 0;
}

.module-band {
  min-height: 352rpx;
  margin-top: 14rpx;
  padding: 22rpx 18rpx 20rpx;
  box-sizing: border-box;
}

.module-band-material {
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.1;
  filter: saturate(1.06) contrast(1.08);
  mix-blend-mode: normal;
}

.compact-header {
  position: relative;
  z-index: 2;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.section-title {
  flex: none;
  overflow: hidden;
  color: #f4ead9;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.14;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-action {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #f8b700;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.14;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-card-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.module-card {
  position: relative;
  display: grid;
  grid-template-columns: 66rpx minmax(0, 1fr) 86rpx;
  grid-template-rows: minmax(0, 1fr);
  align-items: center;
  justify-items: stretch;
  column-gap: 14rpx;
  row-gap: 0;
  min-width: 0;
  min-height: 128rpx;
  padding: 16rpx 14rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.14);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.12), rgba(248, 183, 0, 0) 44%),
    linear-gradient(180deg, rgba(30, 26, 20, 0.92), rgba(8, 8, 7, 0.98)),
    #080807;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.025),
    inset 0 -18rpx 26rpx rgba(0, 0, 0, 0.28),
    0 8rpx 18rpx rgba(0, 0, 0, 0.22);
}

.module-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 3rpx;
  background: rgba(248, 183, 0, 0.24);
}

.module-card::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.08);
  border-radius: 4rpx;
  pointer-events: none;
}

.module-card-top {
  position: relative;
  z-index: 2;
  grid-column: 1;
  grid-row: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding-top: 0;
}

.game-icon-frame {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  overflow: hidden;
  border: 1rpx solid rgba(248, 183, 0, 0.48);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 35%, rgba(248, 183, 0, 0.14), rgba(0, 0, 0, 0.86) 70%),
    #060606;
  color: #f8b700;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow:
    0 0 0 5rpx rgba(0, 0, 0, 0.28),
    0 0 0 7rpx rgba(248, 183, 0, 0.07),
    0 8rpx 18rpx rgba(0, 0, 0, 0.4),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.05);
}

.game-icon-frame::after {
  content: "";
  position: absolute;
  inset: 5rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.game-icon-frame image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.game-icon-frame image.socket-material {
  position: absolute;
  inset: -7rpx;
  z-index: 0;
  width: calc(100% + 14rpx);
  height: calc(100% + 14rpx);
}

.game-icon-frame text {
  position: relative;
  z-index: 1;
}

.module-title,
.module-metric,
.module-desc,
.module-link,
.module-status {
  position: relative;
  z-index: 2;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.module-card-copy {
  position: relative;
  z-index: 2;
  grid-column: 2;
  grid-row: 1;
  min-width: 0;
  width: 100%;
  text-align: left;
}

.module-card-side {
  position: relative;
  right: auto;
  top: auto;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  grid-column: 3;
  grid-row: 1;
}

.module-title {
  margin-top: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: left;
  white-space: nowrap;
}

.module-metric {
  margin-top: 4rpx;
  padding-right: 0;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.12;
  text-align: left;
  white-space: nowrap;
}

.module-desc {
  display: block;
  margin-top: 5rpx;
  min-height: 0;
  color: rgba(225, 226, 229, 0.72);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: left;
  white-space: nowrap;
}

.module-status {
  position: relative;
  min-width: 56rpx;
  max-width: 86rpx;
  padding: 5rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #8e8e8e;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.module-link {
  display: block;
  max-width: 86rpx;
  color: rgba(248, 183, 0, 0.82);
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: right;
  white-space: nowrap;
}

.evidence-section {
  min-height: 640rpx;
  margin-top: 14rpx;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
}

.evidence-section-material {
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.12;
  filter: saturate(1.02) contrast(1.04);
  mix-blend-mode: normal;
}

.evidence-actions {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 78rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.template-count {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(225, 226, 229, 0.58);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.evidence-toggle {
  min-width: 78rpx;
  min-height: 42rpx;
  padding: 0 11rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.16);
  background: rgba(248, 183, 0, 0.09);
  color: #f8b700;
  font-size: 19rpx;
}

.evidence-toggle text {
  position: relative;
  z-index: 1;
  display: block;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.evidence-list {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.evidence-list.expanded {
  gap: 8rpx;
}

.evidence-list.expanded .evidence-row {
  grid-template-columns: 48rpx minmax(0, 1fr) minmax(104rpx, auto) 16rpx;
  gap: 10rpx;
  min-height: 84rpx;
  padding: 11rpx 18rpx;
}

.evidence-row {
  position: relative;
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr) minmax(110rpx, auto) 18rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 92rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-left-color: rgba(248, 183, 0, 0.2);
  border-radius: 6rpx;
  background:
    linear-gradient(90deg, rgba(248, 183, 0, 0.045), rgba(248, 183, 0, 0) 42%),
    linear-gradient(180deg, rgba(18, 16, 13, 0.86), rgba(5, 5, 4, 0.92)),
    #070605;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.035),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.32);
}

.evidence-row::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 11rpx;
  bottom: 11rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.36);
  pointer-events: none;
}

.evidence-row::after {
  content: "";
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  bottom: 6rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(248, 183, 0, 0.16), transparent);
  pointer-events: none;
}

.evidence-icon-socket {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.24);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 35%, rgba(248, 183, 0, 0.13), rgba(0, 0, 0, 0.88) 70%),
    #060606;
  color: #f8b700;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.035);
}

.evidence-icon-socket image.socket-material {
  position: absolute;
  inset: -7rpx;
  z-index: 0;
  width: calc(100% + 14rpx);
  height: calc(100% + 14rpx);
}

.evidence-icon-socket::after {
  content: "";
  position: absolute;
  inset: 5rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.14);
  border-radius: 50%;
  pointer-events: none;
}

.evidence-icon-socket text {
  position: relative;
  z-index: 1;
}

.evidence-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.evidence-label {
  display: block;
  overflow: hidden;
  color: rgba(225, 226, 229, 0.52);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.evidence-value {
  display: block;
  margin-top: 4rpx;
  overflow: visible;
  color: #f4ead9;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.24;
  overflow-wrap: anywhere;
  text-overflow: clip;
  white-space: normal;
}

.evidence-status {
  position: relative;
  z-index: 2;
  flex: none;
  justify-self: end;
  align-self: center;
  min-width: 92rpx;
  max-width: 128rpx;
  overflow: hidden;
  padding: 5rpx 8rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.08);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.28);
  color: rgba(244, 234, 217, 0.62);
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.evidence-list.expanded .evidence-icon-socket {
  width: 42rpx;
  height: 42rpx;
  font-size: 15rpx;
}

.evidence-list.expanded .evidence-value {
  font-size: 20rpx;
}

.evidence-list.expanded .evidence-status {
  max-width: 84rpx;
}

.evidence-arrow {
  position: relative;
  z-index: 2;
  align-self: center;
  color: rgba(248, 183, 0, 0.32);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.evidence-row.status-verified,
.evidence-row.status-partial,
.evidence-row.status-blocked,
.evidence-row.status-source_reference,
.evidence-row.status-stale {
  border-color: rgba(248, 183, 0, 0.12);
  border-left-color: rgba(248, 183, 0, 0.2);
}

.evidence-row.status-verified::before {
  background: rgba(88, 201, 142, 0.56);
}

.evidence-row.status-partial::before {
  background: rgba(248, 183, 0, 0.56);
}

.evidence-row.status-blocked::before {
  background: rgba(255, 107, 100, 0.58);
}

.evidence-row.status-source_reference::before {
  background: rgba(84, 192, 255, 0.52);
}

.evidence-row.status-stale::before {
  background: rgba(255, 140, 128, 0.52);
}

.evidence-row.status-verified .evidence-icon-socket,
.evidence-row.status-partial .evidence-icon-socket,
.evidence-row.status-blocked .evidence-icon-socket,
.evidence-row.status-source_reference .evidence-icon-socket,
.evidence-row.status-stale .evidence-icon-socket {
  border-color: rgba(248, 183, 0, 0.24);
  color: #f8b700;
}

.evidence-row.status-verified .evidence-status {
  border-color: rgba(88, 201, 142, 0.18);
  background: rgba(88, 201, 142, 0.045);
  color: #8fd8af;
}

.evidence-row.status-partial .evidence-status {
  border-color: rgba(248, 183, 0, 0.2);
  background: rgba(248, 183, 0, 0.055);
  color: #f8c84a;
}

.evidence-row.status-blocked .evidence-status {
  border-color: rgba(255, 107, 100, 0.2);
  background: rgba(255, 107, 100, 0.055);
  color: #ff9b95;
}

.evidence-row.status-source_reference .evidence-status {
  border-color: rgba(84, 192, 255, 0.18);
  background: rgba(84, 192, 255, 0.045);
  color: #95d8ff;
}

.evidence-row.status-stale .evidence-status {
  border-color: rgba(255, 140, 128, 0.18);
  background: rgba(255, 140, 128, 0.045);
  color: #ffb1aa;
}

.status-verified {
  border-color: rgba(88, 201, 142, 0.5);
}

.status-verified .module-status,
.status-verified .module-metric,
.status-verified .evidence-status,
.status-verified.readiness-badge {
  color: #58c98e;
}

.status-verified .evidence-icon-socket {
  border-color: rgba(88, 201, 142, 0.5);
  color: #58c98e;
}

.status-verified.verdict-slab {
  border-color: rgba(88, 201, 142, 0.48);
  background: linear-gradient(90deg, rgba(11, 42, 27, 0.46), rgba(6, 6, 6, 0.82)), #10100f;
}

.status-verified.module-card {
  background:
    radial-gradient(circle at 50% 0%, rgba(88, 201, 142, 0.13), rgba(88, 201, 142, 0) 44%),
    linear-gradient(180deg, rgba(21, 33, 25, 0.9), rgba(7, 8, 7, 0.98)),
    #080807;
}

.status-verified.module-card::before {
  background: #58c98e;
}

.status-verified.verdict-slab .readiness-title {
  color: #58c98e;
}

.status-partial {
  border-color: rgba(248, 183, 0, 0.44);
}

.status-partial .module-status,
.status-partial .module-metric,
.status-partial .evidence-status,
.status-partial.readiness-badge {
  color: #f8b700;
}

.status-partial .evidence-icon-socket {
  border-color: rgba(248, 183, 0, 0.5);
  color: #f8b700;
}

.status-partial.verdict-slab {
  border-color: rgba(248, 183, 0, 0.48);
  background: linear-gradient(90deg, rgba(62, 40, 7, 0.46), rgba(6, 6, 6, 0.82)), #10100f;
}

.status-partial.module-card {
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.14), rgba(248, 183, 0, 0) 44%),
    linear-gradient(180deg, rgba(35, 28, 15, 0.9), rgba(8, 8, 7, 0.98)),
    #080807;
}

.status-partial.module-card::before {
  background: #f8b700;
}

.status-partial.verdict-slab .readiness-title {
  color: #f8b700;
}

.status-blocked {
  border-color: rgba(255, 107, 100, 0.5);
}

.status-blocked .module-status,
.status-blocked .module-metric,
.status-blocked .evidence-status,
.status-blocked.readiness-badge {
  color: #ff6b64;
}

.status-blocked .evidence-icon-socket {
  border-color: rgba(255, 107, 100, 0.5);
  color: #ff6b64;
}

.status-blocked.verdict-slab {
  border-color: rgba(255, 107, 100, 0.24);
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 107, 100, 0.045), rgba(255, 107, 100, 0) 31%),
    linear-gradient(90deg, rgba(46, 10, 8, 0.1), rgba(6, 6, 6, 0.76)),
    #080807;
}

.status-blocked.module-card {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 107, 100, 0.12), rgba(255, 107, 100, 0) 44%),
    linear-gradient(180deg, rgba(36, 18, 16, 0.9), rgba(8, 7, 7, 0.98)),
    #080807;
}

.status-blocked.module-card::before {
  background: linear-gradient(180deg, rgba(255, 107, 100, 0.14), rgba(255, 107, 100, 0.72) 48%, rgba(255, 107, 100, 0.16));
}

.status-blocked.verdict-slab .readiness-title {
  color: #ff6b64;
}

.status-source_reference {
  border-color: rgba(84, 192, 255, 0.44);
}

.status-source_reference .module-status,
.status-source_reference .module-metric,
.status-source_reference .evidence-status,
.status-source_reference.readiness-badge {
  color: #54c0ff;
}

.status-source_reference .evidence-icon-socket {
  border-color: rgba(84, 192, 255, 0.5);
  color: #54c0ff;
}

.status-source_reference.verdict-slab {
  border-color: rgba(84, 192, 255, 0.46);
  background: linear-gradient(90deg, rgba(9, 35, 52, 0.46), rgba(6, 6, 6, 0.82)), #10100f;
}

.status-source_reference.module-card {
  background:
    radial-gradient(circle at 50% 0%, rgba(84, 192, 255, 0.12), rgba(84, 192, 255, 0) 44%),
    linear-gradient(180deg, rgba(16, 29, 38, 0.9), rgba(7, 8, 8, 0.98)),
    #080807;
}

.status-source_reference.module-card::before {
  background: #54c0ff;
}

.status-source_reference.verdict-slab .readiness-title {
  color: #8bd8ff;
}

.status-stale {
  border-color: rgba(255, 140, 128, 0.45);
}

.status-stale .module-status,
.status-stale .module-metric,
.status-stale .evidence-status,
.status-stale.readiness-badge {
  color: #ff8c80;
}

.status-stale .evidence-icon-socket {
  border-color: rgba(255, 140, 128, 0.5);
  color: #ff8c80;
}

.status-stale.verdict-slab {
  border-color: rgba(255, 140, 128, 0.46);
}

.status-stale.module-card {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 140, 128, 0.12), rgba(255, 140, 128, 0) 44%),
    linear-gradient(180deg, rgba(36, 22, 18, 0.9), rgba(8, 7, 7, 0.98)),
    #080807;
}

.status-stale.module-card::before {
  background: #ff8c80;
}

.status-stale.verdict-slab .readiness-title {
  color: #ff8c80;
}

@media (max-width: 380px) {
  .workbench-shell .workbench-content {
    padding-left: 0;
    padding-right: 0;
  }

  .workbench-hero,
  .readiness-panel,
  .module-band,
  .evidence-section {
    width: calc(100% - 48rpx);
    max-width: 100%;
    margin-left: 24rpx;
    margin-right: 24rpx;
  }

  .workbench-cockpit {
    min-height: 232rpx;
  }

  .workbench-hero-content {
    min-height: 232rpx;
    padding: 22rpx 24rpx 18rpx;
  }

  .workbench-title-row {
    grid-template-columns: 86rpx minmax(0, 1fr) 82rpx;
    gap: 12rpx;
    min-height: 108rpx;
  }

  .spec-medallion {
    width: 82rpx;
    height: 82rpx;
  }

  .workbench-kicker {
    font-size: 18rpx;
  }

  .workbench-title {
    font-size: 34rpx;
  }

  .workbench-subtitle {
    font-size: 20rpx;
  }

  .workbench-intent {
    font-size: 19rpx;
  }

  .readiness-badge {
    min-width: 78rpx;
    max-width: 90rpx;
    padding: 5rpx 7rpx;
    font-size: 16rpx;
  }

  .workbench-control-strip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2.1fr);
    gap: 7rpx;
    margin: 16rpx 0 0;
    padding: 6rpx;
  }

  .workbench-picker {
    min-height: 46rpx;
    padding: 0 7rpx;
  }

  .picker-label {
    display: none;
  }

  .picker-value {
    font-size: 20rpx;
    line-height: 46rpx;
  }

  .scenario-tabs {
    gap: 5rpx;
  }

  .scenario-tab {
    min-height: 46rpx;
    font-size: 18rpx;
  }

  .verdict-slab {
    min-height: 424rpx;
    padding: 32rpx 22rpx 26rpx;
  }

  .readiness-title {
    font-size: 34rpx;
  }

  .readiness-summary {
    font-size: 24rpx;
  }

  .verdict-label,
  .verdict-value {
    font-size: 26rpx;
  }

  .verdict-head {
    grid-template-columns: minmax(0, 1fr) 106rpx;
    gap: 12rpx;
    min-height: 198rpx;
  }

  .verdict-leading-icon {
    width: 46rpx;
    height: 46rpx;
    margin-top: 6rpx;
    border-width: 2rpx;
  }

  .verdict-leading-icon text {
    font-size: 26rpx;
  }

  .verdict-status-slot {
    width: 104rpx;
    height: 104rpx;
    min-width: 104rpx;
    min-height: 104rpx;
  }

  .verdict-blocker-list {
    min-height: 0;
  }

  .blocker-row {
    grid-template-columns: minmax(0, 1fr) 74rpx;
    gap: 6rpx;
  }

  .blocker-action {
    font-size: 13rpx;
  }

  .primary-action {
    width: 100%;
    min-height: 74rpx;
    font-size: 28rpx;
  }

  .module-band {
    min-height: 344rpx;
    padding: 22rpx 14rpx 20rpx;
  }

  .module-card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10rpx;
  }

  .module-card {
    min-height: 126rpx;
    padding: 13rpx 12rpx;
    grid-template-columns: 56rpx minmax(0, 1fr) 64rpx;
    grid-template-rows: minmax(0, 1fr);
    column-gap: 9rpx;
    row-gap: 0;
  }

  .game-icon-frame {
    width: 54rpx;
    height: 54rpx;
  }

  .module-title {
    margin-top: 0;
    font-size: 22rpx;
    text-align: left;
  }

  .module-metric {
    margin-top: 2rpx;
    font-size: 20rpx;
    text-align: left;
  }

  .module-desc {
    display: block;
    min-height: 0;
    font-size: 16rpx;
  }

  .module-status {
    min-width: 42rpx;
    max-width: 68rpx;
    padding: 4rpx 6rpx;
    font-size: 13rpx;
  }

  .module-link {
    display: block;
    max-width: 72rpx;
    font-size: 13rpx;
  }

  .evidence-section {
    min-height: 640rpx;
    padding: 24rpx 16rpx 20rpx;
  }

  .evidence-actions {
    grid-template-columns: minmax(0, 1fr) 66rpx;
    gap: 6rpx;
  }

  .template-count {
    font-size: 15rpx;
  }

  .evidence-toggle {
    min-width: 64rpx;
    min-height: 34rpx;
    font-size: 16rpx;
  }

  .evidence-list {
    gap: 11rpx;
    margin-top: 16rpx;
  }

  .evidence-list.expanded {
    gap: 7rpx;
  }

  .evidence-row {
    grid-template-columns: 48rpx minmax(0, 1fr) minmax(90rpx, auto) 12rpx;
    gap: 9rpx;
    min-height: 88rpx;
    padding: 12rpx 14rpx;
  }

  .evidence-list.expanded .evidence-row {
    grid-template-columns: 38rpx minmax(0, 1fr) minmax(86rpx, auto) 12rpx;
    gap: 8rpx;
    min-height: 78rpx;
    padding: 9rpx 12rpx;
  }

  .evidence-icon-socket {
    width: 48rpx;
    height: 48rpx;
    font-size: 16rpx;
  }

  .evidence-label {
    font-size: 15rpx;
  }

  .evidence-value {
    font-size: 22rpx;
  }

  .evidence-status {
    min-width: 78rpx;
    max-width: 92rpx;
    font-size: 14rpx;
  }

  .evidence-list.expanded .evidence-icon-socket {
    width: 34rpx;
    height: 34rpx;
    font-size: 12rpx;
  }

  .evidence-list.expanded .evidence-value {
    font-size: 17rpx;
  }

  .evidence-list.expanded .evidence-status {
    min-width: 74rpx;
    max-width: 86rpx;
  }
}
