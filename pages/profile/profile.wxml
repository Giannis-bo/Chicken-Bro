<view class="page-shell">
  <navigation-bar title="我的" back="{{false}}" color="#211A15" background="#F4F1E8"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content profile-page">
      <view class="profile-card user-card">
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar">W</text>
        </button>
        <view class="user-info">
          <input
            class="user-name nickname-input"
            type="nickname"
            value="{{nicknameDraft}}"
            placeholder="点击填写微信昵称"
            bindinput="onNicknameInput"
            bindblur="saveNickname"
            bindconfirm="onNicknameConfirm"
            confirm-type="done"
          />
          <text class="user-desc">管理角色、偏好和常用数据源</text>
        </view>
      </view>

      <view class="metrics">
        <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-label">{{item.label}}</text>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <text class="section-title">我的能力</text>
          <text class="section-action">查看</text>
        </view>
        <view class="ability-list">
          <view class="ability-row" wx:for="{{abilities}}" wx:key="name">
            <view class="ability-main">
              <text class="ability-name">{{item.name}}</text>
              <text class="ability-desc">{{item.desc}}</text>
            </view>
            <text class="ability-level">{{item.level}}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <text class="section-title">设置与管理</text>
        </view>
        <view class="setting-list">
          <view class="setting-row" wx:for="{{settings}}" wx:key="title">
            <text class="setting-title">{{item.title}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
