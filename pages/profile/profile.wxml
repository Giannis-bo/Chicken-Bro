<view class="page-shell profile-shell">
  <view class="profile-shell-bg">
    <view class="profile-shell-vignette"></view>
  </view>
  <navigation-bar title="我的" back="{{false}}" color="#FFFFFF" background="#111111"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y>
    <view class="page-content profile-page">
      <view class="profile-cockpit">
        <view class="profile-cockpit-shade"></view>
        <view class="profile-cockpit-content">
          <view class="profile-identity-row">
            <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
              <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
              <text wx:else class="avatar">W</text>
            </button>
            <view class="user-info">
              <text class="profile-kicker">个人控制台</text>
              <input
                class="user-name nickname-input"
                type="nickname"
                value="{{nicknameDraft}}"
                placeholder="点击填写微信昵称"
                bindinput="onNicknameInput"
                bindblur="saveNickname"
                bindconfirm="onNicknameConfirm"
                confirm-type="done"
              />
              <text class="user-desc">管理模板、角色偏好和数据源</text>
            </view>
          </view>

          <view class="profile-signal-strip">
            <view class="profile-signal" wx:for="{{profileMetrics}}" wx:key="label">
              <text class="metric-value">{{item.value}}</text>
              <text class="metric-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <text class="section-title">个人模板库</text>
        </view>
        <view class="template-module-list">
          <view class="template-module" wx:for="{{templateModules}}" wx:key="type">
            <view class="template-module-head">
              <view>
                <text wx:if="{{item.type == 'talent'}}" class="template-module-title">天赋模板</text>
                <text wx:elif="{{item.type == 'gear'}}" class="template-module-title">装备模板</text>
                <text wx:else class="template-module-title">{{item.title}}</text>
                <text class="template-module-desc">已保存 {{item.count}} 个模板</text>
              </view>
              <text class="template-module-count">{{item.count}}</text>
            </view>

            <view class="template-empty" wx:if="{{item.count == 0}}">
              <text>{{item.emptyText}}</text>
            </view>

            <view class="template-list" wx:else>
              <view class="template-card" wx:for="{{item.recent}}" wx:for-item="template" wx:key="id">
                <view class="template-card-main">
                  <text class="template-title">{{template.title}}</text>
                  <view class="template-meta-row">
                    <text class="template-meta-chip" wx:for="{{template.metaChips}}" wx:for-item="chip" wx:key="*this">{{chip}}</text>
                  </view>
                  <text class="template-source">{{template.savedTimeLabel}}</text>
                </view>
                <button class="template-delete-button" data-id="{{template.id}}" data-title="{{template.title}}" bindtap="deleteTemplate">删除</button>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <text class="section-title">设置与管理</text>
        </view>
        <view class="setting-list">
          <view class="setting-row" wx:for="{{settings}}" wx:key="title">
            <text class="setting-title">{{item.title}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
