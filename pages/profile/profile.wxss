.profile-shell {
  position: relative;
  overflow: hidden;
  background: #060606;
  background: var(--wow-bg);
  --profile-gutter: 24rpx;
}

.profile-shell-bg,
.profile-shell-bg image,
.profile-shell-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.profile-shell-bg {
  z-index: 0;
  opacity: 0.42;
}

.profile-shell-bg image {
  width: 100%;
  height: 100%;
  filter: saturate(1.08) contrast(1.04);
}

.profile-shell-vignette {
  background:
    radial-gradient(circle at 50% 0%, rgba(248, 183, 0, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(6, 6, 6, 0.12) 0%, var(--wow-bg) 74%);
}

.profile-page {
  position: relative;
  z-index: 1;
  padding: 22rpx var(--profile-gutter) var(--wow-tabbar-space);
  background: transparent;
}

.profile-cockpit {
  position: relative;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border: 1rpx solid var(--wow-gold-border);
  border-radius: 8rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 10%, rgba(248, 183, 0, 0.14), transparent 42%),
    linear-gradient(180deg, rgba(20, 18, 14, 0.96), rgba(8, 8, 7, 0.98)),
    #101010;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.24);
}

.profile-cockpit-material,
.profile-cockpit-shade {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.profile-cockpit-material {
  width: 100%;
  height: 100%;
  opacity: 0.035;
  filter: saturate(0.72) contrast(0.9) blur(0.4px);
}

.profile-cockpit-shade {
  background:
    radial-gradient(circle at 22% 8%, rgba(248, 183, 0, 0.09), transparent 40%),
    linear-gradient(180deg, rgba(14, 11, 7, 0.62), rgba(6, 6, 6, 0.72));
}

.profile-cockpit-content {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 20rpx;
  min-width: 0;
  padding: 24rpx;
}

.profile-identity-row {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.avatar-button {
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  flex: none;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  overflow: hidden;
}

.avatar-button::after {
  border: 0;
}

.avatar,
.avatar-image {
  width: 92rpx;
  height: 92rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border: 1rpx solid var(--wow-gold-border);
  border-radius: 8rpx;
  background: #101010;
  background: var(--wow-surface);
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 38rpx;
  font-weight: 900;
}

.avatar-image {
  display: block;
  border-radius: 8rpx;
}

.user-info {
  display: grid;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.profile-kicker {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-name {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: #f1f1f1;
  color: var(--wow-text-strong);
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 48rpx;
  padding: 0;
  line-height: 48rpx;
}

.user-desc {
  display: block;
  min-width: 0;
  color: #9a9a9a;
  color: var(--wow-text-muted);
  font-size: 24rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.profile-signal-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid rgba(248, 183, 0, 0.12);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.22);
}

.profile-signal {
  flex: 1 1 180rpx;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.profile-signal .metric-value {
  display: block;
  min-width: 0;
  color: #f8b700;
  color: var(--wow-gold);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  overflow-wrap: anywhere;
}

.profile-signal .metric-label {
  display: block;
  min-width: 0;
  margin-top: 0;
  color: rgba(255, 255, 255, 0.64);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.template-module-list,
.setting-list {
  display: flex;
  flex-direction: column;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.setting-row:last-child {
  border-bottom: 0;
}

.template-module {
  min-width: 0;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.template-module:first-child {
  padding-top: 0;
}

.template-module:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.template-module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.template-module-title,
.template-title,
.setting-title {
  display: block;
  color: #f1f1f1;
  font-size: 27rpx;
  font-weight: 800;
}

.template-module-desc,
.template-source,
.template-empty {
  display: block;
  color: #9a9a9a;
  font-size: 23rpx;
  line-height: 1.4;
}

.template-module-desc {
  margin-top: 8rpx;
}

.template-module-count {
  flex: none;
  min-width: 56rpx;
  color: #f8b700;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  text-align: right;
}

.template-empty {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  background: #101010;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.template-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: #101010;
}

.template-card-main {
  flex: 1;
  min-width: 0;
}

.template-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.template-meta-chip {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.template-source {
  margin-top: 10rpx;
  overflow-wrap: anywhere;
}

.template-delete-button {
  flex: none;
  align-self: flex-start;
  width: 72rpx;
  min-width: 72rpx;
  height: 44rpx;
  min-height: 44rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  color: #d9d9d9;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.template-delete-button::after {
  border: 0;
}

.setting-arrow {
  color: #f8b700;
  font-size: 36rpx;
}
