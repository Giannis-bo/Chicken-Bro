.profile-page {
  background: #060606;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 0;
  border-color: rgba(248, 183, 0, 0.16);
}

.avatar-button {
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  flex: none;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  overflow: hidden;
}

.avatar-button::after {
  border: 0;
}

.avatar,
.avatar-image {
  width: 104rpx;
  height: 104rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 16rpx;
  background: #101010;
  color: #f8b700;
  font-size: 44rpx;
  font-weight: 900;
}

.avatar-image {
  display: block;
  border-radius: 16rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  color: #f1f1f1;
  font-size: 36rpx;
  font-weight: 900;
}

.nickname-input {
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  line-height: 48rpx;
}

.user-desc {
  display: block;
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.ability-list,
.setting-list {
  display: flex;
  flex-direction: column;
}

.ability-row,
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.ability-row:last-child,
.setting-row:last-child {
  border-bottom: 0;
}

.ability-main {
  flex: 1;
  min-width: 0;
}

.ability-name,
.setting-title {
  display: block;
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 800;
}

.ability-desc {
  display: block;
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 23rpx;
  line-height: 1.4;
}

.ability-level {
  flex: none;
  color: #f8b700;
  font-size: 24rpx;
  font-weight: 800;
}

.setting-arrow {
  color: #8b3ff5;
  font-size: 36rpx;
}
