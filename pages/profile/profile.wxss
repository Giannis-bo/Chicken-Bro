.profile-page {
  background: #060606;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 0;
  border-color: rgba(248, 183, 0, 0.16);
}

.avatar-button {
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  flex: none;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  overflow: hidden;
}

.avatar-button::after {
  border: 0;
}

.avatar,
.avatar-image {
  width: 104rpx;
  height: 104rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(248, 183, 0, 0.28);
  border-radius: 16rpx;
  background: #101010;
  color: #f8b700;
  font-size: 44rpx;
  font-weight: 900;
}

.avatar-image {
  display: block;
  border-radius: 16rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  color: #f1f1f1;
  font-size: 36rpx;
  font-weight: 900;
}

.nickname-input {
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  line-height: 48rpx;
}

.user-desc {
  display: block;
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.template-module-list,
.setting-list {
  display: flex;
  flex-direction: column;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.setting-row:last-child {
  border-bottom: 0;
}

.template-module {
  min-width: 0;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.template-module:first-child {
  padding-top: 0;
}

.template-module:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.template-module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.template-module-title,
.template-title,
.setting-title {
  display: block;
  color: #f1f1f1;
  font-size: 28rpx;
  font-weight: 800;
}

.template-module-desc,
.template-source,
.template-empty {
  display: block;
  color: #9a9a9a;
  font-size: 23rpx;
  line-height: 1.4;
}

.template-module-desc {
  margin-top: 8rpx;
}

.template-module-count {
  flex: none;
  min-width: 56rpx;
  color: #f8b700;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  text-align: right;
}

.template-empty {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  background: #101010;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.template-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: #101010;
}

.template-card-main {
  flex: 1;
  min-width: 0;
}

.template-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.template-meta-chip {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(248, 183, 0, 0.12);
  color: #f8b700;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.template-source {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
}

.template-delete-button {
  flex: none;
  min-width: 88rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #d9d9d9;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.template-delete-button::after {
  border: 0;
}

.setting-arrow {
  color: #8b3ff5;
  font-size: 36rpx;
}
